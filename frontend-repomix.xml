   ENTERPRISE MODAL v2 — Custom Tooltips, Upload Zone Dashed, Blue Accent
   ======================================================================== */

/* ── Custom Tooltip (::after pattern) ─────────────────────────────────── */
/*
   Usage: <element class="custom-tooltip" data-tooltip="Tu texto aquí">
   Aparece instantáneamente (no tiene delay como los title nativos).
*/
[data-tooltip] {
  position: relative;
}
[data-tooltip]::after {
  content: attr(data-tooltip);
  position: absolute;
  bottom: calc(100% + 6px);
  left: 50%;
  transform: translateX(-50%);
  background: #1e293b;
  color: #f8fafc;
  font-size: 0.72rem;
  font-weight: 500;
  line-height: 1.4;
  white-space: normal;       /* permite saltos de l�nea */
  word-wrap: break-word;
  max-width: 220px;
  text-align: center;
  padding: 7px 11px;
  border-radius: 6px;
  box-shadow: 0 4px 12px rgba(0,0,0,.18);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0s;
  z-index: 11000;
}
[data-tooltip]:hover::after {
  opacity: 1;
}
/* Flecha del tooltip */
[data-tooltip]::before {
  content: '';
  position: absolute;
  bottom: calc(100% + 1px);
  left: 50%;
  transform: translateX(-50%);
  border: 5px solid transparent;
  border-top-color: #1e293b;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0s;
  z-index: 11000;
}
[data-tooltip]:hover::before {
  opacity: 1;
}
/* Variante: tooltip que aparece a la derecha */
[data-tooltip-right]::after {
  content: attr(data-tooltip-right);
  left: calc(100% + 8px);
  bottom: auto;
  top: 50%;
  transform: translateY(-50%);
}
[data-tooltip-right]::before {
  left: calc(100% + 2px);
  bottom: auto;
  top: 50%;
  transform: translateY(-50%);
  border-top-color: transparent;
  border-right-color: #1e293b;
}

