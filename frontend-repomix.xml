.input-help-counter strong {
  color: #722f37;
  font-weight: 700;
}

/* Badge "Opcional" en label */
.label-badge {
  background: #f3f4f6;
  color: #6b7280;
  font-size: 0.75rem;
  padding: 3px 10px;
  border-radius: 12px;
  font-weight: 500;
  margin-left: 8px;
  letter-spacing: 0.3px;
  text-transform: uppercase;
}

/* Iconos mini en texto de ayuda */
.mini-icon {
  font-size: 1rem !important;
  vertical-align: middle;
  color: #9ca3af;
}

/* Textarea estándar para descripción corta */
.form-textarea {
  width: 100%;
  padding: 0.75rem;
  border: 2px solid #e5e7eb;
  border-radius: 8px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
