                      <span>Listo</span>
                    } @else if (reindexState[idx.index_name] === 'err') {
                      <span class="material-icons mnt-reindex-btn__icon">cancel</span>
                      <span>Error</span>
                    } @else {
                      <span class="material-icons mnt-reindex-btn__icon">build_circle</span>
                      <span>Reindex</span>
                    }
                  </button>
                </td>

              </tr>
            }
          </tbody>
        </table>
