/* ═══════════════════════════════════════════════════════════════════════════
   Mantenimiento de Base de Datos — estilos propios del componente
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Root ─────────────────────────────────────────────────────────────────── */
.mnt-root {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 24px 24px 24px;
  background: #f8fafc;
}

/* ── Header del módulo ────────────────────────────────────────────────────── */
.mnt-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 20px 24px 18px;
  background: #fff;
  border: 0.5px solid #e2e8f0;
  border-radius: 12px;
}
.mnt-header__left {
  display: flex;
  align-items: center;
  gap: 14px;
}
.mnt-header__icon {
  width: 44px; height: 44px;
  border-radius: 10px;
  background: #fff7ed;
  display: flex; align-items: center; justify-content: center;
  color: #ea580c;
  flex-shrink: 0;
}
.mnt-header__icon .material-icons { font-size: 22px; }
.mnt-header__title-row {
  display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
}
.mnt-header__title {
  font-size: 1rem; font-weight: 700; color: #0f172a; margin: 0;
}
.mnt-header__sub {
  font-size: .78rem; color: #64748b; margin: 2px 0 0;
}

/* Autovacuum badge */
.mnt-av-badge {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: .72rem; font-weight: 600; letter-spacing: .03em;
  padding: 3px 10px; border-radius: 99px;
}
.mnt-av-badge--active  { background: #dcfce7; color: #15803d; }
.mnt-av-badge--inactive{ background: #fee2e2; color: #dc2626; }
.mnt-av-badge__dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: currentColor;
  animation: mnt-pulse 2s infinite;
}
@keyframes mnt-pulse {
  0%,100% { opacity: 1; }
  50%      { opacity: .4; }
}

/* Botón actualizar */
.mnt-btn-refresh {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 14px; border-radius: 8px;
  font-size: .82rem; font-weight: 600; color: #475569;
  background: #f8fafc; border: 1px solid #e2e8f0;
  cursor: pointer; transition: background .15s, color .15s;
  white-space: nowrap;
}
.mnt-btn-refresh:hover:not(:disabled) { background: #f1f5f9; color: #0f172a; }
.mnt-btn-refresh:disabled { opacity: .5; cursor: not-allowed; }

/* ── Callout de error ─────────────────────────────────────────────────────── */
.mnt-callout {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 12px 16px; border-radius: 8px;
  font-size: .82rem;
}
.mnt-callout--red { background: #fff0f0; border-left: 3px solid #dc2626; color: #991b1b; }
.mnt-callout .material-icons { font-size: 18px; margin-top: 1px; }

/* ── KPI grid (Sección 1) ─────────────────────────────────────────────────── */
.mnt-kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}
@media (max-width: 900px) {
  .mnt-kpi-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 560px) {
  .mnt-kpi-grid { grid-template-columns: 1fr; }
}

.mnt-kpi {
  background: #fff;
  border: 0.5px solid #e2e8f0;
  border-radius: 12px;
  padding: 16px 18px;
  display: flex; gap: 14px; align-items: flex-start;
  transition: box-shadow .15s;
}
.mnt-kpi:hover { box-shadow: 0 2px 12px rgba(0,0,0,.07); }
.mnt-kpi--loading { opacity: .6; }
.mnt-kpi--hoverable { cursor: default; }

.mnt-kpi__icon {
  width: 40px; height: 40px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.mnt-kpi__icon .material-icons { font-size: 20px; }
.mnt-kpi__icon--red    { background: #fff0f0; color: #dc2626; }
.mnt-kpi__icon--amber  { background: #fffbeb; color: #d97706; }
.mnt-kpi__icon--blue   { background: #eff6ff; color: #2563eb; }
.mnt-kpi__icon--green  { background: #f0fdf4; color: #16a34a; }

.mnt-kpi__body {
  display: flex; flex-direction: column; gap: 2px; min-width: 0;
}
.mnt-kpi__value {
  font-size: 1.5rem; font-weight: 700; line-height: 1;
}
.mnt-kpi__label {
  font-size: .78rem; font-weight: 600; color: #334155;
}
.mnt-kpi__sub {
  font-size: .72rem; color: #94a3b8;
}
.mnt-kpi__sub--red { color: #dc2626; font-weight: 500; }

/* ── Cards de sección ─────────────────────────────────────────────────────── */
.mnt-card {
  background: #fff;
  border: 0.5px solid #e2e8f0;
  border-radius: 12px;
  overflow: visible;   /* permite que los tooltips sobresalgan */
}

.mnt-card__header {
  display: flex; align-items: center;
  justify-content: space-between; gap: 12px;
  padding: 16px 20px;
  border-bottom: 1px solid #f1f5f9;
  flex-wrap: wrap;
}
.mnt-card__header-left {
  display: flex; align-items: center; gap: 12px;
}
.mnt-card__header-actions {
  display: flex; gap: 8px; flex-shrink: 0; flex-wrap: wrap;
}
.mnt-card__title {
  font-size: .92rem; font-weight: 700; color: #0f172a; margin: 0;
}
.mnt-card__sub {
  font-size: .75rem; color: #64748b; margin: 2px 0 0;
}

/* Íconos de sección */
.mnt-section-icon {
  width: 36px; height: 36px; border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.mnt-section-icon .material-icons { font-size: 18px; }
.mnt-section-icon--orange { background: #fff7ed; color: #ea580c; }
.mnt-section-icon--blue   { background: #eff6ff; color: #2563eb; }
.mnt-section-icon--purple { background: #faf5ff; color: #7c3aed; }

/* ── Botones de acción del header ─────────────────────────────────────────── */
.mnt-btn {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 7px 14px; border-radius: 8px;
  font-size: .8rem; font-weight: 600;
  cursor: pointer; transition: background .15s, color .15s, border-color .15s;
  border: 1px solid transparent;
  white-space: nowrap;
}
.mnt-btn:disabled { opacity: .45; cursor: not-allowed; }
.mnt-btn .material-icons { font-size: 16px; }

.mnt-btn--primary {
  background: #f97316; color: #fff; border-color: #f97316;
}
.mnt-btn--primary:hover:not(:disabled) { background: #ea580c; border-color: #ea580c; }

.mnt-btn--ghost {
  background: #f8fafc; color: #475569; border-color: #e2e8f0;
}
.mnt-btn--ghost:hover:not(:disabled) { background: #f1f5f9; color: #0f172a; }

.mnt-btn--outline {
  background: #fff; color: #475569; border-color: #e2e8f0;
}
.mnt-btn--outline:hover:not(:disabled) { background: #f8fafc; border-color: #cbd5e1; }
.mnt-btn--outline-active {
  background: #eff6ff; color: #2563eb; border-color: #93c5fd;
}

/* ── Barra de progreso bulk vacuum ────────────────────────────────────────── */
.mnt-bulk-progress {
  padding: 10px 20px;
  background: #f8fafc;
  border-bottom: 1px solid #f1f5f9;
  display: flex; flex-direction: column; gap: 6px;
}
.mnt-bulk-progress__bar-wrap {
  height: 6px; background: #e2e8f0; border-radius: 99px; overflow: hidden;
}
.mnt-bulk-progress__bar {
  height: 100%; background: #f97316; border-radius: 99px;
  transition: width .4s ease;
}
.mnt-bulk-progress__label {
  font-size: .75rem; color: #64748b; font-weight: 500;
}

/* ── Panel colapsable de alertas ─────────────────────────────────────────── */
.mnt-alerts-panel {
  margin: 0;
  border-bottom: 1px solid #e2e8f0;
}
.mnt-alerts-panel__toggle {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; padding: 11px 20px;
  background: #fff8ed;
  border: none; cursor: pointer;
  border-top: none; border-bottom: 1px solid #fed7aa;
  transition: background .15s;
