<file path="src/app/components/admin/admin-db-management/tabs/admin-db-monitoring/admin-db-monitoring.component.css">
/* ════════════════════════════════════════════════════════════════════════════
   MONITOREO — estilos específicos del componente
   ════════════════════════════════════════════════════════════════════════════ */

/* ── Chart.js canvas wrappers ───────────────────────────────────────────── */
.mon-chart-canvas-wrap {
  position: relative;
  width: 100%;
  height: 280px;
}
.mon-chart-canvas-wrap--idx {
  height: 280px;
}

/* Timestamp de última actualización */
.mon-last-updated {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  padding: .3em .7em;
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  border-radius: 999px;
  font-size: .78rem;
  color: #15803d;
  font-weight: 500;
  white-space: nowrap;
}
.mon-last-updated .material-icons { font-size: .9rem; }

/* Grupo botón + hora de actualización */
.mon-refresh-group {
  display: flex;
  align-items: center;
  gap: .75rem;
  flex-wrap: wrap;
  justify-content: flex-end;
}

/* ════════════════════════════════════════════════════════════════
   PANEL DE SALUD — score + info + kpis
═══════════════════════════════════════════════════════════════ */
.mon-health-panel {
  display: grid;
  grid-template-columns: 140px 1fr auto;
  gap: 1.5rem;
  align-items: center;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 20px;
  padding: 1.5rem 1.75rem;
  box-shadow: 0 2px 12px rgba(0,0,0,.06);
}

/* Ring del score */
.mon-health-score {
  position: relative;
  width: 120px; height: 120px;
  flex-shrink: 0;
}
.mon-score-svg {
  width: 120px; height: 120px;
  transform: rotate(-90deg);
}
.mon-score-track {
  fill: none;
  stroke: #f3f4f6;
  stroke-width: 9;
}
.mon-score-fill {
  fill: none;
  stroke-width: 9;
  stroke-linecap: round;
  stroke-dasharray: calc(2 * 3.14159 * 42);
  transition: stroke-dashoffset .8s cubic-bezier(.4,0,.2,1), stroke .4s;
}
.mon-health-score--green .mon-score-fill { stroke: #22c55e; }
.mon-health-score--amber  .mon-score-fill { stroke: #f59e0b; }
.mon-health-score--red    .mon-score-fill { stroke: #ef4444; }

.mon-score-inner {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.mon-score-num {
  font-size: 2rem;
  font-weight: 900;
  color: #111827;
  line-height: 1;
}
.mon-score-den {
  font-size: .72rem;
  color: #9ca3af;
  margin-top: .1rem;
}

.skel--ring {
  width: 120px; height: 120px;
  border-radius: 50%;
}

/* Info del estado */
.mon-health-info {
  display: flex;
  flex-direction: column;
  gap: .5rem;
}
.mon-health-label {
  margin: 0;
  font-size: 1.15rem;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: .45rem;
}
.mon-health-label .material-icons { font-size: 1.2rem; }
.mon-health-status {
  margin: 0;
  font-size: .83rem;
  color: #6b7280;
}
.mon-alert-pill {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  padding: .25em .75em;
  border-radius: 999px;
  font-size: .72rem;
  font-weight: 700;
  border: 1px solid;
}
.mon-alert-pill .material-icons { font-size: .9rem; }
.mon-alert-pill--critical { background: #fff1f2; color: #be123c; border-color: #fecdd3; }
.mon-alert-pill--warning  { background: #fffbeb; color: #92400e; border-color: #fde68a; }
.mon-alert-pill--index    { background: #eef2ff; color: #4338ca; border-color: #c7d2fe; }

/* KPIs */
.mon-kpi-row {
  display: flex;
  flex-direction: column;
  gap: .65rem;
}
.mon-kpi-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: .75rem;
  padding: .65rem .9rem;
  background: #f9fafb;
  border: 1px solid #f3f4f6;
  border-radius: 12px;
  cursor: default;
  transition: background .15s;
  min-width: 200px;
}
.mon-kpi-card:hover { background: #f3f4f6; }
.mon-kpi-icon {
  width: 34px; height: 34px;
  border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.mon-kpi-icon .material-icons { font-size: 1.1rem; color: #fff; }
.mon-kpi-icon--blue   { background: linear-gradient(135deg,#1d4ed8,#3b82f6); }
.mon-kpi-icon--green  { background: linear-gradient(135deg,#15803d,#22c55e); }
.mon-kpi-icon--slate  { background: linear-gradient(135deg,#334155,#64748b); }
.mon-kpi-icon--purple { background: linear-gradient(135deg,#6d28d9,#8b5cf6); }

.mon-kpi-label {
  margin: 0 0 .1rem;
  font-size: .68rem;
  font-weight: 600;
  color: #9ca3af;
  text-transform: uppercase;
  letter-spacing: .05em;
}
.mon-kpi-value {
  margin: 0;
  font-size: .92rem;
  font-weight: 800;
  color: #111827;
}

/* ════════════════════════════════════════════════════════════════
   SECCIÓN GENÉRICA
═══════════════════════════════════════════════════════════════ */
.mon-section-card {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  overflow: visible;   /* permite que los tooltips salgan del card */
  box-shadow: 0 1px 8px rgba(0,0,0,.05);
}
.mon-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.1rem 1.5rem;
  border-bottom: 1px solid #f3f4f6;
  background: #fafafa;
  flex-wrap: wrap;
  gap: .75rem;
}
.mon-section-header__left {
  display: flex;
  align-items: center;
  gap: .85rem;
}
.mon-section-icon {
  width: 38px; height: 38px;
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.mon-section-icon .material-icons { font-size: 1.15rem; color: #fff; }
.mon-section-icon--teal   { background: linear-gradient(135deg,#0f766e,#0d9488); }
.mon-section-icon--blue   { background: linear-gradient(135deg,#1d4ed8,#3b82f6); }
.mon-section-icon--slate  { background: linear-gradient(135deg,#334155,#64748b); }
.mon-section-icon--purple { background: linear-gradient(135deg,#6d28d9,#8b5cf6); }
.mon-section-icon--red    { background: linear-gradient(135deg,#9f1239,#e11d48); }
.mon-section-icon--amber  { background: linear-gradient(135deg,#b45309,#f59e0b); }

.mon-section-title {
  margin: 0 0 .15rem;
  font-size: .92rem;
  font-weight: 700;
  color: #111827;
}
.mon-section-sub {
  margin: 0;
  font-size: .75rem;
  color: #9ca3af;
}
.mon-alerts-summary { display: flex; gap: .5rem; flex-wrap: wrap; }

/* ════════════════════════════════════════════════════════════════
   RENDIMIENTO — tarjetas de métricas
═══════════════════════════════════════════════════════════════ */
.mon-perf-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: #f3f4f6;
  overflow: visible;
}
.mon-perf-card {
  position: relative;
  background: #fff;
  padding: 1.4rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: .55rem;
  cursor: default;
  transition: background .15s;
  overflow: visible;
}
.mon-perf-card:hover { background: #fafafa; }
.mon-perf-card--warn { background: #fffbeb; }
.mon-perf-card--bad  { background: #fff1f2; }

.mon-perf-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mon-perf-label {
  font-size: .72rem;
  font-weight: 700;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: .06em;
}
.mon-perf-value {
  margin: 0;
  font-size: 2.2rem;
  font-weight: 900;
  color: #111827;
  line-height: 1;
  display: flex;
  align-items: baseline;
  gap: .25rem;
}
.mon-perf-unit {
  font-size: .9rem;
  font-weight: 500;
  color: #9ca3af;
}
.mon-perf-goal {
  margin: 0;
  font-size: .73rem;
  color: #9ca3af;
  display: flex;
  align-items: center;
  gap: .4rem;
}
.mon-goal-ok   { color: #16a34a; font-weight: 700; }
.mon-goal-fail { color: #dc2626; font-weight: 700; }
.mon-perf-hint {
  margin: .5rem 0 0;
  font-size: .75rem;
  color: #b45309;
  display: flex;
  align-items: flex-start;
  gap: .35rem;
  line-height: 1.45;
  background: #fffbeb;
  border-radius: 8px;
  padding: .5rem .65rem;
}
.mon-perf-hint .material-icons { font-size: .9rem; flex-shrink: 0; margin-top: .05rem; }

/* ════════════════════════════════════════════════════════════════
   INDICADORES DE TENDENCIA
═══════════════════════════════════════════════════════════════ */
.mon-trend {
  font-size: .85rem;
  font-weight: 800;
  padding: .2em .5em;
  border-radius: 6px;
  background: #f3f4f6;
  color: #9ca3af;
  letter-spacing: 0;
  transition: background .2s, color .2s;
}
.mon-trend--up   { background: #dcfce7; color: #16a34a; }
.mon-trend--down { background: #fee2e2; color: #dc2626; }

.mon-trend--conn {
  font-size: .72rem;
  font-weight: 600;
}

/* ════════════════════════════════════════════════════════════════
   PROGRESS BAR
═══════════════════════════════════════════════════════════════ */
.mon-progress {
  width: 100%;
  height: 7px;
  background: #f3f4f6;
  border-radius: 999px;
  overflow: hidden;
  position: relative;
}
.mon-progress--lg { height: 14px; border-radius: 999px; }
.mon-progress--xs { height: 5px; }
.mon-progress__bar {
  height: 100%;
  border-radius: 999px;
  transition: width .6s cubic-bezier(.4,0,.2,1);
}
.mon-progress__bar--green { background: #22c55e; }
.mon-progress__bar--amber { background: #f59e0b; }
.mon-progress__bar--red   { background: #ef4444; }

/* Marcas de umbral en barra de conexiones */
.mon-progress__mark {
  position: absolute;
  top: 0; bottom: 0;
  width: 2px;
  background: rgba(0,0,0,.12);
}
.mon-progress__mark span {
  position: absolute;
  top: 18px;
  left: 50%;
  transform: translateX(-50%);
  font-size: .62rem;
  color: #9ca3af;
  white-space: nowrap;
}
.mon-progress__mark--70 { left: 70%; }
.mon-progress__mark--90 { left: 90%; }

/* ════════════════════════════════════════════════════════════════
   CONEXIONES
═══════════════════════════════════════════════════════════════ */
.mon-conn-body { padding: 1.4rem 1.5rem; }
.mon-conn-top {
  display: flex;
  align-items: baseline;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: .75rem;
}
.mon-conn-count {
  margin: 0;
  font-size: 1.6rem;
  font-weight: 900;
  line-height: 1;
}
.mon-conn-of {
  font-size: .82rem;
  font-weight: 500;
  color: #9ca3af;
}
.mon-conn-pct {
  padding: .2em .65em;
  border-radius: 8px;
  font-size: .8rem;
  font-weight: 800;
}
.mon-conn-pct--green { background: #dcfce7; color: #16a34a; }
.mon-conn-pct--amber { background: #fef3c7; color: #92400e; }
.mon-conn-pct--red   { background: #fee2e2; color: #dc2626; }

/* ════════════════════════════════════════════════════════════════
   TABLA DE ESTADOS
═══════════════════════════════════════════════════════════════ */
.mon-bloat-cell,
.mon-eff-cell {
  display: flex;
  flex-direction: column;
  gap: .35rem;
}
.mon-eff-num {
  font-size: .82rem;
  font-weight: 700;
  font-family: 'Courier New', monospace;
}

/* Badges de estado */
.mon-status-badge {
  display: inline-flex;
  align-items: center;
  gap: .25rem;
  padding: .28em .75em;
  border-radius: 20px;
  font-size: .72rem;
  font-weight: 700;
  white-space: nowrap;
  border: none;
  font-family: inherit;
  cursor: default;
}
.mon-status-badge--optimal  { background: #dcfce7; color: #16a34a; }
.mon-status-badge--warning  { background: #fef3c7; color: #92400e; }
.mon-status-badge--critical { background: #fee2e2; color: #dc2626; }

/* Badge clickeable — variante "link" */
.mon-status-badge--link {
  cursor: pointer;
  position: relative;
  transition: filter .15s, transform .15s, box-shadow .15s;
  text-decoration: none;
}
.mon-status-badge--link:hover {
  filter: brightness(.92);
  transform: translateY(-1px);
  box-shadow: 0 3px 10px rgba(0,0,0,.12);
}
.mon-status-badge--link:active {
  transform: translateY(0);
  box-shadow: none;
}
.mon-status-badge--link.mon-status-badge--warning:hover  { background: #fde68a; }
.mon-status-badge--link.mon-status-badge--critical:hover { background: #fca5a5; }

/* Ícono y flecha dentro del badge */
.mon-badge-icon  { font-size: .78rem !important; }
.mon-badge-arrow {
  font-size: .7rem !important;
  opacity: 0;
  margin-left: .1rem;
  transition: opacity .15s, transform .15s;
  transform: translateX(-4px);
}
.mon-status-badge--link:hover .mon-badge-arrow {
  opacity: 1;
  transform: translateX(0);
}

/* Hint debajo del badge */
.mon-table-hint {
  margin: .4rem 0 0;
  font-size: .71rem;
  color: #b45309;
  display: flex;
  align-items: center;
  gap: .3rem;
}
.mon-table-hint .material-icons { font-size: .85rem; }

/* ════════════════════════════════════════════════════════════════
   TABLAS REDISEÑADAS — columnas, colores y barras
═══════════════════════════════════════════════════════════════ */

/* Nombre de tabla/índice en monospace */
.mon-td-mono {
  font-family: 'Courier New', monospace;
  font-size: 13px;
  color: #1e293b;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* Ícono decorativo antes del nombre */
.mon-td-icon-muted {
  color: #94a3b8;
  font-size: 14px !important;
  vertical-align: middle;
  flex-shrink: 0;
}
/* Celda numérica derecha */
.mon-td-right {
  text-align: right;
  font-variant-numeric: tabular-nums;
  font-size: 13px;
  font-weight: 600;
}

/* Colores para dead tuples */
.mon-dead-red    { color: #dc2626; }
.mon-dead-yellow { color: #ca8a04; }
.mon-dead-gray   { color: #94a3b8; }

/* Colores para escaneos de índice */
.mon-scans-fast   { color: #16a34a; }
.mon-scans-red    { color: #dc2626; }
.mon-scans-yellow { color: #ca8a04; }
.mon-scans-gray   { color: #94a3b8; }

/* Barra de progreso 8px */
.mon-bar8 {
  height: 8px;
  border-radius: 4px;
  background: #e2e8f0;
  overflow: hidden;
  min-width: 80px;
  flex: 1;
}
.mon-bar8__fill {
  height: 100%;
  border-radius: 4px;
  transition: width .4s ease;
}
.mon-bar8__fill--green  { background: #22c55e; }
.mon-bar8__fill--yellow { background: #f59e0b; }
.mon-bar8__fill--red    { background: #ef4444; }
.mon-bar8-wrap {
  display: flex;
  align-items: center;
  gap: .5rem;
}
.mon-bar8-pct {
  font-size: 12px;
  font-weight: 600;
  min-width: 40px;
  text-align: right;
  font-variant-numeric: tabular-nums;
  color: #374151;
}

/* Fecha de VACUUM */
.mon-vacuum-never {
  color: #94a3b8;
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: .8rem;
}
.mon-vacuum-date {
  color: #374151;
  font-size: .76rem;
}

/* Altura de filas en tablas rediseñadas */
.mon-table--compact tbody tr {
  height: 52px;
}

/* ════════════════════════════════════════════════════════════════
   OUTLIER CARD — tablas con muchos dead tuples (naranja)
═══════════════════════════════════════════════════════════════ */
.mon-outlier-card {
  background: #fff7ed;
  border-left: 4px solid #f97316;
  border-radius: 0 8px 8px 0;
  padding: .85rem 1.25rem;
  margin: 0 1.5rem .75rem;
  display: flex;
  align-items: flex-start;
  gap: .75rem;
}
.mon-outlier-card__icon {
  color: #f97316;
  font-size: 1.2rem !important;
  flex-shrink: 0;
  margin-top: .05rem;
}
.mon-outlier-card__body { flex: 1; min-width: 0; }
.mon-outlier-card__title {
  font-size: .875rem;
  font-weight: 700;
  color: #c2410c;
  margin: 0 0 .25rem;
}
.mon-outlier-card__stats {
  font-size: .78rem;
  color: #78350f;
  margin: 0 0 .4rem;
}
.mon-outlier-link {
  font-size: .78rem;
  color: #f97316;
  cursor: pointer;
  text-decoration: none;
  background: none;
  border: none;
  padding: 0;
  font-family: inherit;
  font-weight: 600;
}
.mon-outlier-link:hover {
  text-decoration: underline;
  color: #ea580c;
}

/* ════════════════════════════════════════════════════════════════
   CHAMPION CARD — índice más activo del sistema (verde)
═══════════════════════════════════════════════════════════════ */
.mon-champion-card {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  padding: .7rem 1rem;
  margin: 0 1.5rem .75rem;
  display: flex;
  align-items: center;
  gap: .75rem;
}
.mon-champion-circle {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: #fef9c3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  flex-shrink: 0;
}
.mon-champion-card__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: .25rem .75rem;
}
.mon-champion-card__label {
  font-size: .72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: #64748b;
  width: 100%;
  margin: 0 0 .15rem;
}
.mon-champion-card__name {
  font-family: 'Courier New', monospace;
  font-size: .9rem;
  font-weight: 700;
  color: #1e293b;
  margin: 0;
}
.mon-champion-card__stats {
  font-size: .78rem;
  color: #64748b;
  margin: 0;
}
.mon-champion-card__eff {
  font-size: .78rem;
  font-weight: 600;
  color: #1D9E75;
  margin: 0;
}

/* ════════════════════════════════════════════════════════════════
   SELECTOR DE TABLAS / ÍNDICES
═══════════════════════════════════════════════════════════════ */

/* Botón de selección (aparece en header) */
.mon-sel-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: .35em .8em;
  font-size: .78rem;
  font-weight: 600;
  border: .5px solid #cbd5e1;
  background: #f8fafc;
  border-radius: 7px;
  cursor: pointer;
  color: #475569;
  transition: background .15s, color .15s, border-color .15s;
  font-family: inherit;
}
.mon-sel-btn:hover {
  background: #1e293b;
  color: #fff;
  border-color: #1e293b;
}

/* Badge numérico sobre el botón */
.mon-sel-badge {
  background: #3b82f6;
  color: #fff;
  border-radius: 999px;
  font-size: .7rem;
  padding: .1em .45em;
  min-width: 18px;
  text-align: center;
  line-height: 1.4;
}

/* Panel desplegable (debajo del header) */
.mon-sel-panel {
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  background: #fff;
  padding: 1rem 1.25rem;
  margin: 0 0 .75rem;
  box-shadow: 0 4px 16px rgba(0,0,0,.08);
}
.mon-sel-panel__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: .5rem;
  margin-bottom: .5rem;
}
.mon-sel-panel__title {
  font-size: .7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .07em;
  color: #94a3b8;
}
.mon-sel-actions {
  display: flex;
  gap: 4px;
}
.mon-sel-action {
  padding: .25em .7em;
  font-size: .75rem;
  border: .5px solid #cbd5e1;
  border-radius: 5px;
  background: #f8fafc;
  cursor: pointer;
  color: #475569;
  font-family: inherit;
  transition: background .12s;
}
.mon-sel-action:hover { background: #e2e8f0; }

/* Cuadrícula de chips */
.mon-chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: .75rem 0;
}
.mon-chip {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: .35em .75em;
  border: .5px solid #cbd5e1;
  border-radius: 8px;
  background: #fff;
  cursor: pointer;
  transition: background .12s, border-color .12s, color .12s;
  font-family: inherit;
}
.mon-chip:hover {
  background: #f1f5f9;
  border-color: #94a3b8;
}
.mon-chip--active {
  background: #eff6ff;
  border-color: #3b82f6;
  color: #1d4ed8;
}
.mon-chip__name {
  font-family: 'Courier New', monospace;
  font-size: .78rem;
  font-weight: 600;
}
.mon-chip__sub {
  font-size: .7rem;
  color: #94a3b8;
  display: flex;
  align-items: center;
  gap: 3px;
}
.mon-chip--active .mon-chip__sub { color: #60a5fa; }

/* Icono de eficiencia dentro del chip de índice */
.mon-chip__eff-icon {
  font-size: 11px !important;
  line-height: 1;
  vertical-align: middle;
}
.mon-chip__eff-icon--ok   { color: #16a34a; }
.mon-chip__eff-icon--warn { color: #d97706; }
.mon-chip__eff-icon--bad  { color: #dc2626; }
.mon-chip--active .mon-chip__eff-icon--ok   { color: #4ade80; }
.mon-chip--active .mon-chip__eff-icon--warn { color: #fbbf24; }
.mon-chip--active .mon-chip__eff-icon--bad  { color: #f87171; }

/* Pie del panel (Cancelar / Aplicar) */
.mon-sel-panel__footer {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  padding-top: .75rem;
  border-top: 1px solid #f1f5f9;
}
.mon-sel-cancel {
  padding: .35em .9em;
  font-size: .78rem;
  border: .5px solid #cbd5e1;
  background: #fff;
  border-radius: 6px;
  cursor: pointer;
  color: #64748b;
  font-family: inherit;
  transition: background .12s;
}
.mon-sel-cancel:hover { background: #f1f5f9; }
.mon-sel-apply {
  padding: .35em .9em;
  font-size: .78rem;
  border: none;
  background: #1e293b;
  color: #fff;
  border-radius: 6px;
  cursor: pointer;
  font-weight: 600;
  font-family: inherit;
  transition: background .12s;
}
.mon-sel-apply:hover { background: #0f172a; }


/* ════════════════════════════════════════════════════════════════
   CHART TABS — pill rediseñado
═══════════════════════════════════════════════════════════════ */
.mon-chart-tabs {
  display: flex;
  padding: .75rem 1.5rem .5rem;
}
.mon-chart-tabs-pill {
  display: inline-flex;
  background: #f1f5f9;
  border-radius: 8px;
  padding: 3px;
  gap: 2px;
  border: 1px solid #e2e8f0;
}
.mon-chart-tab {
  padding: .35em 1em;
  border-radius: 6px;
  font-size: .78rem;
  font-weight: 600;
  cursor: pointer;
  border: none;
  background: transparent;
  color: #64748b;
  transition: background .15s, color .15s, box-shadow .15s;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  white-space: nowrap;
}
.mon-chart-tab:hover { color: #334155; }
.mon-chart-tab--active {
  background: #ffffff;
  color: #0f172a;
  border: 0.5px solid #cbd5e1;
  box-shadow: 0 1px 3px rgba(0,0,0,.08);
}
.mon-chart-ok-msg {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  padding: 3rem 1.5rem;
  text-align: center;
}
.mon-chart-ok-msg__icon {
  color: #1D9E75;
  font-size: 2rem !important;
}
.mon-chart-ok-msg__title {
  color: #1D9E75;
  font-size: .95rem;
  font-weight: 700;
  margin: 0;
}
.mon-chart-ok-msg__sub {
  color: #6b7280;
  font-size: .8rem;
  margin: 0;
  max-width: 380px;
}

/* ════════════════════════════════════════════════════════════════
   LEYENDA CUSTOM para gráficas (reemplaza Chart.js legend)
═══════════════════════════════════════════════════════════════ */
.mon-chart-legend {
  display: flex;
  flex-wrap: wrap;
  gap: .5rem 1.25rem;
  padding: .5rem 1.5rem .75rem;
  align-items: center;
}
.mon-chart-legend__item {
