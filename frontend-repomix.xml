/* Register Content */
.register-content {
  min-height: calc(100vh - 200px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
  background: linear-gradient(135deg, #f5f0eb 0%, #ede8e1 100%);
}

.register-content .container {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.register-card {
  background: #FDFCFB;
  border-radius: 30px;
  box-shadow: 0 15px 50px rgba(45,42,38,0.12);
  border: 1px solid #E8E2DC;
  overflow: hidden;
  max-width: 600px;
  width: 100%;
  margin: 0 auto;
  animation: fadeInUp 0.6s ease;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.register-header {
  background: linear-gradient(135deg, #722f37 0%, #600015 100%);
  color: white;
  padding: 40px;
  text-align: center;
}

.register-icon {
  background: rgba(197, 160, 89, 0.2);
  width: 80px;
  height: 80px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
}

.register-icon .material-icons {
  font-size: 40px;
  color: #C5A059;
}

.register-title {
  font-family: Montserrat, sans-serif;
  font-size: 2rem;
  font-weight: 700;
  margin-bottom: 10px;
  letter-spacing: 1px;
}

.register-subtitle {
  font-family: Roboto, sans-serif;
  font-size: 1rem;
  opacity: 0.9;
  color: #F5F5F5;
  margin: 0;
}

.register-body {
  padding: 40px;
}

.form-group {
  margin-bottom: 25px;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: Roboto, sans-serif;
  font-weight: 500;
  color: #1A1A1A;
  margin-bottom: 10px;
  font-size: 0.95rem;
}

.form-label .material-icons {
  font-size: 20px;
  color: #722f37;
}

.input-wrapper {
  position: relative;
}

.form-input {
  width: 100%;
  padding: 14px 18px;
  padding-right: 50px; /* Espacio para iconos de validación */
  border: 2px solid #E8E2DC;
  border-radius: 12px;
  font-size: 1rem;
  font-family: Roboto, sans-serif;
  transition: all 0.3s ease;
  color: #2D2A26;
  background: #FDFCFB;
  box-sizing: border-box;
}

.form-input:focus {
  outline: none;
  border-color: #722f37;
  box-shadow: 0 0 0 4px rgba(128, 0, 32, 0.1);
  transform: translateY(-1px);
}

.form-input.error {
  border-color: #C0392B;
  background: rgba(192, 57, 43, 0.05);
  animation: shake 0.4s ease-in-out;
}

.form-input.success {
  border-color: #27AE60;
  background: rgba(39, 174, 96, 0.05);
}

/* Animación de shake para errores */
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10px); }
  75% { transform: translateX(10px); }
}

/* Icono de validación en el input */
.input-wrapper::after {
  content: '';
  position: absolute;
  right: 18px;
  top: 50%;
  transform: translateY(-50%);
  width: 20px;
  height: 20px;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

/* Icono de check verde cuando es válido */
.input-wrapper.valid::after {
  content: '✓';
  color: #27AE60;
  font-size: 20px;
  font-weight: bold;
  opacity: 1;
}

/* Icono de X roja cuando tiene error */
.input-wrapper.invalid::after {
  content: '✕';
  color: #C0392B;
  font-size: 20px;
  font-weight: bold;
  opacity: 1;
}

.password-toggle {
  position: absolute;
  right: 15px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: #666;
  cursor: pointer;
  padding: 5px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: color 0.3s ease;
}

.password-toggle:hover {
  color: #722f37;
}

.password-strength {
  margin-top: 10px;
}

/* ✅ NUEVO: Checklist de Requisitos de Contraseña */
.password-requirements {
  margin-top: 12px;
  padding: 16px;
  background: rgba(128, 0, 32, 0.03);
  border-left: 3px solid #722f37;
  border-radius: 8px;
  animation: slideDown 0.3s ease-out;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.requirements-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.9rem;
  font-weight: 600;
  color: #722f37;
  margin-bottom: 12px;
  font-family: 'Roboto', sans-serif;
}

.requirements-title .material-icons {
  font-size: 20px;
}

.requirements-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.requirements-list li {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
  font-family: 'Roboto', sans-serif;
  transition: all 0.3s ease;
  padding: 4px 0;
}

.requirements-list li.valid {
  color: #27AE60;
  font-weight: 500;
}

.requirements-list li.invalid {
  color: #999;
}

.requirements-list li .material-icons {
  font-size: 18px;
  transition: all 0.3s ease;
}

.requirements-list li.valid .material-icons {
  color: #27AE60;
  animation: checkPop 0.3s ease-out;
}

.requirements-list li.invalid .material-icons {
  color: #CCCCCC;
}

@keyframes checkPop {
  0% {
    transform: scale(0.8);
  }
  50% {
    transform: scale(1.2);
  }
  100% {
    transform: scale(1);
  }
}

