  box-shadow: 0 4px 6px rgba(128, 0, 32, 0.2);
}

.btn-verify:hover:not(:disabled),
.btn-send-code:hover:not(:disabled) {
  background: linear-gradient(135deg, #660018 0%, #4a0011 100%);
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(128, 0, 32, 0.3);
}

.btn-verify:disabled,
.btn-send-code:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.btn-verify .material-icons,
.btn-send-code .material-icons {
  font-size: 24px;
}

.send-code-section {
