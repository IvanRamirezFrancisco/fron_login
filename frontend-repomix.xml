  }

  .link-btn {
    font-size: 0.875rem;
    padding: 0.625rem;
  }

  .backup-link {
    font-size: 0.875rem;
    padding: 0.625rem;
  }
}

/* Pantallas muy pequeñas (≤375px) - Para 360x640, 320x568, etc */
@media (max-width: 375px) {
  .modal-2fa {
    width: 94%;
    max-height: 90vh;
    border-radius: 10px;
  }

  .modal-header {
    padding: 1rem 0.875rem;
  }

  .modal-header .header-icon {
    width: 50px;
    height: 50px;
    margin-bottom: 0.625rem;
  }

  .modal-header .header-icon .material-icons {
    font-size: 26px;
  }

