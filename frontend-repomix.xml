  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: linear-gradient(135deg, var(--primary-700), var(--primary-800));
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
  box-shadow: 0 2px 20px rgba(62, 39, 35, 0.1);
}

.navigation-header.scrolled {
  background: rgba(62, 39, 35, 0.95);
  backdrop-filter: blur(15px);
  box-shadow: 0 4px 30px rgba(62, 39, 35, 0.2);
}

/* ===== NAVBAR PRINCIPAL ===== */
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 2rem;
  height: 80px;
  max-width: 1400px;
  margin: 0 auto;
}

/* ===== LOGO Y MARCA ===== */
.navbar-brand {
  cursor: pointer;
  transition: transform 0.3s ease;
}

.navbar-brand:hover {
  transform: scale(1.05);
}

.logo-container {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.logo-icon {
  font-size: 2.5rem;
  color: var(--warning-400);
  text-shadow: 0 2px 10px rgba(255, 193, 7, 0.3);
  animation: pulse 3s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-size: 1.8rem;
  font-weight: 700;
  color: white;
  margin: 0;
  line-height: 1.2;
  font-family: 'Montserrat', sans-serif;
}

.brand-subtitle {
  font-size: 0.9rem;
  color: var(--warning-300);
  font-weight: 500;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

/* ===== NAVEGACIÓN PRINCIPAL - DESKTOP ===== */
.desktop-nav {
  display: flex;
  align-items: center;
  gap: 2rem;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: white;
  text-decoration: none;
  padding: 0.75rem 1.5rem;
  border-radius: 50px;
  transition: all 0.3s ease;
  font-weight: 500;
  position: relative;
  cursor: pointer;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(5px);
}

.nav-link:hover {
  background: rgba(255, 255, 255, 0.2);
  transform: translateY(-2px);
  box-shadow: 0 5px 20px rgba(255, 255, 255, 0.1);
  color: var(--warning-300);
}

.nav-icon {
  font-size: 1.1rem;
}

/* ===== ACCIONES DEL USUARIO - DESKTOP ===== */
.desktop-actions {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

/* ===== BOTÓN DEL CARRITO ===== */
.cart-button {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1.5rem;
  background: rgba(255, 193, 7, 0.2);
  border-radius: 50px;
  cursor: pointer;
  transition: all 0.3s ease;
  color: white;
  position: relative;
}

.cart-button:hover {
  background: rgba(255, 193, 7, 0.3);
  transform: translateY(-2px);
  box-shadow: 0 5px 20px rgba(255, 193, 7, 0.2);
}

.action-icon-container {
  position: relative;
}

.action-icon {
  font-size: 1.3rem;
}

.cart-badge {
  position: absolute;
  top: -8px;
  right: -8px;
  background: var(--danger-500);
  color: white;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.2rem 0.5rem;
  border-radius: 50px;
  min-width: 20px;
  text-align: center;
  box-shadow: 0 2px 10px rgba(220, 53, 69, 0.3);
}

.action-label {
  font-weight: 500;
  font-size: 0.95rem;
}

/* ===== MENÚ DE PERFIL ===== */
.profile-menu {
  position: relative;
}

.profile-trigger {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.75rem 1.5rem;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50px;
  cursor: pointer;
  transition: all 0.3s ease;
  color: white;
}

.profile-trigger:hover {
  background: rgba(255, 255, 255, 0.2);
  transform: translateY(-1px);
}

.profile-avatar {
  width: 45px;
  height: 45px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--warning-400), var(--warning-500));
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: white;
  font-size: 1.1rem;
  box-shadow: 0 3px 15px rgba(255, 193, 7, 0.3);
}

.profile-info {
  display: flex;
  flex-direction: column;
  text-align: left;
}

.profile-greeting {
  font-size: 0.8rem;
  color: var(--warning-300);
  font-weight: 400;
}

.profile-name {
  font-size: 0.95rem;
  font-weight: 600;
  color: white;
}

.profile-arrow {
  font-size: 0.8rem;
  transition: transform 0.3s ease;
  color: var(--warning-300);
}

.profile-arrow.rotated {
  transform: rotate(180deg);
}

/* ===== DROPDOWN DEL PERFIL ===== */
.profile-dropdown {
  position: absolute;
  top: calc(100% + 15px);
  right: 0;
  background: white;
  border-radius: 15px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
  min-width: 320px;
  overflow: hidden;
  z-index: 1001;
  animation: fadeInDown 0.3s ease;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.profile-header {
  background: linear-gradient(135deg, var(--primary-600), var(--primary-700));
  padding: 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  color: white;
}

.profile-avatar-large {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--warning-400), var(--warning-500));
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 1.4rem;
  box-shadow: 0 3px 15px rgba(255, 193, 7, 0.3);
}

.profile-details h4 {
  margin: 0 0 0.25rem 0;
  font-size: 1.1rem;
  font-weight: 600;
}

.profile-details p {
  margin: 0;
  font-size: 0.9rem;
  opacity: 0.9;
}

.profile-menu-items {
  padding: 1rem 0;
}

.profile-menu-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.75rem 1.5rem;
  text-decoration: none;
  color: var(--gray-700);
  transition: all 0.3s ease;
  cursor: pointer;
  font-weight: 500;
}

.profile-menu-item:hover {
  background: var(--primary-50);
  color: var(--primary-700);
  padding-left: 2rem;
}

.profile-menu-item i {
  width: 20px;
  text-align: center;
  font-size: 1rem;
}

.profile-menu-divider {
  height: 1px;
  background: var(--gray-200);
  margin: 0.5rem 1.5rem;
}

.logout-item {
  color: var(--danger-600);
}

.logout-item:hover {
  background: var(--danger-50);
  color: var(--danger-700);
}

/* ===== BOTÓN MENÚ MÓVIL ===== */
.mobile-menu-button {
  display: none;
  cursor: pointer;
  padding: 0.5rem;
}

.hamburger {
  width: 30px;
  height: 20px;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.hamburger span {
  width: 100%;
  height: 3px;
  background: white;
  border-radius: 3px;
  transition: all 0.3s ease;
}

.hamburger.active span:nth-child(1) {
  transform: rotate(45deg);
  position: absolute;
  top: 50%;
  margin-top: -1.5px;
}

.hamburger.active span:nth-child(2) {
  opacity: 0;
}

.hamburger.active span:nth-child(3) {
  transform: rotate(-45deg);
  position: absolute;
  top: 50%;
  margin-top: -1.5px;
}

/* ===== MENÚ MÓVIL ===== */
.mobile-menu {
  position: fixed;
  top: 0;
  left: -100%;
  width: 85%;
  max-width: 320px;
  height: 100vh;
  background: white;
  z-index: 1001;
  transition: left 0.3s ease-out;
  box-shadow: 4px 0 20px rgba(0, 0, 0, 0.3);
  overflow-y: auto;
}

.mobile-menu.active {
  left: 0;
}

.mobile-menu-header {
  background: linear-gradient(135deg, var(--primary-600), var(--primary-700));
  padding: 1.5rem;
  color: white;
}

.mobile-profile {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.mobile-avatar {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--warning-400), var(--warning-500));
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 1.2rem;
}

.mobile-profile-info h4 {
  margin: 0 0 0.25rem 0;
  font-size: 1.1rem;
  font-weight: 600;
}

.mobile-profile-info p {
  margin: 0;
  font-size: 0.9rem;
  opacity: 0.9;
}

.mobile-menu-items {
  padding: 0;
}

.mobile-menu-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem 1.5rem;
  text-decoration: none;
  color: var(--gray-700);
  border-bottom: 1px solid var(--gray-100);
  transition: all 0.3s ease;
  cursor: pointer;
}

.mobile-menu-item:hover {
  background: var(--primary-50);
  color: var(--primary-700);
  padding-left: 2rem;
}

.mobile-menu-item i:first-child {
  width: 24px;
  text-align: center;
  font-size: 1.1rem;
}

.mobile-menu-item span {
  flex: 1;
  font-weight: 500;
}

.mobile-menu-item i:last-child {
  font-size: 0.9rem;
  color: var(--gray-400);
}

.mobile-cart-badge {
  background: var(--danger-500);
  color: white;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.2rem 0.5rem;
  border-radius: 50px;
  min-width: 20px;
  text-align: center;
}

.mobile-menu-divider {
  height: 1px;
  background: var(--gray-200);
  margin: 0.5rem 1.5rem;
}

.mobile-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(4px);
  z-index: 1000;
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* ===== RESPONSIVE DESIGN ===== */

/* Tablet */
@media (max-width: 1024px) {
  .navbar {
    padding: 0 1.5rem;
  }
  
  .desktop-nav {
    gap: 1.5rem;
  }
  
  .nav-link {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
  }
}

/* Mobile */
@media (max-width: 768px) {
  .navbar {
    padding: 0 1rem;
    height: 70px;
  }
  
  .desktop-nav,
  .desktop-actions {
    display: none;
  }
  
  .mobile-menu-button {
    display: block;
  }
  
  .logo-icon {
    font-size: 2rem;
  }
  
  .brand-title {
    font-size: 1.5rem;
  }
  
  .brand-subtitle {
    font-size: 0.8rem;
  }
  
  .mobile-menu {
    max-height: calc(100vh - 70px);
  }
}

/* Mobile Small */
@media (max-width: 480px) {
  .navbar {
    padding: 0 0.75rem;
  }
  
  .logo-container {
    gap: 0.75rem;
  }
  
  .brand-title {
    font-size: 1.3rem;
  }
  
  .profile-dropdown {
    min-width: 280px;
    right: -1rem;
  }
}
