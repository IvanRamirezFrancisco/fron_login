}
.mnt-alerts-panel__toggle:hover { background: #fff3dc; }
.mnt-alerts-panel__toggle--open { background: #fff3dc; }
.mnt-alerts-panel__toggle-left {
  display: flex; align-items: center; gap: 10px;
}
.mnt-alerts-panel__badge {
  display: inline-flex; align-items: center; gap: 4px;
  background: #f59e0b; color: #fff;
  border-radius: 20px; padding: 2px 8px 2px 5px;
  font-size: .72rem; font-weight: 700;
  line-height: 1;
}
.mnt-alerts-panel__badge .material-icons { font-size: 14px; }
.mnt-alerts-panel__toggle-title {
  font-size: .82rem; font-weight: 700; color: #92400e;
}
.mnt-alerts-panel__toggle-sub {
  font-size: .74rem; color: #b45309;
}
.mnt-alerts-panel__chevron {
  font-size: 20px; color: #b45309; transition: transform .2s;
  flex-shrink: 0;
}
.mnt-alerts-panel__toggle--open .mnt-alerts-panel__chevron {
  transform: rotate(0deg);
}

/* ── Banners de alerta ────────────────────────────────────────────────────── */
.mnt-banner {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 10px 20px; font-size: .8rem;
}
.mnt-banner--critical {
  background: #fff8ed;
  border-left: 3px solid #f0a020;
  border-bottom: 1px solid #fed7aa;
  border-top: none;
  border-right: none;
  color: #92400e;
}
.mnt-banner .material-icons { font-size: 17px; margin-top: 1px; flex-shrink: 0; }
.mnt-banner strong { font-weight: 700; }
.mnt-banner span { display: block; margin-top: 1px; color: #b45309; font-size: .75rem; }

/* ── Tablas ───────────────────────────────────────────────────────────────── */
.mnt-table-wrap { overflow-x: auto; }

.mnt-table {
  width: 100%; border-collapse: collapse;
  font-size: .8rem;
}
.mnt-table thead th {
  padding: 8px 20px;
  background: #f8fafc;
  border-bottom: 0.5px solid #e2e8f0;
  font-size: .68rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .05em;
  color: #94a3b8;
  white-space: nowrap;
}
.mnt-th-r { text-align: right; }
.mnt-th-c { text-align: center; }

.mnt-table tbody tr { height: 52px; }
.mnt-table tbody td { padding: 0 20px; border-bottom: 1px solid #f1f5f9; }

.mnt-tr--busy { opacity: .7; }
.mnt-tr--skeleton { pointer-events: none; }
.mnt-table tbody tr:hover:not(.mnt-tr--busy):not(.mnt-tr--skeleton) { background: #f8fafc; }

.mnt-td-name code {
  font-family: 'Fira Code', 'Cascadia Code', monospace;
  font-size: .78rem; color: #1e40af; background: #eff6ff;
  padding: 2px 7px; border-radius: 4px;
}
.mnt-td-r     { text-align: right; font-variant-numeric: tabular-nums; }
.mnt-td-date  { font-size: .75rem; color: #64748b; white-space: nowrap; }
.mnt-td-table-ref { font-size: .75rem; color: #94a3b8; }
.mnt-td-actions {
  display: flex; gap: 6px; align-items: center;
  white-space: nowrap; padding-top: 0; padding-bottom: 0;
}

/* Columna OBSOLETOS — número + mini barra */
.mnt-td-obsoletos {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-top: 6px !important;
  padding-bottom: 6px !important;
}
.mnt-obsoletos__num {
  font-size: .88rem; font-weight: 700; line-height: 1;
  font-variant-numeric: tabular-nums;
}
.mnt-mini-bar-wrap {
  width: 60px; height: 4px;
  background: #e2e8f0; border-radius: 99px;
  margin-top: 5px; overflow: hidden;
}
.mnt-mini-bar {
  height: 4px; border-radius: 99px;
  transition: width .3s ease;
}
.mnt-mini-bar--red   { background: #ef4444; }
.mnt-mini-bar--amber { background: #f59e0b; }
.mnt-mini-bar--green { background: #22c55e; }

.mnt-td-empty {
  text-align: center; padding: 32px !important;
  color: #94a3b8; font-size: .82rem;
  display: flex; align-items: center; justify-content: center; gap: 8px;
}
.mnt-td-empty .material-icons { font-size: 22px; }

/* Columna bloat */
.mnt-td-bloat { min-width: 140px; }
.mnt-bloat    { display: flex; align-items: center; gap: 8px; }
.mnt-bloat__bar-wrap {
  flex: 1; height: 6px; background: #f1f5f9;
  border-radius: 99px; overflow: hidden;
}
.mnt-bloat__bar { height: 100%; border-radius: 99px; transition: width .4s; }
.mnt-bloat__bar--green { background: #22c55e; }
.mnt-bloat__bar--amber { background: #f59e0b; }
.mnt-bloat__bar--red   { background: #ef4444; }
.mnt-bloat__pct { font-size: .75rem; font-weight: 600; min-width: 36px; text-align: right; }

/* Columna eficiencia */
.mnt-td-eff { min-width: 130px; }
.mnt-eff    { display: flex; align-items: center; gap: 8px; }
.mnt-eff__bar-wrap {
  flex: 1; height: 6px; background: #f1f5f9;
  border-radius: 99px; overflow: hidden;
}
.mnt-eff__bar { height: 100%; border-radius: 99px; transition: width .4s; }
.mnt-eff__bar--green { background: #22c55e; }
.mnt-eff__bar--amber { background: #f59e0b; }
.mnt-eff__bar--red   { background: #ef4444; }
.mnt-eff__pct { font-size: .75rem; font-weight: 600; min-width: 40px; text-align: right; }

/* ── Botones de fila ──────────────────────────────────────────────────────── */
.mnt-row-btn {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 5px 10px; border-radius: 6px;
  font-size: .75rem; font-weight: 600;
  cursor: pointer; border: 1px solid transparent;
  transition: background .12s, color .12s;
  white-space: nowrap;
}
.mnt-row-btn .material-icons { font-size: 14px; }
.mnt-row-btn:disabled { opacity: .4; cursor: not-allowed; }

.mnt-row-btn--vacuum {
  background: #fff7ed; color: #ea580c; border-color: #fed7aa;
}
.mnt-row-btn--vacuum:hover:not(:disabled) { background: #ffedd5; border-color: #f97316; }

.mnt-row-btn--analyze {
  background: #eff6ff; color: #2563eb; border-color: #bfdbfe;
  min-width: 110px; justify-content: center;
}
.mnt-row-btn--analyze:hover:not(:disabled) { background: #dbeafe; border-color: #60a5fa; }

/* Botón unificado VACUUM ANALYZE — 3 variantes de urgencia */
.mnt-row-btn--va {
  padding: 6px 14px;
  font-size: .78rem; font-weight: 700;
  letter-spacing: .01em;
  border-radius: 7px;
  min-width: 120px; justify-content: center;
}
.mnt-row-btn--va-critical {
  background: #fef2f2; color: #dc2626; border-color: #fca5a5;
}
.mnt-row-btn--va-critical:hover:not(:disabled) { background: #fee2e2; border-color: #ef4444; }
.mnt-row-btn--va-critical:disabled { background: #fee2e2; color: #ef4444; }

.mnt-row-btn--va-warning {
  background: #fff7ed; color: #c2410c; border-color: #fdba74;
}
.mnt-row-btn--va-warning:hover:not(:disabled) { background: #ffedd5; border-color: #f97316; }

.mnt-row-btn--va-low {
  background: #f8fafc; color: #64748b; border-color: #e2e8f0;
}
.mnt-row-btn--va-low:hover:not(:disabled) { background: #f1f5f9; border-color: #cbd5e1; }

/* Estado "ok" del botón VA — verde */
.mnt-row-btn--va:disabled.mnt-row-btn--va-low { opacity: 1; }

/* Celda acción centrada */
.mnt-td-actions--center { text-align: center; }

.mnt-row-btn--reindex {
  background: #eff6ff; color: #2563eb; border-color: #bfdbfe;
  min-width: 110px; justify-content: center;
}
.mnt-row-btn--reindex:hover:not(:disabled) { background: #dbeafe; border-color: #60a5fa; }

/* Estado "Listo" — verde suave */
.mnt-row-btn--reindex.mnt-row-btn--reindex-ok {
  background: #dcfce7; color: #16a34a; border-color: #86efac;
}
/* Estado "Error" — rojo suave */
.mnt-row-btn--reindex.mnt-row-btn--reindex-err {
  background: #fee2e2; color: #dc2626; border-color: #fca5a5;
}

/* ── Badges ───────────────────────────────────────────────────────────────── */
.mnt-badge {
  display: inline-block;
  padding: 2px 8px; border-radius: 99px;
  font-size: .7rem; font-weight: 700; letter-spacing: .03em;
  white-space: nowrap;
}
.mnt-badge--red   { background: #fee2e2; color: #dc2626; }
.mnt-badge--amber { background: #fffbeb; color: #d97706; }
.mnt-badge--green { background: #dcfce7; color: #16a34a; }
.mnt-badge--gray  { background: #f1f5f9; color: #64748b; }

/* ── Status badge de la columna Estado (Mantenimiento) ────────────────────── */
.mnt-td-status { white-space: nowrap; }
.mnt-status-badge {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 3px 9px; border-radius: 99px;
  font-size: .72rem; font-weight: 700; letter-spacing: .03em;
  white-space: nowrap;
}
.mnt-status-badge .material-icons { font-size: 13px; }

.mnt-status-badge--critical {
  background: #fee2e2; color: #b91c1c; border: 1px solid #fca5a5;
}
.mnt-status-badge--warning {
  background: #fff7ed; color: #c2410c; border: 1px solid #fed7aa;
}
.mnt-status-badge--ok {
  background: #f0fdf4; color: #15803d; border: 1px solid #86efac;
}

/* ── Valores com color ────────────────────────────────────────────────────── */
.mnt-val--red    { color: #dc2626; font-weight: 600; }
.mnt-val--orange { color: #ea580c; font-weight: 600; }
.mnt-val--yellow { color: #ca8a04; font-weight: 600; }
.mnt-val--amber  { color: #d97706; font-weight: 600; }
.mnt-val--green  { color: #16a34a; font-weight: 600; }
.mnt-val--muted  { color: #cbd5e1; }
.mnt-kpi__value--red   { color: #dc2626; }
.mnt-kpi__value--amber { color: #d97706; }
.mnt-kpi__value--green { color: #16a34a; }

/* ── Estado vacío (Sección 3 sin índices problemáticos) ───────────────────── */
.mnt-empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding: 40px 24px; text-align: center;
}
.mnt-empty-state__icon {
  font-size: 48px; color: #22c55e; margin-bottom: 12px;
}
.mnt-empty-state__title {
  font-size: .9rem; font-weight: 700; color: #0f172a; margin: 0 0 4px;
}
.mnt-empty-state__sub {
  font-size: .78rem; color: #94a3b8; margin: 0;
}

/* ── Skeletons ────────────────────────────────────────────────────────────── */
.mnt-skel {
  background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
  background-size: 200% 100%;
  animation: mnt-shimmer 1.4s infinite;
  border-radius: 4px; height: 14px;
}
.mnt-skel--sm  { width: 60px; }
.mnt-skel--md  { width: 100px; }
.mnt-skel--lg  { width: 150px; }
.mnt-skel--r   { margin-left: auto; }
.mnt-skel--c   { margin: 0 auto; }
@keyframes mnt-shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ── Spinner ──────────────────────────────────────────────────────────────── */
.mnt-spin {
  animation: mnt-rotate .7s linear infinite;
  display: inline-block;
}
@keyframes mnt-rotate {
  to { transform: rotate(360deg); }
}

/* ── Dialog de confirmación ───────────────────────────────────────────────── */
.mnt-backdrop {
  position: fixed; inset: 0;
  background: rgba(15,23,42,.45);
  display: flex; align-items: center; justify-content: center;
  z-index: 9999;
}
.mnt-dialog {
  background: #fff; border-radius: 14px;
  padding: 28px 32px; max-width: 480px; width: 90%;
  box-shadow: 0 24px 64px rgba(0,0,0,.22);
  display: flex; flex-direction: column; align-items: center; gap: 12px;
  text-align: center;
}
.mnt-dialog__icon {
  width: 52px; height: 52px; border-radius: 12px;
  background: #fff7ed; color: #ea580c;
  display: flex; align-items: center; justify-content: center;
}
.mnt-dialog__icon--orange { background: #fff7ed; color: #ea580c; }
.mnt-dialog__icon .material-icons { font-size: 26px; }
.mnt-dialog__title { font-size: .95rem; font-weight: 700; color: #0f172a; margin: 0; }
.mnt-dialog__body  { font-size: .82rem; color: #475569; margin: 0; line-height: 1.6; text-align: left; width: 100%; }
.mnt-dialog__body strong { color: #0f172a; }
.mnt-dialog__table {
  font-family: 'Fira Code', 'Cascadia Code', monospace;
  font-size: .8rem; color: #1e40af;
  background: #eff6ff; padding: 2px 7px; border-radius: 4px;
  display: inline-block; margin: 4px 0;
}
.mnt-dialog__note {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: .75rem; color: #0369a1;
  background: #f0f9ff; border-radius: 6px;
  padding: 5px 10px; margin-top: 2px;
}
.mnt-dialog__note .material-icons { font-size: 14px; }
.mnt-dialog__actions {
  display: flex; gap: 10px; margin-top: 4px; justify-content: center;
}

/* ── Sección 4 — Autovacuum ───────────────────────────────────────────────── */
.mnt-av-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 0; padding: 16px 20px;
}
@media (max-width: 640px) {
  .mnt-av-grid { grid-template-columns: 1fr; }
}

.mnt-av-col { display: flex; flex-direction: column; gap: 0; }

.mnt-av-row {
  display: flex; align-items: center;
  justify-content: space-between; gap: 12px;
  padding: 11px 12px;
  border-bottom: 1px solid #f1f5f9;
  transition: background .12s;
}
.mnt-av-row:hover { background: #fafafa; }

.mnt-av-row__left {
  display: flex; flex-direction: column; gap: 2px;
  min-width: 0;
}
.mnt-av-row__name {
  font-family: 'Fira Code', 'Cascadia Code', monospace;
  font-size: .75rem; color: #1e40af; background: #eff6ff;
  padding: 2px 6px; border-radius: 4px; width: fit-content;
}
.mnt-av-row__desc {
  font-size: .72rem; color: #94a3b8;
}
.mnt-av-row__val {
  font-size: .82rem; font-weight: 700; color: #334155;
  white-space: nowrap; flex-shrink: 0;
}

.mnt-av-note {
  display: flex; align-items: flex-start; gap: 6px;
  padding: 12px 20px;
  font-size: .73rem; color: #94a3b8;
  font-style: italic;
  border-top: 1px solid #f1f5f9;
  margin: 0;
}
.mnt-av-note .material-icons { font-size: 15px; margin-top: 1px; flex-shrink: 0; }
.mnt-av-note code { font-style: normal; color: #64748b; }

/* ── Toast ────────────────────────────────────────────────────────────────── */
.mnt-toast {
  position: fixed; bottom: 24px; right: 24px; z-index: 10000;
  display: flex; align-items: flex-start; gap: 12px;
  min-width: 320px; max-width: 460px;
  background: #fff; border-radius: 10px;
  box-shadow: 0 8px 32px rgba(0,0,0,.18);
  padding: 14px 16px 20px;
  animation: mnt-toast-in .3s ease;
  overflow: hidden;
}
.mnt-toast--closing {
  animation: mnt-toast-out .4s ease forwards;
}
.mnt-toast--success { border-left: 4px solid #22c55e; }
.mnt-toast--error   { border-left: 4px solid #ef4444; }

.mnt-toast__icon { font-size: 22px; margin-top: 1px; flex-shrink: 0; }
.mnt-toast--success .mnt-toast__icon { color: #22c55e; }
.mnt-toast--error   .mnt-toast__icon { color: #ef4444; }

.mnt-toast__body { flex: 1; min-width: 0; }
.mnt-toast__title { font-size: .85rem; font-weight: 700; color: #0f172a; margin: 0 0 3px; }
.mnt-toast__sub   { display: flex; align-items: center; gap: 6px; margin: 0 0 4px; }
.mnt-toast__badge {
  font-size: .68rem; font-weight: 700;
  background: #f1f5f9; color: #475569;
  padding: 1px 7px; border-radius: 99px;
}
.mnt-toast__table { font-size: .72rem; color: #64748b; font-family: monospace; }
.mnt-toast__msg   { font-size: .78rem; color: #475569; margin: 0; line-height: 1.4; }
.mnt-toast__close {
  background: none; border: none; cursor: pointer;
  color: #94a3b8; padding: 0; flex-shrink: 0; line-height: 1;
}
.mnt-toast__close .material-icons { font-size: 18px; }
.mnt-toast__close:hover { color: #475569; }

.mnt-toast__progress {
  position: absolute; bottom: 0; left: 0;
  height: 3px; width: 100%; background: #22c55e;
  border-radius: 0 0 10px 10px;
  animation: mnt-toast-bar 5s linear forwards;
}
.mnt-toast__progress--error {
  background: #ef4444;
  animation-duration: 8s;
}

@keyframes mnt-toast-in {
  from { transform: translateY(20px); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}
@keyframes mnt-toast-out {
  from { transform: translateX(0);    opacity: 1; }
  to   { transform: translateX(120%); opacity: 0; }
}
/* ── Estado "todo limpio" (tablas/índices) ────────────────────────────────── */
.mnt-clean-state {
  display: flex; flex-direction: column; align-items: center;
  padding: 44px 24px; text-align: center; gap: 8px;
}
.mnt-clean-state__icon {
  font-size: 52px; color: #22c55e; margin-bottom: 4px;
}
.mnt-clean-state__title {
  font-size: .92rem; font-weight: 700; color: #0f172a; margin: 0;
}
.mnt-clean-state__sub {
  font-size: .78rem; color: #94a3b8; margin: 0; max-width: 420px; line-height: 1.5;
}
.mnt-clean-state__toggle {
  margin-top: 8px; font-size: .78rem;
}

/* ── Ícono de ayuda (?) en títulos de sección ─────────────────────────────── */
.mnt-card__title {
  display: flex; align-items: center; gap: 6px;
}
.mnt-help-tip {
  display: inline-flex; align-items: center; justify-content: center;
  color: #94a3b8; cursor: help; transition: color .15s;
  background: none; border: none; padding: 0; line-height: 1;
}
.mnt-help-tip .material-icons { font-size: 15px; }
.mnt-help-tip:hover,
.mnt-help-tip:focus { color: #3b82f6; outline: none; }

/* ── Tooltip flotante global (position:fixed — nunca queda cortado) ───────── */
.mnt-global-tooltip {
  position: fixed;
  z-index: 99999;
  transform: translate(-50%, -100%);
  pointer-events: none;

  min-width: 240px;
  max-width: 360px;
  background: #1e293b;
  color: #f1f5f9;
  font-size: .73rem;
  font-weight: 400;
  line-height: 1.6;
  padding: 9px 13px;
  border-radius: 8px;
  box-shadow: 0 6px 24px rgba(0,0,0,.3);
  white-space: normal;
  text-align: left;
  animation: mnt-tip-in .12s ease;
}
/* Flecha apuntando hacia abajo */
.mnt-global-tooltip::after {
  content: '';
  position: absolute;
  top: 100%; left: 50%;
  transform: translateX(-50%);
  border: 5px solid transparent;
  border-top-color: #1e293b;
}
/* Permite negritas en el innerHTML del tooltip */
:host ::ng-deep .mnt-global-tooltip strong { font-weight: 700; color: #fbbf24; }
:host ::ng-deep .mnt-global-tooltip em     { color: #94d8fb; font-style: normal; }
:host ::ng-deep .mnt-global-tooltip code   { background: rgba(255,255,255,.1); border-radius: 3px; padding: 0 4px; font-family: monospace; font-size: .71rem; }
@keyframes mnt-tip-in {
  from { opacity: 0; transform: translate(-50%, calc(-100% - 4px)); }
  to   { opacity: 1; transform: translate(-50%, -100%); }
}

/* ── Columna "Problema detectado" en tabla reindex ───────────────────────── */
.mnt-td-problem {
  display: flex; align-items: center; gap: 6px;
  font-size: .75rem; color: #64748b; min-width: 220px; max-width: 340px;
  white-space: normal; line-height: 1.35;
  padding-top: 6px !important; padding-bottom: 6px !important;
}
.mnt-td-problem__icon {
  font-size: 15px; color: #f59e0b; flex-shrink: 0; margin-top: 1px;
}

/* ══════════════════════════════════════════════════════════════════════════
   TABLA REINDEX — diseño profesional dedicado
   Clase específica para no afectar la tabla de VACUUM
══════════════════════════════════════════════════════════════════════════ */
.mnt-reindex-wrap { border-radius: 10px; overflow: hidden; border: 1px solid #e2e8f0; }

.mnt-reindex-table { width: 100%; border-collapse: collapse; font-size: .82rem; table-layout: fixed; }

/* Anchos de columna fijos — distribuyen el espacio de forma predecible */
.mnt-rcol--index   { width: 22%; }
.mnt-rcol--table   { width: 15%; }
.mnt-rcol--eff     { width: 18%; }
.mnt-rcol--problem { width: 33%; }
.mnt-rcol--action  { width: 12%; }

/* Cabecera */
.mnt-reindex-table thead th {
  padding: 11px 16px;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
  font-size: .67rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .06em;
  color: #94a3b8;
  white-space: nowrap;
}
.mnt-reindex-table thead th:last-child { text-align: center; }

/* Filas */
.mnt-reindex-table tbody tr {
  height: 56px;
  transition: background .12s;
}
.mnt-reindex-table tbody tr:not(:last-child) {
  border-bottom: 1px solid #f1f5f9;
}
.mnt-reindex-table tbody tr:hover:not(.mnt-tr--busy) { background: #f8fafc; }
.mnt-reindex-table tbody td { padding: 0 16px; vertical-align: middle; }

/* Celda ÍNDICE */
.mnt-rtd-index { overflow: hidden; }
.mnt-rtd-index code {
  font-family: 'Fira Code', 'Cascadia Code', monospace;
  font-size: .78rem; color: #1e40af;
  background: #eff6ff; padding: 3px 8px;
  border-radius: 5px; white-space: nowrap;
  display: inline-block; max-width: 100%;
  overflow: hidden; text-overflow: ellipsis;
}

/* Celda TABLA */
.mnt-rtd-table { overflow: hidden; }
.mnt-rtd-table__badge {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: .75rem; font-weight: 500; color: #475569;
  background: #f1f5f9; border: 1px solid #e2e8f0;
  padding: 3px 9px; border-radius: 6px;
  white-space: nowrap; max-width: 100%;
  overflow: hidden; text-overflow: ellipsis;
}
.mnt-rtd-table__badge .material-icons { font-size: 13px; color: #94a3b8; flex-shrink: 0; }

/* Celda EFICIENCIA */
.mnt-rtd-eff { min-width: 0; }
.mnt-rtd-eff .mnt-eff__bar-wrap { flex: 1; min-width: 60px; }

/* Celda PROBLEMA DETECTADO */
.mnt-rtd-problem {
  vertical-align: middle;
  padding-top: 8px !important;
  padding-bottom: 8px !important;
}
.mnt-rtd-problem__chip {
  display: flex; align-items: flex-start; gap: 6px;
  background: #fffbeb; border: 1px solid #fde68a;
  border-radius: 7px; padding: 6px 10px;
}
.mnt-rtd-problem__icon {
  font-size: 14px; color: #d97706; flex-shrink: 0; margin-top: 1px;
}
.mnt-rtd-problem__text {
  font-size: .75rem; color: #78350f; line-height: 1.45; white-space: normal;
}

/* Celda ACCIÓN */
.mnt-rtd-action {
  text-align: center;
  white-space: nowrap;
}

/* Botón Reindex dedicado */
.mnt-reindex-btn {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 7px 14px;
  border-radius: 8px;
  font-size: .78rem; font-weight: 700;
  cursor: pointer;
  border: 1px solid #bfdbfe;
  background: #eff6ff; color: #1d4ed8;
  transition: background .15s, border-color .15s, box-shadow .15s;
  white-space: nowrap;
  min-width: 108px; justify-content: center;
  box-shadow: 0 1px 3px rgba(37,99,235,.12);
}
.mnt-reindex-btn__icon { font-size: 15px; }
.mnt-reindex-btn:hover:not(:disabled) {
  background: #dbeafe; border-color: #93c5fd;
  box-shadow: 0 2px 8px rgba(37,99,235,.18);
}
.mnt-reindex-btn:disabled { opacity: .45; cursor: not-allowed; box-shadow: none; }

/* Estado ejecutando */
.mnt-reindex-btn--busy {
  background: #fafafa; color: #64748b; border-color: #e2e8f0;
  box-shadow: none;
}

/* Estado listo */
.mnt-reindex-btn--ok {
  background: #f0fdf4; color: #15803d; border-color: #86efac;
  box-shadow: 0 1px 3px rgba(34,197,94,.15);
}

/* Estado error */
.mnt-reindex-btn--err {
  background: #fef2f2; color: #b91c1c; border-color: #fca5a5;
  box-shadow: 0 1px 3px rgba(239,68,68,.15);
}

/* ── Skeleton extra-large ─────────────────────────────────────────────────── */
.mnt-skel--xl { width: 220px; }

/* ── Estado visual del botón VACUUM ANALYZE al completar ─────────────────── */
/* Cuando vacuumState === 'ok', el botón está disabled — mostramos verde */
.mnt-row-btn--va:disabled {
  opacity: 1;
  cursor: default;
}
/* Celda de fecha con tooltip nativo — cursor help para indicar que hay info */
.mnt-td-date[title] { cursor: help; }

@keyframes mnt-toast-bar {
  from { width: 100%; }
  to   { width: 0; }
}

/* ════════════════════════════════════════════════════════════════════════════
   SECCIÓN 5 — HISTORIAL DE OPERACIONES
   ════════════════════════════════════════════════════════════════════════ */

/* Ícono del card header — variante slate */
.mnt-section-icon--slate { background: #f1f5f9; color: #475569; }
.mnt-card__subtitle       { font-size: .75rem; color: #64748b; margin: 2px 0 0; }

/* Botón ghost del header */
.mnt-btn-ghost {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 6px 12px; border-radius: 8px;
  font-size: .79rem; font-weight: 600; cursor: pointer;
  background: transparent; border: 1px solid #e2e8f0; color: #475569;
  transition: background .15s, border-color .15s;
}
.mnt-btn-ghost:hover:not(:disabled) { background: #f1f5f9; border-color: #cbd5e1; }
.mnt-btn-ghost:disabled { opacity: .45; cursor: not-allowed; }
.mnt-btn-ghost .material-icons { font-size: 16px; }

/* ── Tabla de historial ────────────────────────────────────────────────────  */
.mnt-hist-table { font-size: .81rem; }

/* Anchos de columna */
.mnt-hcol--op     { width: 100px; }
.mnt-hcol--target { width: 22%;   }
.mnt-hcol--user   { width: 14%;   }
.mnt-hcol--date   { width: 13%;   }
.mnt-hcol--result { width: 18%;   }
.mnt-hcol--dur    { width: 80px;  }
.mnt-hcol--status { width: 120px; }

/* ── Badges de operación ────────────────────────────────────────────────── */
.mnt-hist-op-badge {
  display: inline-flex; align-items: center;
  padding: 3px 9px; border-radius: 20px;
  font-size: .73rem; font-weight: 700; letter-spacing: .3px;
  border: 1px solid transparent;
}
.mnt-hist-op-badge--vacuum  {
  background: #eff6ff; color: #1d4ed8; border-color: #bfdbfe;
}
.mnt-hist-op-badge--reindex {
  background: #faf5ff; color: #7c3aed; border-color: #ddd6fe;
}
.mnt-hist-op-badge--analyze {
  background: #f0fdf4; color: #15803d; border-color: #bbf7d0;
}

/* ── Columna tabla / índice ────────────────────────────────────────────── */
.mnt-hist-target__name {
  display: block;
  font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', monospace;
  font-size: .79rem; color: #0f172a; font-weight: 600;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  max-width: 200px;
}
.mnt-hist-target__type {
  display: block; font-size: .69rem; color: #94a3b8;
  text-transform: uppercase; letter-spacing: .4px; margin-top: 1px;
}

/* ── Usuario ────────────────────────────────────────────────────────────── */
.mnt-hist-user { color: #475569; font-size: .79rem; }

/* ── Fecha relativa ────────────────────────────────────────────────────── */
.mnt-hist-date { color: #64748b; font-size: .79rem; cursor: help; }

/* ── Resultado ────────────────────────────────────────────────────────── */
.mnt-hist-result           { font-size: .79rem; }
.mnt-hist-result--positive { color: #16a34a; font-weight: 600; }
.mnt-hist-result--neutral  { color: #94a3b8; }

/* ── Duración ─────────────────────────────────────────────────────────── */
.mnt-hist-duration {
  font-variant-numeric: tabular-nums;
  color: #64748b; font-size: .79rem; text-align: right; padding-right: 8px !important;
}

/* ── Badges de estado ─────────────────────────────────────────────────── */
.mnt-hist-status-badge {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 3px 9px; border-radius: 20px;
  font-size: .73rem; font-weight: 600;
  border: 1px solid transparent;
}
.mnt-hist-status-badge .material-icons { font-size: 13px; }

.mnt-hist-status-badge--success  { background: #f0fdf4; color: #16a34a; border-color: #bbf7d0; }
.mnt-hist-status-badge--error    { background: #fef2f2; color: #dc2626; border-color: #fecaca; cursor: help; }
.mnt-hist-status-badge--progress { background: #fffbeb; color: #d97706; border-color: #fde68a; }

/* ── Empty state ──────────────────────────────────────────────────────── */
.mnt-hist-empty {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 48px 24px; gap: 8px; text-align: center;
}
.mnt-hist-empty__icon {
  font-size: 40px; color: #cbd5e1;
}
.mnt-hist-empty__text {
  font-size: .88rem; font-weight: 600; color: #94a3b8; margin: 0;
}
.mnt-hist-empty__sub  {
  font-size: .78rem; color: #cbd5e1; margin: 0;
}

/* ── Skeleton del historial ───────────────────────────────────────────── */
.mnt-hist-skeleton       { padding: 8px 0; }
.mnt-hist-skeleton__row  {
  display: flex; gap: 12px; align-items: center;
  padding: 10px 20px;
  border-bottom: 1px solid #f8fafc;
}
.mnt-hist-skeleton__cell {
  height: 18px; border-radius: 4px;
  background: #f1f5f9;
  animation: mnt-pulse 1.5s ease-in-out infinite;
}
.mnt-hist-skeleton__cell--op     { width: 80px; }
.mnt-hist-skeleton__cell--target { flex: 1; }
.mnt-hist-skeleton__cell--sm     { width: 100px; }
.mnt-hist-skeleton__cell--xs     { width: 60px; }
.mnt-hist-skeleton__cell--status { width: 90px; }

/* ═══════════════════════════════════════════════════════════════════════════
   NUEVOS ESTILOS — ANALYZE + AUTOMATIZACIÓN
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Sección icon teal (automatización) ──────────────────────────────────── */
.mnt-section-icon--teal { background: #f0fdfa; color: #0d9488; }

/* ── Variantes dialog icon (para toggle automático) ─────────────────────── */
.mnt-dialog__icon--green { background: #f0fdf4; color: #16a34a; }
.mnt-dialog__icon--gray  { background: #f8fafc; color: #64748b; }

/* ── Note de advertencia dentro del dialog ───────────────────────────────── */
.mnt-dialog__note--warn {
  background: #fffbeb; color: #92400e; border-radius: 6px;
  padding: 8px 10px; display: flex; gap: 6px; align-items: flex-start;
  font-size: .78rem; font-style: normal;
}
.mnt-dialog__note--warn .material-icons { font-size: 15px; color: #d97706; margin-top: 1px; }

/* ── Botones nuevos en la barra de acciones (header) ─────────────────────── */
.mnt-btn--analyze-all {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 14px; border-radius: 8px; border: 1px solid #bfdbfe;
  background: #eff6ff; color: #2563eb;
  font-size: .78rem; font-weight: 600; cursor: pointer;
  transition: background .15s, border-color .15s;
}
.mnt-btn--analyze-all:hover:not(:disabled) { background: #dbeafe; border-color: #60a5fa; }
.mnt-btn--analyze-all:disabled { opacity: .45; cursor: not-allowed; }
.mnt-btn--analyze-all .material-icons { font-size: 16px; }

.mnt-btn--run-now {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 16px; border-radius: 8px; border: 1px solid #6ee7b7;
  background: #ecfdf5; color: #047857;
  font-size: .78rem; font-weight: 600; cursor: pointer;
  transition: background .15s, border-color .15s;
}
.mnt-btn--run-now:hover:not(:disabled) { background: #d1fae5; border-color: #34d399; }
.mnt-btn--run-now:disabled { opacity: .45; cursor: not-allowed; }
.mnt-btn--run-now .material-icons { font-size: 18px; }

.mnt-btn--save-config {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 9px 20px; border-radius: 8px; border: 1px solid #818cf8;
  background: #eef2ff; color: #4338ca;
  font-size: .82rem; font-weight: 600; cursor: pointer;
  transition: background .15s, border-color .15s;
}
.mnt-btn--save-config:hover:not(:disabled) { background: #e0e7ff; border-color: #6366f1; }
.mnt-btn--save-config:disabled { opacity: .45; cursor: not-allowed; }
.mnt-btn--save-config .material-icons { font-size: 17px; }

.mnt-btn--danger {
  background: #fee2e2; color: #dc2626; border: 1px solid #fca5a5;
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 16px; border-radius: 8px;
  font-size: .82rem; font-weight: 600; cursor: pointer;
  transition: background .15s, border-color .15s;
}
.mnt-btn--danger:hover:not(:disabled) { background: #fecaca; border-color: #ef4444; }
.mnt-btn--danger:disabled { opacity: .45; cursor: not-allowed; }

/* ── Grupo de botones en celda de acción (VACUUM + ANALYZE) ──────────────── */
.mnt-row-action-group {
  display: flex; flex-direction: column; gap: 4px; align-items: stretch;
}
@media (min-width: 1200px) {
  .mnt-row-action-group { flex-direction: row; gap: 5px; justify-content: center; }
}

/* ── Tarjeta de automatización ───────────────────────────────────────────── */
.mnt-auto-card {
  border-top: 3px solid #0d9488;
}

/* Spinner de carga */
.mnt-auto-loading {
  display: flex; align-items: center; gap: 8px;
  padding: 24px 20px; color: #94a3b8; font-size: .85rem;
}

/* ── Toggle activar / desactivar ─────────────────────────────────────────── */
.mnt-auto-toggle-row {
  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;
  padding: 16px 20px;
  background: #f8fafc; border-radius: 10px; margin: 0 20px 20px;
  border: 1px solid #e2e8f0;
}
.mnt-auto-toggle-info {
  display: flex; flex-direction: column; gap: 3px;
}
.mnt-auto-toggle-label {
  font-size: .83rem; font-weight: 700; color: #0f172a;
}
.mnt-auto-toggle-desc {
  font-size: .77rem; color: #64748b;
}

/* Toggle pill (iOS style) */
.mnt-toggle {
  display: inline-flex; align-items: center; gap: 8px;
  background: none; border: none; cursor: pointer; padding: 4px 0;
  user-select: none;
  transition: opacity .15s;
}
.mnt-toggle:disabled { opacity: .5; cursor: not-allowed; }
.mnt-toggle__track {
  position: relative;
  width: 44px; height: 24px;
  background: #cbd5e1; border-radius: 12px;
  transition: background .25s;
  flex-shrink: 0;
}
.mnt-toggle--on .mnt-toggle__track { background: #0d9488; }
.mnt-toggle__thumb {
  position: absolute;
  top: 2px; left: 2px;
  width: 20px; height: 20px;
  background: #fff; border-radius: 50%;
  box-shadow: 0 1px 4px rgba(0,0,0,.2);
  transition: transform .25s cubic-bezier(.4,0,.2,1);
}
.mnt-toggle--on .mnt-toggle__thumb { transform: translateX(20px); }
.mnt-toggle__text {
  font-size: .75rem; font-weight: 700; letter-spacing: .04em;
  color: #94a3b8; transition: color .2s;
}
.mnt-toggle--on .mnt-toggle__text { color: #0d9488; }

/* ── Tarjetas próxima / última ejecución ─────────────────────────────────── */
.mnt-auto-exec-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
  padding: 0 20px 20px;
}
@media (max-width: 640px) { .mnt-auto-exec-grid { grid-template-columns: 1fr; } }

.mnt-auto-exec-card {
  display: flex; align-items: flex-start; gap: 12px;
  padding: 14px 16px; border-radius: 10px;
  border: 1px solid #e2e8f0;
  background: #f8fafc;
}
.mnt-auto-exec-card--next { border-left: 3px solid #0d9488; }
.mnt-auto-exec-card--last { border-left: 3px solid #94a3b8; }

.mnt-auto-exec-card__icon {
  width: 36px; height: 36px; border-radius: 8px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.mnt-auto-exec-card--next .mnt-auto-exec-card__icon { background: #f0fdfa; color: #0d9488; }
.mnt-auto-exec-card--last .mnt-auto-exec-card__icon { background: #f8fafc; color: #64748b; }
.mnt-auto-exec-card__icon .material-icons { font-size: 20px; }

.mnt-auto-exec-card__body { display: flex; flex-direction: column; gap: 3px; }
.mnt-auto-exec-card__label { font-size: .73rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: .05em; }
.mnt-auto-exec-card__value { font-size: .95rem; font-weight: 700; color: #0f172a; }
.mnt-auto-exec-card__exact { font-size: .73rem; color: #94a3b8; }

/* ── Sección de configuración ────────────────────────────────────────────── */
.mnt-auto-config-section {
  border-top: 1px solid #e2e8f0;
  padding: 20px 20px 0;
}
.mnt-auto-config-title {
  display: flex; align-items: center; gap: 7px;
  font-size: .83rem; font-weight: 700; color: #334155; margin: 0 0 16px;
}
.mnt-auto-config-title .material-icons { font-size: 18px; color: #0d9488; }

.mnt-auto-config-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 16px 24px;
}
@media (max-width: 640px) { .mnt-auto-config-grid { grid-template-columns: 1fr; } }

.mnt-auto-field {
  display: flex; flex-direction: column; gap: 8px;
}
.mnt-auto-field__label {
  display: flex; align-items: center; gap: 5px;
  font-size: .78rem; font-weight: 600; color: #475569;
}

/* Frequency chips */
.mnt-freq-chips {
  display: flex; flex-wrap: wrap; gap: 6px;
}
.mnt-freq-chip {
  padding: 5px 14px; border-radius: 20px;
  border: 1px solid #e2e8f0; background: #f8fafc;
  font-size: .78rem; font-weight: 600; color: #64748b;
  cursor: pointer; transition: all .15s;
}
.mnt-freq-chip:hover { background: #f1f5f9; border-color: #cbd5e1; color: #334155; }
.mnt-freq-chip--active {
  background: #f0fdfa; border-color: #0d9488; color: #0d9488;
}

/* Select hora preferida */
.mnt-auto-select {
  padding: 7px 10px; border-radius: 7px;
  border: 1px solid #e2e8f0; background: #fff;
  font-size: .82rem; color: #0f172a;
  cursor: pointer; outline: none;
  transition: border-color .15s;
  max-width: 160px;
}
.mnt-auto-select:focus { border-color: #0d9488; box-shadow: 0 0 0 2px rgba(13,148,136,.12); }

/* Input numérico con unidad */
.mnt-auto-input-wrap {
  display: flex; align-items: center; gap: 8px;
}
.mnt-auto-input {
  width: 90px; padding: 7px 10px; border-radius: 7px;
  border: 1px solid #e2e8f0; background: #fff;
  font-size: .82rem; color: #0f172a; outline: none;
  transition: border-color .15s;
}
.mnt-auto-input:focus { border-color: #0d9488; box-shadow: 0 0 0 2px rgba(13,148,136,.12); }
.mnt-auto-input-unit { font-size: .77rem; color: #94a3b8; font-weight: 500; }

/* Acciones del formulario */
.mnt-auto-config-actions {
  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  padding: 16px 0 20px;
}
.mnt-auto-config-hint {
  display: flex; align-items: center; gap: 5px;
  font-size: .75rem; color: #94a3b8;
}
.mnt-auto-config-hint .material-icons { font-size: 14px; }

/* ── Badge "Automático" en historial ─────────────────────────────────────── */
.mnt-hist-executor--auto {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 2px 8px; border-radius: 12px;
  background: #f0fdfa; color: #0d9488; border: 1px solid #99f6e4;
  font-size: .73rem; font-weight: 600;
  cursor: default;
}
.mnt-hist-executor--auto .material-icons { font-size: 13px; }

/* ── Resultado ANALYZE en historial ──────────────────────────────────────── */
.mnt-hist-result--analyze {
  color: #2563eb; font-size: .78rem; font-weight: 600;
}

/* ════════════════════════════════════════════════════════════════════════════
   BANNER DE REDIRECCIÓN A AUTOMATIZACIONES
   ════════════════════════════════════════════════════════════════════════════ */
.mnt-auto-redirect-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  background: #f0fdfa;
  border: 1px solid #99f6e4;
  border-left: 4px solid #0d9488;
  border-radius: 12px;
  padding: 18px 22px;
  margin-bottom: 20px;
}
.mnt-auto-redirect-banner__left {
  display: flex;
  align-items: center;
  gap: 14px;
  flex: 1;
  min-width: 0;
}
.mnt-auto-redirect-banner__icon {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: #ccfbf1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.mnt-auto-redirect-banner__icon .material-icons {
  font-size: 1.4rem;
  color: #0f766e;
}
.mnt-auto-redirect-banner__title {
  font-size: .9rem;
  font-weight: 700;
  color: #134e4a;
  margin: 0 0 3px;
}
.mnt-auto-redirect-banner__sub {
  font-size: .8rem;
  color: #0f766e;
  margin: 0;
  line-height: 1.5;
}
.mnt-auto-redirect-banner__sub strong {
  color: #0d9488;
}
.mnt-auto-redirect-banner__btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: #0d9488;
  color: #ffffff;
  border: none;
  border-radius: 8px;
  padding: 10px 18px;
  font-size: .85rem;
  font-weight: 600;
  cursor: pointer;
  transition: background .15s, transform .1s;
  white-space: nowrap;
  flex-shrink: 0;
}
.mnt-auto-redirect-banner__btn .material-icons {
  font-size: 1rem;
}
.mnt-auto-redirect-banner__btn:hover {
  background: #0f766e;
  transform: translateY(-1px);
}
.mnt-auto-redirect-banner__btn:active {
  transform: translateY(0);
}
