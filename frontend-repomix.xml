<file path="src/app/components/wishlist/wishlist.component.css">
/* ============================================================
   WISHLIST PAGE — Fase 2 E-Commerce
   Diseño premium con glassmorphism y micro-animaciones
   ============================================================ */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

:host {
  font-family: 'Inter', var(--fuente-principal, sans-serif);
}

.wishlist-page {
  min-height: 100vh;
  background: #f8fafc; /* Color crema/beige claro tipo catalogo */
  padding: 24px 20px 60px;
}

/* ── Header ─────────────────────────────────────────────────── */
.page-header {
  max-width: 1280px;
  margin: 0 auto 32px;
}

.header-content {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}

.header-title {
  display: flex;
  align-items: center;
  gap: 16px;
}

.header-icon {
  font-size: 48px;
  color: #e91e63;
  filter: drop-shadow(0 0 12px rgba(233, 30, 99, 0.5));
  animation: heartbeat 2.5s ease-in-out infinite;
}

@keyframes heartbeat {
  0%, 100% { transform: scale(1); }
  30%       { transform: scale(1.12); }
  60%       { transform: scale(1.05); }
}

h1 {
  font-size: clamp(1.8rem, 4vw, 2.4rem);
  font-weight: 700;
  color: #1e293b;
  margin: 0;
  letter-spacing: -0.5px;
}

.header-subtitle {
  color: #64748b;
  margin: 4px 0 0;
  font-size: 0.95rem;
}

.header-stats {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: center;
}

.stat-chip {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  border-radius: 20px;
  font-size: 0.82rem;
  font-weight: 600;
  backdrop-filter: blur(10px);

  .material-symbols-outlined { font-size: 16px; }

  &.in-stock {
    background: rgba(76, 175, 80, 0.2);
    color: #81c784;
    border: 1px solid rgba(76, 175, 80, 0.3);
  }
  &.price-drop {
    background: rgba(233, 30, 99, 0.2);
    color: #f48fb1;
    border: 1px solid rgba(233, 30, 99, 0.3);
  }
  &.total-value {
    background: rgba(255, 193, 7, 0.15);
    color: #ffe082;
    border: 1px solid rgba(255, 193, 7, 0.25);
  }
}

/* ── Toasts ─────────────────────────────────────────────────── */
.toast-area {
  position: fixed;
  top: 80px;
  right: 20px;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.toast {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 20px;
  border-radius: 12px;
  font-size: 0.88rem;
  font-weight: 500;
  max-width: 340px;
  backdrop-filter: blur(16px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  animation: toastIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);

  .material-symbols-outlined { font-size: 20px; flex-shrink: 0; }

  &.success {
    background: rgba(76, 175, 80, 0.85);
    color: #fff;
    border: 1px solid rgba(76, 175, 80, 0.5);
  }
  &.error {
    background: rgba(244, 67, 54, 0.85);
    color: #fff;
    border: 1px solid rgba(244, 67, 54, 0.5);
  }
}

@keyframes toastIn {
  from { opacity: 0; transform: translateX(40px) scale(0.9); }
  to   { opacity: 1; transform: translateX(0) scale(1); }
}

/* ── Loading skeleton ────────────────────────────────────────── */
.loading-container { max-width: 1280px; margin: 0 auto; }

.skeleton-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 24px;
}

.skeleton-card {
  height: 380px;
  border-radius: 20px;
  background: linear-gradient(90deg,
    rgba(255,255,255,0.06) 25%,
    rgba(255,255,255,0.12) 50%,
    rgba(255,255,255,0.06) 75%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0%   { background-position: -200% 0; }
  100% { background-position:  200% 0; }
}

/* ── Estado vacío ─────────────────────────────────────────────── */
.empty-state {
  max-width: 480px;
  margin: 80px auto;
  text-align: center;
  color: #475569;

  .empty-icon {
    font-size: 80px;
    color: #cbd5e1;
    display: block;
    margin-bottom: 24px;
  }

  h2 {
    color: #1e293b;
    font-size: 1.6rem;
    margin: 0 0 12px;
  }

  p {
    margin: 0 0 32px;
    line-height: 1.6;
  }
}

.btn-brand {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 28px;
  background: var(--color-primario, #722f37);
  color: #fff;
  border: none;
  border-radius: 12px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  text-decoration: none;

  .material-symbols-outlined { font-size: 20px; }

  &:hover {
    transform: translateY(-2px);
    background: var(--color-primario-hover, #5a252b);
    box-shadow: 0 8px 24px rgba(114, 47, 55, 0.4);
  }
}

/* ── Error state ──────────────────────────────────────────────── */
.error-state {
  max-width: 400px;
  margin: 80px auto;
  text-align: center;
  color: rgba(255,255,255,0.7);

  .material-symbols-outlined { font-size: 64px; color: rgba(244,67,54,0.5); margin-bottom: 16px; display: block; }
  h3 { color: #fff; margin: 0 0 8px; }
  p { margin: 0 0 24px; }
}

.btn-retry {
  padding: 10px 24px;
  background: rgba(255,255,255,0.1);
  color: #fff;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 8px;
  cursor: pointer;
  font-size: 0.9rem;
  transition: all 0.2s;
  &:hover { background: rgba(255,255,255,0.2); }
}

/* ── Actions bar ──────────────────────────────────────────────── */
.wishlist-content { max-width: 1280px; margin: 0 auto; }

.actions-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 28px;
  padding: 16px 20px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  flex-wrap: wrap;
}

.sort-control {
  display: flex;
  align-items: center;
  gap: 10px;

  label {
    color: #64748b;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  select {
    background: #f8fafc;
    color: #1e293b;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 0.88rem;
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s;

    option { background: #fff; color: #1e293b; }

    &:focus { border-color: var(--color-primario, #722f37); }
  }
}

.btn-move-all {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  background: var(--color-primario, #722f37);
  color: #fff;
  border: none;
  border-radius: 10px;
  font-size: 0.88rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;

  .material-symbols-outlined { font-size: 18px; }

  &:hover {
    transform: translateY(-1px);
    background: var(--color-primario-hover, #5a252b);
    box-shadow: 0 6px 20px rgba(114, 47, 55, 0.4);
  }
}

.count-badge {
  background: rgba(255,255,255,0.25);
  border-radius: 12px;
  padding: 2px 8px;
  font-size: 0.78rem;
}

/* ── Grid de productos ────────────────────────────────────────── */
.wishlist-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 24px;
}

/* ── Tarjeta ─────────────────────────────────────────────────── */
.wishlist-card {
  position: relative;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: all 0.35s cubic-bezier(0.23, 1, 0.32, 1);
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);

  &:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    border-color: #cbd5e1;
  }

  &.out-of-stock {
    opacity: 0.7;
    .card-image img { filter: grayscale(40%); }
  }

  &.removing {
    opacity: 0.4;
    pointer-events: none;
    transform: scale(0.97);
  }
}

/* Badges */
.badge {
  position: absolute;
  top: 12px;
  z-index: 2;
  border-radius: 8px;
  font-size: 0.72rem;
  font-weight: 700;
  padding: 4px 8px;
  display: flex;
  align-items: center;
  gap: 3px;
  text-transform: uppercase;
  letter-spacing: 0.5px;

  .material-symbols-outlined { font-size: 13px; }
}

.price-drop-badge {
  left: 12px;
  background: linear-gradient(135deg, #e91e63, #c2185b);
  color: #fff;
  box-shadow: 0 2px 8px rgba(233, 30, 99, 0.4);
}

.out-of-stock-badge {
  right: 12px;
  background: rgba(0,0,0,0.6);
  color: rgba(255,255,255,0.8);
  border: 1px solid rgba(255,255,255,0.15);
}

/* Imagen */
.card-image {
  position: relative;
  height: 200px;
  overflow: hidden;
  cursor: pointer;

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #fff;
    font-size: 0.88rem;
    font-weight: 600;
    opacity: 0;
    transition: opacity 0.3s ease;

    .material-symbols-outlined { font-size: 20px; }
  }

  &:hover {
    img { transform: scale(1.08); }
    .image-overlay { opacity: 1; }
  }
}

/* Cuerpo */
.card-body {
  padding: 16px;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.product-sku {
  font-size: 0.72rem;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}

.product-name {
  font-size: 1rem;
  font-weight: 600;
  color: #1e293b;
  margin: 0;
  cursor: pointer;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  transition: color 0.2s;

  &:hover { color: var(--color-primario, #722f37); }
}

.price-section {
  display: flex;
  align-items: baseline;
  gap: 8px;
  flex-wrap: wrap;
}

.current-price {
  font-size: 1.3rem;
  font-weight: 700;
  color: #0f172a;
}

.original-price {
  font-size: 0.9rem;
  color: #94a3b8;
  text-decoration: line-through;
}

.savings-label {
  font-size: 0.75rem;
  font-weight: 600;
  color: #81c784;
  background: rgba(76, 175, 80, 0.15);
  padding: 2px 7px;
  border-radius: 6px;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  flex-wrap: wrap;
}

.stock-indicator {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 0.78rem;
  font-weight: 500;

  .material-symbols-outlined { font-size: 14px; }

  &.in-stock { color: #81c784; }
  &.no-stock { color: #ef9a9a; }
}

.priority-chip {
  font-size: 0.7rem;
  font-weight: 600;
  padding: 3px 8px;
  border-radius: 8px;
  text-transform: uppercase;
  letter-spacing: 0.5px;

  &.priority-low    { background: rgba(96, 125, 139, 0.25); color: #90a4ae; }
  &.priority-medium { background: rgba(255, 152, 0, 0.2);   color: #ffb74d; }
  &.priority-high   { background: rgba(233, 30, 99, 0.2);   color: #f48fb1; }
}

.added-date {
  font-size: 0.73rem;
  color: #94a3b8;
  margin-top: auto;
}

/* Acciones de tarjeta */
.card-actions {
  display: flex;
  gap: 8px;
  padding: 12px 16px 16px;
  border-top: 1px solid #f1f5f9;
}

.btn-add-cart {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 10px 14px;
  border: none;
  border-radius: 10px;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  background: #f1f5f9;
  color: #94a3b8;

  .material-symbols-outlined { font-size: 16px; }

  &.in-stock {
    background: var(--color-primario, #722f37);
    color: #fff;

    &:hover:not(:disabled) {
      transform: translateY(-1px);
      box-shadow: 0 4px 16px rgba(114, 47, 55, 0.4);
      background: var(--color-primario-hover, #5a252b);
    }
  }

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }
}

.btn-remove {
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  background: #f8fafc;
  color: #94a3b8;
  cursor: pointer;
  transition: all 0.2s ease;
  flex-shrink: 0;

  .material-symbols-outlined { font-size: 18px; }

  &:hover:not(:disabled) {
    background: #fee2e2;
    border-color: #fca5a5;
    color: #ef4444;
  }

  &:disabled { opacity: 0.4; cursor: not-allowed; }
}

/* Spinners */
.btn-spinner {
  width: 14px;
  height: 14px;
  border: 2px solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  display: inline-block;

  &.small {
    width: 12px;
    height: 12px;
  }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ── Responsive ─────────────────────────────────────────────── */
@media (max-width: 768px) {
  .wishlist-page { padding: 16px 12px 40px; }

  .header-content {
    flex-direction: column;
    gap: 16px;
  }

  .wishlist-grid {
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }

  .actions-bar {
    flex-direction: column;
    align-items: stretch;
  }

  .btn-move-all {
    justify-content: center;
  }

  .toast-area { right: 12px; left: 12px; }
  .toast { max-width: 100%; }
}

@media (max-width: 480px) {
  .wishlist-grid {
    grid-template-columns: 1fr;
  }

  .card-image { height: 180px; }
}
