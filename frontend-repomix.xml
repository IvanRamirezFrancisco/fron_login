    margin-bottom: 0.375rem;
  }

  .modal-header p {
    font-size: 0.85rem;
  }

  .modal-close {
    top: 0.75rem;
    right: 0.75rem;
    width: 32px;
    height: 32px;
  }

  .modal-close .material-icons {
    font-size: 20px;
  }

  .modal-body {
    padding: 1.25rem 1rem;
  }

  .methods-grid {
    gap: 0.875rem;
  }

  .method-card {
    padding: 1rem;
  }

  .method-card .material-icons {
    font-size: 36px;
  }

  .method-card h4 {
    font-size: 1rem;
  }

  .method-card p {
    font-size: 0.85rem;
  }

  .method-header {
    margin-bottom: 0.875rem;
    padding-bottom: 0.875rem;
  }

  .method-header .material-icons {
    font-size: 24px;
  }

  .method-header h3 {
    font-size: 1.05rem;
  }

  .method-instruction {
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
  }

  .code-input-group {
    margin-bottom: 1.25rem;
  }

  .code-input-group label {
    font-size: 0.875rem;
  }

  .code-input {
    font-size: 1.1rem;
    padding: 0.75rem;
    letter-spacing: 0.3rem;
  }

  .btn-verify,
  .btn-send-code {
    padding: 0.875rem;
    font-size: 0.95rem;
    min-height: 48px; /* Touch-friendly */
  }

  .btn-verify .material-icons,
  .btn-send-code .material-icons {
    font-size: 20px;
  }

  .email-display {
    padding: 0.875rem;
    font-size: 0.875rem;
    flex-wrap: wrap;
  }

  .success-message {
