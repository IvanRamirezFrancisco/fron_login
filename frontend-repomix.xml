<!-- ==================== MODAL DETALLE DE ORDEN ==================== -->
<div class="modal-backdrop" (click)="onBackdropClick($event)">
  <div class="modal-container">

    <!-- HEADER -->
    <div class="flex items-center justify-between px-6 py-4 bg-gray-800 rounded-t-2xl flex-shrink-0">
      <div class="flex items-center gap-3 min-w-0">
        <i class="fa-solid fa-receipt text-[#C5A059] text-lg flex-shrink-0"></i>
        <div class="min-w-0">
          <h2 class="text-white font-bold text-base leading-tight">Detalle de Orden</h2>
          <span class="text-gray-300 text-xs font-mono">{{ order.orderNumber }}</span>
        </div>
        <div class="hidden sm:flex items-center gap-2 ml-2">
          <span class="px-2.5 py-1 rounded-full text-xs font-semibold" [ngClass]="{
            'bg-amber-100 text-amber-800': order.status === 'PENDING',
            'bg-blue-100 text-blue-800': order.status === 'CONFIRMED' || order.status === 'PROCESSING',
            'bg-green-100 text-green-800': order.status === 'COMPLETED',
            'bg-red-100 text-red-800': order.status === 'CANCELLED'
          }">{{ translateOrderStatus(order.status) }}</span>
          <span class="px-2.5 py-1 rounded-full text-xs font-semibold" [ngClass]="{
            'bg-amber-100 text-amber-800': order.paymentStatus === 'PENDING',
            'bg-green-100 text-green-800': order.paymentStatus === 'PAID',
            'bg-red-100 text-red-800': order.paymentStatus === 'FAILED' || order.paymentStatus === 'REFUNDED'
          }">{{ translatePaymentStatus(order.paymentStatus) }}</span>
          <span class="px-2.5 py-1 rounded-full text-xs font-semibold" [ngClass]="{
            'bg-gray-100 text-gray-600': order.shippingStatus === 'PENDING',
            'bg-blue-100 text-blue-800': order.shippingStatus === 'PREPARING',
            'bg-indigo-100 text-indigo-800': order.shippingStatus === 'SHIPPED' || order.shippingStatus === 'IN_TRANSIT',
            'bg-green-100 text-green-800': order.shippingStatus === 'DELIVERED',
            'bg-red-100 text-red-800': order.shippingStatus === 'RETURNED'
          }">{{ translateShippingStatus(order.shippingStatus) }}</span>
        </div>
      </div>
      <button (click)="closeModal()" title="Cerrar"
        class="w-8 h-8 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors flex-shrink-0 ml-2">
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>
    </div>

    <!-- Alertas -->
    <div *ngIf="successMessage" class="flex items-center gap-2 px-6 py-2.5 bg-green-50 border-b border-green-200 text-green-700 text-sm font-medium flex-shrink-0">
      <i class="fa-solid fa-circle-check text-green-500"></i>
      {{ successMessage }}
    </div>
    <div *ngIf="error" class="flex items-center gap-2 px-6 py-2.5 bg-red-50 border-b border-red-200 text-red-700 text-sm font-medium flex-shrink-0">
      <i class="fa-solid fa-circle-exclamation text-red-500"></i>
      {{ error }}
    </div>

    <!-- BODY SCROLLABLE -->
    <div class="modal-body px-6 py-5 space-y-5">

      <!-- SECCIÓN: INFORMACIÓN DEL CLIENTE -->
      <div class="bg-gray-50 rounded-xl border border-gray-200 p-4">
        <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
          <i class="fa-solid fa-user text-[#C5A059]"></i>
          Información del Cliente
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <!-- Nombre -->
          <div class="flex items-start gap-2.5">
            <i class="fa-solid fa-user-circle text-gray-400 mt-0.5 w-4 text-sm flex-shrink-0"></i>
            <div>
              <p class="text-xs text-gray-500">Cliente</p>
              <p class="text-sm font-semibold text-gray-800">{{ order.customerName }}</p>
            </div>
          </div>
          <!-- Email -->
          <div class="flex items-start gap-2.5">
            <i class="fa-solid fa-envelope text-gray-400 mt-0.5 w-4 text-sm flex-shrink-0"></i>
            <div>
              <p class="text-xs text-gray-500">Email</p>
              <p class="text-sm text-gray-800 break-all">{{ order.customerEmail }}</p>
            </div>
          </div>
          <!-- Teléfono -->
          <div class="flex items-start gap-2.5" *ngIf="order.customerPhone">
            <i class="fa-solid fa-phone text-gray-400 mt-0.5 w-4 text-sm flex-shrink-0"></i>
            <div>
              <p class="text-xs text-gray-500">Teléfono</p>
              <p class="text-sm text-gray-800">{{ order.customerPhone }}</p>
            </div>
          </div>
          <!-- Dirección -->
          <div class="flex items-start gap-2.5" *ngIf="order.shippingAddress">
            <i class="fa-solid fa-location-dot text-gray-400 mt-0.5 w-4 text-sm flex-shrink-0"></i>
            <div>
              <p class="text-xs text-gray-500">Dirección de Envío</p>
              <p class="text-sm text-gray-800">{{ order.shippingAddress }}</p>
            </div>
          </div>
          <!-- Método de Pago -->
          <div class="flex items-start gap-2.5" *ngIf="order.paymentMethod">
            <i class="fa-solid fa-credit-card text-gray-400 mt-0.5 w-4 text-sm flex-shrink-0"></i>
            <div>
              <p class="text-xs text-gray-500">Método de Pago</p>
              <p class="text-sm text-gray-800">{{ order.paymentMethod }}</p>
              <p class="text-xs text-gray-500" *ngIf="order.transactionId">ID: {{ order.transactionId }}</p>
            </div>
          </div>
          <!-- Fecha -->
          <div class="flex items-start gap-2.5">
            <i class="fa-solid fa-calendar text-gray-400 mt-0.5 w-4 text-sm flex-shrink-0"></i>
            <div>
              <p class="text-xs text-gray-500">Fecha de Orden</p>
              <p class="text-sm text-gray-800">{{ orderService.formatDate(order.orderDate) }}</p>
            </div>
          </div>
        </div>

        <!-- Notas -->
        <div *ngIf="order.cancellationReason" class="mt-3 p-3 bg-red-50 border border-red-200 rounded-lg">
          <p class="text-xs font-semibold text-red-700 mb-1 flex items-center gap-1">
            <i class="fa-solid fa-ban"></i> Razón de Cancelación
          </p>
          <p class="text-sm text-red-600">{{ order.cancellationReason }}</p>
        </div>
        <div *ngIf="order.customerNotes" class="mt-3 p-3 bg-amber-50 border border-amber-200 rounded-lg">
          <p class="text-xs font-semibold text-amber-700 mb-1 flex items-center gap-1">
            <i class="fa-solid fa-comment"></i> Notas del Cliente
          </p>
          <p class="text-sm text-amber-800">{{ order.customerNotes }}</p>
        </div>
      </div>

      <!-- SECCIÓN: ACTUALIZAR ESTADOS -->
      <div class="bg-gray-50 rounded-xl border border-gray-200 p-4">
        <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
          <i class="fa-solid fa-sliders text-[#C5A059]"></i>
          Actualizar Estados
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-3">
          <!-- Estado Orden -->
          <div>
            <label class="text-xs font-medium text-gray-600 block mb-1">Estado de Orden</label>
            <select
              class="w-full text-sm border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#800020] focus:border-transparent bg-white"
              [(ngModel)]="selectedOrderStatus"
              (change)="updateOrderStatus()"
              [disabled]="loading">
              <option *ngFor="let s of orderStatusOptions" [ngValue]="s">{{ translateOrderStatus(s) }}</option>
            </select>
          </div>
          <!-- Estado Pago -->
          <div>
            <label class="text-xs font-medium text-gray-600 block mb-1">Estado de Pago</label>
            <select
              class="w-full text-sm border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#800020] focus:border-transparent bg-white"
              [(ngModel)]="selectedPaymentStatus"
              (change)="updatePaymentStatus()"
              [disabled]="loading">
              <option *ngFor="let s of paymentStatusOptions" [ngValue]="s">{{ translatePaymentStatus(s) }}</option>
            </select>
          </div>
          <!-- Estado Envío -->
          <div>
            <label class="text-xs font-medium text-gray-600 block mb-1">Estado de Envío</label>
            <select
              class="w-full text-sm border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#800020] focus:border-transparent bg-white"
              [(ngModel)]="selectedShippingStatus"
              (change)="updateShippingStatus()"
              [disabled]="loading">
              <option *ngFor="let s of shippingStatusOptions" [ngValue]="s">{{ translateShippingStatus(s) }}</option>
            </select>
          </div>
        </div>
        <!-- Tracking -->
        <div>
          <label class="text-xs font-medium text-gray-600 block mb-1">
            <i class="fa-solid fa-truck text-gray-400 mr-1"></i>
            Número de Rastreo
          </label>
          <div class="flex gap-2">
            <input
              type="text"
              class="flex-1 text-sm border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#800020] focus:border-transparent"
              [(ngModel)]="trackingNumber"
              placeholder="Ingresa el número de rastreo..."
              [disabled]="loading" />
            <button
              (click)="updateShippingStatus()"
              [disabled]="loading || trackingNumber === (order.trackingNumber || '')"
              class="px-4 py-2 bg-[#800020] hover:bg-[#6a001a] disabled:bg-gray-300 disabled:cursor-not-allowed text-white text-sm font-semibold rounded-lg transition-colors flex items-center gap-1.5">
              <i class="fa-solid fa-floppy-disk text-xs"></i>
              Guardar
            </button>
          </div>
        </div>
      </div>

      <!-- SECCIÓN: REVISIÓN DE COMPROBANTE DE PAGO -->
      <div class="bg-gray-50 rounded-xl border border-gray-200 p-4" *ngIf="order.paymentMethod === 'BANK_TRANSFER' || order.paymentMethod === 'TRANSFER'">
        <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
          <i class="fa-solid fa-file-invoice-dollar text-[#C5A059]"></i>
          Comprobante de Pago
        </h3>

        <!-- Loading -->
        <div *ngIf="proofLoading" class="flex justify-center p-4">
          <div class="w-6 h-6 border-2 border-gray-200 border-t-[#800020] rounded-full animate-spin"></div>
        </div>

        <div *ngIf="!proofLoading">
          <!-- Sin comprobante -->
          <div *ngIf="!order.hasPaymentProof" class="text-sm text-gray-500 italic bg-white p-3 rounded border border-dashed border-gray-300 text-center">
            El cliente aún no ha subido comprobante.
          </div>

          <!-- Con comprobante -->
          <div *ngIf="order.hasPaymentProof && proofMetadata">
            <!-- PENDING_REVIEW -->
            <div *ngIf="order.paymentProofStatus === 'PENDING_REVIEW'" class="space-y-4">
              <div class="flex items-start gap-2 p-3 bg-amber-50 border border-amber-200 rounded-lg text-amber-800 text-sm">
                <i class="fa-solid fa-circle-exclamation mt-0.5"></i>
                <p><strong>Comprobante en revisión.</strong> Revisa los datos y aprueba o rechaza el pago.</p>
              </div>
              
              <div class="grid grid-cols-2 gap-y-2 text-sm bg-white p-3 border border-gray-200 rounded-lg">
                <div class="text-gray-500">Subido el:</div><div class="font-medium text-gray-800">{{ orderService.formatDate(proofMetadata.uploadedAt) }}</div>
                <div class="text-gray-500">Banco:</div><div class="font-medium text-gray-800">{{ proofMetadata.bankName || 'No especificado' }}</div>
                <div class="text-gray-500">Referencia:</div><div class="font-medium text-gray-800">{{ proofMetadata.referenceNumber || 'No especificado' }}</div>
                <div class="text-gray-500">Monto reportado:</div><div class="font-medium text-gray-800">{{ proofMetadata.amountDeclared ? orderService.formatCurrency(proofMetadata.amountDeclared) : 'No especificado' }}</div>
                <div class="text-gray-500">Fecha transferencia:</div><div class="font-medium text-gray-800">{{ proofMetadata.transferDate || 'No especificada' }}</div>
                <div class="text-gray-500">Notas:</div><div class="font-medium text-gray-800 col-span-2 italic text-xs">{{ proofMetadata.notes || 'Sin notas' }}</div>
              </div>

              <div class="flex flex-wrap gap-2">
                <button (click)="viewProof()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 text-sm font-semibold rounded-lg transition-colors flex items-center gap-1.5 border border-gray-300">
                  <i class="fa-solid fa-eye text-xs"></i> Ver archivo
                </button>
                <ng-container *ngIf="canManagePayments(); else noManagePermissions">
                  <button (click)="approveProof()" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded-lg transition-colors flex items-center gap-1.5">
                    <i class="fa-solid fa-check text-xs"></i> Aprobar pago
                  </button>
                  <button (click)="rejectProof()" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold rounded-lg transition-colors flex items-center gap-1.5">
                    <i class="fa-solid fa-xmark text-xs"></i> Rechazar
                  </button>
                </ng-container>
                <ng-template #noManagePermissions>
                  <div class="px-4 py-2 text-red-600 bg-red-50 border border-red-100 rounded-lg text-sm italic">
                    <i class="fa-solid fa-lock text-xs mr-1"></i> No tienes permisos para aprobar o rechazar comprobantes de pago.
                  </div>
                </ng-template>
              </div>
            </div>

            <!-- APPROVED -->
            <div *ngIf="order.paymentProofStatus === 'APPROVED'" class="space-y-3">
              <div class="flex items-center gap-2 p-3 bg-green-50 border border-green-200 rounded-lg text-green-800 text-sm">
                <i class="fa-solid fa-circle-check"></i>
                <p><strong>Comprobante aprobado.</strong> El pago ha sido confirmado.</p>
              </div>
              <p class="text-xs text-gray-500">Aprobado el: {{ proofMetadata.reviewedAt ? orderService.formatDate(proofMetadata.reviewedAt) : '---' }}</p>
              <button (click)="viewProof()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 text-sm font-semibold rounded-lg transition-colors flex items-center gap-1.5 border border-gray-300 w-fit">
                <i class="fa-solid fa-eye text-xs"></i> Ver archivo
              </button>
            </div>

            <!-- REJECTED -->
            <div *ngIf="order.paymentProofStatus === 'REJECTED'" class="space-y-3">
              <div class="flex items-start gap-2 p-3 bg-red-50 border border-red-200 rounded-lg text-red-800 text-sm">
                <i class="fa-solid fa-circle-xmark mt-0.5"></i>
                <div>
                  <p><strong>Comprobante rechazado.</strong></p>
                  <p class="text-xs mt-1">Motivo: {{ proofMetadata.rejectionReason }}</p>
                </div>
              </div>
              <p class="text-xs text-gray-500">Rechazado el: {{ proofMetadata.reviewedAt ? orderService.formatDate(proofMetadata.reviewedAt) : '---' }}</p>
              <button (click)="viewProof()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 text-sm font-semibold rounded-lg transition-colors flex items-center gap-1.5 border border-gray-300 w-fit">
                <i class="fa-solid fa-eye text-xs"></i> Ver archivo rechazado
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- SECCIN: PRODUCTOS -->
      <div class="bg-gray-50 rounded-xl border border-gray-200 p-4">
        <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
          <i class="fa-solid fa-cart-shopping text-[#C5A059]"></i>
          Artculos de la Orden
          <span class="ml-1 bg-gray-200 text-gray-600 text-xs font-bold px-1.5 py-0.5 rounded-full">{{ calculateItemsTotal() }}</span>
        </h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left text-xs font-semibold text-gray-500 pb-2 min-w-[200px]">Producto</th>
                <th class="text-left text-xs font-semibold text-gray-500 pb-2 hidden sm:table-cell whitespace-nowrap">SKU</th>
                <th class="text-center text-xs font-semibold text-gray-500 pb-2 whitespace-nowrap">Cant.</th>
                <th class="text-right text-xs font-semibold text-gray-500 pb-2 whitespace-nowrap">Precio</th>
                <th class="text-right text-xs font-semibold text-gray-500 pb-2 whitespace-nowrap">Total</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <tr *ngFor="let item of order.items" class="hover:bg-white/70">
                <td class="py-2.5 pr-3 min-w-[200px]">
                  <div class="flex items-center gap-2.5">
                    <img *ngIf="item.productImage"
                      [src]="item.productImage"
                      [alt]="item.productName"
                      class="w-10 h-10 min-w-[40px] rounded-lg object-cover border border-gray-200 flex-shrink-0"
                      (error)="$any($event.target).src='assets/icons/placeholder.png'" />
                    <div *ngIf="!item.productImage"
                      class="w-10 h-10 min-w-[40px] rounded-lg bg-gray-200 flex items-center justify-center flex-shrink-0">
                      <i class="fa-solid fa-image text-gray-400 text-sm"></i>
                    </div>
                    <span class="font-medium text-gray-800 text-sm leading-snug">{{ item.productName }}</span>
                  </div>
                </td>
                <td class="py-2.5 pr-3 hidden sm:table-cell">
                  <span class="text-xs text-gray-500 font-mono">{{ item.productSku }}</span>
                </td>
                <td class="py-2.5 text-center">
                  <span class="inline-block bg-gray-200 text-gray-700 text-xs font-bold px-2 py-0.5 rounded-full">{{ item.quantity }}</span>
                </td>
                <td class="py-2.5 text-right text-sm text-gray-600">{{ orderService.formatCurrency(item.price) }}</td>
                <td class="py-2.5 text-right text-sm font-semibold text-gray-800">{{ orderService.formatCurrency(item.subtotal) }}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Totales -->
        <div class="mt-4 pt-3 border-t border-gray-200 space-y-1.5">
          <div class="flex justify-between text-sm text-gray-600">
            <span>Subtotal</span>
            <span>{{ orderService.formatCurrency(order.subtotal) }}</span>
          </div>
          <div class="flex justify-between text-sm text-gray-600" *ngIf="order.shipping > 0">
            <span>Env�o</span>
            <span>{{ orderService.formatCurrency(order.shipping) }}</span>
          </div>
          <div class="flex justify-between text-sm text-gray-600" *ngIf="order.tax > 0">
            <span>Impuestos</span>
            <span>{{ orderService.formatCurrency(order.tax) }}</span>
          </div>
          <div class="flex justify-between text-sm text-green-600 font-medium" *ngIf="order.discount > 0">
            <span>Descuento</span>
            <span>-{{ orderService.formatCurrency(order.discount) }}</span>
          </div>
          <div class="flex justify-between text-base font-extrabold text-[#800020] pt-2 border-t border-gray-200 mt-1">
            <span>Total</span>
            <span>{{ orderService.formatCurrency(order.total) }}</span>
          </div>
        </div>
      </div>

      <!-- SECCI�N: TIMELINE (condicional) -->
      <div *ngIf="order.shippedAt || order.deliveredAt || order.cancelledAt"
        class="bg-gray-50 rounded-xl border border-gray-200 p-4">
        <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
          <i class="fa-solid fa-timeline text-[#C5A059]"></i>
          Historial de Eventos
        </h3>
        <div class="space-y-3">
          <div *ngIf="order.shippedAt" class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center flex-shrink-0">
              <i class="fa-solid fa-truck text-blue-500 text-xs"></i>
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-700">Enviado</p>
              <p class="text-xs text-gray-500">{{ orderService.formatDate(order.shippedAt) }}</p>
            </div>
          </div>
          <div *ngIf="order.deliveredAt" class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0">
              <i class="fa-solid fa-circle-check text-green-500 text-xs"></i>
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-700">Entregado</p>
              <p class="text-xs text-gray-500">{{ orderService.formatDate(order.deliveredAt) }}</p>
            </div>
          </div>
          <div *ngIf="order.cancelledAt" class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
              <i class="fa-solid fa-ban text-[#800020] text-xs"></i>
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-700">Cancelado</p>
              <p class="text-xs text-gray-500">{{ orderService.formatDate(order.cancelledAt) }}</p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- FOOTER -->
    <div class="flex justify-end px-6 py-4 border-t border-gray-100 bg-gray-50 rounded-b-2xl flex-shrink-0">
      <button (click)="closeModal()"
        class="flex items-center gap-2 px-5 py-2 bg-gray-700 hover:bg-gray-800 text-white text-sm font-semibold rounded-lg transition-colors">
        <i class="fa-solid fa-xmark text-xs"></i>
        Cerrar
      </button>
    </div>

  </div>
</div>

<!-- VISOR PROFESIONAL DE COMPROBANTE (ADMIN) -->
<div class="fixed inset-0 bg-black/70 z-[2000] flex items-center justify-center p-4 backdrop-blur-sm" *ngIf="showProofPreviewModal" (click)="closeProofPreview()">
  <div class="bg-white rounded-2xl w-full max-w-4xl shadow-2xl flex flex-col overflow-hidden max-h-[90vh]" (click)="$event.stopPropagation()">
    
    <!-- HEADER -->
    <div class="flex items-center justify-between px-6 py-4 bg-gray-50 border-b border-gray-200">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-[#f0e6e7] flex items-center justify-center">
          <i class="fa-solid fa-file-invoice text-[#722f37] text-lg"></i>
        </div>
        <div>
          <h3 class="text-lg font-bold text-gray-800 leading-tight">Visor de comprobante</h3>
          <p class="text-xs text-gray-500 font-mono">Pedido #{{ proofPreviewOrderNumber }}</p>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider" [ngClass]="{
          'bg-amber-100 text-amber-800 border border-amber-200': proofPreviewStatus === 'PENDING_REVIEW',
          'bg-green-100 text-green-800 border border-green-200': proofPreviewStatus === 'APPROVED',
          'bg-red-100 text-red-800 border border-red-200': proofPreviewStatus === 'REJECTED'
        }">
          {{ proofPreviewStatus === 'PENDING_REVIEW' ? 'EN REVISIÓN' : (proofPreviewStatus === 'APPROVED' ? 'APROBADO' : 'RECHAZADO') }}
        </span>
        <button (click)="closeProofPreview()" class="w-8 h-8 flex items-center justify-center rounded-full text-gray-400 hover:text-gray-700 hover:bg-gray-200 transition-colors">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>
    </div>

    <!-- BODY -->
    <div class="relative bg-gray-200 flex-1 min-h-[400px] flex items-center justify-center overflow-hidden p-2">
      <div *ngIf="loadingProofPreview" class="absolute inset-0 bg-white/80 flex flex-col items-center justify-center z-10 backdrop-blur-sm">
        <div class="w-10 h-10 border-4 border-gray-200 border-t-[#722f37] rounded-full animate-spin mb-3"></div>
        <p class="text-sm font-medium text-gray-600">Cargando comprobante...</p>
      </div>
      
      <div *ngIf="!loadingProofPreview && proofPreviewError" class="bg-white p-6 rounded-xl shadow-sm text-center max-w-md">
        <i class="fa-solid fa-circle-exclamation text-red-500 text-4xl mb-3"></i>
        <p class="text-red-600 font-medium">{{ proofPreviewError }}</p>
      </div>

      <div *ngIf="!loadingProofPreview && !proofPreviewError && proofPreviewSafeUrl" class="w-full h-full flex items-center justify-center">
        <canvas *ngIf="proofPreviewContentType === 'application/pdf'" #pdfCanvas class="bg-white rounded shadow-sm max-w-full" style="border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);"></canvas>
        <img *ngIf="proofPreviewContentType?.startsWith('image/')" [src]="proofPreviewSafeUrl" alt="Comprobante" class="max-w-full max-h-[75vh] object-contain rounded shadow-md bg-white">
      </div>
    </div>

    <!-- FOOTER -->
    <div class="px-6 py-4 border-t border-gray-200 bg-white flex items-center justify-between">
      <div class="flex items-center gap-2 text-gray-600 font-mono text-sm">
        <i class="fa-regular fa-file"></i>
        {{ proofPreviewFilename }}
      </div>
      <div class="flex items-center gap-3">
        <button (click)="openProofInNewTab()" [disabled]="!proofPreviewUrl" class="px-4 py-2 border border-[#722f37] text-[#722f37] rounded-lg hover:bg-red-50 font-semibold text-sm transition-colors flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
          <i class="fa-solid fa-arrow-up-right-from-square"></i> Abrir en nueva pestaña
        </button>
        <button (click)="downloadProof()" [disabled]="!proofPreviewUrl" class="px-5 py-2 bg-[#722f37] text-white rounded-lg hover:bg-[#5a252b] font-semibold text-sm transition-colors flex items-center gap-2 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
          <i class="fa-solid fa-download"></i> Descargar comprobante
        </button>
      </div>
    </div>

  </div>
</div>
