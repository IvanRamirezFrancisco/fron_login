<file path="src/app/styles/security.css">
/* Estilos de seguridad para indicadores visuales */

.invalid-input {
  border-color: var(--color-error) !important;
  background-color: rgba(248, 113, 113, 0.1) !important;
  animation: shake 0.3s ease-in-out;
}

.valid-input {
  border-color: var(--color-exito) !important;
  background-color: rgba(34, 197, 94, 0.1) !important;
}

.security-warning {
  background: linear-gradient(45deg, #fef3c7, #fde68a);
  border: 1px solid #f59e0b;
  color: #92400e;
  padding: 0.75rem 1rem;
  border-radius: var(--border-radius-lg);
  margin: 0.5rem 0;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  animation: pulse-warning 2s infinite;
}

.security-error {
  background: linear-gradient(45deg, #fef2f2, #fee2e2);
  border: 1px solid #ef4444;
  color: #dc2626;
  padding: 0.75rem 1rem;
  border-radius: var(--border-radius-lg);
  margin: 0.5rem 0;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  animation: pulse-error 1s ease-in-out;
}

.security-success {
  background: linear-gradient(45deg, #f0fdf4, #dcfce7);
  border: 1px solid #22c55e;
  color: #16a34a;
  padding: 0.75rem 1rem;
  border-radius: var(--border-radius-lg);
  margin: 0.5rem 0;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
}

/* Animaciones para indicadores de seguridad */
@keyframes shake {
  0%, 20%, 50%, 80%, 100% { transform: translateX(0); }
  10% { transform: translateX(-5px); }
  30% { transform: translateX(5px); }
  60% { transform: translateX(-3px); }
  90% { transform: translateX(3px); }
}

@keyframes pulse-warning {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.8; }
}

@keyframes pulse-error {
  0% { transform: scale(1); }
  50% { transform: scale(1.02); }
  100% { transform: scale(1); }
}

/* Indicador de entrada segura */
.secure-input-indicator {
  position: absolute;
  right: 8px;
  top: 50%;
  transform: translateY(-50%);
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: bold;
  transition: all 0.2s ease;
}

.secure-input-indicator.safe {
  background: var(--color-exito);
  color: white;
}

.secure-input-indicator.unsafe {
  background: var(--color-error);
  color: white;
  animation: pulse-error 1s ease-in-out infinite;
}

/* Tooltip de seguridad */
.security-tooltip {
  position: absolute;
  top: -35px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.8);
  color: white;
  padding: 0.5rem 0.75rem;
  border-radius: 6px;
  font-size: 0.75rem;
  white-space: nowrap;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.2s ease;
}

.security-tooltip.show {
  opacity: 1;
  visibility: visible;
}

.security-tooltip::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  border: 5px solid transparent;
  border-top-color: rgba(0, 0, 0, 0.8);
}

/* Indicador de nivel de seguridad */
.security-level-indicator {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.5rem;
  font-size: 0.75rem;
}

.security-level-bar {
  flex: 1;
  height: 4px;
  background: #e5e7eb;
  border-radius: 2px;
  overflow: hidden;
}

.security-level-fill {
  height: 100%;
  transition: width 0.3s ease, background-color 0.3s ease;
  border-radius: 2px;
}

.security-level-fill.low {
  background: var(--color-error);
  width: 25%;
}

.security-level-fill.medium {
  background: #f59e0b;
  width: 50%;
}

.security-level-fill.high {
  background: var(--color-exito);
  width: 75%;
}

.security-level-fill.very-high {
  background: #059669;
  width: 100%;
}

/* Botón con protección XSS */
.btn-protected {
  position: relative;
  overflow: hidden;
}

.btn-protected::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
  transition: left 0.5s ease;
}

.btn-protected:hover::before {
  left: 100%;
}

/* Indicador de contenido sanitizado */
.sanitized-content {
  position: relative;
}

.sanitized-content::after {
  content: '🛡️';
  position: absolute;
  top: 4px;
  right: 4px;
  font-size: 10px;
  opacity: 0.5;
  pointer-events: none;
}

/* Modo seguro activado */
.safe-mode-active {
  border: 2px solid var(--color-exito);
  background: rgba(34, 197, 94, 0.05);
}

.safe-mode-active::before {
  content: 'Modo Seguro';
  position: absolute;
  top: -10px;
  left: 10px;
  background: var(--color-exito);
  color: white;
  padding: 2px 6px;
  border-radius: 3px;
  font-size: 10px;
  font-weight: bold;
}

/* Responsividad para indicadores de seguridad */
@media (max-width: 576px) {
  .security-warning,
  .security-error,
  .security-success {
    font-size: 0.8rem;
    padding: 0.5rem 0.75rem;
  }
  
  .security-tooltip {
    font-size: 0.7rem;
    padding: 0.375rem 0.5rem;
  }
  
  .security-level-indicator {
    font-size: 0.7rem;
  }
}
</file>

