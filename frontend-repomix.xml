@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
:host { font-family: 'Inter', sans-serif; }

.orders-page {
  --wine: #722f37; --wine-dark: #5a2029;
  --gray-50: #f9fafb; --gray-100: #f3f4f6; --gray-200: #e5e7eb;
  --gray-600: #4b5563; --gray-700: #374151; --gray-800: #1f2937;
  --radius: 12px; --shadow-sm: 0 1px 3px rgba(0,0,0,.08); --shadow-md: 0 4px 12px rgba(0,0,0,.1);
}

.orders-page { min-height: 100vh; background: var(--gray-50); }
.container { max-width: 960px; margin: 0 auto; padding: 0 1.5rem; }

.orders-header {
  background: #ffffff;
  border-bottom: 1px solid var(--gray-200);
  padding: 1.5rem 0 1rem;
}
.breadcrumb { display: flex; align-items: center; gap: .5rem; font-size: .85rem; color: var(--gray-500, #6b7280); margin-bottom: 1rem; }
.breadcrumb-link { color: var(--gray-700, #374151); text-decoration: none; display: flex; align-items: center; gap: .25rem; font-weight: 500; }
.breadcrumb-link:hover { color: var(--wine); }
.breadcrumb .material-icons { font-size: 1.1rem; color: var(--gray-400, #9ca3af); }
.breadcrumb-current { color: var(--wine); font-weight: 600; }
.page-title { font-size: 1.75rem; font-weight: 700; display: flex; align-items: center; gap: .5rem; margin: 0; color: var(--gray-900, #111827); }

.orders-body { padding: 2rem 1.5rem; }

/* State */
.state-center { text-align: center; padding: 4rem 1rem; }
.state-icon { font-size: 4rem; display: block; margin: 0 auto 1rem; opacity: .45; }
.empty-icon { color: var(--wine); }
.error-icon { color: #ef4444; }
.state-center h2 { font-size: 1.4rem; color: var(--gray-800); margin: 0 0 .5rem; }
.state-center p { color: var(--gray-600); margin-bottom: 1.5rem; }

.spinner-large {
  width: 44px; height: 44px; margin: 0 auto 1rem;
  border: 4px solid var(--gray-200); border-top-color: var(--wine);
  border-radius: 50%; animation: spin .8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.btn-retry, .btn-primary {
  display: inline-flex; align-items: center; gap: .5rem;
  background: var(--wine); color: #fff; border: none; border-radius: 8px;
  padding: .7rem 1.4rem; font-weight: 600; cursor: pointer;
  text-decoration: none; transition: background .2s; font-size: .9rem;
}
.btn-retry:hover, .btn-primary:hover { background: var(--wine-dark); }

.results-count { color: var(--gray-600); font-size: .875rem; margin-bottom: 1.25rem; }

/* Order cards */
.orders-list { display: flex; flex-direction: column; gap: 1rem; }

.order-card {
  background: #fff; border-radius: var(--radius);
  box-shadow: var(--shadow-sm); border: 1px solid var(--gray-200);
  overflow: hidden; transition: box-shadow .2s;
}
.order-card:hover { box-shadow: var(--shadow-md); }

.order-card-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 1rem 1.25rem;
  background: linear-gradient(135deg, var(--gray-50), #fff);
  border-bottom: 1px solid var(--gray-200);
}

.order-number-section { display: flex; flex-direction: column; }
.order-label { font-size: .75rem; color: var(--gray-600); font-weight: 500; text-transform: uppercase; letter-spacing: .05em; }
.order-number { font-size: 1rem; font-weight: 700; color: var(--gray-800); }

.order-meta { display: flex; align-items: center; }
.order-date { display: flex; align-items: center; gap: .35rem; font-size: .85rem; color: var(--gray-600); }
.order-date .material-icons { font-size: .95rem; }

.order-card-body { padding: 1.25rem; }

/* Badges */
.status-badges { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1rem; }

.badge {
  display: inline-flex; align-items: center; gap: .3rem;
  padding: .3rem .75rem; border-radius: 999px; font-size: .78rem; font-weight: 600;
}
.badge .material-icons { font-size: .9rem; }

.badge-amber { background: #fffbeb; color: #92400e; border: 1px solid #fde68a; }
.badge-blue { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
.badge-indigo { background: #eef2ff; color: #3730a3; border: 1px solid #c7d2fe; }
.badge-green { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
.badge-red { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
.badge-gray { background: var(--gray-100); color: var(--gray-700); border: 1px solid var(--gray-200); }
.badge-ship { background: #f5f3ff; color: #5b21b6; border: 1px solid #ddd6fe; }

/* Summary row */
.order-summary-row { display: flex; gap: 2rem; flex-wrap: wrap; }
.summary-stat { display: flex; flex-direction: column; gap: .2rem; }
.stat-label { font-size: .75rem; color: var(--gray-600); text-transform: uppercase; letter-spacing: .04em; }
.stat-value { font-size: .95rem; font-weight: 600; color: var(--gray-800); }
.total-highlight { color: var(--wine); font-size: 1.05rem; }
.payment-method { font-size: .85rem; }

/* Footer */
.order-card-footer {
  display: flex; justify-content: space-between; align-items: center;
  padding: .9rem 1.25rem;
  border-top: 1px solid var(--gray-200);
  background: var(--gray-50);
}

.btn-view-detail {
  display: inline-flex; align-items: center; gap: .4rem;
  background-color: var(--wine); color: #fff !important; border: none; border-radius: 8px;
  padding: .55rem 1.1rem; font-weight: 600; font-size: .875rem;
  cursor: pointer; text-decoration: none; transition: background .2s;
}
.btn-view-detail:hover { background: var(--wine-dark); }
.btn-view-detail .material-icons { font-size: 1rem; }

.cancel-hint { display: flex; align-items: center; gap: .3rem; font-size: .8rem; color: #ef4444; }
.cancel-hint .material-icons { font-size: 1rem; }

/* Pagination */
.pagination { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 2rem; }
.page-btn {
  display: flex; align-items: center; justify-content: center;
  width: 36px; height: 36px; border: 1.5px solid var(--gray-200);
  border-radius: 8px; background: #fff; cursor: pointer; transition: all .2s;
}
.page-btn:hover:not(:disabled) { border-color: var(--wine); color: var(--wine); }
.page-btn:disabled { opacity: .4; cursor: not-allowed; }
.page-info { font-size: .9rem; color: var(--gray-700); }

@media (max-width: 600px) {
  .orders-body { padding: 1rem; }
  .order-summary-row { gap: 1rem; }
  .order-card-header { flex-direction: column; align-items: flex-start; gap: .5rem; }
}
