<!-- MODAL PROFESIONAL CON SISTEMA DE TABS/PESTAÑAS -->
<div class="modal-overlay" *ngIf="showCreateModal || showEditModal" (click)="closeModal()">
  <div class="modal-content modal-large-tabs" (click)="$event.stopPropagation()">
    
    <!-- Header del Modal -->
    <div class="modal-header">
      <div class="modal-header-content">
        <span class="material-icons modal-icon">{{ showCreateModal ? 'add_shopping_cart' : 'edit' }}</span>
        <div>
          <h2>{{ showCreateModal ? '🆕 Nuevo Producto' : '✏️ Editar Producto' }}</h2>
          <p class="modal-subtitle">Complete los campos por sección para registrar el producto</p>
        </div>
      </div>
      <button class="modal-close" (click)="closeModal()">
        <span class="material-icons">close</span>
      </button>
    </div>

    <!-- Sistema de Tabs Profesional -->
    <div class="tabs-container">
      <div class="tabs-header">
        <button 
          class="tab-btn" 
          [class.active]="currentTab === 'general'"
          (click)="setTab('general')">
          <span class="material-icons">info</span>
          <span class="tab-label">
            <span class="tab-title">Información General</span>
            <span class="tab-subtitle">Datos básicos del producto</span>
          </span>
          <span class="tab-indicator"></span>
        </button>
        
        <button 
          class="tab-btn" 
          [class.active]="currentTab === 'pricing'"
          (click)="setTab('pricing')">
          <span class="material-icons">attach_money</span>
          <span class="tab-label">
            <span class="tab-title">Precios e Inventario</span>
            <span class="tab-subtitle">Precio y stock</span>
          </span>
          <span class="tab-indicator"></span>
        </button>
        
        <button 
          class="tab-btn" 
          [class.active]="currentTab === 'media'"
