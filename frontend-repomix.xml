  justify-content: space-between;
  gap: 0.75rem;
  margin-top: 0.5rem;
  padding: 0.5rem 0.75rem;
  font-size: 0.85rem;
  color: #6b7280;
  background: #f9fafb;
  border-radius: 6px;
  border: 1px solid #e5e7eb;
}

.input-help-counter span {
  display: flex;
  align-items: center;
  gap: 0.5rem;
