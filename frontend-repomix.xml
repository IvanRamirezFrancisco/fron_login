/* ════════════════════════════════════════════════════════════════════════════
   Admin DB Management — Estilos del contenedor padre con Tabs
   Paleta: #722f37 (burgundy) · #C5A059 (dorado antiguo) · grises neutros
   ════════════════════════════════════════════════════════════════════════════ */

:host { display: block; }

/* ── Contenedor raíz ────────────────────────────────────────────────────── */
.dbm-root {
  min-height: 100%;
  background: #f5f0eb;
  font-family: 'Poppins', 'Segoe UI', sans-serif;
  display: flex;
  flex-direction: column;
}

/* ════════════════════════════════════════════════════════════════════════════
   BARRA DE TABS
   ════════════════════════════════════════════════════════════════════════════ */
.dbm-tabs {
  display: flex;
  align-items: flex-end;
  gap: 0;
  background: #FDFCFB;
  border-bottom: 1px solid #e5e7eb;
  padding: 0 2rem;          /* coincide con el padding del topbar */
  position: sticky;
  top: var(--topbar-height, 57px); /* se pega justo debajo del admin-topbar */
  z-index: 20;
  /* Sin box-shadow propio — el topbar ya da la separación visual */
}

.dbm-tab {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  padding: .9rem 1.1rem .85rem;
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  font-family: 'Poppins', sans-serif;
  font-size: .82rem;
  font-weight: 500;
  color: #6b7280;
  cursor: pointer;
  white-space: nowrap;
  transition: color .18s, border-color .18s;
  position: relative;
  margin-bottom: -1px; /* solapa con el border del nav */
}

.dbm-tab:hover {
  color: #374151;
}

.dbm-tab--active {
  color: #1A1A1A;
  border-bottom-color: #C5A059;
  font-weight: 700;
}

.dbm-tab__icon {
  font-size: 1.05rem;
  transition: color .18s;
}

.dbm-tab--active .dbm-tab__icon {
  color: #C5A059;
}

.dbm-tab__label {
  letter-spacing: .01em;
}

/* ── Responsive: scroll horizontal en móvil ─────────────────────────────── */
@media (max-width: 640px) {
  .dbm-tabs {
    overflow-x: auto;
    padding: 0 .75rem;
    gap: 0;
  }
  .dbm-tab {
    padding: .8rem .85rem .75rem;
    font-size: .78rem;
  }
}

/* ════════════════════════════════════════════════════════════════════════════
   ÁREA DE CONTENIDO
   ════════════════════════════════════════════════════════════════════════════ */
.dbm-content {
  flex: 1;
  background: #f5f0eb;
  animation: tabFadeIn .2s ease;
}

/* El componente de backups no tiene padding propio al estar embebido en el tab.
   Se lo damos aquí para alinearlo con el resto de pestañas. */
.dbm-content app-admin-backups {
  display: block;
  padding: 1.75rem 2rem 3rem;
  max-width: 1280px;
}

@keyframes tabFadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}
