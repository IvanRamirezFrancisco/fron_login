/* ════════════════════════════════════════════════════════════════════════════
   Shared Tab Styles — Monitoreo / Mantenimiento / Consultas Lentas
   Todas las clases base (.tab-root, .tab-header, .callout, .section-card,
   .tab-table, .metrics-grid, .metric-card, etc.) se definen aquí.
   ════════════════════════════════════════════════════════════════════════════ */

:host { display: block; font-family: 'Poppins', 'Segoe UI', sans-serif; }

/* ── Contenedor raíz del tab ─────────────────────────────────────────────── */
.tab-root {
  padding: 1.75rem 2rem 3rem;   /* 2rem lateral = alineado con topbar y tab-bar */
  max-width: 1280px;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

/* ════════════════════════════════════════════════════════════════════════════
   ENCABEZADO DEL TAB
   ════════════════════════════════════════════════════════════════════════════ */
.tab-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
}
.tab-header__left {
  display: flex;
  align-items: center;
  gap: 1rem;
}
.tab-header__icon {
  width: 48px; height: 48px;
  border-radius: 14px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.tab-header__icon .material-icons { font-size: 1.5rem; color: #fff; }

/* Variantes de color del icono */
.tab-header__icon--teal   { background: linear-gradient(135deg, #0f766e, #0d9488); }
.tab-header__icon--orange { background: linear-gradient(135deg, #c2410c, #ea580c); }
.tab-header__icon--red    { background: linear-gradient(135deg, #9f1239, #e11d48); }

.tab-header__title {
  margin: 0 0 .2rem;
  font-size: 1.2rem;
  font-weight: 700;
  color: #111827;
}
.tab-header__sub {
  margin: 0;
  font-size: .82rem;
  color: #6b7280;
}
.tab-header__sub code {
  background: #f3f4f6;
  padding: .1em .4em;
  border-radius: 4px;
  font-size: .78rem;
  color: #722f37;
}

/* Badge "Próximamente" */
.soon-badge {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  padding: .3rem .85rem;
  background: #fef3c7;
  color: #92400e;
  border: 1px solid #fde68a;
  border-radius: 20px;
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .05em;
  text-transform: uppercase;
  white-space: nowrap;
}

/* ════════════════════════════════════════════════════════════════════════════
   CALLOUT INFORMATIVO
   ════════════════════════════════════════════════════════════════════════════ */
.callout {
  display: flex;
  align-items: flex-start;
  gap: .9rem;
  padding: 1rem 1.25rem;
  border-radius: 12px;
  border-left: 4px solid;
  font-size: .83rem;
  line-height: 1.55;
}
.callout .material-icons { font-size: 1.2rem; flex-shrink: 0; margin-top: .1rem; }
.callout strong { display: block; font-weight: 700; margin-bottom: .2rem; }
.callout span { color: inherit; opacity: .85; }
.callout code {
  background: rgba(0,0,0,.06);
  padding: .1em .4em;
  border-radius: 4px;
  font-size: .78rem;
  font-weight: 600;
}

.callout--blue   { background: #eff6ff; border-color: #3b82f6; color: #1e40af; }
.callout--amber  { background: #fffbeb; border-color: #f59e0b; color: #92400e; }
.callout--red    { background: #fff1f2; border-color: #e11d48; color: #9f1239; }

/* ════════════════════════════════════════════════════════════════════════════
   GRID DE MÉTRICAS
   ════════════════════════════════════════════════════════════════════════════ */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1rem;
}

.metric-card {
  background: #FDFCFB;
  border-radius: 14px;
  border: 1px solid #e5e7eb;
  padding: 1.25rem;
  display: flex;
  align-items: flex-start;
  gap: .9rem;
  position: relative;
  overflow: hidden;
  box-shadow: 0 1px 6px rgba(0,0,0,.05);
  transition: box-shadow .18s;
}
.metric-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.09); }

.metric-card__icon {
  width: 40px; height: 40px;
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.metric-card__icon .material-icons { font-size: 1.3rem; color: #fff; }

.metric-card--blue   .metric-card__icon { background: linear-gradient(135deg,#1d4ed8,#3b82f6); }
.metric-card--green  .metric-card__icon { background: linear-gradient(135deg,#15803d,#22c55e); }
.metric-card--amber  .metric-card__icon { background: linear-gradient(135deg,#b45309,#f59e0b); }
.metric-card--slate  .metric-card__icon { background: linear-gradient(135deg,#334155,#64748b); }
.metric-card--red    .metric-card__icon { background: linear-gradient(135deg,#9f1239,#e11d48); }

.metric-card__label {
  margin: 0 0 .2rem;
  font-size: .74rem;
  font-weight: 600;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: .05em;
}
.metric-card__value {
  margin: 0 0 .2rem;
  font-size: 1.55rem;
  font-weight: 800;
  color: #111827;
  line-height: 1.1;
}
.metric-card__hint {
  margin: 0;
  font-size: .68rem;
  color: #9ca3af;
  font-family: 'Courier New', monospace;
}

/* Overlay "pendiente" */
.metric-card__overlay {
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,.82);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: .4rem;
  font-size: .73rem;
  font-weight: 600;
  color: #6b7280;
  backdrop-filter: blur(2px);
  border-radius: 14px;
}
.metric-card__overlay .material-icons { font-size: 1.4rem; color: #9ca3af; }

/* ════════════════════════════════════════════════════════════════════════════
   TARJETA DE SECCIÓN (tabla envuelta)
   ════════════════════════════════════════════════════════════════════════════ */
.section-card {
  background: #FDFCFB;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 1px 8px rgba(0,0,0,.05);
}
.section-card__header {
  display: flex;
  align-items: center;
  gap: .7rem;
  padding: 1.1rem 1.4rem;
  border-bottom: 1px solid #f3f4f6;
  background: #FAF8F6;
}
.section-card__header .material-icons { font-size: 1.1rem; color: #6b7280; }
.section-card__header h3 {
  margin: 0;
  font-size: .9rem;
  font-weight: 700;
  color: #111827;
}

/* ════════════════════════════════════════════════════════════════════════════
   TABLA GENÉRICA DE TABS
   ════════════════════════════════════════════════════════════════════════════ */
.table-wrap { overflow-x: auto; }

.tab-table {
  width: 100%;
  border-collapse: collapse;
  font-size: .83rem;
}
.tab-table thead { background: #f9fafb; }
.tab-table th {
  padding: .75rem 1rem;
  text-align: left;
  font-size: .7rem;
  font-weight: 700;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: .06em;
  border-bottom: 1px solid #e5e7eb;
  white-space: nowrap;
}
.tab-table td {
  padding: .85rem 1rem;
  color: #374151;
  border-bottom: 1px solid #f3f4f6;
  vertical-align: middle;
}
.tab-table tr:last-child td { border-bottom: none; }
.tab-table tr:hover td { background: #FAF8F6; }

/* Skeleton rows */
.skeleton-tr td { padding: .7rem 1rem; }
.skel {
  height: 13px;
  border-radius: 6px;
  background: linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 50%, #f3f4f6 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}
.skel--xs    { width: 28px; }
.skel--sm    { width: 72px; }
.skel--md    { width: 140px; }
.skel--value { width: 80px; height: 28px; border-radius: 6px; margin: .3rem 0; }

@keyframes shimmer {
  from { background-position: 200% 0; }
  to   { background-position: -200% 0; }
}

/* Celda vacía */
.td-empty {
  text-align: center;
  padding: 2rem !important;
  color: #9ca3af;
  font-size: .83rem;
}

/* ════════════════════════════════════════════════════════════════════════════
   BOTÓN ACTUALIZAR (Monitoreo)
   ════════════════════════════════════════════════════════════════════════════ */
.btn-refresh-mon {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  padding: .45rem 1rem;
  border-radius: 9px;
  background: #FDFCFB;
  border: 1px solid #e5e7eb;
  font-family: 'Poppins', sans-serif;
  font-size: .8rem;
  font-weight: 600;
  color: #374151;
  cursor: pointer;
  transition: background .15s, box-shadow .15s;
  white-space: nowrap;
}
.btn-refresh-mon:hover:not(:disabled) {
  background: #f9fafb;
  box-shadow: 0 2px 8px rgba(0,0,0,.07);
}
.btn-refresh-mon:disabled { opacity: .55; cursor: not-allowed; }
.btn-refresh-mon .material-icons { font-size: 1rem; }

@keyframes spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}
.spin { animation: spin .8s linear infinite; }

/* Celda nombre tabla */
.td-name {
  display: flex;
  align-items: center;
  gap: .4rem;
  font-family: 'Courier New', monospace;
  font-weight: 700;
  color: #722f37;
}
.table-icon { font-size: .9rem; color: #9ca3af; }

.td-mono {
  font-family: 'Courier New', monospace;
  font-size: .8rem;
  color: #6b7280;
  white-space: nowrap;
}

/* Rango en queries */
.td-rank {
  font-weight: 800;
  color: #9ca3af;
  font-size: .8rem;
  width: 32px;
}

/* Snippet de query */
.td-query { max-width: 360px; }
.query-snippet {
  display: block;
  font-size: .75rem;
  color: #374151;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 340px;
  background: #f9fafb;
  padding: .25em .55em;
  border-radius: 5px;
  border: 1px solid #e5e7eb;
}

/* Acciones de mantenimiento */
.td-actions { white-space: nowrap; display: flex; gap: .5rem; }
.btn-maint {
  display: inline-flex;
  align-items: center;
  gap: .28rem;
  padding: .32rem .75rem;
  border-radius: 7px;
  font-family: 'Poppins', sans-serif;
  font-size: .72rem;
  font-weight: 700;
  cursor: not-allowed;
  border: 1px solid;
  opacity: .55;
  transition: opacity .15s;
}
.btn-maint .material-icons { font-size: .9rem; }
.btn-maint--vacuum  { background: #f0fdf4; color: #15803d; border-color: #bbf7d0; }
.btn-maint--reindex { background: #f5f3ff; color: #6d28d9; border-color: #ddd6fe; }

/* ── Nota "próximamente" al pie de la tabla ─────────────────────────────── */
.coming-soon-note {
  display: flex;
  align-items: center;
  gap: .5rem;
  padding: .85rem 1.4rem;
  border-top: 1px solid #f3f4f6;
  font-size: .78rem;
  color: #9ca3af;
  background: #FAF8F6;
}
.coming-soon-note .material-icons { font-size: 1rem; color: #d1d5db; }
.coming-soon-note code {
  background: #f3f4f6;
  padding: .1em .4em;
  border-radius: 4px;
  font-size: .75rem;
  color: #374151;
}

/* ════════════════════════════════════════════════════════════════════════════
   GRID DE OPERACIONES (Mantenimiento)
   ════════════════════════════════════════════════════════════════════════════ */
.ops-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1rem;
}
.op-card {
  display: flex;
  align-items: flex-start;
  gap: .9rem;
  padding: 1.1rem 1.25rem;
  border-radius: 12px;
  border: 1px solid;
}
.op-card__icon {
  width: 38px; height: 38px;
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.op-card__icon .material-icons { font-size: 1.2rem; color: #fff; }
.op-card--green { background: #f0fdf4; border-color: #bbf7d0; }
.op-card--green .op-card__icon { background: linear-gradient(135deg, #15803d, #22c55e); }
.op-card--purple { background: #f5f3ff; border-color: #ddd6fe; }
.op-card--purple .op-card__icon { background: linear-gradient(135deg, #6d28d9, #8b5cf6); }

.op-card__title {
  margin: 0 0 .3rem;
  font-size: .87rem;
  font-weight: 700;
  color: #111827;
}
.op-card__desc {
  margin: 0;
  font-size: .8rem;
  color: #6b7280;
  line-height: 1.5;
}
.op-card__desc strong { color: #374151; }

/* ════════════════════════════════════════════════════════════════════════════
   RESPONSIVE
   ════════════════════════════════════════════════════════════════════════════ */
@media (max-width: 768px) {
  .tab-root { padding: 1rem 1rem 2.5rem; }
  .metrics-grid { grid-template-columns: 1fr 1fr; }
  .tab-table th, .tab-table td { padding: .65rem .7rem; font-size: .77rem; }
}
@media (max-width: 480px) {
  .metrics-grid { grid-template-columns: 1fr; }
  .tab-header { flex-direction: column; align-items: flex-start; }
  .query-snippet { max-width: 180px; }
}

/* ════════════════════════════════════════════════════════════════════════════
   MONITOREO — Grid y tarjetas rediseñadas (flex-col, SQL truncado)
   ════════════════════════════════════════════════════════════════════════════ */

/* Grid 4 columnas (respira en pantallas grandes) */
.mon-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.25rem;
  margin-bottom: 1.75rem;
}

/* Tarjeta base */
.mon-card {
  background: #FDFCFB;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  padding: 1.25rem 1.3rem 1rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 1px 6px rgba(0,0,0,.05);
  transition: box-shadow .18s, border-color .18s;
  min-width: 0; /* permite que truncate funcione */
}
.mon-card:hover { box-shadow: 0 4px 18px rgba(0,0,0,.09); }

/* Color de borde dinámico para Cache Hit Ratio */
.mon-card--good  { border-color: #bbf7d0; }
.mon-card--warn  { border-color: #fde68a; }
.mon-card--bad   { border-color: #fecaca; }

/* Parte superior: icono + label */
.mon-card__top {
  display: flex;
  align-items: center;
  gap: .65rem;
  margin-bottom: .85rem;
}

/* Icono pastel */
.mon-card__icon {
  width: 36px; height: 36px;
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.mon-card__icon .material-icons { font-size: 1.15rem; }

.mon-card__icon--blue  { background: #eff6ff; color: #2563eb; }
.mon-card__icon--green { background: #f0fdf4; color: #16a34a; }
.mon-card__icon--amber { background: #fffbeb; color: #d97706; }
.mon-card__icon--red   { background: #fff1f2; color: #e11d48; }
.mon-card__icon--slate { background: #f1f5f9; color: #475569; }
/* Fallback para cache (sin datos) */
.mon-card__icon--cache { background: #f1f5f9; color: #475569; }

/* Label */
.mon-card__label {
  font-size: .7rem;
  font-weight: 700;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: .06em;
  line-height: 1.3;
}

/* Valor grande */
.mon-card__value-wrap { flex: 1; display: flex; align-items: flex-end; }
.mon-card__value {
  margin: 0;
  font-size: 2rem;
  font-weight: 800;
  color: #1a1a1a;
  line-height: 1;
  display: flex;
  align-items: baseline;
  gap: .3rem;
}
.mon-card__unit {
  font-size: .95rem;
  font-weight: 500;
  color: #9ca3af;
  margin-bottom: .05em;
}

/* Pie: separador + SQL */
.mon-card__footer {
  margin-top: 1rem;
  padding-top: .6rem;
  border-top: 1px solid #f3f4f6;
  min-width: 0;
}
.mon-card__sql {
  display: block;
  font-size: .68rem;
  color: #9ca3af;
  font-family: 'Courier New', monospace;
  background: #f9fafb;
  padding: .25em .55em;
  border-radius: 5px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  border: 1px solid #f3f4f6;
}

/* ── Tabla Top 5 rediseñada ────────────────────────────────────────────── */
.mon-table-card {
  background: #FDFCFB;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 1px 8px rgba(0,0,0,.05);
}
.mon-table-card__header {
  display: flex;
  align-items: center;
  gap: .65rem;
  padding: 1.1rem 1.5rem;
  border-bottom: 1px solid #f3f4f6;
  background: #FAF8F6;
}
.mon-table-card__header .material-icons { font-size: 1.1rem; color: #6b7280; }
.mon-table-card__header h3 {
  margin: 0;
  font-size: .9rem;
  font-weight: 700;
  color: #111827;
}

.mon-table {
  width: 100%;
  border-collapse: collapse;
  font-size: .83rem;
}

/* Encabezados */
.mon-table thead { background: rgba(249,250,251,.5); }
.mon-table th {
  text-align: left;
  padding: 1rem 1.5rem;
  font-size: .7rem;
  font-weight: 600;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: .07em;
  border-bottom: 1px solid #e5e7eb;
  white-space: nowrap;
}

/* Celdas */
.mon-table td {
  padding: 1rem 1.5rem;
  border-bottom: 1px solid #f3f4f6;
  vertical-align: middle;
  color: #374151;
}
.mon-table tr:last-child td { border-bottom: none; }
.mon-table tbody tr:hover td { background: #FAF8F6; }

/* Rank # */
.mon-td-rank {
  font-weight: 800;
  color: #d1d5db;
  font-size: .85rem;
  width: 36px;
}

/* Nombre de tabla */
.mon-td-name {
  display: flex;
  align-items: center;
  gap: .45rem;
  font-family: 'Courier New', monospace;
  font-weight: 700;
  color: #722f37;
  font-size: .82rem;
}
.mon-td-icon { font-size: .85rem; color: #d1d5db; }

/* Celdas numéricas (MB) */
.mon-td-num { white-space: nowrap; }
.mon-td-num__main {
  font-family: 'Courier New', monospace;
  font-size: .83rem;
  font-weight: 700;
  color: #374151;
}
.mon-td-num__unit {
  font-size: .7rem;
  color: #9ca3af;
  margin-left: .2em;
}

/* Filas */
.mon-td-rows {
  font-family: 'Courier New', monospace;
  font-size: .8rem;
  color: #6b7280;
}

/* ── Responsive para mon-grid ────────────────────────────────────────────── */
@media (max-width: 1200px) {
  .mon-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .mon-grid { grid-template-columns: 1fr; }
  .mon-card__value { font-size: 1.6rem; }
  .mon-table th, .mon-table td { padding: .75rem 1rem; }
}

/* ══════════════════════════════════════════════════════════════════════════
   MAINTENANCE TAB — admin-db-maintenance
   ══════════════════════════════════════════════════════════════════════════ */

/* Badge autovacuum (pill verde) */
.badge-autovacuum {
  display: inline-flex; align-items: center; gap: .35rem;
  background: #dcfce7; color: #15803d;
  font-size: .7rem; font-weight: 700;
  padding: .25rem .7rem; border-radius: 999px; letter-spacing: .04em;
}
.badge-autovacuum__dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: #22c55e; animation: pulse-dot 2s infinite;
}
@keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: .4; } }

/* Header layout */
.maint-header-text { display: flex; flex-direction: column; gap: .3rem; }
.maint-header-title-row { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }

/* Grid de tarjetas de acción */
.maint-action-grid {
  display: grid; grid-template-columns: repeat(2, 1fr);
  gap: 1.25rem; margin-bottom: 1.75rem;
}
.maint-action-card {
  background: #FDFCFB; border: 1px solid #e5e7eb; border-radius: 16px;
  padding: 1.4rem; display: flex; flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 1px 6px rgba(0,0,0,.05);
}
.maint-action-card__body { display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 1.25rem; }
.maint-action-card__icon {
  width: 42px; height: 42px; border-radius: 12px;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.maint-action-card__icon .material-icons { font-size: 1.3rem; color: #fff; }
.maint-action-card__icon--green { background: linear-gradient(135deg, #15803d, #22c55e); }
.maint-action-card__icon--dark  { background: linear-gradient(135deg, #1a1a1a, #374151); }
.maint-action-card__title { margin: 0 0 .15rem; font-size: .92rem; font-weight: 700; color: #111827; }
.maint-action-card__subtitle {
  margin: 0 0 .5rem; font-size: .75rem; font-weight: 600;
  color: #9ca3af; font-family: 'Courier New', monospace;
}
.maint-action-card__desc { margin: 0; font-size: .8rem; color: #6b7280; line-height: 1.55; }
.maint-action-card__footer { border-top: 1px solid #f3f4f6; padding-top: 1rem; }

/* Botones de mantenimiento */
.maint-btn {
  display: inline-flex; align-items: center; gap: .45rem;
  padding: .55rem 1.25rem; border-radius: 10px;
  font-family: 'Poppins', sans-serif; font-size: .82rem; font-weight: 700;
  cursor: pointer; border: none; color: #fff;
  transition: background .15s, box-shadow .15s;
}
.maint-btn:disabled { opacity: .5; cursor: not-allowed; }
.maint-btn--vacuum  { background: #722f37; }
.maint-btn--vacuum:hover:not(:disabled)  { background: #600018; }
.maint-btn--reindex { background: #1a1a1a; }
.maint-btn--reindex:hover:not(:disabled) { background: #374151; }
.maint-btn .material-icons { font-size: 1rem; }
.maint-spin { animation: spin .8s linear infinite; }

/* Tarjeta de auditoría */
.maint-audit-card {
  background: #FDFCFB; border: 1px solid #e5e7eb; border-radius: 16px;
  overflow: hidden; box-shadow: 0 1px 8px rgba(0,0,0,.05);
}
.maint-audit-card__header {
  display: flex; align-items: center; justify-content: space-between;
  gap: .75rem; padding: 1.1rem 1.5rem;
  border-bottom: 1px solid #f3f4f6; background: #FAF8F6; flex-wrap: wrap;
}
.maint-audit-card__header-left { display: flex; align-items: center; gap: .65rem; }
.maint-audit-card__header-left .material-icons { font-size: 1.1rem; color: #6b7280; }
.maint-audit-card__header-left h3 { margin: 0 0 .1rem; font-size: .9rem; font-weight: 700; color: #111827; }
.maint-audit-card__header-left p { margin: 0; font-size: .72rem; color: #9ca3af; }
.maint-audit-card__header-left code {
  background: #f3f4f6; padding: .1em .4em; border-radius: 4px; font-size: .68rem;
}

/* Tuplas muertas — colores condicionales */
.maint-dead-high {
  display: inline-flex; align-items: center; gap: .3rem;
  color: #c0392b; font-weight: 700;
  font-family: 'Courier New', monospace; font-size: .82rem;
}
.maint-dead-high .material-icons { font-size: .95rem; color: #e74c3c; }
.maint-dead-low  { font-family: 'Courier New', monospace; font-size: .82rem; color: #6b7280; }
.maint-td-vacuum { font-size: .78rem; color: #6b7280; font-family: 'Courier New', monospace; white-space: nowrap; }

/* Filas de vacuum con badge DBA / AUTO */
.maint-vacuum-row {
  display: flex; align-items: center; gap: .4rem;
  line-height: 1.6;
}
.maint-vacuum-badge {
  display: inline-block;
  font-size: .58rem; font-weight: 800; letter-spacing: .06em;
  padding: .1em .45em; border-radius: 4px;
  flex-shrink: 0;
}
.maint-vacuum-badge--manual {
  background: #dbeafe; color: #1d4ed8;   /* azul — acción humana */
}
.maint-vacuum-badge--auto {
  background: #f3f4f6; color: #6b7280;   /* gris — daemon automático */
}
.maint-vacuum-date--nunca {
  color: #d1d5db; font-style: italic;
}

/* Callout verde */
.callout--green { border-left-color: #22c55e; background: #f0fdf4; }
.callout--green .material-icons { color: #22c55e; }
.callout--green strong { color: #15803d; }

/* Responsive mantenimiento */
@media (max-width: 768px) {
  .maint-action-grid { grid-template-columns: 1fr; }
}

/* ── Botones inline por fila (control granular tabla por tabla) ──────────── */
.maint-td-actions {
  display: flex; align-items: center; gap: .45rem;
  white-space: nowrap;
}
.maint-row-btn {
  display: inline-flex; align-items: center; gap: .3rem;
  padding: .3rem .7rem; border-radius: 7px;
  font-family: 'Poppins', sans-serif; font-size: .72rem; font-weight: 700;
  cursor: pointer; background: transparent;
  transition: background .15s, color .15s, border-color .15s;
  line-height: 1;
}
.maint-row-btn:disabled { opacity: .45; cursor: not-allowed; }

/* Vacuum — outline vino tinto */
.maint-row-btn--vacuum {
  color: #722f37; border: 1.5px solid #722f37;
}
.maint-row-btn--vacuum:hover:not(:disabled) {
  background: #722f37; color: #fff;
}

/* Reindex — outline negro */
.maint-row-btn--reindex {
  color: #1a1a1a; border: 1.5px solid #1a1a1a;
}
.maint-row-btn--reindex:hover:not(:disabled) {
  background: #1a1a1a; color: #fff;
}

/* ══════════════════════════════════════════════════════════════════════════
   TOAST DE RESULTADO — aparece en esquina inferior derecha, se auto-cierra
   ══════════════════════════════════════════════════════════════════════════ */
.maint-toast {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  z-index: 9999;
  width: 380px;
  max-width: calc(100vw - 2rem);
  background: #FDFCFB;
  border-radius: 16px;
  box-shadow: 0 8px 32px rgba(0,0,0,.18), 0 2px 8px rgba(0,0,0,.08);
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  gap: .9rem;
  padding: 1.1rem 1.1rem 1.4rem;
  animation: toast-in .35s cubic-bezier(.22,.68,0,1.2) both;
  border-left: 5px solid transparent;
}
.maint-toast--success { border-left-color: #22c55e; }
.maint-toast--error   { border-left-color: #e74c3c; }
.maint-toast--closing { animation: toast-out .4s ease forwards; }

/* Icono circular */
.maint-toast__icon-wrap {
  flex-shrink: 0;
  width: 38px; height: 38px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin-top: .1rem;
}
.maint-toast--success .maint-toast__icon-wrap {
  background: #dcfce7;
}
.maint-toast--success .maint-toast__icon-wrap .material-icons {
  color: #22c55e; font-size: 1.35rem;
}
.maint-toast--error .maint-toast__icon-wrap {
  background: #fee2e2;
}
.maint-toast--error .maint-toast__icon-wrap .material-icons {
  color: #e74c3c; font-size: 1.35rem;
}

/* Cuerpo */
.maint-toast__body { flex: 1; min-width: 0; }
.maint-toast__title {
  margin: 0 0 .3rem;
  font-size: .88rem; font-weight: 700; color: #111827;
}
.maint-toast__op {
  display: flex; align-items: center; gap: .4rem;
  margin: 0 0 .45rem;
}
.maint-toast__op-badge {
  background: #f3f4f6;
  color: #374151;
  font-family: 'Courier New', monospace;
  font-size: .68rem; font-weight: 700;
  padding: .15em .5em; border-radius: 4px;
  white-space: nowrap;
}
.maint-toast__op-table {
  font-family: 'Courier New', monospace;
  font-size: .73rem; color: #6b7280;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.maint-toast__msg {
  margin: 0;
  font-size: .78rem; color: #4b5563; line-height: 1.5;
}

/* Botón cerrar */
.maint-toast__close {
  flex-shrink: 0;
  background: none; border: none; cursor: pointer;
  padding: .1rem; color: #9ca3af;
  display: flex; align-items: center;
  transition: color .15s;
}
.maint-toast__close:hover { color: #374151; }
.maint-toast__close .material-icons { font-size: 1.05rem; }

/* Barra de progreso inferior */
.maint-toast__progress {
  position: absolute;
  bottom: 0; left: 0;
  height: 3px;
  background: #22c55e;
  border-radius: 0 0 0 16px;
  animation: toast-progress 5s linear forwards;
}
.maint-toast__progress--error {
  background: #e74c3c;
  animation-duration: 8s;
}

/* Keyframes */
@keyframes toast-in {
  from { opacity: 0; transform: translateY(24px) scale(.96); }
  to   { opacity: 1; transform: translateY(0)    scale(1);   }
}
@keyframes toast-out {
  from { opacity: 1; transform: translateY(0)    scale(1);   }
  to   { opacity: 0; transform: translateY(16px) scale(.95); }
}
@keyframes toast-progress {
  from { width: 100%; }
  to   { width: 0%;   }
}
</file>

