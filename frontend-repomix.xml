  margin-bottom: 15px;
}

.footer-logo {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}

.footer-logo img {
  height: 50px;
  width: auto;
  filter: brightness(1.2);
}

.footer-logo-text {
  font-family: Montserrat, sans-serif;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: 2px;
  color: #C5A059;
}

.footer-description {
  color: #AAAAAA;
  line-height: 1.8;
  margin-bottom: 25px;
}

.social-links {
  display: flex;
  gap: 15px;
  margin-top: 20px;
}

.social-link {
  width: 45px;
  height: 45px;
  background: #1A1A1A;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C5A059;
  text-decoration: none;
  transition: all 0.3s ease;
  border: 2px solid #1A1A1A;
}

.social-link:hover {
  background: #C5A059;
  color: #000000;
  border-color: #C5A059;
  transform: translateY(-3px);
  box-shadow: 0 5px 15px rgba(197, 160, 89, 0.4);
}

.footer-links {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-links li {
  margin-bottom: 12px;
}

.footer-links a {
  color: #CCCCCC;
  text-decoration: none;
  font-family: Roboto, sans-serif;
  font-size: 0.95rem;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  gap: 8px;
}

.footer-links a:hover {
  color: #C5A059;
  padding-left: 5px;
}

.footer-links a .material-icons {
  font-size: 18px;
}

.contact-info {
  list-style: none;
  padding: 0;
  margin: 0;
}

.contact-info li {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 15px;
  color: #CCCCCC;
  font-family: Roboto, sans-serif;
  font-size: 0.95rem;
}

.contact-info li .material-icons {
  color: #C5A059;
  font-size: 20px;
  margin-top: 2px;
}

.footer .newsletter-form {
  display: flex;
  flex-direction: column;
  gap: 15px;
  margin-top: 20px;
}

.footer .newsletter-input {
  padding: 14px 18px;
  border: 2px solid #333;
  border-radius: 10px;
  background: #1A1A1A;
  color: white;
  font-family: Roboto, sans-serif;
  font-size: 0.95rem;
  transition: all 0.3s ease;
}

.footer .newsletter-input:focus {
  outline: none;
  border-color: #C5A059;
  background: #222;
}

.footer .newsletter-input::placeholder {
  color: #777;
}

.footer .newsletter-btn {
  padding: 14px 24px;
  background: linear-gradient(135deg, #C5A059 0%, #D4AF6A 100%);
  color: #000000;
  border: none;
  border-radius: 10px;
  font-weight: 700;
  font-size: 1rem;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  font-family: Montserrat, sans-serif;
}

