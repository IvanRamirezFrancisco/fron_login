          </thead>
          <tbody>
            @for (entry of maintenanceHistory; track entry.id) {
              <tr>
                <!-- OPERACIÓN -->
                <td>
                  <span class="mnt-hist-op-badge" [ngClass]="histOpClass(entry.operation)">
                    {{ histOpLabel(entry.operation) }}
