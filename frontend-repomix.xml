    font-size: 0.875rem;
  }
}

/* ═══════════════════════════════════════════════════════════════
   TOAST DE NOTIFICACIÓN — Sistema de alertas elegante
   ═══════════════════════════════════════════════════════════════ */

.pm-toast-wrapper {
  position: fixed;
  top: 1.5rem;
  right: 1.5rem;
  z-index: 99999;
  pointer-events: none;
  opacity: 0;
  transform: translateX(calc(100% + 2rem));
  transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.pm-toast-wrapper.pm-toast--visible {
  opacity: 1;
  transform: translateX(0);
  pointer-events: all;
}

.pm-toast {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 0.875rem;
  min-width: 320px;
  max-width: 420px;
  padding: 1rem 1rem 1.4rem 1rem;
  border-radius: 14px;
  background: #FDFCFB;
  box-shadow:
    0 4px 6px -1px rgba(0, 0, 0, 0.07),
    0 10px 25px -5px rgba(0, 0, 0, 0.13),
    0 0 0 1px rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

/* Línea de color izquierda por tipo */
.pm-toast::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  border-radius: 14px 0 0 14px;
}

.pm-toast--success::before { background: #10b981; }
.pm-toast--error::before   { background: #ef4444; }
.pm-toast--warning::before { background: #f59e0b; }
.pm-toast--info::before    { background: #3b82f6; }

/* Icono */
.pm-toast__icon {
  flex-shrink: 0;
  width: 2rem;
  height: 2rem;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pm-toast__icon .material-icons {
  font-size: 1.15rem;
  color: #ffffff;
}

.pm-toast--success .pm-toast__icon { background: #10b981; }
.pm-toast--error   .pm-toast__icon { background: #ef4444; }
.pm-toast--warning .pm-toast__icon { background: #f59e0b; }
.pm-toast--info    .pm-toast__icon { background: #3b82f6; }

/* Cuerpo de texto */
.pm-toast__body {
  flex: 1;
  min-width: 0;
}

.pm-toast__title {
  font-size: 0.875rem;
  font-weight: 700;
  color: #111827;
  margin: 0 0 0.2rem 0;
  line-height: 1.3;
}

.pm-toast__message {
  font-size: 0.8rem;
  color: #4b5563;
  margin: 0;
  line-height: 1.45;
  word-break: break-word;
}

/* Botón de cerrar */
.pm-toast__close {
  flex-shrink: 0;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.1rem;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  transition: background 0.15s, color 0.15s;
  margin-top: -0.1rem;
}

.pm-toast__close:hover {
  background: #f3f4f6;
  color: #374151;
}

.pm-toast__close .material-icons {
  font-size: 1rem;
}

/* Barra de progreso */
.pm-toast__progress {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: rgba(0, 0, 0, 0.06);
  border-radius: 0 0 14px 14px;
}

.pm-toast__progress-bar {
  height: 100%;
  border-radius: 0 0 14px 14px;
  transition: width 50ms linear;
}

.pm-toast--success .pm-toast__progress-bar { background: #10b981; }
.pm-toast--error   .pm-toast__progress-bar { background: #ef4444; }
.pm-toast--warning .pm-toast__progress-bar { background: #f59e0b; }
.pm-toast--info    .pm-toast__progress-bar { background: #3b82f6; }

/* Responsive */
@media (max-width: 480px) {
  .pm-toast-wrapper {
    top: auto;
    bottom: 1rem;
    right: 0.75rem;
    left: 0.75rem;
    transform: translateY(calc(100% + 2rem));
  }

  .pm-toast-wrapper.pm-toast--visible {
    transform: translateY(0);
  }

  .pm-toast {
    min-width: unset;
    max-width: unset;
    width: 100%;
  }
}

/* ================================================================
   BOTON DE ALERTAS DE STOCK (toolbar)
   ================================================================ */
.pm-btn-stock-alerts {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  padding: .55rem 1.1rem;
  background: linear-gradient(135deg, #722f37, #944050);
  color: #fff;
  border: none;
  border-radius: 10px;
  font-size: .82rem;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  white-space: nowrap;
  transition: all .25s cubic-bezier(.4,0,.2,1);
  box-shadow: 0 2px 8px rgba(114,47,55,.18);
}
.pm-btn-stock-alerts:hover {
  background: linear-gradient(135deg, #5a2430, #7a3040);
  box-shadow: 0 4px 14px rgba(114,47,55,.28);
  transform: translateY(-1px);
}
.pm-btn-stock-alerts .material-icons {
  font-size: 1.15rem;
}

/* ================================================================
   STOCK ALERTS MODAL — Paleta corporativa #722f37 / #C5A059
   ================================================================ */
.sa-backdrop {
  position: fixed;
  inset: 0;
  z-index: 10000;
  background: rgba(0,0,0,.45);
  backdrop-filter: blur(3px);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: saFadeIn .2s ease;
  padding: 1rem;
}
@keyframes saFadeIn { from { opacity: 0; } to { opacity: 1; } }

.sa-modal {
  background: #FDFCFB;
  border-radius: 18px;
  width: 100%;
  max-width: 560px;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 24px 64px rgba(0,0,0,.18);
  animation: saSlideUp .3s cubic-bezier(.4,0,.2,1);
  overflow: hidden;
}
@keyframes saSlideUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* -- Header -------------------------------------------------------- */
.sa-modal__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.25rem 1.5rem 1rem;
  border-bottom: 1px solid #f0ece7;
}
.sa-modal__header-left {
  display: flex;
  align-items: center;
  gap: .85rem;
}
.sa-modal__icon-circle {
  width: 42px; height: 42px;
  border-radius: 12px;
  background: linear-gradient(135deg, #722f37, #944050);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.sa-modal__icon-circle .material-icons { font-size: 1.25rem; color: #fff; }
.sa-modal__title {
  margin: 0;
  font-size: 1.05rem;
  font-weight: 700;
  color: #111827;
}
.sa-modal__subtitle {
  margin: .2rem 0 0;
  font-size: .78rem;
  color: #6b7280;
  line-height: 1.4;
}
.sa-modal__close {
  background: none;
  border: none;
  color: #9ca3af;
  cursor: pointer;
  padding: 4px;
  border-radius: 8px;
  transition: all .2s;
}
.sa-modal__close:hover { background: #f3f4f6; color: #374151; }

/* -- Body ---------------------------------------------------------- */
.sa-modal__body {
  flex: 1;
  overflow-y: auto;
  padding: 1.25rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
}

/* -- Footer -------------------------------------------------------- */
.sa-modal__footer {
  display: flex;
  justify-content: flex-end;
  gap: .65rem;
  padding: 1rem 1.5rem;
  border-top: 1px solid #f0ece7;
  background: #faf8f6;
}

/* -- Sections ------------------------------------------------------ */
.sa-section {
  display: flex;
  flex-direction: column;
  gap: .65rem;
}
.sa-section--fade-in {
  animation: saFieldFadeIn .25s ease-out;
}
@keyframes saFieldFadeIn {
  from { opacity: 0; transform: translateY(-6px); }
  to   { opacity: 1; transform: translateY(0); }
}
.sa-section__title {
  display: flex;
  align-items: center;
  gap: .45rem;
  margin: 0;
  font-size: .85rem;
  font-weight: 700;
  color: #374151;
}
.sa-section__title .material-icons {
  font-size: 1.05rem;
  color: #722f37;
}

/* -- Toggle -------------------------------------------------------- */
.sa-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: .85rem 1rem;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
}
.sa-toggle-text {
  display: flex;
  flex-direction: column;
  gap: .15rem;
}
.sa-toggle-text strong {
  font-size: .85rem;
  color: #111827;
}
.sa-toggle-sub {
  font-size: .72rem;
  color: #6b7280;
  line-height: 1.4;
}
.sa-toggle {
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  flex-shrink: 0;
}
.sa-toggle__track {
  display: flex;
  align-items: center;
  width: 42px; height: 24px;
  border-radius: 12px;
  background: #d1d5db;
  padding: 2px;
  transition: background .2s ease;
}
.sa-toggle--on .sa-toggle__track {
  background: linear-gradient(135deg, #722f37, #944050);
}
.sa-toggle__thumb {
  width: 20px; height: 20px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 1px 3px rgba(0,0,0,.15);
  transition: transform .2s ease;
}
.sa-toggle--on .sa-toggle__thumb {
  transform: translateX(18px);
}

/* -- Threshold ----------------------------------------------------- */
.sa-threshold-row {
  display: flex;
  align-items: center;
  gap: .5rem;
}
.sa-input {
  width: 100%;
  padding: .55rem .75rem;
  border: 1.5px solid #e5e7eb;
  border-radius: 10px;
  font-size: .85rem;
  font-family: inherit;
  color: #111827;
  background: #fff;
  transition: border-color .2s;
}
.sa-input:focus {
  outline: none;
  border-color: #C5A059;
  box-shadow: 0 0 0 3px rgba(197,160,89,.12);
}
.sa-input--num {
  max-width: 100px;
  text-align: center;
  font-weight: 600;
}
.sa-threshold-unit {
  font-size: .78rem;
  color: #6b7280;
  white-space: nowrap;
}
.sa-hint {
  font-size: .72rem;
  color: #9ca3af;
  display: flex;
  align-items: center;
  gap: .25rem;
}

/* -- Badge --------------------------------------------------------- */
.sa-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 20px; height: 20px;
  border-radius: 10px;
  background: #722f37;
  color: #fff;
  font-size: .65rem;
  font-weight: 700;
  padding: 0 5px;
  margin-left: .35rem;
}

/* -- Chips --------------------------------------------------------- */
.sa-chips {
  display: flex;
  flex-wrap: wrap;
  gap: .45rem;
}
.sa-chip {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  padding: .3rem .55rem .3rem .3rem;
  background: #f5f0eb;
  border: 1px solid #e5e0d8;
  border-radius: 20px;
  font-size: .78rem;
  color: #374151;
  animation: saFieldFadeIn .2s ease;
}
.sa-chip__avatar {
  width: 26px; height: 26px;
  border-radius: 50%;
  background: linear-gradient(135deg, #722f37, #944050);
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: .6rem;
  font-weight: 700;
  flex-shrink: 0;
}
.sa-chip__info {
  display: flex;
  flex-direction: column;
  line-height: 1.25;
}
.sa-chip__name {
  font-weight: 600;
  font-size: .75rem;
}
.sa-chip__role {
  font-size: .62rem;
  color: #9ca3af;
  text-transform: uppercase;
  letter-spacing: .02em;
}
.sa-chip__remove {
  background: none;
  border: none;
  color: #9ca3af;
  cursor: pointer;
  padding: 2px;
  border-radius: 50%;
  display: flex;
  transition: all .15s;
}
.sa-chip__remove .material-icons { font-size: .85rem; }
.sa-chip__remove:hover { background: #fee2e2; color: #ef4444; }

/* -- Search + Dropdown --------------------------------------------- */
.sa-search-wrap {
  position: relative;
}
.sa-search-icon {
  position: absolute;
  left: .65rem;
  top: 50%;
  transform: translateY(-50%);
  font-size: 1.05rem;
  color: #9ca3af;
  pointer-events: none;
}
.sa-search {
  width: 100%;
  padding: .55rem .75rem .55rem 2.2rem;
  border: 1.5px solid #e5e7eb;
  border-radius: 10px;
  font-size: .82rem;
  font-family: inherit;
  color: #111827;
  background: #fff;
  transition: border-color .2s;
  box-sizing: border-box;
}
.sa-search:focus {
  outline: none;
  border-color: #C5A059;
  box-shadow: 0 0 0 3px rgba(197,160,89,.12);
}

.sa-dropdown {
  position: absolute;
  top: calc(100% + 4px);
  left: 0; right: 0;
  z-index: 20;
  background: #fff;
  border: 1.5px solid #e5e7eb;
  border-radius: 12px;
  box-shadow: 0 8px 24px rgba(0,0,0,.1);
  max-height: 220px;
  overflow-y: auto;
  animation: saFieldFadeIn .15s ease;
}
.sa-dropdown__item {
  display: flex;
  align-items: center;
  gap: .6rem;
  width: 100%;
  padding: .55rem .75rem;
  border: none;
  background: none;
  cursor: pointer;
  text-align: left;
  font-family: inherit;
  transition: background .12s;
}
.sa-dropdown__item:hover {
  background: #f5f0eb;
}
.sa-dropdown__avatar {
  width: 30px; height: 30px;
  border-radius: 50%;
  background: linear-gradient(135deg, #C5A059, #d4b76a);
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: .6rem;
  font-weight: 700;
  flex-shrink: 0;
}
.sa-dropdown__info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}
.sa-dropdown__name {
  font-size: .8rem;
  font-weight: 600;
  color: #111827;
}
.sa-dropdown__email {
  font-size: .68rem;
  color: #9ca3af;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sa-dropdown__role {
  font-size: .6rem;
  font-weight: 600;
  color: #722f37;
  background: rgba(114,47,55,.08);
  padding: .15rem .45rem;
  border-radius: 6px;
  text-transform: uppercase;
  letter-spacing: .03em;
  white-space: nowrap;
}
.sa-dropdown__loading,
.sa-dropdown__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  padding: 1rem;
  font-size: .8rem;
  color: #9ca3af;
}
.sa-dropdown__empty .material-icons {
  font-size: 1.1rem;
}

/* -- Buttons ------------------------------------------------------- */
.sa-btn {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  padding: .55rem 1.1rem;
  border: none;
  border-radius: 10px;
  font-size: .82rem;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  transition: all .2s;
}
.sa-btn--ghost {
  background: none;
  color: #6b7280;
  border: 1px solid #e5e7eb;
}
.sa-btn--ghost:hover {
  background: #f3f4f6;
  color: #374151;
}
.sa-btn--primary {
  background: linear-gradient(135deg, #722f37, #944050);
  color: #fff;
  box-shadow: 0 2px 8px rgba(114,47,55,.18);
}
.sa-btn--primary:hover:not(:disabled) {
  background: linear-gradient(135deg, #5a2430, #7a3040);
  box-shadow: 0 4px 14px rgba(114,47,55,.28);
  transform: translateY(-1px);
}
.sa-btn--primary:disabled {
  opacity: .5;
  cursor: not-allowed;
  transform: none;
}
.sa-btn .material-icons {
  font-size: 1rem;
}

/* -- Spinner ------------------------------------------------------- */
.sa-spinner {
  width: 28px; height: 28px;
  border: 3px solid #f0ece7;
  border-top-color: #722f37;
  border-radius: 50%;
  animation: saSpin .7s linear infinite;
}
.sa-spinner--small {
  width: 16px; height: 16px;
  border-width: 2px;
}
.sa-btn-spinner {
  width: 16px; height: 16px;
  border: 2px solid rgba(255,255,255,.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: saSpin .7s linear infinite;
}
@keyframes saSpin { to { transform: rotate(360deg); } }

/* -- Loading state ------------------------------------------------- */
.sa-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: .75rem;
  padding: 2.5rem 1rem;
  color: #6b7280;
  font-size: .85rem;
}

/* -- Responsive ---------------------------------------------------- */
@media (max-width: 640px) {
  .sa-modal {
    max-width: 100%;
    border-radius: 14px;
    max-height: 92vh;
  }
  .sa-modal__header,
  .sa-modal__body,
  .sa-modal__footer {
    padding-left: 1rem;
    padding-right: 1rem;
  }
  .sa-toggle-row {
    flex-direction: column;
    align-items: flex-start;
    gap: .65rem;
  }
}

