<!-- ═══════════════════════════════════════════════════════════════════════
     PRODUCTOS DESTACADOS
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="text-xs font-semibold tracking-widest uppercase text-amber-500 mb-1">Selección de la semana</p>
        <h2 class="text-3xl font-extrabold text-slate-900">Productos Destacados</h2>
      </div>
      <a routerLink="/catalogo"
         class="text-sm font-semibold text-amber-600 hover:text-amber-500 flex items-center gap-1 transition-colors">
        Ver catálogo <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
      </a>
    </div>

    <!-- Skeleton -->
    @if (loadingFeatured) {
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        @for (i of [1,2,3,4]; track i) {
          <div class="rounded-2xl border border-gray-100 overflow-hidden animate-pulse">
            <div class="aspect-square bg-gray-100"></div>
            <div class="p-4 space-y-2">
              <div class="h-3 bg-gray-100 rounded w-3/4"></div>
              <div class="h-3 bg-gray-100 rounded w-1/2"></div>
              <div class="h-5 bg-gray-100 rounded w-1/3 mt-3"></div>
            </div>
          </div>
        }
      </div>
    }

    <!-- Grid -->
    @if (!loadingFeatured) {
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">

        @for (product of featuredProducts; track product.id) {
          <div class="group rounded-2xl border border-gray-100 bg-white overflow-hidden
                      hover:shadow-xl hover:border-amber-200 hover:-translate-y-1
                      transition-all duration-300 cursor-pointer flex flex-col"
               (click)="router.navigate(['/producto', product.id])">

            <div class="relative aspect-square bg-gray-50 overflow-hidden">
              <img [src]="product.imageUrl || 'assets/icons/placeholder.png'" [alt]="product.name"
                   class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                   loading="lazy" />
              @if (getDiscountPercent(product) > 0) {
                <span class="absolute top-3 left-3 bg-red-500 text-white text-xs font-bold px-2 py-0.5 rounded-full">
                  -{{ getDiscountPercent(product) }}%
                </span>
              }

            </div>

            <div class="flex flex-col flex-1 p-4">
              @if (product.brand) {
                <span class="text-xs text-amber-600 font-semibold uppercase tracking-wide mb-0.5">{{ product.brand }}</span>
              }
              <p class="text-sm font-semibold text-slate-800 leading-snug mb-2 line-clamp-2">{{ product.name }}</p>

              @if (product.averageRating && product.averageRating > 0) {
                <div class="flex items-center gap-1 mb-2">
                  @for (star of [1,2,3,4,5]; track star) {
                    <span class="material-symbols-outlined text-[14px]"
                          [ngClass]="star <= product.averageRating ? 'text-amber-400' : 'text-gray-200'">star</span>
                  }
                  <span class="text-xs text-gray-400 ml-1">({{ product.reviewCount }})</span>
                </div>
              }

              <div class="flex-1"></div>

              <div class="flex items-end justify-between mt-2">
                <div>
                  @if (getDiscountPercent(product) > 0) {
                    <p class="text-xs text-gray-400 line-through leading-none mb-0.5">
                      ${{ product.price | number:'1.0-0' }}
                    </p>
                  }
                  <p class="text-lg font-extrabold text-slate-900">
                    ${{ getEffectivePrice(product) | number:'1.0-0' }}
                    <span class="text-xs font-normal text-gray-400">MXN</span>
                  </p>
                </div>
                <button (click)="$event.stopPropagation(); addToCart(product)"
                        class="w-9 h-9 rounded-full bg-amber-500 hover:bg-amber-400 flex items-center
                               justify-center shadow-sm hover:shadow-amber-400/40 hover:scale-110 transition-all duration-200">
                  <span class="material-symbols-outlined text-[20px] text-slate-900">add_shopping_cart</span>
                </button>
              </div>
            </div>

          </div>
        }

        @if (featuredProducts.length === 0) {
          <div class="col-span-4 text-center py-16 text-gray-400">
            <span class="material-symbols-outlined text-5xl mb-3 block">inventory_2</span>
            <p class="text-sm">No hay productos destacados disponibles.</p>
          </div>
        }

      </div>
    }

  </div>
</section>


