<file path="src/app/components/admin/admin-layout/admin-layout.component.css">
/* ===================================
   ADMIN CONTAINER
   =================================== */
.admin-container {
  display: flex;
  min-height: 100vh;
  background: #f5f0eb;
  font-family: 'Poppins', sans-serif;
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden; /* Evita scroll horizontal del body */
  position: relative;
}

/* ===================================
   SIDEBAR
   =================================== */
.admin-sidebar {
  width: 280px;
  background: linear-gradient(180deg, #34495e 0%, #34495e 100%);
  color: white;
  display: flex;
  flex-direction: column;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  box-shadow: 4px 0 12px rgba(0, 0, 0, 0.1);
}

.admin-sidebar.collapsed {
  width: 80px;
}

/* Sidebar Header */
.sidebar-header {
  padding: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.logo {
  display: flex;
  align-items: center;
  gap: 12px;
  animation: fadeIn 0.3s ease;
}

.logo-icon {
  font-size: 32px;
  color: #C5A059;
}

.logo-text {
  font-size: 1.25rem;
  font-weight: 700;
  color: #C5A059;
}

.toggle-btn {
  background: rgba(255, 255, 255, 0.1);
  border: none;
  color: white;
  width: 36px;
  height: 36px;
  border-radius: 8px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.toggle-btn:hover {
  background: rgba(197, 160, 89, 0.3);
}

/* Navigation */
.sidebar-nav {
  flex: 1;
  padding: 1rem 0;
  overflow-y: auto;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 14px 1.5rem;
  color: rgba(255, 255, 255, 0.8);
  text-decoration: none;
  transition: all 0.3s ease;
  position: relative;
  cursor: pointer;
  margin: 4px 12px;
  border-radius: 10px;
}

.nav-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4px;
  height: 0;
  background: #C5A059;
  border-radius: 0 4px 4px 0;
  transition: height 0.3s ease;
}

.nav-item:hover {
  background: rgba(255, 255, 255, 0.1);
  color: white;
}

.nav-item:hover::before {
  height: 70%;
}

.nav-item.active {
  background: rgba(197, 160, 89, 0.2);
  color: #C5A059;
  font-weight: 600;
}

.nav-item.active::before {
  height: 70%;
}

.nav-icon {
  font-size: 24px;
  min-width: 24px;
}

.nav-text {
  font-size: 15px;
  white-space: nowrap;
  animation: fadeIn 0.3s ease;
}

.badge {
  margin-left: auto;
  background: #e74c3c;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 11px;
  font-weight: 600;
  animation: fadeIn 0.3s ease;
}

.collapsed .nav-item {
  justify-content: center;
  padding: 14px 0;
}

.collapsed .nav-text,
.collapsed .badge {
  display: none;
}

/* Sidebar Footer */
.sidebar-footer {
  padding: 1rem;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.user-info {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 10px;
  margin-bottom: 12px;
  animation: fadeIn 0.3s ease;
}

.user-avatar {
  width: 40px;
  height: 40px;
  background: linear-gradient(135deg, #C5A059 0%, #A88647 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-avatar .material-icons {
  font-size: 24px;
  color: white;
}

.user-details {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.user-name {
  font-size: 14px;
  font-weight: 600;
}

.user-role {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.6);
}

.btn-action,
.btn-logout {
  width: 100%;
  padding: 12px;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-family: 'Poppins', sans-serif;
  font-size: 14px;
  font-weight: 500;
  transition: all 0.3s ease;
  margin-top: 8px;
}

.btn-action {
  background: rgba(197, 160, 89, 0.2);
  color: #C5A059;
}

.btn-action:hover {
  background: rgba(197, 160, 89, 0.3);
  transform: translateY(-2px);
}

.btn-logout {
  background: rgba(231, 76, 60, 0.2);
  color: #e74c3c;
}

.btn-logout:hover {
  background: rgba(231, 76, 60, 0.3);
  transform: translateY(-2px);
}

/* ===================================
   MAIN CONTENT
   =================================== */
.admin-main {
  flex: 1;
  margin-left: 280px;
  transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  min-width: 0; /* Crítico: permite que flex respete el ancho disponible */
  overflow-y: auto; /* El scroll ocurre aquí para que sticky funcione */
  overflow-x: hidden;
  height: 100vh; /* Necesario para que el contenedor sea el scroll context */
  width: calc(100% - 280px); /* Asegura el ancho correcto */
  max-width: calc(100% - 280px);
  --topbar-height: 73px; /* Altura del admin-topbar para sticky de sub-barras */
}

.admin-main.expanded {
  margin-left: 80px;
  width: calc(100% - 80px);
  max-width: calc(100% - 80px);
}

/* Top Bar */
.admin-topbar {
  background: rgba(253, 252, 251, 0.80);
  padding: 0.6rem 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: none;
  border-bottom: 1px solid var(--border-color, #E8E2DC);
  position: sticky;
  top: 0;
  z-index: 200;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  transition: background 0.3s ease, box-shadow 0.3s ease, padding 0.3s ease;
}

.admin-topbar.scrolled {
  background: rgba(253, 252, 251, 0.72);
  box-shadow: 0 4px 20px rgba(45, 42, 38, 0.08);
  border-bottom: 1px solid rgba(232, 226, 220, 0.6);
  padding: 0.4rem 2rem;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.mobile-menu-btn {
  display: none;
  background: none;
  border: none;
  color: #2C3E50;
  cursor: pointer;
  padding: 8px;
}

.module-header {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  padding: 0.5rem 0.9rem;
  background: #FDFCFB;
  border-radius: 14px;
  border: 1px solid #E8E2DC;
  box-shadow: 0 2px 8px rgba(45, 42, 38, 0.08);
  transition: padding 0.3s ease, box-shadow 0.3s ease;
}

.module-icon {
  width: 44px;
  height: 44px;
  border-radius: 14px;
  background: linear-gradient(135deg, #722f37 0%, #8a3545 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 16px rgba(114, 47, 55, 0.25);
  flex-shrink: 0;
}

.module-icon .material-icons {
  font-size: 22px;
  color: #ffffff;
}

.module-text {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.module-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.1;
}

.module-subtitle {
  font-size: 0.85rem;
  color: #6b7280;
}

.module-action-group {
  display: flex;
  align-items: center;
  gap: 0.65rem;
}

.module-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.65rem 1.2rem;
  border-radius: 12px;
  border: none;
  background: linear-gradient(135deg, #722f37 0%, #8a3545 100%);
  color: #ffffff;
  font-weight: 600;
  font-size: 0.85rem;
  box-shadow: 0 6px 16px rgba(114, 47, 55, 0.25);
  cursor: pointer;
  transition: all 0.3s ease;
}

.module-action-btn .material-icons {
  font-size: 1.1rem;
}

.module-action-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 22px rgba(114, 47, 55, 0.35);
}

.module-action-btn--secondary {
  background: #FDFCFB;
  color: #722f37;
  border: 1.5px solid rgba(114, 47, 55, 0.3);
  box-shadow: 0 2px 8px rgba(45, 42, 38, 0.08);
}

.module-action-btn--secondary:hover {
  background: #ede8e1;
  color: #722f37;
  box-shadow: 0 4px 12px rgba(45, 42, 38, 0.12);
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.topbar-divider {
  width: 1px;
  height: 24px;
  background: #E8E2DC;
  flex-shrink: 0;
}

.topbar-btn {
  background: #ede8e1;
  border: none;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  position: relative;
  transition: all 0.3s ease;
}

.topbar-btn:hover {
  background: #d6c79e;
  transform: translateY(-2px);
}

.notification-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: #e74c3c;
  color: white;
  font-size: 10px;
  font-weight: 600;
  padding: 2px 6px;
  border-radius: 10px;
}

.user-menu {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: #ede8e1;
  border-radius: 20px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.user-menu:hover {
  background: #d6c79e;
}

.user-name-top {
  font-size: 14px;
  font-weight: 600;
  color: #2C3E50;
}

/* Content Area */
.admin-content {
  flex: 1;
  padding: 28px 32px;
  overflow: visible; /* El scroll lo maneja .admin-main */
  box-sizing: border-box;
  width: 100%;
}

/* Módulos que gestionan su propio padding interno (ej. tabs con sticky bar) */
.admin-content--flush {
  padding: 0;
}

/* ===================================
   ANIMATIONS
   =================================== */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* ===================================
   RESPONSIVE
   =================================== */
@media (max-width: 1024px) {
  .admin-sidebar {
    transform: translateX(-100%);
  }

  .admin-sidebar.collapsed {
    transform: translateX(0);
    width: 80px;
  }

  .admin-main {
    margin-left: 0;
  }

  .mobile-menu-btn {
    display: flex;
  }
}

@media (max-width: 768px) {
  .admin-topbar {
    padding: 1rem;
  }

  .module-header {
    padding: 0.5rem 0.75rem;
  }

  .module-title {
    font-size: 1rem;
  }

  .module-subtitle {
    display: none;
  }

  .module-action-btn {
    padding: 0.55rem 0.9rem;
    font-size: 0.8rem;
  }

  .module-action-group {
    gap: 0.5rem;
  }

  .admin-content {
    padding: 1rem;
  }

  .user-name-top {
    display: none;
  }
}
</file>

