<div class="sitemap-container">
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs">
    <div class="breadcrumbs-inner">
      <a routerLink="/home">Inicio</a>
      <span class="separator">/</span>
      <span class="current">Mapa del Sitio</span>
    </div>
  </nav>

  <!-- Header Section -->
  <div class="sitemap-header">
    <div class="header-icon">
      <span class="material-icons">map</span>
    </div>
    <h1 class="sitemap-title">Mapa del Sitio</h1>
    <p class="sitemap-subtitle">
      Navega fácilmente por todas las secciones de Casa de Música Castillo
    </p>
  </div>

  <!-- Sitemap Grid -->
  <div class="sitemap-grid">
    <div class="sitemap-section" *ngFor="let section of siteMapSections; let i = index" [style.animation-delay.ms]="i * 100">
