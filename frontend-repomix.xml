/* ========================================
   FOOTER COMPONENT - CASA DE MÚSICA CASTILLO
======================================== */

.footer-tienda {
  background-color: var(--color-primario);
  color: white;
  margin-top: auto;
}

.footer-principal {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 3rem;
  padding: 3rem 0;
}

/* ========================================
   COLUMNA DE MARCA
======================================== */

.marca-columna {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.footer-logo {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 0.5rem;
}

.logo-icono {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50px;
  height: 50px;
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  backdrop-filter: blur(10px);
}

.logo-icono .material-symbols-outlined {
  font-size: 28px;
  color: var(--color-resalte);
}

.logo-texto {
  display: flex;
  flex-direction: column;
}

.footer-titulo {
  font-family: var(--font-titulos);
  font-size: 1.5rem;
  font-weight: 700;
  margin: 0 0 0.25rem 0;
  color: white;
  line-height: 1.2;
}

.footer-subtitulo {
  font-family: var(--font-cuerpo);
  font-size: 0.875rem;
  color: var(--color-resalte);
  font-weight: 400;
  margin: 0;
}

.footer-descripcion {
  font-family: var(--font-cuerpo);
  font-size: 0.95rem;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.9);
  margin: 0;
}

/* Redes sociales */
.redes-sociales {
  margin-top: 0.5rem;
}

.redes-titulo {
  font-family: var(--font-titulos);
  font-size: 1rem;
  font-weight: 600;
  margin: 0 0 1rem 0;
  color: white;
}

.redes-iconos {
  display: flex;
  gap: 1rem;
}

.red-social {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  color: rgba(255, 255, 255, 0.8);
  text-decoration: none;
  transition: all 0.3s ease;
}

.red-social:hover {
  background-color: var(--color-resalte);
  color: var(--color-primario);
  transform: translateY(-2px);
}

.red-social .material-symbols-outlined {
  font-size: 20px;
}

/* ========================================
   COLUMNA DE ENLACES
======================================== */

.enlaces-columna .footer-titulo {
  margin-bottom: 1.5rem;
}

.enlaces-grupos {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.enlaces-grupo {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.grupo-titulo {
  font-family: var(--font-titulos);
  font-size: 1rem;
  font-weight: 600;
  margin: 0 0 0.5rem 0;
  color: var(--color-resalte);
}

.enlaces-lista {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
