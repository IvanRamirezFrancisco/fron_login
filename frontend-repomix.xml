  filter: drop-shadow(0 2px 4px rgba(199, 93, 44, 0.3));
}

.menu-divider {
  height: 2px;
  background: 
    linear-gradient(90deg, transparent, rgba(199, 93, 44, 0.2), transparent),
    linear-gradient(90deg, rgba(255, 207, 113, 0.1) 0%, rgba(199, 93, 44, 0.1) 50%, rgba(255, 207, 113, 0.1) 100%);
  background-blend-mode: normal, overlay;
  margin: 0.75rem 0;
  border-radius: 1px;
}

.logout-item {
  color: #DC2626;
  border-top: 2px solid rgba(220, 38, 38, 0.1);
  margin-top: 0.75rem;
  font-weight: 600;
}

.logout-item:hover {
  background: linear-gradient(90deg, rgba(220, 38, 38, 0.08), rgba(254, 226, 226, 0.5));
  border-left-color: #DC2626;
  color: #B91C1C;
}

.logout-item:hover .item-icon {
  filter: drop-shadow(0 2px 4px rgba(220, 38, 38, 0.3));
}

/* ===== MOBILE MENU ===== */
.mobile-menu-btn {
  display: none;
  flex-direction: column;
  justify-content: space-around;
  width: 30px;
  height: 30px;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;
}

.hamburger-line {
  width: 25px;
  height: 3px;
  background: white;
  border-radius: 2px;
  transition: all 0.3s ease;
  transform-origin: center;
}

.hamburger-line.active:nth-child(1) {
  transform: rotate(45deg) translate(5px, 5px);
}

.hamburger-line.active:nth-child(2) {
  opacity: 0;
}

.hamburger-line.active:nth-child(3) {
  transform: rotate(-45deg) translate(7px, -6px);
}

.mobile-nav {
  position: fixed;
  top: 65px;
  left: 0;
  right: 0;
  bottom: 0;
  background: white;
  transform: translateX(-100%);
  transition: transform 0.3s ease;
  z-index: 999;
  overflow-y: auto;
}

.mobile-nav.show {
  transform: translateX(0);
}

.mobile-nav-content {
  padding: 1rem;
}

.mobile-nav-item {
  display: flex;
  align-items: center;
  padding: 1rem;
  color: #495057;
  text-decoration: none;
  border-radius: 0.5rem;
  margin-bottom: 0.25rem;
  transition: all 0.2s ease;
}

.mobile-nav-item:hover {
  background: #f8f9fa;
  color: #667eea;
}

.mobile-nav-section {
  margin: 1.5rem 0;
}

.mobile-section-title {
  color: #6c757d;
  font-size: 0.875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 0.75rem;
  padding: 0 1rem;
}

.mobile-nav-footer {
  margin-top: 2rem;
  padding-top: 1rem;
  border-top: 1px solid #dee2e6;
}

.mobile-logout-btn {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 1rem;
  background: transparent;
  border: 1px solid #dc3545;
  border-radius: 0.5rem;
  color: #dc3545;
  font-size: 1rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.mobile-logout-btn:hover {
  background: #dc3545;
  color: white;
}

.mobile-overlay {
  position: fixed;
  top: 65px;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  z-index: 998;
}

.mobile-overlay.show {
  opacity: 1;
  visibility: visible;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
  .desktop-nav {
    display: none;
  }
  
  .mobile-menu-btn {
    display: flex;
  }
  
  .nav-container {
    padding: 0 0.75rem;
    height: 60px;
  }
  
  .brand-link {
    font-size: 1.1rem;
  }
  
  .brand-icon {
    font-size: 1.3rem;
  }
}

@media (max-width: 480px) {
  .nav-container {
    padding: 0 0.5rem;
  }
  
  .brand-text {
    display: none;
  }
}

/* ===== ANIMATIONS ===== */
@keyframes slideDown {
  0% {
    opacity: 0;
    transform: translateY(-15px) scale(0.95);
  }
  50% {
    opacity: 0.8;
    transform: translateY(-5px) scale(0.98);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

.dropdown-menu.show {
  animation: slideDown 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.user-avatar:hover {
  animation: pulse 2s infinite;
}

/* Efecto de brillo en hover para los iconos */
@keyframes iconGlow {
  0%, 100% {
    filter: drop-shadow(0 2px 4px rgba(199, 93, 44, 0.3));
  }
  50% {
    filter: drop-shadow(0 4px 8px rgba(255, 207, 113, 0.6));
  }
}

.dropdown-item:hover .item-icon {
  animation: iconGlow 1.5s ease-in-out infinite;
}

/* ===== SMOOTH SCROLLING ===== */
html {
  scroll-behavior: smooth;
}

/* ===== BODY MARGIN FOR FIXED HEADER ===== */
body {
  padding-top: 65px;
}

@media (max-width: 768px) {
  body {
    padding-top: 60px;
  }
}
</file>

