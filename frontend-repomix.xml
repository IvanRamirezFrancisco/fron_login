                <!-- DURACIÓN -->
                <td class="mnt-hist-duration">{{ histDurationLabel(entry.durationMs) }}</td>

                <!-- ESTADO -->
                <td>
                  @if (entry.status === 'SUCCESS') {
                    <span class="mnt-hist-status-badge mnt-hist-status-badge--success">
