<file path="src/app/components/admin/admin-roles/admin-roles.component.css">
/* ================================================================
   ADMIN ROLES & PERMISSIONS
   Paleta: Tinto #722f37 | Dorado #D4A347 | Oscuro #1a1a2e
   ================================================================ */

:host {
  --wine:        #722f37;
  --wine-dark:   #600018;
  --wine-light:  rgba(128,0,32,.09);
  --gold:        #D4A347;
  --gold-light:  rgba(212,163,71,.13);
  --dark:        #1a1a2e;
  --text-main:   #111827;
  --text-muted:  #6b7280;
  --text-light:  #9ca3af;
  --border:      #e5e7eb;
  --bg-page:     #f8f9fb;
  --bg-card:     #ffffff;
  --radius-card: 14px;
  --radius-btn:  9px;
  --shadow-sm:   0 2px 8px rgba(0,0,0,.07);
  --shadow-md:   0 6px 20px rgba(0,0,0,.11);
  --shadow-lg:   0 14px 44px rgba(0,0,0,.17);
  --transition:  .22s ease;
}

/* -- Wrapper ---------------------------------------------------- */
:host {
  display: block;
}

.roles-wrapper {
  padding: 0;
  max-width: 1400px;
  margin: 0 auto;
}

/* ── Barra de contexto minimalista ────────────────────────────── */
.module-info-bar {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.75rem 1.25rem;
  margin-bottom: 1.5rem;
  background: var(--surface, #fff);
  border: 1px solid var(--border, #e5e7eb);
  border-radius: 12px;
  flex-wrap: wrap;
}

.module-info-bar__stat {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  flex-shrink: 0;
}

.module-info-bar__stat svg {
  width: 16px;
  height: 16px;
  color: var(--wine, #8b1a1a);
  opacity: 0.75;
  flex-shrink: 0;
}

.module-info-bar__num {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--wine, #8b1a1a);
  line-height: 1;
}

.module-info-bar__label {
  font-size: 0.8rem;
  color: var(--text-secondary, #6b7280);
  font-weight: 500;
}

.module-info-bar__divider {
  width: 1px;
  height: 1.5rem;
  background: var(--border, #e5e7eb);
  flex-shrink: 0;
}

.module-info-bar__hint {
  font-size: 0.8rem;
  color: var(--text-secondary, #6b7280);
  margin: 0;
  line-height: 1.4;
  flex: 1;
  min-width: 200px;
}

/* -- Encabezado de p�gina --------------------------------------- */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  margin-bottom: 2rem;
  padding-bottom: 1.5rem;
  border-bottom: 2px solid var(--border);
  flex-wrap: wrap;
}

.page-header__left {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.page-header__icon {
  width: 54px;
  height: 54px;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--wine) 0%, var(--wine-dark) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4px 14px rgba(128,0,32,.3);
}

.page-header__icon svg {
  width: 26px;
  height: 26px;
  stroke: #fff;
}

.page-header__title {
  margin: 0;
  font-size: 1.65rem;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: -.02em;
}

.page-header__subtitle {
  margin: .2rem 0 0;
  font-size: .875rem;
  color: var(--text-muted);
}

.page-header__right {
  display: flex;
  align-items: center;
  gap: .9rem;
}

/* Contador de roles */
.roles-counter {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--wine-light);
  border: 1px solid rgba(128,0,32,.2);
  border-radius: 10px;
  padding: .4rem .9rem;
  min-width: 72px;
}

.roles-counter__num {
  font-size: 1.45rem;
  font-weight: 800;
  color: var(--wine);
  line-height: 1;
}

.roles-counter__label {
  font-size: .68rem;
  color: var(--wine);
  text-transform: uppercase;
  letter-spacing: .04em;
  font-weight: 600;
  margin-top: 1px;
}

/* -- Bot�n Crear ----------------------------------------------- */
.btn-create {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  padding: .65rem 1.3rem;
  background: linear-gradient(135deg, var(--wine) 0%, var(--wine-dark) 100%);
  color: #fff;
  border: none;
  border-radius: var(--radius-btn);
  font-size: .9rem;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition);
  box-shadow: 0 3px 12px rgba(128,0,32,.3);
  white-space: nowrap;
}

.btn-create svg {
  width: 17px;
  height: 17px;
  stroke: #fff;
  flex-shrink: 0;
}

.btn-create:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(128,0,32,.4);
}

.btn-create:active { transform: translateY(0); }

/* -- Alerta acceso restringido --------------------------------- */
.alert-restricted {
  display: flex;
  align-items: center;
  gap: .75rem;
  padding: .9rem 1.25rem;
  background: rgba(212,163,71,.1);
  border: 1px solid rgba(212,163,71,.4);
  border-radius: 10px;
  margin-bottom: 1.5rem;
  font-size: .875rem;
  color: #7a5c00;
}

.alert-restricted svg {
  width: 20px;
  height: 20px;
  stroke: var(--gold);
  flex-shrink: 0;
}

/* -- Loading --------------------------------------------------- */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rem 2rem;
  gap: 1rem;
  color: var(--text-muted);
  font-size: .9rem;
}

.spinner-ring {
  width: 44px;
  height: 44px;
  border: 4px solid #f0f0f0;
  border-top-color: var(--wine);
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* -- Grid de roles --------------------------------------------- */
.roles-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
  gap: 1.5rem;
}

/* -- Tarjeta de rol -------------------------------------------- */
.role-card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  border: 1.5px solid var(--border);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  transition: box-shadow var(--transition), transform var(--transition), border-color var(--transition);
  overflow: hidden;
}

.role-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-3px);
  border-color: rgba(128,0,32,.22);
}

/* Tarjetas de roles del sistema: borde dorado */
.role-card--system {
  border-color: rgba(212,163,71,.45);
  background: linear-gradient(160deg, #fffef5 0%, #fff 60%);
}

.role-card--system:hover {
  border-color: var(--gold);
  box-shadow: 0 6px 22px rgba(212,163,71,.18);
}

/* Cabecera de tarjeta */
.role-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 1.25rem 1.25rem .5rem;
}

.role-card__avatar {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: var(--wine-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.role-card__avatar svg {
  width: 23px;
  height: 23px;
  stroke: var(--wine);
}

.role-card__avatar--gold {
  background: var(--gold-light);
}

.role-card__avatar--gold svg {
  stroke: #9a7020;
}

/* Badge "Sistema" */
.chip-system {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: .25rem .65rem;
  background: var(--gold-light);
  border: 1px solid rgba(212,163,71,.45);
  border-radius: 20px;
  font-size: .71rem;
  font-weight: 700;
  color: #7a5c00;
  letter-spacing: .02em;
  white-space: nowrap;
}

.chip-system svg {
  width: 11px;
  height: 11px;
  stroke: #9a7020;
}

/* Cuerpo de tarjeta */
.role-card__body {
  padding: .6rem 1.25rem .5rem;
  flex: 1;
}

.role-card__name {
  margin: 0 0 .15rem;
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: -.01em;
}

.role-card__full-name {
  margin: 0 0 .4rem;
  font-size: .72rem;
  color: var(--text-light);
  font-family: 'Courier New', monospace;
  letter-spacing: .03em;
}

.role-card__desc {
  margin: 0;
  font-size: .83rem;
  color: var(--text-muted);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Estad�sticas de tarjeta */
.role-card__stats {
  display: flex;
  gap: .75rem;
  padding: .6rem 1.25rem;
}

.stat-pill {
  display: flex;
  align-items: center;
  gap: .35rem;
  font-size: .8rem;
  color: var(--text-muted);
  background: var(--bg-page);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: .25rem .65rem;
}

.stat-pill svg {
  width: 13px;
  height: 13px;
  stroke: var(--text-light);
  flex-shrink: 0;
}

.stat-pill strong {
  color: var(--text-main);
}

/* Pie de tarjeta */
.role-card__own-badge {
  display: flex;
  align-items: center;
  gap: .35rem;
  padding: .35rem 1.25rem;
  font-size: .72rem;
  font-weight: 600;
  color: #4338ca;
  background: #eef2ff;
  border-top: 1px solid #e0e7ff;
  letter-spacing: .02em;
}

.role-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .5rem;
  padding: .85rem 1.25rem 1.1rem;
  border-top: 1px solid #f3f4f6;
  flex-wrap: wrap;
}

/* Botones de acci�n en tarjeta */
.btn-action {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  padding: .48rem .9rem;
  border: none;
  border-radius: 8px;
  font-size: .82rem;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition);
}

.btn-action svg {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
}

.btn-action--primary {
  background: var(--wine-light);
  color: var(--wine);
}

.btn-action--primary svg { stroke: var(--wine); }

.btn-action--primary:hover {
  background: var(--wine);
  color: #fff;
  box-shadow: 0 3px 10px rgba(128,0,32,.25);
}

.btn-action--primary:hover svg { stroke: #fff; }

.btn-action--danger {
  background: rgba(220,38,38,.07);
  color: #dc2626;
}

.btn-action--danger svg { stroke: #dc2626; }

.btn-action--danger:hover {
  background: #dc2626;
  color: #fff;
  box-shadow: 0 3px 10px rgba(220,38,38,.25);
}

.btn-action--danger:hover svg { stroke: #fff; }

/* Etiqueta "Protegido" */
.label-protected {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  font-size: .78rem;
  color: var(--text-light);
  font-style: italic;
}

.label-protected svg {
  width: 13px;
  height: 13px;
  stroke: var(--text-light);
}

/* -- Estado vac�o ---------------------------------------------- */
.empty-state {
  grid-column: 1 / -1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rem 2rem;
  gap: .75rem;
  text-align: center;
  color: var(--text-muted);
}

.empty-state__icon {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: .5rem;
}

.empty-state__icon svg {
  width: 36px;
  height: 36px;
  stroke: #9ca3af;
}

.empty-state h3 {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 600;
  color: #374151;
}

.empty-state p {
  margin: 0;
  font-size: .875rem;
  max-width: 340px;
}

/* ================================================================
   OVERLAY / MODALES
   ================================================================ */

.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.55);
  backdrop-filter: blur(3px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1050;
  padding: 1rem;
  animation: fadeIn .18s ease;
}

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

/* Caja del modal */
.modal-box {
  background: #FDFCFB;
  border-radius: 18px;
  box-shadow: var(--shadow-lg);
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 90vh;
  animation: slideUp .22s ease;
  overflow: hidden;
}

.modal-box--sm { max-width: 460px; }
.modal-box--lg { max-width: 680px; }
.modal-box--xl { max-width: 880px; }

@keyframes slideUp {
  from { opacity: 0; transform: translateY(22px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Cabecera del modal */
.modal-box__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.2rem 1.5rem;
  background: linear-gradient(135deg, var(--dark) 0%, #16213e 100%);
  flex-shrink: 0;
  gap: 1rem;
}

.modal-box__header-info {
  display: flex;
  align-items: center;
  gap: .9rem;
}

.modal-box__header-icon {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  background: rgba(255,255,255,.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.modal-box__header-icon svg {
  width: 20px;
  height: 20px;
  stroke: var(--gold);
}

.modal-box__title {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 700;
  color: #fff;
}

.modal-box__subtitle {
  margin: .1rem 0 0;
  font-size: .8rem;
  color: rgba(255,255,255,.6);
}

.modal-box__subtitle strong { color: var(--gold); }

.modal-box__close {
  width: 34px;
  height: 34px;
  border: none;
  background: rgba(255,255,255,.1);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  flex-shrink: 0;
  transition: background var(--transition);
}

.modal-box__close svg {
  width: 17px;
  height: 17px;
  stroke: rgba(255,255,255,.8);
}

.modal-box__close:hover { background: rgba(255,255,255,.22); }

/* Barra de estad�sticas (modal permisos) */
.modal-stats-bar {
  display: flex;
  gap: 1px;
  background: var(--border);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.modal-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: .75rem 1rem;
  background: #FDFCFB;
  gap: .1rem;
}

.modal-stat__val {
  font-size: 1.45rem;
  font-weight: 800;
  line-height: 1;
  color: #374151;
}

.modal-stat__val--wine { color: var(--wine); }
.modal-stat__val--gold { color: #9a7020; }

.modal-stat__lbl {
  font-size: .7rem;
  color: var(--text-light);
  text-transform: uppercase;
  letter-spacing: .04em;
  font-weight: 600;
}

/* Cuerpo del modal */
.modal-box__body {
  padding: 1.5rem;
  overflow-y: auto;
  flex: 1;
  scrollbar-width: thin;
  scrollbar-color: var(--wine) #f0f0f0;
}

.modal-box__body::-webkit-scrollbar       { width: 5px; }
.modal-box__body::-webkit-scrollbar-track { background: #f0f0f0; }
.modal-box__body::-webkit-scrollbar-thumb { background: var(--wine); border-radius: 3px; }

/* Pie del modal */
.modal-box__footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: .75rem;
  padding: 1rem 1.5rem;
  background: #f9fafb;
  border-top: 1px solid var(--border);
  flex-shrink: 0;
}

/* Botones del modal */
.btn-modal-cancel {
  display: inline-flex;
  align-items: center;
  padding: .55rem 1.2rem;
  background: #FDFCFB;
  color: #374151;
  border: 1.5px solid #d1d5db;
  border-radius: var(--radius-btn);
  font-size: .875rem;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition);
}

.btn-modal-cancel:hover:not(:disabled) {
  border-color: #9ca3af;
  background: #f9fafb;
}

.btn-modal-cancel:disabled { opacity: .5; cursor: not-allowed; }

.btn-modal-confirm {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  padding: .55rem 1.4rem;
  background: linear-gradient(135deg, var(--wine) 0%, var(--wine-dark) 100%);
  color: #fff;
  border: none;
  border-radius: var(--radius-btn);
  font-size: .875rem;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition);
  box-shadow: 0 3px 10px rgba(128,0,32,.25);
}

.btn-modal-confirm:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 5px 16px rgba(128,0,32,.35);
}

.btn-modal-confirm:disabled {
  opacity: .65;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

/* ================================================================
   FORMULARIO
   ================================================================ */

.field-group { margin-bottom: 1.2rem; }

.field-label {
  display: block;
  font-size: .875rem;
  font-weight: 600;
  color: #374151;
  margin-bottom: .45rem;
}

.field-required { color: var(--wine); margin-left: 2px; }

.field-input {
  display: block;
  width: 100%;
  padding: .6rem .875rem;
  font-size: .9rem;
  color: var(--text-main);
  background: #FDFCFB;
  border: 1.5px solid #d1d5db;
  border-radius: var(--radius-btn);
  outline: none;
  transition: border-color var(--transition), box-shadow var(--transition);
  box-sizing: border-box;
  font-family: inherit;
}

.field-input:focus {
  border-color: var(--wine);
  box-shadow: 0 0 0 3px rgba(128,0,32,.12);
}

.field-textarea {
  resize: vertical;
  min-height: 76px;
  line-height: 1.5;
}

/* Campo con prefijo ROLE_ */
.field-prefix-wrap {
  display: flex;
  align-items: center;
  border: 1.5px solid #d1d5db;
  border-radius: var(--radius-btn);
  overflow: hidden;
  transition: border-color var(--transition), box-shadow var(--transition);
}

.field-prefix-wrap:focus-within {
  border-color: var(--wine);
  box-shadow: 0 0 0 3px rgba(128,0,32,.12);
}

.field-prefix {
  padding: .6rem .75rem;
  background: var(--wine-light);
  color: var(--wine);
  font-size: .83rem;
  font-weight: 700;
  letter-spacing: .02em;
  font-family: 'Courier New', monospace;
  white-space: nowrap;
  border-right: 1.5px solid #d1d5db;
  flex-shrink: 0;
}

.field-input--prefixed {
  border: none;
  border-radius: 0;
  box-shadow: none !important;
  flex: 1;
  font-family: 'Courier New', monospace;
  font-size: .88rem;
  letter-spacing: .03em;
}

.field-hint {
  display: block;
  font-size: .78rem;
  color: var(--text-light);
  margin-top: .3rem;
}

/* Fila label + badge de permisos seleccionados */
.perms-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: .3rem;
}

.perms-badge {
  display: inline-flex;
  align-items: center;
  padding: .2rem .65rem;
  border-radius: 20px;
  font-size: .75rem;
  font-weight: 700;
  background: #f3f4f6;
  color: var(--text-muted);
  border: 1px solid var(--border);
  transition: all var(--transition);
}

.perms-badge--ok {
  background: rgba(128,0,32,.08);
  color: var(--wine);
  border-color: rgba(128,0,32,.2);
}

/* ================================================================
   PERMISOS EN MODAL CREAR ROL
   ================================================================ */

.create-perms-scroll {
  border: 1.5px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
  max-height: 340px;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: var(--wine) #f0f0f0;
}

.create-perms-scroll::-webkit-scrollbar       { width: 5px; }
.create-perms-scroll::-webkit-scrollbar-track { background: #f0f0f0; }
.create-perms-scroll::-webkit-scrollbar-thumb { background: var(--wine); border-radius: 3px; }

.create-cat-block { border-bottom: 1px solid var(--border); }
.create-cat-block:last-child { border-bottom: none; }

.create-cat-toggle {
  display: flex;
  align-items: center;
  gap: .6rem;
  cursor: pointer;
  margin: 0;
}

.create-cat-check {
  width: 16px;
  height: 16px;
  cursor: pointer;
  accent-color: var(--wine);
  flex-shrink: 0;
}

.create-cat-abbr {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  border-radius: 6px;
  background: linear-gradient(135deg, var(--wine) 0%, var(--wine-dark) 100%);
  color: #fff;
  font-size: .68rem;
  font-weight: 700;
  flex-shrink: 0;
}

.create-cat-name {
  font-size: .88rem;
  font-weight: 600;
  color: #374151;
}

.create-cat-count {
  font-size: .73rem;
  color: var(--text-light);
  background: var(--border);
  padding: .15rem .5rem;
  border-radius: 12px;
  font-weight: 600;
}

.create-perms-list {
  display: flex;
  flex-direction: column;
}

.create-perm-item {
  display: flex;
  align-items: flex-start;
  gap: .65rem;
  padding: .6rem 1rem;
  border-bottom: 1px solid #f9fafb;
  cursor: pointer;
  transition: background var(--transition);
  user-select: none;
}

.create-perm-item:last-child { border-bottom: none; }
.create-perm-item:hover { background: var(--wine-light); }
.create-perm-item--on  { background: rgba(128,0,32,.05); }
.create-perm-item--on:hover { background: rgba(128,0,32,.1); }

.create-perm-check {
  width: 15px;
  height: 15px;
  margin-top: 2px;
  cursor: pointer;
  accent-color: var(--wine);
  flex-shrink: 0;
}

.create-perm-info {
  display: flex;
  flex-direction: column;
  gap: .1rem;
  min-width: 0;
}

.create-perm-name {
  font-size: .82rem;
  font-weight: 600;
  color: var(--text-main);
}

.create-perm-desc {
  font-size: .75rem;
  color: var(--text-muted);
}

/* ================================================================
   PERMISOS EN MODAL CONFIGURAR PERMISOS
   ================================================================ */

.perms-scroll {
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
}

.cat-block {
  border: 1.5px solid var(--border);
  border-radius: 11px;
  overflow: hidden;
  transition: border-color var(--transition);
}

.cat-block:hover {
  border-color: rgba(128,0,32,.2);
}

.cat-toggle {
  display: flex;
  align-items: center;
  gap: .65rem;
  cursor: pointer;
  margin: 0;
}

.cat-check {
  width: 16px;
  height: 16px;
  cursor: pointer;
  accent-color: var(--wine);
  flex-shrink: 0;
}

.cat-abbr {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 27px;
  height: 27px;
  border-radius: 7px;
  background: linear-gradient(135deg, var(--wine) 0%, var(--wine-dark) 100%);
  color: #fff;
  font-size: .7rem;
  font-weight: 700;
  flex-shrink: 0;
}

.cat-name {
  font-size: .9rem;
  font-weight: 600;
  color: #374151;
}

.cat-count {
  font-size: .73rem;
  color: var(--text-light);
  background: var(--border);
  padding: .18rem .55rem;
  border-radius: 12px;
  font-weight: 600;
}

.perms-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
}

.perm-item {
  display: flex;
  align-items: flex-start;
  gap: .6rem;
  padding: .75rem 1rem;
  border-bottom: 1px solid #f3f4f6;
  border-right: 1px solid #f3f4f6;
  cursor: pointer;
  transition: background var(--transition);
  user-select: none;
}

.perm-item:hover { background: var(--wine-light); }
.perm-item--on   { background: rgba(128,0,32,.05); }
.perm-item--on:hover { background: rgba(128,0,32,.1); }

.perm-check {
  width: 15px;
  height: 15px;
  margin-top: 2px;
  cursor: pointer;
  accent-color: var(--wine);
  flex-shrink: 0;
}

.perm-info {
  display: flex;
  flex-direction: column;
  gap: .12rem;
  min-width: 0;
}

.perm-name {
  font-size: .82rem;
  font-weight: 600;
  color: var(--text-main);
  word-break: break-word;
}

.perm-desc {
  font-size: .74rem;
  color: var(--text-muted);
  line-height: 1.4;
}

.perm-tags {
  display: flex;
  gap: .3rem;
  flex-wrap: wrap;
  margin-top: .2rem;
}

.tag-resource {
  display: inline-block;
  padding: .12rem .4rem;
  border-radius: 4px;
  font-size: .66rem;
  font-weight: 700;
  background: var(--wine-light);
  color: var(--wine);
  letter-spacing: .02em;
}

.tag-action {
  display: inline-block;
  padding: .12rem .4rem;
  border-radius: 4px;
  font-size: .66rem;
  font-weight: 700;
  background: var(--gold-light);
  color: #7a5c00;
  letter-spacing: .02em;
}

/* Spinner peque�o */
.spinner-xs {
  display: inline-block;
  width: 14px;
  height: 14px;
  border: 2.5px solid rgba(255,255,255,.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin .7s linear infinite;
  flex-shrink: 0;
}

input[type="checkbox"]:indeterminate {
  accent-color: var(--wine);
}

/* -- Responsive ------------------------------------------------ */
@media (max-width: 900px) {
  .roles-grid {
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .modal-box--xl { max-width: 98vw; }
  .perms-grid    { grid-template-columns: 1fr; }
  .modal-stats-bar { flex-wrap: wrap; }
}

@media (max-width: 620px) {
  .page-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .page-header__title  { font-size: 1.3rem; }
  .roles-grid          { grid-template-columns: 1fr; }
  .modal-box--sm,
  .modal-box--lg       { max-width: 98vw; }
  .modal-box__body     { padding: 1rem; }

  .modal-box__footer {
    padding: .75rem 1rem;
    flex-wrap: wrap;
  }

  .btn-modal-confirm,
  .btn-modal-cancel {
    flex: 1;
    justify-content: center;
  }
}

/* ================================================================
   NUEVOS ESTILOS � Mejoras UX v2
   ================================================================ */

/* -- Stat-pill clickeable -------------------------------------- */
button.stat-pill {
  all: unset;
  display: flex;
  align-items: center;
  gap: .35rem;
  font-size: .8rem;
  color: var(--text-muted);
  background: var(--bg-page);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: .25rem .65rem;
  cursor: pointer;
  transition: background var(--transition), border-color var(--transition), color var(--transition), transform var(--transition);
  box-sizing: border-box;
  font-family: inherit;
}

button.stat-pill svg {
  width: 13px;
  height: 13px;
  stroke: var(--text-light);
  flex-shrink: 0;
  transition: stroke var(--transition);
}

button.stat-pill strong {
  color: var(--text-main);
}

button.stat-pill:hover {
  background: var(--wine-light);
  border-color: rgba(128,0,32,.3);
  color: var(--wine);
  transform: translateY(-1px);
}

button.stat-pill:hover svg {
  stroke: var(--wine);
}

button.stat-pill:hover strong {
  color: var(--wine);
}

/* -- Bot�n "Ver Permisos" (solo lectura) ----------------------- */
.btn-action--view {
  background: rgba(59,130,246,.07);
  color: #2563eb;
}

.btn-action--view svg {
  stroke: #2563eb;
}

.btn-action--view:hover {
  background: #2563eb;
  color: #fff;
  box-shadow: 0 3px 10px rgba(37,99,235,.25);
}

.btn-action--view:hover svg {
  stroke: #fff;
}

/* -- Badge "Solo lectura" en header del modal ------------------ */
.badge-readonly {
  display: inline-flex;
  align-items: center;
  margin-left: .5rem;
  padding: .15rem .5rem;
  background: rgba(212,163,71,.18);
  border: 1px solid rgba(212,163,71,.4);
  border-radius: 10px;
  font-size: .7rem;
  font-weight: 700;
  color: #b8903d;
  letter-spacing: .03em;
  vertical-align: middle;
}

/* -- Tabla de usuarios por rol --------------------------------- */
.users-table {
  width: 100%;
  border-collapse: collapse;
  font-size: .875rem;
}

.users-table thead tr {
  background: #f9fafb;
  border-bottom: 2px solid var(--border);
}

.users-table th {
  padding: .65rem 1rem;
  text-align: left;
  font-size: .73rem;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: .05em;
  white-space: nowrap;
}

.users-table__row {
  border-bottom: 1px solid #f3f4f6;
  transition: background var(--transition);
}

.users-table__row:last-child {
  border-bottom: none;
}

.users-table__row:hover {
  background: var(--wine-light);
}

.users-table td {
  padding: .7rem 1rem;
  vertical-align: middle;
}

/* Celda nombre con avatar */
.user-cell {
  display: flex;
  align-items: center;
  gap: .65rem;
  font-weight: 500;
  color: var(--text-main);
}

.user-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--wine) 0%, var(--wine-dark) 100%);
  color: #fff;
  font-size: .72rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  text-transform: uppercase;
}

.user-email {
  color: var(--text-muted);
  font-size: .82rem;
}

.user-date {
  color: var(--text-light);
  font-size: .8rem;
  white-space: nowrap;
}

/* -- Badge de estado ------------------------------------------- */
.status-dot {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  padding: .22rem .6rem;
  border-radius: 20px;
  font-size: .73rem;
  font-weight: 700;
  white-space: nowrap;
}

.status-dot::before {
  content: '';
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-dot--active {
  background: rgba(22,163,74,.1);
  color: #16a34a;
}

.status-dot--active::before {
  background: #16a34a;
}

.status-dot--disabled {
  background: rgba(107,114,128,.1);
  color: #6b7280;
}

.status-dot--disabled::before {
  background: #9ca3af;
}

.status-dot--locked {
  background: rgba(220,38,38,.08);
  color: #dc2626;
}

.status-dot--locked::before {
  background: #dc2626;
}

/* -- Paginaci�n del modal usuarios ----------------------------- */
.users-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .35rem;
  padding: 1rem 0 .25rem;
}

.pg-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32px;
  height: 32px;
  padding: 0 .4rem;
  border: 1.5px solid var(--border);
  border-radius: 8px;
  background: #FDFCFB;
  color: var(--text-muted);
  font-size: .82rem;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition);
}

.pg-btn:hover:not(:disabled):not(.pg-btn--active) {
  border-color: var(--wine);
  color: var(--wine);
  background: var(--wine-light);
}

.pg-btn--active {
  background: var(--wine);
  border-color: var(--wine);
  color: #fff;
  cursor: default;
}

.pg-btn:disabled {
  opacity: .4;
  cursor: not-allowed;
}

/* -- Readonly: cursor default en items de permisos ------------- */
.perm-item--readonly {
  cursor: default;
  opacity: .85;
}

.perm-item--readonly:hover {
  background: transparent;
}

/* ================================================================
   ACCORDION (Collapsible Categories)
   ================================================================ */

/* Cabecera de categoría clickeable */
.cat-block__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: .7rem 1rem;
  background: #f9fafb;
  border-bottom: 1px solid var(--border);
  cursor: pointer;
  user-select: none;
  transition: background var(--transition);
}

.cat-block__header:hover {
  background: #f3f4f6;
}

.cat-header-left {
  display: flex;
  align-items: center;
  gap: .65rem;
}

.cat-header-right {
  display: flex;
  align-items: center;
  gap: .5rem;
}

.cat-chevron {
  width: 16px;
  height: 16px;
  stroke: var(--text-light);
  transition: transform .25s ease;
  flex-shrink: 0;
}

.cat-block--collapsed .cat-chevron {
  transform: rotate(-90deg);
}

.cat-block--collapsed .cat-block__header {
  border-bottom: none;
}

/* Cat body transition */
.cat-body {
  overflow: hidden;
}

/* Selection badge N/M */
.cat-selection-badge {
  display: inline-flex;
  align-items: center;
  padding: .15rem .55rem;
  border-radius: 12px;
  font-size: .72rem;
  font-weight: 700;
  background: #f3f4f6;
  color: var(--text-light);
  border: 1px solid var(--border);
  min-width: 36px;
  justify-content: center;
  transition: all var(--transition);
}

.cat-selection-badge--active {
  background: rgba(128,0,32,.08);
  color: var(--wine);
  border-color: rgba(128,0,32,.2);
}

/* Create modal accordion */
.create-cat-block--collapsed .create-perms-list {
  display: none;
}

.create-cat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: .65rem 1rem;
  background: #f9fafb;
  border-bottom: 1px solid var(--border);
  cursor: pointer;
  user-select: none;
  transition: background var(--transition);
}

.create-cat-header:hover {
  background: #f3f4f6;
}

.create-cat-right {
  display: flex;
  align-items: center;
  gap: .5rem;
}

.create-cat-block--collapsed .cat-chevron {
  transform: rotate(-90deg);
}

.create-cat-block--collapsed .create-cat-header {
  border-bottom: none;
}

/* ================================================================
   ACTION TAGS (color-coded by permission type)
   ================================================================ */

.tag-action {
  display: inline-block;
  padding: .12rem .45rem;
  border-radius: 4px;
  font-size: .66rem;
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
  /* Default: neutral */
  background: #f3f4f6;
  color: var(--text-muted);
}

.tag-action.action--view {
  background: rgba(59,130,246,.1);
  color: #2563eb;
}

.tag-action.action--create {
  background: rgba(22,163,74,.1);
  color: #16a34a;
}

.tag-action.action--edit {
  background: rgba(212,163,71,.12);
  color: #92700c;
}

.tag-action.action--delete {
  background: rgba(220,38,38,.08);
  color: #dc2626;
}

.tag-action.action--manage {
  background: rgba(128,0,32,.08);
  color: var(--wine);
}

/* Technical name badge */
.tag-technical {
  display: inline-block;
  padding: .12rem .4rem;
  border-radius: 4px;
  font-size: .62rem;
  font-weight: 600;
  background: #f3f4f6;
  color: var(--text-light);
  font-family: 'Courier New', monospace;
  letter-spacing: .02em;
}

/* Create modal perm tags */
.create-perm-tags {
  display: flex;
  gap: .3rem;
  flex-wrap: wrap;
  margin-top: .2rem;
}

/* ================================================================
   TAG RESOURCE — REMOVE OLD STYLE (replaced by action tags)
   ================================================================ */
.tag-resource {
  display: inline-block;
  padding: .12rem .4rem;
  border-radius: 4px;
  font-size: .66rem;
  font-weight: 700;
  background: var(--wine-light);
  color: var(--wine);
  letter-spacing: .02em;
}

/* ================================================================
   SEARCH BAR
   ================================================================ */
.search-bar {
  display: flex;
  align-items: center;
  gap: .75rem;
  margin-bottom: 1.25rem;
}

.search-bar__input-wrap {
  position: relative;
  display: flex;
  align-items: center;
  flex: 1;
  max-width: 420px;
}

.search-bar__icon {
  position: absolute;
  left: 12px;
  width: 16px;
  height: 16px;
  color: var(--text-muted);
  pointer-events: none;
}

.search-bar__input {
  width: 100%;
  padding: .55rem .55rem .55rem 36px;
  border: 1px solid var(--border);
  border-radius: var(--radius-btn);
  font-size: .85rem;
  color: var(--text-main);
  background: var(--bg-card);
  transition: border-color var(--transition), box-shadow var(--transition);
  outline: none;
}

.search-bar__input::placeholder {
  color: var(--text-light);
}

.search-bar__input:focus {
  border-color: var(--wine);
  box-shadow: 0 0 0 3px rgba(114,47,55,.1);
}

.search-bar__clear {
  position: absolute;
  right: 8px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 2px;
  color: var(--text-muted);
  display: flex;
  align-items: center;
}

.search-bar__clear svg {
  width: 14px;
  height: 14px;
}

.search-bar__clear:hover {
  color: var(--wine);
}

.search-bar__count {
  font-size: .78rem;
  color: var(--text-muted);
  white-space: nowrap;
}

/* ================================================================
   CHIP CUSTOM (for non-system roles)
   ================================================================ */
.chip-custom {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: .25rem .65rem;
  background: rgba(114,47,55,.08);
  border: 1px solid rgba(114,47,55,.25);
  border-radius: 20px;
  font-size: .71rem;
  font-weight: 700;
  color: var(--wine);
  letter-spacing: .02em;
  white-space: nowrap;
}

.chip-custom svg {
  width: 11px;
  height: 11px;
  stroke: var(--wine);
}

/* ================================================================
   ROLE CARD — CUSTOM VARIANT
   ================================================================ */
.role-card--custom {
  border-left: 3px solid var(--wine);
}

.role-card--custom:hover {
  border-left-color: var(--wine-dark);
}

/* ================================================================
   STAT PILL — CATEGORIES
   ================================================================ */
.stat-pill--categories {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  padding: .3rem .65rem;
  background: #f3f4f6;
  border-radius: 20px;
  font-size: .76rem;
  color: var(--text-muted);
  white-space: nowrap;
}

.stat-pill--categories svg {
  width: 13px;
  height: 13px;
}

/* ================================================================
   FIELD ERROR (duplicate name)
   ================================================================ */
.field-error {
  display: block;
  margin-top: .3rem;
  font-size: .78rem;
  color: #c62828;
  font-weight: 600;
}
</file>

<file path="src/app/components/admin/admin-roles/admin-roles.component.html">
<!-- ================================================================
     GESTIÓN DE ROLES Y PERMISOS
     Accesible solo para SUPER_ADMIN (protegido por SuperAdminGuard)
     ================================================================ -->
<div class="roles-wrapper">

  <!-- ── BARRA DE CONTEXTO MINIMALISTA ─────────────────────── -->
  <div class="module-info-bar">
    <div class="module-info-bar__stat">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
      <span class="module-info-bar__num">{{ roles.length }}</span>
      <span class="module-info-bar__label">roles activos</span>
    </div>
    <div class="module-info-bar__divider"></div>
    <div class="module-info-bar__stat">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
      </svg>
      <span class="module-info-bar__num">{{ getTotalPermissionsCount() }}</span>
      <span class="module-info-bar__label">permisos totales</span>
    </div>
    <div class="module-info-bar__divider"></div>
    <p class="module-info-bar__hint">
      Configura los roles del sistema y sus permisos de acceso. Los roles del sistema no pueden modificarse.
    </p>
  </div>

  <!-- ── AVISO ACCESO RESTRINGIDO ──────────────────────────── -->
  <div *ngIf="isReadOnlyMode" class="alert-restricted">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <line x1="12" y1="8" x2="12" y2="12"/>
      <line x1="12" y1="16" x2="12.01" y2="16"/>
    </svg>
    <span>Tienes acceso de <strong>solo lectura</strong> a los roles del sistema. Contacta al Super Administrador para realizar cambios.</span>
  </div>

  <!-- ── BARRA DE BUSQUEDA ─────────────────────────────────── -->
  <div class="search-bar">
    <div class="search-bar__input-wrap">
      <svg class="search-bar__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input type="text" class="search-bar__input"
             [(ngModel)]="searchTerm"
             placeholder="Buscar rol por nombre o descripcion..."
             autocomplete="off">
      <button *ngIf="searchTerm" class="search-bar__clear" (click)="searchTerm = ''">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <span class="search-bar__count" *ngIf="searchTerm">
      {{ filteredRoles.length }} de {{ roles.length }} roles
    </span>
  </div>

  <!-- ── CARGANDO ───────────────────────────────────────────── -->
  <div *ngIf="loading" class="loading-state">
    <div class="spinner-ring"></div>
    <p>Cargando roles del sistema...</p>
  </div>

  <!-- ── GRID DE TARJETAS ───────────────────────────────────── -->
  <div *ngIf="!loading" class="roles-grid">

    <div *ngFor="let role of filteredRoles"
         class="role-card"
         [class.role-card--system]="isImmutableRole(role)"
         [class.role-card--custom]="!isImmutableRole(role)">

      <!-- Cabecera de tarjeta -->
      <div class="role-card__head">
        <div class="role-card__avatar" [class.role-card__avatar--gold]="isImmutableRole(role)">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <span *ngIf="isImmutableRole(role)" class="chip-system">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          Sistema
        </span>
        <span *ngIf="!isImmutableRole(role)" class="chip-custom">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
          </svg>
          Personalizado
        </span>
      </div>

      <!-- Nombre del rol -->
      <div class="role-card__body">
        <h3 class="role-card__name">{{ displayName(role.name) }}</h3>
        <p class="role-card__full-name">{{ role.name }}</p>
        <p class="role-card__desc">{{ role.description || "Sin descripción asignada." }}</p>
      </div>

      <!-- Estadísticas -->
      <div class="role-card__stats">
        <button class="stat-pill stat-pill--clickable"
                (click)="openPermissionsModal(role)"
                title="Ver permisos de este rol">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
          </svg>
          <span><strong>{{ (role.permissions.length) || 0 }}</strong> permisos</span>
        </button>
        <button class="stat-pill stat-pill--clickable"
                (click)="openRoleUsersModal(role)"
                title="Ver usuarios con este rol">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          <span><strong>{{ role.userCount || 0 }}</strong> usuarios</span>
        </button>
        <span class="stat-pill stat-pill--categories" title="Categorias de permisos">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
            <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
          </svg>
          <span><strong>{{ getRoleCategoryCount(role) }}</strong> cat.</span>
        </span>
      </div>

      <!-- Indicador de rol propio -->
      <div *ngIf="isOwnRole(role)" class="role-card__own-badge">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             style="width:14px;height:14px">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        Tu rol actual
      </div>

      <!-- Acciones -->
      <div class="role-card__footer">
        <!-- Botón editar permisos: visible si puede editar Y no es su propio rol -->
        <button
          *ngIf="canEditPermissions(role) && !isOwnRole(role)"
          class="btn-action btn-action--primary"
          (click)="openPermissionsModal(role)"
          title="Configurar permisos">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/>
          </svg>
          Permisos
        </button>

        <!-- Botón ver permisos (solo lectura): para inmutables, propio rol, o sin PERMISSION_ASSIGN -->
        <button
          *ngIf="!canEditPermissions(role) || isImmutableRole(role) || isOwnRole(role)"
          class="btn-action btn-action--view"
          (click)="openPermissionsModalReadOnly(role)"
          title="Ver permisos (solo lectura)">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          Ver Permisos
        </button>

        <!-- Botón eliminar: no puede eliminar su propio rol -->
        <button
          *ngIf="canDelete(role) && !isOwnRole(role)"
          class="btn-action btn-action--danger"
          (click)="deleteRole(role)"
          title="Eliminar rol">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"/>
            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
            <path d="M10 11v6"/><path d="M14 11v6"/>
            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
          </svg>
          Eliminar
        </button>
      </div>

    </div><!-- /role-card -->

    <!-- Sin resultados de busqueda -->
    <div *ngIf="filteredRoles.length === 0 && roles.length > 0 && searchTerm" class="empty-state">
      <div class="empty-state__icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          <line x1="8" y1="11" x2="14" y2="11"/>
        </svg>
      </div>
      <h3>Sin resultados</h3>
      <p>No se encontraron roles que coincidan con "<strong>{{ searchTerm }}</strong>".</p>
      <button class="btn-create" (click)="searchTerm = ''">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
        Limpiar busqueda
      </button>
    </div>

    <!-- Estado vacío -->
    <div *ngIf="roles.length === 0 && !searchTerm" class="empty-state">
      <div class="empty-state__icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <line x1="9" y1="9" x2="15" y2="15"/><line x1="15" y1="9" x2="9" y2="15"/>
        </svg>
      </div>
      <h3>No hay roles configurados</h3>
      <p>Crea el primer rol del sistema para comenzar a gestionar permisos.</p>
      <button *ngIf="canCreateRole()" class="btn-create" (click)="openCreateRoleModal()">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Crear primer rol
      </button>
    </div>

  </div><!-- /roles-grid -->

</div><!-- /roles-wrapper -->


<!-- ================================================================
     MODAL: CREAR ROL (incluye selector de permisos obligatorio)
     ================================================================ -->
<div *ngIf="showRoleModal" class="overlay" (click)="closeRoleModal()">
  <div class="modal-box modal-box--lg" (click)="$event.stopPropagation()">

    <div class="modal-box__header">
      <div class="modal-box__header-info">
        <div class="modal-box__header-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>
          </svg>
        </div>
        <div>
          <h2 class="modal-box__title">Crear Nuevo Rol</h2>
          <p class="modal-box__subtitle">Completa los datos y asigna al menos un permiso</p>
        </div>
      </div>
      <button class="modal-box__close" (click)="closeRoleModal()">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div class="modal-box__body">

      <div class="field-group">
        <label class="field-label" for="roleName">
          Nombre del Rol <span class="field-required">*</span>
        </label>
        <div class="field-prefix-wrap">
          <span class="field-prefix">ROLE_</span>
          <input type="text" id="roleName"
                 class="field-input field-input--prefixed"
                 [(ngModel)]="roleFormData.name"
                 (input)="onRoleNameInput($event)"
                 placeholder="NOMBRE_ROL"
                 autocomplete="off">
        </div>
        <small class="field-hint">Solo letras mayusculas y guiones bajos. El prefijo ROLE_ se agrega automaticamente.</small>
        <small *ngIf="isNameDuplicate()" class="field-error">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
               style="width:13px;height:13px;vertical-align:middle;margin-right:4px">
            <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/>
            <line x1="9" y1="9" x2="15" y2="15"/>
          </svg>
          Ya existe un rol con este nombre.
        </small>
      </div>

      <div class="field-group">
        <label class="field-label" for="roleDesc">Descripción</label>
        <textarea id="roleDesc" class="field-input field-textarea" rows="2"
                  [(ngModel)]="roleFormData.description"
                  placeholder="Describe brevemente las responsabilidades de este rol..."></textarea>
      </div>

      <div class="field-group">
        <div class="perms-label-row">
          <label class="field-label">
            Permisos del Rol <span class="field-required">*</span>
          </label>
          <span class="perms-badge" [class.perms-badge--ok]="selectedPermissions.length > 0">
            {{ selectedPermissions.length }} seleccionado(s)
          </span>
        </div>
        <p class="field-hint" style="margin-bottom:.75rem">
          Debes seleccionar al menos un permiso. Puedes modificarlos después.
        </p>

        <div class="create-perms-scroll">
          <div *ngFor="let category of getCategories()" class="create-cat-block"
               [class.create-cat-block--collapsed]="isCreateCategoryCollapsed(category)">
            <div class="create-cat-header" (click)="toggleCreateCategoryCollapse(category)">
              <label class="create-cat-toggle" (click)="$event.stopPropagation()">
                <input type="checkbox" class="create-cat-check"
                       [checked]="isCategoryFullySelected(category)"
                       [indeterminate]="isCategoryPartiallySelected(category)"
                       (change)="toggleCategory(category, $any($event.target).checked)">
                <span class="create-cat-abbr">{{ getCategoryAbbr(category) }}</span>
                <span class="create-cat-name">{{ translateCategory(category) }}</span>
              </label>
              <div class="create-cat-right">
                <span class="cat-selection-badge"
                      [class.cat-selection-badge--active]="categorySelectedCount(category) > 0">
                  {{ categorySelectedCount(category) }}/{{ permissionsByCategory[category].length }}
                </span>
                <svg class="cat-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </div>
            </div>
            <div class="create-perms-list" *ngIf="!isCreateCategoryCollapsed(category)">
              <div *ngFor="let perm of permissionsByCategory[category]"
                   class="create-perm-item"
                   [class.create-perm-item--on]="isPermissionSelected(perm.id)"
                   (click)="togglePermission(perm.id)">
                <input type="checkbox" class="create-perm-check"
                       [checked]="isPermissionSelected(perm.id)"
                       (click)="$event.stopPropagation()">
                <div class="create-perm-info">
                  <span class="create-perm-name">{{ translatePermission(perm.name) }}</span>
                  <span class="create-perm-desc">{{ perm.description }}</span>
                  <div class="create-perm-tags">
                    <span class="tag-action" [ngClass]="getActionClass(perm.name)">{{ getPermissionAction(perm.name) }}</span>
                    <span class="tag-technical">{{ perm.name }}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

    </div><!-- /body -->

    <div class="modal-box__footer">
      <button class="btn-modal-cancel" (click)="closeRoleModal()" [disabled]="savingRole">
        Cancelar
      </button>
      <button class="btn-modal-confirm" (click)="saveRole()" [disabled]="savingRole || isNameDuplicate()">
        <span *ngIf="savingRole" class="spinner-xs"></span>
        <svg *ngIf="!savingRole" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
             stroke-linejoin="round" style="width:16px;height:16px">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        {{ savingRole ? "Creando..." : "Crear Rol" }}
      </button>
    </div>

  </div>
</div>


<!-- ================================================================
     MODAL: CONFIGURAR PERMISOS (para roles ya creados)
     ================================================================ -->
<div *ngIf="showPermissionsModal" class="overlay" (click)="closePermissionsModal()">
  <div class="modal-box modal-box--xl" (click)="$event.stopPropagation()">

    <div class="modal-box__header">
      <div class="modal-box__header-info">
        <div class="modal-box__header-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
          </svg>
        </div>
        <div>
          <h2 class="modal-box__title">
            {{ permissionsModalReadOnly ? 'Ver Permisos' : 'Configurar Permisos' }}
          </h2>
          <p class="modal-box__subtitle">
            Rol: <strong>{{ selectedRole?.name }}</strong>
            <span *ngIf="permissionsModalReadOnly" class="badge-readonly">Solo lectura</span>
          </p>
        </div>
      </div>
      <button class="modal-box__close" (click)="closePermissionsModal()">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div class="modal-stats-bar">
      <div class="modal-stat">
        <span class="modal-stat__val modal-stat__val--wine">{{ selectedPermissions.length }}</span>
        <span class="modal-stat__lbl">Seleccionados</span>
      </div>
      <div class="modal-stat">
        <span class="modal-stat__val">{{ allPermissions.length }}</span>
        <span class="modal-stat__lbl">Disponibles</span>
      </div>
      <div class="modal-stat">
        <span class="modal-stat__val modal-stat__val--gold">{{ getCategories().length }}</span>
        <span class="modal-stat__lbl">Categorías</span>
      </div>
    </div>

    <div class="modal-box__body">
      <div class="perms-scroll">
        <div *ngFor="let category of getCategories()" class="cat-block"
             [class.cat-block--collapsed]="isCategoryCollapsed(category)">

          <!-- Cabecera de categoría (acordeón) -->
          <div class="cat-block__header" (click)="toggleCategoryCollapse(category)">
            <div class="cat-header-left">
              <label class="cat-toggle" (click)="$event.stopPropagation()">
                <input type="checkbox" class="cat-check"
                       [checked]="isCategoryFullySelected(category)"
                       [indeterminate]="isCategoryPartiallySelected(category)"
                       [disabled]="permissionsModalReadOnly"
                       (change)="toggleCategory(category, $any($event.target).checked)">
              </label>
              <span class="cat-abbr">{{ getCategoryAbbr(category) }}</span>
              <span class="cat-name">{{ translateCategory(category) }}</span>
            </div>
            <div class="cat-header-right">
              <span class="cat-selection-badge"
                    [class.cat-selection-badge--active]="categorySelectedCount(category) > 0">
                {{ categorySelectedCount(category) }}/{{ permissionsByCategory[category].length }}
              </span>
              <svg class="cat-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </div>
          </div>

          <!-- Permisos (colapsable) -->
          <div class="cat-body" *ngIf="!isCategoryCollapsed(category)">
            <div class="perms-grid">
              <div *ngFor="let perm of permissionsByCategory[category]"
                   class="perm-item"
                   [class.perm-item--on]="isPermissionSelected(perm.id)"
                   [class.perm-item--readonly]="permissionsModalReadOnly"
                   (click)="togglePermission(perm.id)">
                <input type="checkbox" class="perm-check"
                       [checked]="isPermissionSelected(perm.id)"
                       [disabled]="permissionsModalReadOnly"
                       (click)="$event.stopPropagation()">
                <div class="perm-info">
                  <span class="perm-name">{{ translatePermission(perm.name) }}</span>
                  <span class="perm-desc">{{ perm.description }}</span>
                  <div class="perm-tags">
                    <span class="tag-action" [ngClass]="getActionClass(perm.name)">{{ getPermissionAction(perm.name) }}</span>
                    <span class="tag-technical">{{ perm.name }}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <div class="modal-box__footer">
      <button class="btn-modal-cancel" (click)="closePermissionsModal()" [disabled]="savingPermissions">
        {{ permissionsModalReadOnly ? 'Cerrar' : 'Cancelar' }}
      </button>
      <button *ngIf="!permissionsModalReadOnly"
              class="btn-modal-confirm" (click)="savePermissions()" [disabled]="savingPermissions">
        <span *ngIf="savingPermissions" class="spinner-xs"></span>
        <svg *ngIf="!savingPermissions" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
             stroke-linejoin="round" style="width:16px;height:16px">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        {{ savingPermissions ? "Guardando..." : "Guardar Permisos" }}
      </button>
    </div>

  </div>
</div>


<!-- ================================================================
     MODAL: USUARIOS POR ROL (auditoría — lista paginada)
     ================================================================ -->
<div *ngIf="showUsersModal" class="overlay" (click)="closeUsersModal()">
  <div class="modal-box modal-box--lg" (click)="$event.stopPropagation()">

    <div class="modal-box__header">
      <div class="modal-box__header-info">
        <div class="modal-box__header-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <div>
          <h2 class="modal-box__title">Usuarios con este Rol</h2>
          <p class="modal-box__subtitle">
            Rol: <strong>{{ usersModalRole?.name }}</strong>
            <span *ngIf="usersPage"> · {{ usersPage.totalElements }} usuario(s)</span>
          </p>
        </div>
      </div>
      <button class="modal-box__close" (click)="closeUsersModal()">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div class="modal-box__body">

      <!-- Cargando -->
      <div *ngIf="usersModalLoading" class="loading-state">
        <div class="spinner-ring"></div>
        <p>Cargando usuarios...</p>
      </div>

      <!-- Sin usuarios -->
      <div *ngIf="!usersModalLoading && usersPage && usersPage.content.length === 0"
           class="empty-state" style="padding:3rem 1rem">
        <div class="empty-state__icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <line x1="17" y1="11" x2="23" y2="17"/><line x1="23" y1="11" x2="17" y2="17"/>
          </svg>
        </div>
        <h3>Sin usuarios asignados</h3>
        <p>Ningún usuario tiene el rol <strong>{{ usersModalRole?.name }}</strong> actualmente.</p>
      </div>

      <!-- Tabla de usuarios -->
      <table *ngIf="!usersModalLoading && usersPage && usersPage.content.length > 0"
             class="users-table">
        <thead>
          <tr>
            <th>Usuario</th>
            <th>Email</th>
            <th>Estado</th>
            <th>Registro</th>
          </tr>
        </thead>
        <tbody>
          <tr *ngFor="let u of usersPage.content" class="users-table__row">
            <td class="user-cell">
              <div class="user-avatar">{{ u.firstName.charAt(0) }}{{ u.lastName.charAt(0) }}</div>
              <span>{{ u.firstName }} {{ u.lastName }}</span>
            </td>
            <td class="user-email">{{ u.email }}</td>
            <td>
              <span class="status-dot"
                    [class.status-dot--active]="u.enabled && u.accountNonLocked"
                    [class.status-dot--disabled]="!u.enabled"
                    [class.status-dot--locked]="u.enabled && !u.accountNonLocked">
                {{ u.enabled && u.accountNonLocked ? 'Activo' : (!u.enabled ? 'Desactivado' : 'Bloqueado') }}
              </span>
            </td>
            <td class="user-date">{{ u.createdAt | date:'dd/MM/yyyy' }}</td>
          </tr>
        </tbody>
      </table>

      <!-- Paginación -->
      <div *ngIf="usersPage && usersPage.totalPages > 1" class="users-pagination">
        <button class="pg-btn" (click)="goToUsersPage(usersCurrentPage - 1)"
                [disabled]="usersPage.first">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
               width="16" height="16">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>
        <button *ngFor="let p of getUsersPageNumbers()"
                class="pg-btn" [class.pg-btn--active]="p === usersCurrentPage"
                (click)="goToUsersPage(p)">
          {{ p + 1 }}
        </button>
        <button class="pg-btn" (click)="goToUsersPage(usersCurrentPage + 1)"
                [disabled]="usersPage.last">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
               width="16" height="16">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </button>
      </div>

    </div><!-- /body -->

    <div class="modal-box__footer">
      <button class="btn-modal-cancel" (click)="closeUsersModal()">Cerrar</button>
    </div>

  </div>
</div>
</file>

<file path="src/app/components/admin/admin-roles/admin-roles.component.ts">
import { Component, OnInit, OnDestroy } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { ActivatedRoute, Router } from '@angular/router';
import { Subject, takeUntil } from 'rxjs';
import { RoleService } from '../../../services/role.service';
import { AuthService } from '../../../services/auth.service';
import { Role, Permission, PermissionsByCategory, RoleUserDTO, PageResponse } from '../../../models/staff.model';
import { User } from '../../../models/user.model';

declare const Swal: any;

@Component({
  selector: 'app-admin-roles',
  standalone: true,
  imports: [CommonModule, FormsModule],
  templateUrl: './admin-roles.component.html',
  styleUrls: ['./admin-roles.component.css']
})
export class AdminRolesComponent implements OnInit, OnDestroy {

  roles: Role[] = [];
  allPermissions: Permission[] = [];
  permissionsByCategory: PermissionsByCategory = {};
  loading = false;
  currentUser: User | null = null;
  private destroy$ = new Subject<void>();

  // ── Search ─────────────────────────────────────────────────────
  searchTerm = '';

  // ── Permissions Modal ──────────────────────────────────────────
  showPermissionsModal = false;
  selectedRole: Role | null = null;
  /** IDs de permisos seleccionados. Usamos number[] (inmutable en cada cambio)
   *  para que Angular detecte el cambio y re-renderice el template. */
  selectedPermissions: number[] = [];
  savingPermissions = false;
  /** When true, the permissions modal is read-only (system roles) */
  permissionsModalReadOnly = false;

  // ── Create Role Modal ──────────────────────────────────────────
  showRoleModal = false;
  savingRole = false;
  roleFormData = { name: '', description: '' };

  // ── Role Users Modal ──────────────────────────────────────────
  showUsersModal = false;
  usersModalRole: Role | null = null;
  usersModalLoading = false;
  usersPage: PageResponse<RoleUserDTO> | null = null;
  usersCurrentPage = 0;
  readonly usersPageSize = 8;

  // ── Accordion state (collapsed categories) ────────────────────
  collapsedCategories: Set<string> = new Set();
  createCollapsedCategories: Set<string> = new Set();

  constructor(
    private roleService: RoleService,
    private authService: AuthService,
    private router: Router,
    private route: ActivatedRoute
  ) {}

  ngOnInit(): void {
    this.authService.getCurrentUser().pipe(takeUntil(this.destroy$)).subscribe(user => {
      this.currentUser = user;
    });
    this.loadRoles();
    this.loadPermissionsByCategory();

    this.route.queryParams
      .pipe(takeUntil(this.destroy$))
      .subscribe(params => {
        if (params['action'] === 'create' && this.canCreateRole() && !this.showRoleModal) {
          this.openCreateRoleModal();
          this.clearActionParam();
        }
      });
  }

  ngOnDestroy(): void {
    this.destroy$.next();
    this.destroy$.complete();
  }

  // ==================== SEGURIDAD ====================

  isSuperAdmin(): boolean {
    const roles = this.currentUser?.roles;
    if (!roles || roles.length === 0) return false;
    return roles.some(r => {
      const normalized = r?.toUpperCase().replace('ROLE_', '');
      return normalized === 'SUPER_ADMIN';
    });
  }

  isImmutableRole(role: Role): boolean {
    return role.immutable === true;
  }

  /**
   * Determina si el usuario puede editar los permisos de un rol.
   * Requiere: rol no inmutable + (SUPER_ADMIN o tiene PERMISSION_ASSIGN).
   */
  canEditPermissions(role: Role): boolean {
    if (this.isImmutableRole(role)) return false;
    return this.isSuperAdmin() || this.authService.hasPermission('PERMISSION_ASSIGN');
  }

  /**
   * Determina si el usuario puede eliminar un rol.
   * Requiere: rol no inmutable + (SUPER_ADMIN o tiene ROLE_DELETE).
   */
  canDelete(role: Role): boolean {
    if (this.isImmutableRole(role)) return false;
    return this.isSuperAdmin() || this.authService.hasPermission('ROLE_DELETE');
  }

  /**
   * Determina si el usuario puede crear roles nuevos.
   * Requiere: SUPER_ADMIN o ROLE_CREATE.
   */
  canCreateRole(): boolean {
    return this.isSuperAdmin() || this.authService.hasPermission('ROLE_CREATE');
  }

  /**
   * Determina si el usuario tiene acceso de solo lectura a los roles
   * (tiene ROLE_READ pero NO puede crear/editar/eliminar).
   */
  get isReadOnlyMode(): boolean {
    return !this.isSuperAdmin()
      && !this.authService.hasPermission('ROLE_CREATE')
      && !this.authService.hasPermission('ROLE_DELETE')
      && !this.authService.hasPermission('PERMISSION_ASSIGN');
  }

  /**
   * Verifica si un rol es el propio rol del usuario actual.
   * Previene auto-edición de permisos del rol que uno mismo tiene asignado.
   */
  isOwnRole(role: Role): boolean {
    const userRoles = this.currentUser?.roles ?? [];
    return userRoles.some(r => r?.toUpperCase() === role.name?.toUpperCase());
  }

  // ==================== CARGA DE DATOS ====================

  /** Roles filtrados por el termino de busqueda */
  get filteredRoles(): Role[] {
    if (!this.searchTerm.trim()) return this.roles;
    const term = this.searchTerm.trim().toLowerCase();
    return this.roles.filter(r =>
      r.name.toLowerCase().includes(term) ||
      (r.description ?? '').toLowerCase().includes(term)
    );
  }

  loadRoles(): void {
    this.loading = true;
    this.roleService.getAllRoles().pipe(takeUntil(this.destroy$)).subscribe({
      next: (roles) => { this.roles = roles; this.loading = false; },
      error: (err: any) => { console.error('loadRoles error:', err); this.loading = false; }
    });
  }

  loadPermissionsByCategory(): void {
    this.roleService.getPermissionsByCategory().pipe(takeUntil(this.destroy$)).subscribe({
      next: (permissions) => {
        this.permissionsByCategory = permissions;
        this.allPermissions = Object.values(permissions).flat();
      },
      error: (err: any) => { console.error('loadPermissionsByCategory error:', err); }
    });
  }

  // ==================== MODAL DE PERMISOS ====================

  /** Abre el modal de permisos. Se decide el modo (edición/lectura) automáticamente. */
  openPermissionsModal(role: Role): void {
    this.selectedRole = { ...role };
    this.selectedPermissions = role.permissions?.map(p => p.id) ?? [];
    this.collapsedCategories.clear();

    // Forzar lectura si: rol inmutable, usuario sin PERMISSION_ASSIGN, o es su propio rol
    if (this.isImmutableRole(role) || !this.canEditPermissions(role) || this.isOwnRole(role)) {
      this.permissionsModalReadOnly = true;
    } else {
      this.permissionsModalReadOnly = false;
    }

    this.showPermissionsModal = true;
  }

  /** Abre el modal de permisos en modo solo-lectura explícito */
  openPermissionsModalReadOnly(role: Role): void {
    this.selectedRole = { ...role };
    this.selectedPermissions = role.permissions?.map(p => p.id) ?? [];
    this.permissionsModalReadOnly = true;
    this.collapsedCategories.clear();
    this.showPermissionsModal = true;
  }

  closePermissionsModal(): void {
    this.showPermissionsModal = false;
    this.selectedRole = null;
    this.selectedPermissions = [];
    this.permissionsModalReadOnly = false;
  }

  togglePermission(permissionId: number): void {
    if (this.permissionsModalReadOnly) return;
    if (this.selectedPermissions.includes(permissionId)) {
      // Crea un nuevo array sin el elemento → Angular detecta el cambio
      this.selectedPermissions = this.selectedPermissions.filter(id => id !== permissionId);
    } else {
      // Crea un nuevo array con el elemento agregado
      this.selectedPermissions = [...this.selectedPermissions, permissionId];
    }
  }

  isPermissionSelected(permissionId: number): boolean {
    return this.selectedPermissions.includes(permissionId);
  }

  toggleCategory(category: string, selected: boolean): void {
    if (this.permissionsModalReadOnly) return;
    const perms = this.permissionsByCategory[category] ?? [];
    if (selected) {
      // Agrega los IDs de la categoría que no estén ya seleccionados
      const newIds = perms.map(p => p.id).filter(id => !this.selectedPermissions.includes(id));
      this.selectedPermissions = [...this.selectedPermissions, ...newIds];
    } else {
      // Elimina todos los IDs de la categoría
      const categoryIds = new Set(perms.map(p => p.id));
      this.selectedPermissions = this.selectedPermissions.filter(id => !categoryIds.has(id));
    }
  }

  isCategoryFullySelected(category: string): boolean {
    const perms = this.permissionsByCategory[category] ?? [];
    return perms.length > 0 && perms.every(p => this.selectedPermissions.includes(p.id));
  }

  isCategoryPartiallySelected(category: string): boolean {
    const perms = this.permissionsByCategory[category] ?? [];
    const count = perms.filter(p => this.selectedPermissions.includes(p.id)).length;
    return count > 0 && count < perms.length;
  }

  savePermissions(): void {
    if (!this.selectedRole || this.permissionsModalReadOnly) return;
    this.savingPermissions = true;
    this.roleService.updateRolePermissions(
      this.selectedRole.id,
      this.selectedPermissions
    ).pipe(takeUntil(this.destroy$)).subscribe({
      next: (response) => {
        this.savingPermissions = false;
        this.closePermissionsModal();
        const idx = this.roles.findIndex(r => r.id === response.role.id);
        if (idx !== -1) { this.roles[idx] = response.role; }
        Swal.fire({
          title: 'Permisos actualizados',
          text: `Los permisos del rol "${response.role.name}" fueron guardados correctamente.`,
          icon: 'success',
          confirmButtonColor: '#722f37',
          timer: 3000,
          timerProgressBar: true
        });
      },
      error: (err: any) => {
        this.savingPermissions = false;
        Swal.fire({
          title: 'Error',
          text: err.error?.message ?? 'No se pudieron guardar los permisos.',
          icon: 'error',
          confirmButtonColor: '#722f37'
        });
      }
    });
  }

  // ==================== MODAL CREAR ROL ====================

  /** Verifica si el nombre del rol ya existe en el sistema */
  isNameDuplicate(): boolean {
    const rawName = this.roleFormData.name.trim().toUpperCase();
    const fullName = rawName.startsWith('ROLE_') ? rawName : 'ROLE_' + rawName;
    return this.roles.some(r => r.name.toUpperCase() === fullName);
  }

  openCreateRoleModal(): void {
    this.roleFormData = { name: '', description: '' };
    this.selectedPermissions = [];
    this.createCollapsedCategories.clear();
    this.showRoleModal = true;
  }

  closeRoleModal(): void {
    this.showRoleModal = false;
    this.roleFormData = { name: '', description: '' };
    this.selectedPermissions = [];
  }

  private clearActionParam(): void {
    this.router.navigate([], {
      queryParams: { action: null },
      queryParamsHandling: 'merge'
    });
  }

  saveRole(): void {
    let rawName = this.roleFormData.name.trim().toUpperCase();
    if (!rawName) {
      Swal.fire({
        title: 'Campo obligatorio',
        text: 'El nombre del rol es requerido.',
        icon: 'warning',
        confirmButtonColor: '#722f37'
      });
      return;
    }

    if (!rawName.startsWith('ROLE_')) {
      rawName = 'ROLE_' + rawName;
    }

    // Validar nombre duplicado
    if (this.roles.some(r => r.name.toUpperCase() === rawName)) {
      Swal.fire({
        title: 'Nombre duplicado',
        text: `Ya existe un rol con el nombre "${rawName}". Elige un nombre diferente.`,
        icon: 'warning',
        confirmButtonColor: '#722f37'
      });
      return;
    }

    if (this.selectedPermissions.length === 0) {
      Swal.fire({
        title: 'Selecciona al menos un permiso',
        text: 'El rol debe tener al menos un permiso asignado para ser creado.',
        icon: 'warning',
        confirmButtonColor: '#722f37'
      });
      return;
    }

    this.savingRole = true;
    this.roleService.createRole({
      name: rawName,
      description: this.roleFormData.description.trim(),
      permissionIds: this.selectedPermissions
    }).pipe(takeUntil(this.destroy$)).subscribe({
      next: (response) => {
        this.savingRole = false;
        this.closeRoleModal();
        this.roles.push(response.role);
        Swal.fire({
          title: 'Rol creado',
          text: `El rol "${response.role.name}" fue creado correctamente.`,
          icon: 'success',
          confirmButtonColor: '#722f37',
          timer: 3000,
          timerProgressBar: true
        });
      },
      error: (err: any) => {
        this.savingRole = false;
        Swal.fire({
          title: 'Error',
          text: err.error?.message ?? 'No se pudo crear el rol.',
          icon: 'error',
          confirmButtonColor: '#722f37'
        });
      }
    });
  }

  // ==================== MODAL USUARIOS POR ROL ====================

  openRoleUsersModal(role: Role): void {
    this.usersModalRole = role;
    this.usersCurrentPage = 0;
    this.usersPage = null;
    this.showUsersModal = true;
    this.loadRoleUsers();
  }

  closeUsersModal(): void {
    this.showUsersModal = false;
    this.usersModalRole = null;
    this.usersPage = null;
    this.usersCurrentPage = 0;
  }

  loadRoleUsers(): void {
    if (!this.usersModalRole) return;
    this.usersModalLoading = true;
    this.roleService.getUsersByRole(
      this.usersModalRole.id,
      this.usersCurrentPage,
      this.usersPageSize
    ).pipe(takeUntil(this.destroy$)).subscribe({
      next: (page) => { this.usersPage = page; this.usersModalLoading = false; },
      error: (err: any) => {
        this.usersModalLoading = false;
        Swal.fire({
          title: 'Error',
          text: err.error?.message ?? 'No se pudieron cargar los usuarios.',
          icon: 'error',
          confirmButtonColor: '#722f37'
        });
      }
    });
  }

  goToUsersPage(page: number): void {
    if (!this.usersPage) return;
    if (page < 0 || page >= this.usersPage.totalPages) return;
    this.usersCurrentPage = page;
    this.loadRoleUsers();
  }

  getUsersPageNumbers(): number[] {
    if (!this.usersPage) return [];
    return Array.from({ length: this.usersPage.totalPages }, (_, i) => i);
  }

  // ==================== ELIMINAR ROL ====================

  deleteRole(role: Role): void {
    this.roleService.getUsersCountForRole(role.id).pipe(takeUntil(this.destroy$)).subscribe({
      next: (response: { roleId: number; userCount: number }) => {
        const userCount = response.userCount;

        if (userCount > 0) {
          Swal.fire({
            title: 'No se puede eliminar',
            html: `El rol <strong>${role.name}</strong> tiene <strong>${userCount}</strong> usuario(s) asignado(s).<br><br>
                   Primero reasigna a estos <strong>${userCount}</strong> usuarios a otro rol antes de eliminar.`,
            icon: 'warning',
            confirmButtonColor: '#722f37'
          });
          return;
        }

        Swal.fire({
          title: 'Eliminar Rol',
          html: `
            <p style="color:#555; margin-bottom:.5rem;">
              Está por eliminar el rol <strong>${role.name}</strong>.
            </p>
            <p style="color:#722f37; font-size:.875rem;">
              Esta acción no se puede deshacer.
            </p>
          `,
          icon: 'warning',
          showCancelButton: true,
          confirmButtonText: 'Sí, eliminar',
          cancelButtonText: 'Cancelar',
          confirmButtonColor: '#722f37',
          cancelButtonColor: '#6c757d'
        }).then((result: any) => {
          if (!result.isConfirmed) return;
          this.roleService.deleteRole(role.id).pipe(takeUntil(this.destroy$)).subscribe({
            next: () => {
              this.roles = this.roles.filter(r => r.id !== role.id);
              Swal.fire({
                title: 'Rol eliminado',
                text: `El rol "${role.name}" fue eliminado correctamente.`,
                icon: 'success',
                confirmButtonColor: '#722f37',
                timer: 3000,
                timerProgressBar: true
              });
            },
            error: (err: any) => {
              Swal.fire({
                title: 'No se puede eliminar',
                text: err.error?.message ?? 'No se pudo eliminar el rol.',
                icon: 'error',
                confirmButtonColor: '#722f37'
              });
            }
          });
        });
      },
      error: (err: any) => {
        Swal.fire({
          title: 'Error al verificar usuarios',
          text: err.error?.message ?? 'No se pudo verificar el número de usuarios asignados al rol.',
          icon: 'error',
          confirmButtonColor: '#722f37'
        });
      }
    });
  }

  // ==================== HELPERS ====================

  getCategories(): string[] {
    return Object.keys(this.permissionsByCategory).sort();
  }

  displayName(roleName: string): string {
    return roleName?.replace(/^ROLE_/, '') ?? roleName;
  }

  translateCategory(category: string): string {
    const map: { [k: string]: string } = {
      USER: 'Gestion de Usuarios',
      ROLE: 'Gestion de Roles',
      PERMISSION: 'Permisos del Sistema',
      SYSTEM: 'Configuracion del Sistema',
      PRODUCT: 'Gestion de Productos',
      ORDER: 'Gestion de Pedidos',
      ADMIN: 'Panel de Administracion',
      DATABASE: 'Base de Datos',
      CUSTOMER: 'Gestion de Clientes',
      REPORT: 'Reportes y Exportacion',
      // Legacy categories (backwards compatibility)
      USER_MANAGEMENT: 'Gestion de Usuarios',
      PRODUCT_MANAGEMENT: 'Gestion de Productos',
      ORDER_MANAGEMENT: 'Gestion de Pedidos',
      CONTENT_MANAGEMENT: 'Gestion de Contenido',
      ANALYTICS: 'Analitica y Reportes',
      SECURITY: 'Seguridad',
      ROLE_MANAGEMENT: 'Gestion de Roles'
    };
    return map[category] ?? category.replace(/_/g, ' ');
  }

  getCategoryAbbr(category: string): string {
    const map: { [k: string]: string } = {
      USER: 'US',
      ROLE: 'RL',
      PERMISSION: 'PM',
      SYSTEM: 'SI',
      PRODUCT: 'PR',
      ORDER: 'OR',
      ADMIN: 'AD',
      DATABASE: 'DB',
      CUSTOMER: 'CL',
      REPORT: 'RP',
      // Legacy
      USER_MANAGEMENT: 'US',
      PRODUCT_MANAGEMENT: 'PR',
      ORDER_MANAGEMENT: 'OR',
      CONTENT_MANAGEMENT: 'CN',
      ANALYTICS: 'AN',
      SECURITY: 'SE',
      ROLE_MANAGEMENT: 'RL'
    };
    return map[category] ?? category.slice(0, 2);
  }

