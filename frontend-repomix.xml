                  @if (entry.status === 'ERROR') {
                    <span class="mnt-hist-status-badge mnt-hist-status-badge--error"
                          [title]="entry.errorMessage ?? ''"
                          (mouseenter)="showTooltip($event, entry.errorMessage ?? 'Error desconocido')"
                          (mouseleave)="hideTooltip()">
                      <span class="material-icons">cancel</span>
                      Error
                    </span>
                  }
                  @if (entry.status === 'IN_PROGRESS') {
                    <span class="mnt-hist-status-badge mnt-hist-status-badge--progress">
                      <span class="material-icons">hourglass_empty</span>
                      En progreso
                    </span>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }

    <!-- Skeleton mientras carga -->
    @if (loading) {
      <div class="mnt-hist-skeleton">
        @for (_ of [1,2,3]; track $index) {
          <div class="mnt-hist-skeleton__row">
            <div class="mnt-hist-skeleton__cell mnt-hist-skeleton__cell--op"></div>
            <div class="mnt-hist-skeleton__cell mnt-hist-skeleton__cell--target"></div>
