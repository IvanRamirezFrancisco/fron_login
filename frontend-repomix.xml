    <!-- Tabla -->
    @if (!loading && maintenanceHistory.length > 0) {
      <div class="mnt-table-wrap">
        <table class="mnt-table mnt-hist-table">
          <colgroup>
            <col class="mnt-hcol--op">
            <col class="mnt-hcol--target">
