<!-- ═══════════════════════════════════════════════════════════════════════
     HERO SLIDER  –  diseño elegante: texto izquierda + imagen derecha
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="relative h-[88vh] min-h-[580px] overflow-hidden bg-[#0a0a0f]">

  @for (slide of heroSlides; track $index) {
    <div
      class="absolute inset-0 transition-all duration-1000 ease-in-out"
      [ngClass]="$index === currentSlide ? 'opacity-100 z-10' : 'opacity-0 z-0'">

      <!-- Imagen de fondo dividida: visible solo en la mitad derecha -->
      <div class="absolute inset-y-0 right-0 w-full md:w-[58%]">
        <img
          [src]="slide.imageUrl"
          [alt]="slide.title"
          class="w-full h-full object-cover object-center" />
        <!-- Gradiente que fusiona la imagen hacia la izquierda -->
        <div class="absolute inset-0 bg-gradient-to-r from-[#0a0a0f] via-[#0a0a0f]/80 to-transparent"></div>
        <!-- Gradiente superior e inferior para suavizar -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0f]/60 via-transparent to-[#0a0a0f]/20"></div>
      </div>

      <!-- Fondo sólido oscuro en la parte izquierda -->
      <div class="absolute inset-y-0 left-0 w-1/2 bg-[#0a0a0f] hidden md:block"></div>

      <!-- Contenido: texto a la izquierda -->
      <div class="relative z-10 h-full flex items-center">
        <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 w-full">
          <div class="max-w-xl">

            <!-- Badge / Tag -->
            <div class="inline-flex items-center gap-2 mb-6">
              <span class="w-6 h-0.5 bg-amber-500"></span>
              <span class="text-xs font-bold tracking-[0.2em] uppercase text-amber-400">
                {{ slide.tag }}
              </span>
            </div>

            <!-- Título con salto de línea elegante -->
            <h1 class="text-5xl md:text-6xl lg:text-7xl font-black text-white leading-[1.05] mb-6 tracking-tight">
              @for (line of slide.title.split('\n'); track $index) {
                @if ($index === 1) {
                  <span class="block text-amber-400">{{ line }}</span>
                } @else {
                  <span class="block">{{ line }}</span>
                }
              }
            </h1>

            <!-- Subtítulo -->
            <p class="text-gray-400 text-base md:text-lg leading-relaxed mb-10 max-w-md">
              {{ slide.subtitle }}
            </p>

            <!-- CTAs -->
            <div class="flex flex-wrap items-center gap-4">
              <a
                [routerLink]="slide.ctaLink"
                [queryParams]="slide.ctaParams"
                class="group inline-flex items-center gap-3 bg-amber-500 hover:bg-amber-400
                       text-slate-900 font-bold px-7 py-3.5 rounded-full
                       transition-all duration-300 text-sm tracking-wide
                       shadow-xl shadow-amber-500/20 hover:shadow-amber-400/40 hover:scale-105">
                {{ slide.cta }}
                <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform duration-300">
                  arrow_forward
                </span>
              </a>
              <a
                routerLink="/catalogo"
                class="inline-flex items-center gap-2 text-white/70 hover:text-white
                       text-sm font-semibold transition-colors duration-200 group">
                <span class="material-symbols-outlined text-[18px]">play_circle</span>
                Ver colección
                <span class="w-0 group-hover:w-4 overflow-hidden transition-all duration-300
                             h-0.5 bg-white/50 rounded-full mt-px"></span>
              </a>
            </div>

          </div>
        </div>
      </div>

    </div>
  }

  <!-- Indicadores / Dots – abajo a la izquierda -->
  <div class="absolute bottom-8 left-0 right-0 z-20">
    <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 flex items-center gap-6">

      <!-- Dots -->
      <div class="flex items-center gap-2">
        @for (slide of heroSlides; track $index) {
          <button
            (click)="goToSlide($index)"
            [attr.aria-label]="'Ir al slide ' + ($index + 1)"
            class="transition-all duration-500 rounded-full"
            [ngClass]="$index === currentSlide
              ? 'w-10 h-2 bg-amber-400'
              : 'w-2 h-2 bg-white/25 hover:bg-white/50'">
          </button>
        }
      </div>

      <!-- Contador -->
      <span class="text-xs text-white/30 font-mono tracking-widest">
        {{ (currentSlide + 1).toString().padStart(2, '0') }} / {{ heroSlides.length.toString().padStart(2, '0') }}
      </span>
    </div>
  </div>

  <!-- Flechas de navegación -->
  <button
    (click)="goToSlide((currentSlide - 1 + heroSlides.length) % heroSlides.length)"
    aria-label="Slide anterior"
    class="absolute right-16 bottom-6 z-20 w-11 h-11 rounded-full border border-white/15
           hover:border-amber-400/50 bg-white/5 hover:bg-amber-500/10 backdrop-blur-sm
           flex items-center justify-center transition-all duration-200 text-white/60 hover:text-amber-400">
    <span class="material-symbols-outlined text-[20px]">chevron_left</span>
  </button>

  <button
    (click)="goToSlide((currentSlide + 1) % heroSlides.length)"
    aria-label="Slide siguiente"
    class="absolute right-4 bottom-6 z-20 w-11 h-11 rounded-full border border-white/15
           hover:border-amber-400/50 bg-white/5 hover:bg-amber-500/10 backdrop-blur-sm
           flex items-center justify-center transition-all duration-200 text-white/60 hover:text-amber-400">
    <span class="material-symbols-outlined text-[20px]">chevron_right</span>
  </button>

  <!-- Línea decorativa animada en el borde inferior -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-amber-500/40 to-transparent z-20"></div>
</section>




<!-- ═══════════════════════════════════════════════════════════════════════
     CATEGORÍAS
