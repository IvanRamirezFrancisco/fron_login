}

.code-input-group label .material-icons {
  font-size: 20px;
  color: #722f37;
}

.code-input {
  width: 100%;
  padding: 1rem;
  border: 2px solid #E8E2DC;
  border-radius: 8px;
  font-size: 1.5rem;
  text-align: center;
  letter-spacing: 0.5rem;
  font-weight: 600;
  transition: all 0.3s ease;
  background: #FDFCFB;
}

.code-input:focus {
  outline: none;
  border-color: #C5A059;
  box-shadow: 0 0 0 3px rgba(197, 160, 89, 0.1);
}

.btn-verify,
.btn-send-code {
  width: 100%;
  padding: 1rem;
  background: linear-gradient(135deg, #722f37 0%, #600015 100%);
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 1.05rem;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
