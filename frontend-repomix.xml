/* ===== MAIN HEADER ===== */
.main-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: linear-gradient(135deg, #3E2723 0%, #2C1810 100%);
  box-shadow: 0 4px 25px rgba(62, 39, 35, 0.3);
  backdrop-filter: blur(15px);
  border-bottom: 1px solid rgba(199, 93, 44, 0.2);
}

/* ===== NAVBAR ===== */
.navbar {
  position: relative;
}

.nav-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 65px;
}

/* ===== BRAND ===== */
.navbar-brand {
  flex-shrink: 0;
}

.brand-link {
  display: flex;
  align-items: center;
  text-decoration: none;
  color: white;
  font-weight: 700;
  font-size: 1.25rem;
  transition: all 0.3s ease;
}

.brand-link:hover {
  transform: translateY(-1px);
  color: #f8f9fa;
}

.brand-icon {
  font-size: 1.75rem;
  margin-right: 0.75rem;
  color: #FFCF71;
  filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
  transition: all 0.3s ease;
}

.brand-link:hover .brand-icon {
  transform: scale(1.1) rotate(10deg);
  color: #FFE082;
}

.brand-text {
  background: linear-gradient(45deg, #FFFFFF, #FFCF71);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
}

/* ===== DESKTOP NAVIGATION ===== */
.desktop-nav {
  display: flex;
  align-items: center;
  gap: 2rem;
}

.nav-link {
  display: flex;
  align-items: center;
  padding: 0.75rem 1rem;
  color: rgba(255, 255, 255, 0.9);
  text-decoration: none;
  border-radius: 0.5rem;
  transition: all 0.3s ease;
  font-weight: 500;
  position: relative;
}

.nav-link:hover {
  background: rgba(199, 93, 44, 0.15);
  color: #FFCF71;
  transform: translateY(-1px);
  box-shadow: 0 2px 8px rgba(199, 93, 44, 0.2);
}

.nav-link.active {
  background: rgba(199, 93, 44, 0.25);
  color: #FFCF71;
  box-shadow: 0 2px 8px rgba(199, 93, 44, 0.3);
}

.nav-link.active::before {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 50%;
  transform: translateX(-50%);
  width: 30px;
  height: 3px;
  background: linear-gradient(90deg, #C75D2C, #FFCF71);
  border-radius: 2px;
  box-shadow: 0 1px 3px rgba(199, 93, 44, 0.4);
}

.nav-icon {
  margin-right: 0.5rem;
  font-size: 1.2rem;
  filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.2));
  transition: all 0.3s ease;
}

.nav-link:hover .nav-icon {
  transform: scale(1.1);
}

/* ===== DROPDOWN ===== */
.nav-dropdown {
  position: relative;
}

.dropdown-toggle {
  position: relative;
}

.dropdown-arrow {
  margin-left: 0.5rem;
  font-size: 1rem;
  transition: transform 0.3s ease;
  opacity: 0.8;
}

.nav-dropdown:hover .dropdown-arrow {
  transform: rotate(180deg);
  opacity: 1;
}

.dropdown-menu {
  position: absolute;
  top: 100%;
  left: 0;
  min-width: 220px;
  background: linear-gradient(145deg, #FFFFFF 0%, #FAFAFA 100%);
  border-radius: 16px;
  box-shadow: 
    0 8px 32px rgba(62, 39, 35, 0.15),
    0 4px 16px rgba(199, 93, 44, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.8);
  opacity: 0;
  visibility: hidden;
  transform: translateY(-15px) scale(0.95);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 1001;
  border: 2px solid rgba(199, 93, 44, 0.1);
  overflow: hidden;
}

.dropdown-menu.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
}

.dropdown-menu::before {
  content: '';
  position: absolute;
  top: -8px;
  left: 20px;
  width: 16px;
  height: 16px;
  background: linear-gradient(145deg, #FFFFFF, #FAFAFA);
  border: 2px solid rgba(199, 93, 44, 0.1);
  border-bottom: none;
  border-right: none;
  transform: rotate(45deg);
  box-shadow: -2px -2px 4px rgba(62, 39, 35, 0.05);
}

/* ===== ACCOUNT MENU ===== */
.account-menu {
  right: 0;
  left: auto;
  min-width: 320px;
  max-width: 350px;
}

.account-menu::before {
  right: 30px;
  left: auto;
}

/* Responsive adjustments for account menu */
@media (max-width: 480px) {
  .account-menu {
    min-width: 280px;
    right: -10px;
  }
  
  .account-menu::before {
    right: 25px;
  }
