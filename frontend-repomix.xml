@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
:host { font-family: 'Inter', sans-serif; }

.detail-page {
  --wine: #722f37; --wine-dark: #5a2029; --wine-light: #8f3b44;
  --gray-50: #f9fafb; --gray-100: #f3f4f6; --gray-200: #e5e7eb;
  --gray-600: #4b5563; --gray-700: #374151; --gray-800: #1f2937;
  --radius: 12px; --shadow-sm: 0 1px 3px rgba(0,0,0,.08); --shadow-md: 0 4px 12px rgba(0,0,0,.1);
}

.detail-page { min-height: 100vh; background: var(--gray-50); }
.container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }

/* ── Header ─────────────────────────────────────────────────────── */
.detail-header {
  background: #ffffff;
  border-bottom: 1px solid var(--gray-200);
  padding: 1.5rem 0 1rem;
}
.breadcrumb { display: flex; align-items: center; gap: .5rem; font-size: .85rem; color: var(--gray-500, #6b7280); margin-bottom: 1rem; }
.breadcrumb-link { color: var(--gray-700, #374151); text-decoration: none; display: flex; align-items: center; gap: .25rem; font-weight: 500; }
.breadcrumb-link:hover { color: var(--wine); }
.breadcrumb .material-icons { font-size: 1.1rem; color: var(--gray-400, #9ca3af); }
.breadcrumb-current { color: var(--wine); font-weight: 600; }
.header-row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
.page-title { font-size: 1.6rem; font-weight: 700; display: flex; align-items: center; gap: .5rem; margin: 0; color: var(--gray-900, #111827); }
.btn-back { display: inline-flex; align-items: center; gap: .4rem; background: var(--gray-100); color: var(--gray-700); border: 1px solid var(--gray-200); border-radius: 8px; padding: .5rem 1rem; font-weight: 500; font-size: .875rem; text-decoration: none; transition: all .2s; white-space: nowrap; }
.btn-back:hover { background: var(--gray-200); color: var(--gray-900); }
.btn-back .material-icons { font-size: 1rem; }

/* ── Body ──────────────────────────────────────────────────────── */
.detail-body { padding: 2rem 1.5rem; }

/* ── State ────────────────────────────────────────────────────── */
.state-center { text-align: center; padding: 4rem 1rem; }
.state-icon { font-size: 4rem; display: block; margin: 0 auto 1rem; opacity: .45; }
.error-icon { color: #ef4444; }
.state-center h2 { font-size: 1.4rem; color: var(--gray-800); margin: 0 0 1rem; }
.spinner-large { width: 44px; height: 44px; margin: 0 auto 1rem; border: 4px solid var(--gray-200); border-top-color: var(--wine); border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.btn-primary { display: inline-flex; align-items: center; gap: .5rem; background: var(--wine); color: #fff; border: none; border-radius: 8px; padding: .7rem 1.4rem; font-weight: 600; cursor: pointer; text-decoration: none; }

/* ── Cancelled Alert ─────────────────────────────────────────── */
.alert-cancelled {
  display: flex; align-items: flex-start; gap: 1rem;
  background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px;
  padding: 1rem 1.25rem; margin-bottom: 1.5rem; color: #991b1b;
}
.alert-cancelled .material-icons { font-size: 1.5rem; flex-shrink: 0; }
.cancelled-info { display: flex; flex-direction: column; gap: .25rem; font-size: .9rem; }
.cancelled-info strong { font-weight: 700; }
.cancel-reason { margin: .5rem 0 0; font-style: italic; color: #7f1d1d; }

/* ── Grid ─────────────────────────────────────────────────────── */
.detail-grid { display: grid; grid-template-columns: 1fr 320px; gap: 1.5rem; align-items: start; }

/* ── Cards ─────────────────────────────────────────────────────── */
.detail-card, .totals-card {
  background: #fff; border-radius: var(--radius); border: 1px solid var(--gray-200);
  box-shadow: var(--shadow-sm); margin-bottom: 1.25rem; overflow: hidden;
}
.totals-card { margin-bottom: 1rem; }

.card-header { display: flex; align-items: center; gap: .6rem; padding: 1rem 1.25rem; background: linear-gradient(135deg, var(--gray-50), #fff); border-bottom: 1px solid var(--gray-200); }
.card-header .material-icons { color: var(--wine); }
.card-header h2 { font-size: .95rem; font-weight: 700; color: var(--gray-800); margin: 0; }

.card-body { padding: 1.25rem; }
.card-body.no-padding { padding: 0; }

/* Info grid */
.info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.info-item { display: flex; flex-direction: column; gap: .25rem; }
.info-label { font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; color: var(--gray-600); }
.info-value { font-size: .9rem; font-weight: 500; color: var(--gray-800); }
.info-value.tracking { font-family: monospace; font-size: .85rem; background: var(--gray-100); padding: .2rem .5rem; border-radius: 4px; }

/* Address */
.address-section { margin-bottom: 1rem; }
.address-section:last-child { margin-bottom: 0; }
.address-title { font-size: .85rem; font-weight: 600; color: var(--gray-700); margin: 0 0 .35rem; }
.address-text { font-size: .9rem; color: var(--gray-800); margin: 0; line-height: 1.6; }
.same-address-note { display: flex; align-items: center; gap: .4rem; font-size: .875rem; color: #16a34a; margin: 0; }
.same-address-note .material-icons { font-size: 1.1rem; }

/* Notes */
.notes-text { font-size: .9rem; color: var(--gray-700); margin: 0; line-height: 1.6; font-style: italic; }

/* Products */
.product-row {
  display: flex; align-items: center; gap: 1rem;
  padding: 1rem 1.25rem; border-bottom: 1px solid var(--gray-100);
}
.product-row:last-child { border-bottom: none; }
.product-image { width: 60px; height: 60px; object-fit: cover; border-radius: 8px; border: 1px solid var(--gray-200); flex-shrink: 0; }
.product-image-wrapper { flex-shrink: 0; }
.product-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .2rem; }
.product-name { font-weight: 600; font-size: .9rem; color: var(--gray-800); }
.product-sku { font-size: .75rem; color: var(--gray-600); }
.product-qty { font-size: .8rem; color: var(--gray-600); }
.product-pricing { display: flex; flex-direction: column; align-items: flex-end; gap: .2rem; }
.product-unit-price { font-size: .8rem; color: var(--gray-600); }
.product-subtotal { font-size: 1rem; font-weight: 700; color: var(--wine); }

/* Badges */
.badge { display: inline-flex; align-items: center; gap: .3rem; padding: .3rem .75rem; border-radius: 999px; font-size: .78rem; font-weight: 600; }
.badge-amber { background: #fffbeb; color: #92400e; border: 1px solid #fde68a; }
.badge-blue { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
.badge-indigo { background: #eef2ff; color: #3730a3; border: 1px solid #c7d2fe; }
.badge-green { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
.badge-red { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
.badge-gray { background: var(--gray-100); color: var(--gray-700); border: 1px solid var(--gray-200); }

/* Cancel action */
.cancel-action { margin-top: .5rem; }
.btn-cancel-order { display: inline-flex; align-items: center; gap: .5rem; background: #fef2f2; color: #991b1b; border: 1.5px solid #fecaca; border-radius: 8px; padding: .7rem 1.4rem; font-weight: 600; font-size: .875rem; cursor: pointer; transition: all .2s; }
.btn-cancel-order:hover { background: #fee2e2; border-color: #fca5a5; }
.btn-cancel-order .material-icons { font-size: 1.1rem; }
.cancel-hint { font-size: .8rem; color: var(--gray-600); margin: .5rem 0 0; }

/* Totals */
.total-row { display: flex; justify-content: space-between; font-size: .9rem; color: var(--gray-700); padding: .35rem 0; }
.total-row.discount-row { color: #16a34a; }
.total-row.grand-total { font-size: 1.1rem; font-weight: 700; color: var(--gray-800); }
.total-divider { height: 1px; background: var(--gray-200); margin: .75rem 0; }

/* Sidebar actions */
.sidebar-actions { display: flex; flex-direction: column; gap: .75rem; }
.btn-outline { display: flex; align-items: center; gap: .5rem; background: #fff; color: var(--wine); border: 1.5px solid var(--wine); border-radius: 8px; padding: .6rem 1rem; font-weight: 500; font-size: .875rem; text-decoration: none; transition: all .2s; }
.btn-outline:hover { background: var(--wine); color: #fff; }
.btn-outline .material-icons { font-size: 1rem; }

/* Bank Transfer */
.bank-transfer-card { border-left: 4px solid var(--wine); }
.bank-header .material-icons { color: var(--wine); }
.bank-intro { font-size: .9rem; color: var(--gray-700); margin-top: 0; margin-bottom: 1.25rem; }
.bank-details-box { background: var(--gray-50); border: 1px dashed var(--gray-300); border-radius: 8px; padding: 1.25rem; display: flex; flex-direction: column; gap: .75rem; margin-bottom: 1.25rem; }
.bank-row { display: flex; justify-content: space-between; align-items: center; font-size: .95rem; }
.bank-label { color: var(--gray-600); }
.bank-value { font-weight: 600; color: var(--gray-800); }
.bank-value.highlight { color: var(--wine); font-family: monospace; font-size: 1.1rem; background: #fff; padding: .2rem .5rem; border-radius: 4px; border: 1px solid var(--gray-200); }
.bank-value.highlight-price { font-size: 1.1rem; color: #16a34a; }
.bank-footer { display: flex; align-items: flex-start; gap: .5rem; font-size: .85rem; color: var(--gray-600); margin: 0; background: #eff6ff; padding: 1rem; border-radius: 8px; border: 1px solid #bfdbfe; color: #1e40af; }
.bank-footer .material-icons { font-size: 1.1rem; color: #3b82f6; }

/* Modal */
.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.55); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 1rem; }
.modal-content { background: #fff; border-radius: 16px; padding: 0; max-width: 460px; width: 100%; box-shadow: 0 20px 60px rgba(0,0,0,.3); overflow: hidden; }
.modal-header { display: flex; flex-direction: column; align-items: center; gap: .75rem; padding: 2rem 1.5rem 1rem; text-align: center; }
.modal-icon { font-size: 3rem; }
.warning-icon { color: #f59e0b; }
.modal-header h3 { font-size: 1.25rem; font-weight: 700; color: var(--gray-800); margin: 0; }
.modal-body { padding: 0 1.5rem 1rem; }
.modal-body p { font-size: .9rem; color: var(--gray-700); text-align: center; margin: 0 0 1rem; }
.modal-form-group label { display: block; font-size: .85rem; font-weight: 500; color: var(--gray-700); margin-bottom: .4rem; }
.modal-textarea { width: 100%; box-sizing: border-box; border: 1.5px solid var(--gray-200); border-radius: 8px; padding: .7rem 1rem; font-family: 'Inter', sans-serif; font-size: .9rem; resize: vertical; }
.modal-textarea:focus { outline: none; border-color: var(--wine); box-shadow: 0 0 0 3px rgba(114,47,55,.1); }
.modal-error { display: flex; align-items: center; gap: .5rem; margin-top: .75rem; color: #991b1b; font-size: .85rem; background: #fef2f2; padding: .6rem .9rem; border-radius: 8px; }
.modal-error .material-icons { font-size: 1.1rem; }
.modal-footer { display: flex; gap: .75rem; padding: 1rem 1.5rem 1.5rem; }
.btn-modal-cancel { flex: 1; padding: .7rem; background: var(--gray-100); color: var(--gray-700); border: 1px solid var(--gray-200); border-radius: 8px; font-weight: 500; cursor: pointer; transition: background .2s; }
.btn-modal-cancel:hover:not(:disabled) { background: var(--gray-200); }
.btn-modal-confirm { flex: 1; display: flex; align-items: center; justify-content: center; gap: .4rem; padding: .7rem; background: #ef4444; color: #fff; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; transition: background .2s; }
.btn-modal-confirm:hover:not(:disabled) { background: #dc2626; }
.btn-modal-confirm:disabled, .btn-modal-cancel:disabled { opacity: .65; cursor: not-allowed; }
.spinner-sm { width: 16px; height: 16px; border: 2.5px solid rgba(255,255,255,.3); border-top-color: #fff; border-radius: 50%; animation: spin .7s linear infinite; }

@media (max-width: 900px) {
  .detail-grid { grid-template-columns: 1fr; }
  .detail-sidebar { order: -1; }
}
@media (max-width: 600px) {
  .detail-body { padding: 1rem; }
  .info-grid { grid-template-columns: 1fr; }
  .header-row { flex-direction: column; align-items: flex-start; }
  .page-title { font-size: 1.3rem; }
}

/* ================= COMPROBANTES DE PAGO ================= */

.proof-section {
  margin-top: 1.5rem;
  border-top: 1px solid var(--gray-200);
  padding-top: 1.5rem;
}

.proof-alert {
  display: flex;
  align-items: flex-start;
  gap: .75rem;
  padding: 1rem 1.25rem;
  border-radius: 8px;
  font-size: .9rem;
  margin-bottom: 1.25rem;
}
.proof-alert .material-icons {
  font-size: 1.25rem;
  flex-shrink: 0;
}
.proof-alert.error {
  background: #fef2f2; border: 1px solid #fecaca; color: #991b1b;
}
.proof-alert.error .material-icons { color: #dc2626; }
.proof-alert.warning {
  background: #fffbeb; border: 1px solid #fde68a; color: #92400e; flex-direction: column;
}
.proof-alert.warning .material-icons { color: #d97706; }
.proof-alert.success {
  background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534;
}
.proof-alert.success .material-icons { color: #16a34a; }
.proof-alert.cancelled {
  background: var(--gray-100); border: 1px solid var(--gray-300); color: var(--gray-600);
}

.proof-actions {
  margin-top: .75rem;
}

.btn-secondary {
  display: inline-flex; align-items: center; gap: .5rem; 
  background: #fff; color: var(--gray-800); border: 1px solid var(--gray-300); 
  border-radius: 6px; padding: .5rem 1rem; font-weight: 500; font-size: .85rem; 
  cursor: pointer; transition: all .2s;
}
.btn-secondary:hover {
  background: var(--gray-50); border-color: var(--gray-400);
}

.proof-form {
  background: #fff;
  border: 1px solid var(--gray-200);
  border-radius: 8px;
  padding: 1.25rem;
}

.proof-form .form-group {
  margin-bottom: 1rem;
}
.proof-form label {
  display: block; font-size: .85rem; font-weight: 600; color: var(--gray-700); margin-bottom: .4rem;
}
.proof-form .required { color: #dc2626; }
.proof-form input[type="text"],
.proof-form input[type="number"],
.proof-form input[type="date"],
.proof-form textarea {
  width: 100%; box-sizing: border-box; border: 1px solid var(--gray-300); border-radius: 6px;
  padding: .6rem .8rem; font-family: inherit; font-size: .9rem;
}
.proof-form input[type="text"]:focus,
.proof-form input[type="number"]:focus,
.proof-form input[type="date"]:focus,
.proof-form textarea:focus {
  outline: none; border-color: var(--wine); box-shadow: 0 0 0 3px rgba(114,47,55,.1);
}

.proof-form input[type="file"] {
  display: block; width: 100%; font-size: .9rem; color: var(--gray-700);
}
.proof-form input[type="file"]::file-selector-button {
  background: var(--gray-100); border: 1px solid var(--gray-300); border-radius: 6px;
  padding: .4rem .8rem; margin-right: 1rem; cursor: pointer; font-family: inherit; font-weight: 500;
  transition: all .2s; color: var(--gray-800);
}
.proof-form input[type="file"]::file-selector-button:hover {
  background: var(--gray-200);
}
.proof-form .file-group small {
  display: block; margin-top: .4rem; color: var(--gray-500); font-size: .8rem;
}

.form-row {
  display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
}

.error-msg {
  color: #dc2626; font-size: .85rem; margin-bottom: 1rem; display: flex; align-items: center; gap: .4rem;
}

/* VISOR PROFESIONAL DE COMPROBANTE */
.visor-overlay { z-index: 1050; }
.visor-modal { max-width: 800px; border-radius: 12px; background: #fff; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0,0,0,.25); }
.visor-header { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--gray-200); background: #f8fafc; }
.visor-title-group { display: flex; align-items: center; gap: .75rem; }
.visor-icon { color: var(--wine); font-size: 1.5rem; }
.visor-title-text h3 { margin: 0; font-size: 1.1rem; font-weight: 600; color: var(--gray-800); }
.visor-subtitle { font-size: .8rem; color: var(--gray-500); }
.visor-status { margin-left: auto; margin-right: 1rem; }
.visor-body { position: relative; background: #e2e8f0; min-height: 400px; max-height: 70vh; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.visor-content { width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; }
.visor-iframe { width: 100%; height: 70vh; border: none; background: #fff; }
.visor-img { max-width: 100%; max-height: 70vh; object-fit: contain; box-shadow: var(--shadow-sm); }
.visor-loading { position: absolute; inset: 0; background: rgba(255,255,255,.8); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 10; }
.visor-error { padding: 2rem; text-align: center; color: #dc2626; }
.visor-footer { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.5rem; background: #fff; border-top: 1px solid var(--gray-200); }
.visor-filename { display: flex; align-items: center; gap: .5rem; font-size: .85rem; color: var(--gray-600); font-family: monospace; }
.visor-filename .material-icons { font-size: 1.1rem; color: var(--gray-400); }
.visor-actions { display: flex; gap: .75rem; }
.btn-sm { padding: .5rem 1rem; font-size: .85rem; }
</file>

<file path="src/app/components/order-detail/order-detail.component.html">
<div class="detail-page">

  <!-- HEADER -->
  <div class="detail-header">
    <div class="container">
      <div class="breadcrumb">
        <a routerLink="/home" class="breadcrumb-link"><span class="material-icons">home</span>Inicio</a>
        <span class="material-icons">chevron_right</span>
        <a routerLink="/orders/my" class="breadcrumb-link">Mis Pedidos</a>
        <span class="material-icons">chevron_right</span>
        <span class="breadcrumb-current">Detalle del Pedido</span>
      </div>
      <div class="header-row">
        <h1 class="page-title">
          <span class="material-icons">receipt_long</span>
          <span *ngIf="order">Pedido #{{ order.orderNumber }}</span>
          <span *ngIf="!order && isLoading">Cargando...</span>
        </h1>
        <a routerLink="/orders/my" class="btn-back">
          <span class="material-icons">arrow_back</span>Mis Pedidos
        </a>
      </div>
    </div>
  </div>

  <div class="container detail-body">

    <!-- LOADING -->
    <div class="state-center" *ngIf="isLoading">
      <div class="spinner-large"></div>
      <p>Cargando detalles del pedido...</p>
    </div>

    <!-- ERROR -->
    <div class="state-center" *ngIf="!isLoading && error">
      <span class="material-icons state-icon error-icon">error_outline</span>
      <h2>{{ error }}</h2>
      <a routerLink="/orders/my" class="btn-primary">Ver mis pedidos</a>
    </div>

    <!-- DETALLE -->
    <div *ngIf="!isLoading && !error && order">

      <!-- ALERTA CANCELADO -->
      <div class="alert-cancelled" *ngIf="order.status === 'CANCELLED'">
        <span class="material-icons">cancel</span>
        <div class="cancelled-info">
          <strong>Pedido cancelado</strong>
          <span *ngIf="order.cancelledAt"> el {{ formatDate(order.cancelledAt) }}</span>
          <span *ngIf="order.cancelSource"> · {{ getCancelSourceLabel(order.cancelSource) }}</span>
          <p *ngIf="order.cancellationReason" class="cancel-reason">
            Motivo: {{ order.cancellationReason }}
          </p>
        </div>
      </div>

      <div class="detail-grid">

        <!-- COLUMNA IZQUIERDA -->
        <div class="detail-main">

          <!-- INFORMACIÓN DEL PEDIDO -->
          <div class="detail-card">
            <div class="card-header">
              <span class="material-icons">info</span>
              <h2>Información del Pedido</h2>
            </div>
            <div class="card-body info-grid">
              <div class="info-item">
                <span class="info-label">Número de pedido</span>
                <span class="info-value"># {{ order.orderNumber }}</span>
              </div>
              <div class="info-item">
                <span class="info-label">Fecha</span>
                <span class="info-value">{{ formatDate(order.createdAt) }}</span>
              </div>
              <div class="info-item">
                <span class="info-label">Estado del pedido</span>
                <span class="badge" [ngClass]="getStatusBadgeClass(order.status)">
                  {{ getStatusLabel(order.status) }}
                </span>
              </div>
              <div class="info-item">
                <span class="info-label">Estado de pago</span>
                <span class="info-value">{{ getPaymentLabel(order.paymentStatus) }}</span>
              </div>
              <div class="info-item">
                <span class="info-label">Estado de envío</span>
                <span class="info-value">{{ getShippingLabel(order.shippingStatus) }}</span>
              </div>
              <div class="info-item" *ngIf="order.paymentMethod">
                <span class="info-label">Método de pago</span>
                <span class="info-value">{{ getPaymentMethodLabel(order.paymentMethod || '') }}</span>
              </div>
              <div class="info-item" *ngIf="order.trackingNumber">
                <span class="info-label">Número de seguimiento</span>
                <span class="info-value tracking">{{ order.trackingNumber }}</span>
              </div>
            </div>
          </div>

          <!-- DIRECCIÓN -->
          <div class="detail-card">
            <div class="card-header">
              <span class="material-icons">location_on</span>
              <h2>Dirección</h2>
            </div>
            <div class="card-body">
              <div class="address-section" *ngIf="order.shippingAddress">
                <h3 class="address-title">Dirección de envío</h3>
                <p class="address-text">{{ order.shippingAddress }}</p>
              </div>
              <div class="address-section" *ngIf="order.billingAddress && order.billingAddress !== order.shippingAddress">
                <h3 class="address-title">Dirección de facturación</h3>
                <p class="address-text">{{ order.billingAddress }}</p>
              </div>
              <p class="same-address-note" *ngIf="order.billingAddress === order.shippingAddress">
                <span class="material-icons">check_circle</span>
                La dirección de facturación es la misma que la de envío.
              </p>
            </div>
          </div>

          <!-- INSTRUCCIONES DE TRANSFERENCIA -->
          <div class="detail-card bank-transfer-card" *ngIf="order.paymentMethod === 'BANK_TRANSFER' || order.paymentMethod === 'TRANSFER'">
            <div class="card-header bank-header">
              <span class="material-icons">account_balance</span>
              <h2>Datos y Comprobante de Pago</h2>
            </div>
            <div class="card-body">
              <!-- Cargando instrucciones -->
              <div *ngIf="loadingInstructions" class="state-center py-4">
                <div class="spinner-large" style="width: 24px; height: 24px; border-width: 3px;"></div>
                <p class="text-sm mt-2">Cargando datos bancarios...</p>
              </div>

              <!-- Información de transferencia -->
              <div *ngIf="!loadingInstructions">
                <p class="bank-intro" *ngIf="order.paymentStatus === 'PENDING' && !order.hasPaymentProof">
                  Después de realizar tu transferencia, sube tu comprobante en esta misma sección.<br>
                  Tu pedido quedará pendiente hasta que el negocio confirme el pago.
                </p>
                
                <div class="bank-details-box" *ngIf="paymentInstructions?.configured">
                  <div class="bank-row">
                    <span class="bank-label">Banco:</span>
                    <span class="bank-value">{{ paymentInstructions?.bankName }}</span>
                  </div>
                  <div class="bank-row">
                    <span class="bank-label">Titular:</span>
                    <span class="bank-value">{{ paymentInstructions?.accountHolder }}</span>
                  </div>
                  <div class="bank-row">
                    <span class="bank-label">CLABE:</span>
                    <span class="bank-value highlight flex items-center gap-2">
                      {{ paymentInstructions?.clabe }}
                      <button (click)="copyToClipboard(paymentInstructions?.clabe, 'CLABE')" title="Copiar CLABE" class="text-gray-500 hover:text-[#722f37] transition-colors border-none bg-transparent cursor-pointer">
                        <span class="material-icons" style="font-size: 1rem;">content_copy</span>
                      </button>
                    </span>
                  </div>
                  <div class="bank-row" *ngIf="paymentInstructions?.accountNumber">
                    <span class="bank-label">Cuenta:</span>
                    <span class="bank-value">{{ paymentInstructions?.accountNumber }}</span>
                  </div>
                  <div class="bank-row">
                    <span class="bank-label">Concepto de pago:</span>
                    <span class="bank-value highlight flex items-center gap-2">
                      {{ paymentInstructions?.concept }}
                      <button (click)="copyToClipboard(paymentInstructions?.concept, 'Concepto')" title="Copiar Concepto" class="text-gray-500 hover:text-[#722f37] transition-colors border-none bg-transparent cursor-pointer">
                        <span class="material-icons" style="font-size: 1rem;">content_copy</span>
                      </button>
                    </span>
                  </div>
                  <div class="bank-row">
                    <span class="bank-label">Total a transferir:</span>
                    <span class="bank-value highlight-price flex items-center gap-2">
                      ${{ paymentInstructions?.amount | number:'1.2-2' }}
                      <button (click)="copyToClipboard(paymentInstructions?.amount, 'Total')" title="Copiar Total" class="text-gray-500 hover:text-[#16a34a] transition-colors border-none bg-transparent cursor-pointer">
                        <span class="material-icons" style="font-size: 1rem;">content_copy</span>
                      </button>
                    </span>
                  </div>
                  <div class="mt-2 text-sm text-gray-600" *ngIf="paymentInstructions?.referenceInstructions">
                    <strong>Instrucciones de referencia:</strong> {{ paymentInstructions?.referenceInstructions }}
                  </div>
                  <div class="mt-1 text-sm text-gray-600 italic" *ngIf="paymentInstructions?.additionalInstructions">
                    {{ paymentInstructions?.additionalInstructions }}
                  </div>
                </div>

                <div class="bank-details-box bg-red-50 border-red-200" *ngIf="paymentInstructions && !paymentInstructions.configured">
                  <p class="text-red-700 text-sm font-medium mb-0">
                    <span class="material-icons align-middle mr-1 text-red-600" style="font-size: 1.1rem;">error_outline</span>
                    Los datos bancarios aún no han sido configurados por el negocio.<br>
                    Comunícate con la tienda para completar tu pago.
                  </p>
                </div>
              </div>
              

              <!-- ESTADO CANCELADO -->
              <div *ngIf="order.status === 'CANCELLED'" class="proof-alert cancelled">
                <span class="material-icons">cancel</span> Este pedido fue cancelado. No se pueden subir comprobantes.
              </div>

              <!-- ESTADO PAGADO -->
              <div *ngIf="order.paymentStatus === 'PAID'" class="proof-alert success">
                <span class="material-icons">check_circle</span> Pago confirmado.
              </div>

              <!-- SECCIÓN COMPROBANTE -->
              <div class="proof-section" *ngIf="order.status !== 'CANCELLED' && order.paymentStatus !== 'PAID'">

                <!-- FORMULARIO SUBIR (SIN COMPROBANTE O RECHAZADO) -->
                <div *ngIf="!order.hasPaymentProof || order.paymentProofStatus === 'REJECTED'">
                  <div *ngIf="order.paymentProofStatus === 'REJECTED'" class="proof-alert error">
                    <span class="material-icons">error</span> Tu comprobante anterior fue rechazado. Puedes subir uno nuevo.
                    <br><strong>Motivo:</strong> {{ order.paymentProofRejectionReason }}
                  </div>

                  <form [formGroup]="proofForm" (ngSubmit)="submitProof()" class="proof-form">
                    <div class="form-group file-group">
                      <label for="proofFile">Seleccionar comprobante (JPG, PNG o PDF) <span class="required">*</span></label>
                      <input type="file" id="proofFile" (change)="onFileSelected($event)" accept=".jpg,.jpeg,.png,.pdf">
                      <small>Tamaño máximo: 5 MB.</small>
                    </div>

                    <div class="form-row">
                      <div class="form-group">
                        <label for="bankName">Banco emisor (Opcional)</label>
                        <input type="text" id="bankName" formControlName="bankName" placeholder="Ej. BBVA">
                      </div>
                      <div class="form-group">
                        <label for="referenceNumber">No. de referencia (Opcional)</label>
                        <input type="text" id="referenceNumber" formControlName="referenceNumber" placeholder="Referencia o folio">
                      </div>
                    </div>

                    <div class="form-row">
                      <div class="form-group">
                        <label for="amountDeclared">Monto transferido (Opcional)</label>
                        <input type="number" id="amountDeclared" formControlName="amountDeclared" step="0.01" min="0">
                      </div>
                      <div class="form-group">
                        <label for="transferDate">Fecha de transferencia (Opcional)</label>
                        <input type="date" id="transferDate" formControlName="transferDate">
                      </div>
                    </div>

                    <div class="form-group">
                      <label for="notes">Notas adicionales (Opcional)</label>
                      <textarea id="notes" formControlName="notes" rows="2"></textarea>
                    </div>

                    <div *ngIf="uploadError" class="error-msg">{{ uploadError }}</div>

                    <button type="submit" class="btn-primary" [disabled]="!selectedFile || isUploading || proofForm.invalid">
                      <span class="spinner-sm" *ngIf="isUploading"></span>
                      {{ isUploading ? 'Subiendo...' : 'Subir Comprobante' }}
                    </button>
                  </form>
                </div>

                <!-- EN REVISIÓN -->
                <div *ngIf="order.hasPaymentProof && order.paymentProofStatus === 'PENDING_REVIEW'" class="proof-alert warning">
                  <span class="material-icons">schedule</span> Tu comprobante está siendo revisado por el administrador.
                  <div class="proof-actions">
                    <button class="btn-secondary" (click)="viewProof()">Ver comprobante enviado</button>
                  </div>
                </div>

                <!-- APROBADO (Edge case si hasPaymentProof=true pero paymentStatus!=PAID aún por lag) -->
                <div *ngIf="order.hasPaymentProof && order.paymentProofStatus === 'APPROVED'" class="proof-alert success">
                  <span class="material-icons">check_circle</span> Comprobante aprobado.
                  <div class="proof-actions">
                    <button class="btn-secondary" (click)="viewProof()">Ver comprobante</button>
                  </div>
                </div>

              </div> <!-- fin sección comprobante -->
              
              <p class="bank-footer" *ngIf="!order.hasPaymentProof">
                <span class="material-icons">info</span>
                Asegúrate de que la imagen o PDF sea legible para evitar retrasos en tu envío.
              </p>
            </div>
          </div>

          <!-- PAGO CON MERCADO PAGO -->
          <div class="detail-card mercado-pago-card" *ngIf="order.paymentMethod === 'MERCADO_PAGO' && order.status !== 'CANCELLED' && order.paymentStatus !== 'PAID'">
            <div class="card-header" style="background-color: #009ee3; color: white;">
              <i class="fa-solid fa-handshake"></i>
              <h2 style="color: white; margin-left: 8px;">Mercado Pago Checkout Pro</h2>
            </div>
            <div class="card-body text-center" style="padding: 2rem;">
              <p class="mb-4 text-gray-700">Has elegido Mercado Pago como método de pago. Al hacer clic en el botón a continuación, serás redirigido a la plataforma segura de Mercado Pago para completar tu compra.</p>
              
              <button 
                (click)="payWithMercadoPago()" 
                [disabled]="isPayingWithMP"
                class="btn-primary"
                style="background-color: #009ee3; color: white; padding: 12px 24px; border-radius: 8px; font-weight: bold; border: none; cursor: pointer; display: inline-flex; items-align: center; gap: 8px;">
                <span *ngIf="isPayingWithMP" class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <i class="fa-solid fa-credit-card" *ngIf="!isPayingWithMP"></i>
                {{ isPayingWithMP ? 'Iniciando...' : 'Pagar con Mercado Pago' }}
              </button>
              
              <div class="mt-4 text-sm text-gray-500">
                <i class="fa-solid fa-lock"></i> Pagos procesados de forma segura.
              </div>
            </div>
          </div>

          <!-- NOTAS -->
          <div class="detail-card" *ngIf="order.customerNotes || order.notes">
            <div class="card-header">
              <span class="material-icons">notes</span>
              <h2>Notas del pedido</h2>
            </div>
            <div class="card-body">
              <p class="notes-text">{{ order.customerNotes || order.notes }}</p>
            </div>
          </div>

          <!-- PRODUCTOS -->
          <div class="detail-card">
            <div class="card-header">
              <span class="material-icons">inventory_2</span>
              <h2>Productos ({{ order.totalItems }})</h2>
            </div>
            <div class="card-body no-padding">
              <div class="product-row" *ngFor="let item of order.items">
                <div class="product-image-wrapper">
                  <img
                    [src]="item.productImage || '/assets/logoP.png'"
                    [alt]="item.productName"
                    class="product-image"
                    (error)="onImageError($event)"
                  >
                </div>
                <div class="product-info">
                  <span class="product-name">{{ item.productName }}</span>
                  <span class="product-sku" *ngIf="item.productSku">SKU: {{ item.productSku }}</span>
                  <span class="product-qty">Cantidad: {{ item.quantity }}</span>
                </div>
                <div class="product-pricing">
                  <span class="product-unit-price">${{ item.price | number:'1.2-2' }} c/u</span>
                  <span class="product-subtotal">${{ item.subtotal | number:'1.2-2' }}</span>
                </div>
              </div>
            </div>
          </div>

          <!-- ACCIÓN: CANCELAR -->
          <div class="cancel-action" *ngIf="canClientCancel()">
            <button class="btn-cancel-order" (click)="openCancelModal()">
              <span class="material-icons">cancel</span>Solicitar Cancelación
            </button>
            <p class="cancel-hint">Solo puedes cancelar pedidos pendientes o confirmados.</p>
          </div>

        </div>

        <!-- COLUMNA DERECHA: TOTALES -->
        <aside class="detail-sidebar">
          <div class="totals-card">
            <div class="card-header">
              <span class="material-icons">receipt</span>
              <h2>Resumen del Pago</h2>
            </div>
            <div class="card-body">
              <div class="total-row">
                <span>Subtotal</span>
                <span>${{ order.subtotal | number:'1.2-2' }}</span>
              </div>
              <div class="total-row">
                <span>IVA</span>
                <span>${{ order.tax | number:'1.2-2' }}</span>
              </div>
              <div class="total-row" *ngIf="order.shipping > 0">
                <span>Envío</span>
                <span>${{ order.shipping | number:'1.2-2' }}</span>
              </div>
              <div class="total-row discount-row" *ngIf="order.discount > 0">
                <span>Descuento</span>
                <span>-${{ order.discount | number:'1.2-2' }}</span>
              </div>
              <div class="total-divider"></div>
              <div class="total-row grand-total">
                <span>Total</span>
                <span>${{ order.total | number:'1.2-2' }}</span>
              </div>
            </div>
          </div>

          <div class="sidebar-actions">
            <a routerLink="/orders/my" class="btn-outline">
              <span class="material-icons">list</span>Ver todos mis pedidos
            </a>
            <a routerLink="/catalogo" class="btn-outline">
              <span class="material-icons">shopping_bag</span>Seguir comprando
            </a>
          </div>
        </aside>

      </div>

    </div><!-- /order detail -->

  </div><!-- /container -->
</div><!-- /detail-page -->

<!-- MODAL CANCELACIÓN -->
<div class="modal-overlay" *ngIf="showCancelModal" (click)="closeCancelModal()">
  <div class="modal-content" (click)="$event.stopPropagation()">
    <div class="modal-header">
      <span class="material-icons modal-icon warning-icon">warning_amber</span>
      <h3>¿Cancelar pedido?</h3>
    </div>
    <div class="modal-body">
      <p>Esta acción no se puede deshacer. El stock de los productos será restaurado automáticamente.</p>
      <div class="modal-form-group">
        <label for="cancelReason">Motivo de cancelación (opcional)</label>
        <textarea
          id="cancelReason"
          [(ngModel)]="cancelReason"
          class="modal-textarea"
          placeholder="Ej: Ya no necesito el producto, me equivoqué en el pedido..."
          rows="3"
          maxlength="500"
        ></textarea>
      </div>
      <div class="modal-error" *ngIf="cancelError">
        <span class="material-icons">error</span>{{ cancelError }}
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-modal-cancel" (click)="closeCancelModal()" [disabled]="isCancelling">
        No, mantener pedido
      </button>
      <button class="btn-modal-confirm" (click)="confirmCancel()" [disabled]="isCancelling">
        <span class="spinner-sm" *ngIf="isCancelling"></span>
        <span class="material-icons" *ngIf="!isCancelling">cancel</span>
        {{ isCancelling ? 'Cancelando...' : 'Sí, cancelar pedido' }}
      </button>
    </div>
  </div>
</div>

<!-- VISOR PROFESIONAL DE COMPROBANTE -->
<div class="modal-overlay visor-overlay" *ngIf="showProofPreviewModal" (click)="closeProofPreview()">
  <div class="modal-content visor-modal" (click)="$event.stopPropagation()">
    <div class="visor-header">
      <div class="visor-title-group">
        <span class="material-icons visor-icon">visibility</span>
        <div class="visor-title-text">
          <h3>Comprobante enviado</h3>
          <span class="visor-subtitle">Pedido #{{ proofPreviewOrderNumber }}</span>
        </div>
      </div>
      <div class="visor-status badge" [ngClass]="{
        'badge-amber': proofPreviewStatus === 'PENDING_REVIEW',
        'badge-green': proofPreviewStatus === 'APPROVED',
        'badge-red': proofPreviewStatus === 'REJECTED'
      }">
        {{ proofPreviewStatus === 'PENDING_REVIEW' ? 'EN REVISIÓN' : (proofPreviewStatus === 'APPROVED' ? 'APROBADO' : 'RECHAZADO') }}
      </div>
      <button class="btn-close" (click)="closeProofPreview()" aria-label="Cerrar visor"></button>
    </div>
    
    <div class="visor-body">
      <div class="visor-loading state-center" *ngIf="loadingProofPreview">
        <div class="spinner-large"></div>
        <p>Cargando comprobante...</p>
      </div>
      
      <div class="visor-error state-center" *ngIf="!loadingProofPreview && proofPreviewError">
        <span class="material-icons state-icon error-icon">error_outline</span>
        <p>{{ proofPreviewError }}</p>
      </div>

      <div class="visor-content" *ngIf="!loadingProofPreview && !proofPreviewError && proofPreviewSafeUrl" style="display: flex; justify-content: center; align-items: center; min-height: 400px; width: 100%; background: #f9fafb;">
        <canvas *ngIf="proofPreviewContentType === 'application/pdf'" #pdfCanvas class="visor-pdf-canvas" style="max-width: 100%; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);"></canvas>
        <img *ngIf="proofPreviewContentType?.startsWith('image/')" [src]="proofPreviewSafeUrl" alt="Comprobante" class="visor-img" style="max-width: 100%; max-height: 70vh; object-fit: contain;">
      </div>
    </div>
    
    <div class="visor-footer">
      <div class="visor-filename">
        <span class="material-icons">description</span>
        {{ proofPreviewFilename }}
      </div>
      <div class="visor-actions">
        <button (click)="openProofInNewTab()" [disabled]="!proofPreviewUrl" style="background-color: white; color: #722f37; border: 1px solid #722f37; padding: 8px 16px; border-radius: 6px; display: flex; align-items: center; gap: 6px; font-weight: 600; cursor: pointer;" [style.opacity]="!proofPreviewUrl ? '0.5' : '1'">
          <span class="material-icons" style="font-size: 18px;">open_in_new</span> Abrir
        </button>
        <button (click)="downloadProof()" [disabled]="!proofPreviewUrl" style="background-color: #722f37; color: white; border: none; padding: 8px 16px; border-radius: 6px; display: flex; align-items: center; gap: 6px; font-weight: 600; cursor: pointer; box-shadow: 0 1px 2px rgba(0,0,0,0.1);" [style.opacity]="!proofPreviewUrl ? '0.5' : '1'">
          <span class="material-icons" style="font-size: 18px;">download</span> Descargar comprobante
        </button>
      </div>
    </div>
  </div>
</div>
