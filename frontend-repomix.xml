  width: 10px;
  height: 10px;
  border-radius: 2px;
  flex-shrink: 0;
}

/* ════════════════════════════════════════════════════════════════
   NOTA AL PIE de gráficas
═══════════════════════════════════════════════════════════════ */
.mon-chart-footnote {
  padding: .25rem 1.5rem .75rem;
  font-size: .72rem;
  font-style: italic;
  color: #94a3b8;
  line-height: 1.5;
