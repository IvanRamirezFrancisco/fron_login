  align-items: center;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid #f0f0f0;
}

.precio-label {
  font-size: 0.75rem;
  color: #888;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.precio-original {
  font-size: 0.9rem;
  color: #999;
  text-decoration: line-through;
  font-weight: 600;
}

/* Precio Main - Precio actual + Ahorro */
.precio-main {
