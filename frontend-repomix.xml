.mon-alert-card:last-child { border-bottom: none; }
.mon-alert-card:hover { background: #fafafa; }
.mon-alert-card--critical { border-left: 4px solid #ef4444; }
.mon-alert-card--warning  { border-left: 4px solid #f59e0b; }

.mon-alert-card__icon {
  width: 36px; height: 36px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  margin-top: .1rem;
}
.mon-alert-card--critical .mon-alert-card__icon { background: #fee2e2; }
.mon-alert-card--critical .mon-alert-card__icon .material-icons { color: #ef4444; font-size: 1.2rem; }
.mon-alert-card--warning  .mon-alert-card__icon { background: #fef3c7; }
.mon-alert-card--warning  .mon-alert-card__icon .material-icons { color: #f59e0b; font-size: 1.2rem; }

.mon-alert-card__body { flex: 1; min-width: 0; }
.mon-alert-card__top {
  display: flex;
  align-items: center;
  gap: .5rem;
  margin-bottom: .35rem;
}
.mon-alert-badge {
  padding: .15em .6em;
  border-radius: 5px;
  font-size: .67rem;
  font-weight: 800;
  letter-spacing: .04em;
  text-transform: uppercase;
}
.mon-alert-badge--critical { background: #fee2e2; color: #dc2626; }
.mon-alert-badge--warning  { background: #fef3c7; color: #92400e; }
.mon-alert-category {
  font-size: .72rem;
  color: #9ca3af;
  font-weight: 600;
}
.mon-alert-card__msg {
  margin: 0 0 .25rem;
  font-size: .85rem;
  font-weight: 600;
  color: #111827;
}
.mon-alert-card__value {
  margin: 0 0 .35rem;
  font-size: .78rem;
  color: #6b7280;
}
.mon-alert-card__hint {
  margin: 0;
  font-size: .75rem;
  color: #374151;
  display: flex;
  align-items: flex-start;
  gap: .35rem;
  line-height: 1.45;
}
.mon-alert-card__hint .material-icons { font-size: .9rem; color: #6b7280; flex-shrink: 0; margin-top: .05rem; }

/* ════════════════════════════════════════════════════════════════
   TOOLTIP — sistema CSS puro, position:fixed, nunca recortado
═══════════════════════════════════════════════════════════════ */

/* ── Contenedor disparador: cualquier elemento que tenga un .mon-tt-fixed dentro ── */
.mon-th-tip,
.mon-tt-wrap {
  position: relative;
}

/* ── El tooltip en sí ── */
.mon-tt-fixed {
  display: none;
  position: fixed;
  z-index: 9999;
  background: #1e293b;
  color: #f1f5f9;
  font-size: .73rem;
  font-weight: 400;
  line-height: 1.55;
  padding: .75rem 1rem;
  border-radius: 10px;
  white-space: normal;
  max-width: 280px;
  min-width: 180px;
  box-shadow: 0 8px 24px rgba(0,0,0,.32);
  pointer-events: none;
  text-align: left;
  /* Posición por defecto: aparece debajo del cursor via JS-less CSS trick */
  top: auto;
  left: auto;
  /* Usamos transform para anclar al TH padre mediante CSS hover */
  transform: none;
}

/* Triángulo apuntando hacia arriba (tooltip debajo del th) */
.mon-tt-fixed::before {
  content: '';
  position: absolute;
  bottom: 100%;
  left: 1.2rem;
  border: 7px solid transparent;
  border-bottom-color: #1e293b;
}

/* Mostrar al hacer hover sobre el disparador */
.mon-th-tip:hover > .mon-tt-fixed,
.mon-tt-wrap:hover > .mon-tt-fixed {
  display: block;
  /* Anclamos abajo-izquierda del TH usando inset */
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  /* Evitar que se salga por la derecha */
  right: auto;
}

/* Variante: abrir hacia la izquierda (últimas columnas) */
.mon-th-tip:hover > .mon-tt-fixed--left,
.mon-tt-wrap:hover > .mon-tt-fixed--left {
  left: auto;
  right: 0;
}
.mon-tt-fixed--left::before {
  left: auto;
  right: 1.2rem;
}

/* Tooltip para nombres largos en celdas (aparece encima para no tapar la tabla) */
.mon-tt-fixed--name {
  font-size: .75rem;
  max-width: 340px;
  white-space: pre-wrap;
  word-break: break-all;
}
.mon-tt-wrap:hover > .mon-tt-fixed--name {
  top: auto;
  bottom: calc(100% + 8px);
  left: 0;
  right: auto;
}
.mon-tt-fixed--name::before {
  bottom: auto;
  top: 100%;
  border-bottom-color: transparent;
  border-top-color: #1e293b;
}

/* Mini-badges dentro del tooltip de Estado */
.mon-tt-badge {
  display: inline-block;
  padding: .1em .5em;
  border-radius: 999px;
  font-size: .7rem;
  font-weight: 700;
  margin-right: .3rem;
}
.mon-tt-badge--green { background: #dcfce7; color: #15803d; }
.mon-tt-badge--amber { background: #fef3c7; color: #92400e; }
.mon-tt-badge--red   { background: #fee2e2; color: #b91c1c; }

/* Encabezado del TH: flex para alinear texto + iconos */
.mon-th-inner {
  display: inline-flex;
  align-items: center;
  gap: .25rem;
  cursor: pointer;
}

/* Help icon en TH */
.mon-th-help {
  font-size: .85rem !important;
  vertical-align: middle;
  color: #d1d5db;
  margin-left: .1rem;
  cursor: help;
  transition: color .15s;
}
.mon-th-tip:hover .mon-th-help { color: #6b7280; }

/* ═══ Tooltip overlay global — position:fixed, nunca recortado ══════════ */
/*
 * Se renderiza al final del DOM, fuera de cualquier contenedor con
 * overflow:hidden. La posición (top/left) se calcula en TypeScript
 * mediante getBoundingClientRect() del elemento disparador.
 *
 * Por defecto abre hacia ARRIBA (transform-origin: bottom center).
 * Con la clase --down abre hacia ABAJO (transform-origin: top center).
 */
.mon-tooltip-overlay {
  position: fixed;
  left: 50%;                          /* sobreescrito por [style.left.px] */
  transform: translateX(-50%) translateY(-100%);
  background: #1e293b;
  color: #f1f5f9;
  font-size: .78rem;
  font-weight: 400;
  line-height: 1.6;
  padding: .7rem 1rem;
  border-radius: 10px;
  white-space: normal;
  max-width: 300px;
  min-width: 180px;
  width: max-content;
  box-shadow: 0 8px 24px rgba(0,0,0,.30);
  z-index: 99999;
  pointer-events: none;
  text-align: center;
  /* pequeña animación de entrada */
  animation: tooltipFadeIn .12s ease;
}
/* Flecha hacia abajo (tooltip abre arriba) */
.mon-tooltip-overlay::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  border: 7px solid transparent;
  border-top-color: #1e293b;
}
/* Cuando abre hacia ABAJO */
.mon-tooltip-overlay--down {
  transform: translateX(-50%) translateY(0);
}
.mon-tooltip-overlay--down::after {
  top: auto;
  bottom: 100%;
  border-top-color: transparent;
  border-bottom-color: #1e293b;
}
@keyframes tooltipFadeIn {
  from { opacity: 0; transform: translateX(-50%) translateY(calc(-100% - 4px)); }
  to   { opacity: 1; transform: translateX(-50%) translateY(-100%); }
}
@keyframes tooltipFadeInDown {
  from { opacity: 0; transform: translateX(-50%) translateY(4px); }
  to   { opacity: 1; transform: translateX(-50%) translateY(0); }
}
.mon-tooltip-overlay--down {
  animation: tooltipFadeInDown .12s ease;
}

/* ═══ Tooltip legado — ELIMINADO, reemplazado por mon-tooltip-overlay ════ */
/* Se mantiene el selector vacío para no romper referencias residuales     */
.mon-tooltip { display: none !important; }

/* ════════════════════════════════════════════════════════════════
   COLORES DE TEXTO SEMÁNTICOS
═══════════════════════════════════════════════════════════════ */
.text-green { color: #16a34a !important; }
.text-amber { color: #b45309 !important; }
.text-red   { color: #dc2626 !important; }

/* ════════════════════════════════════════════════════════════════
   CALLOUT VERDE (sin alertas)
═══════════════════════════════════════════════════════════════ */
.callout--green {
  background: #f0fdf4;
  border-left-color: #22c55e;
  color: #15803d;
}
.callout--green .material-icons { color: #22c55e; }
.callout--green strong { color: #15803d; }

/* ════════════════════════════════════════════════════════════════
   CALLOUT INFO (índices sin datos suficientes)
═══════════════════════════════════════════════════════════════ */
.callout--info {
  background: #eff6ff;
  border-left-color: #3b82f6;
  color: #1e40af;
}
.callout--info .material-icons { color: #3b82f6; }
.callout--info strong { color: #1d4ed8; }

/* ════════════════════════════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════════════════════════ */
@media (max-width: 1100px) {
  .mon-health-panel { grid-template-columns: 120px 1fr; }
  .mon-kpi-row      { display: grid; grid-template-columns: 1fr 1fr; }
  .mon-perf-grid    { grid-template-columns: 1fr; }
}
@media (max-width: 768px) {
  .mon-health-panel { grid-template-columns: 1fr; justify-items: center; text-align: center; }
  .mon-health-label { justify-content: center; }
  .mon-kpi-row      { grid-template-columns: 1fr; }
  .mon-conn-top     { flex-direction: column; align-items: flex-start; }
}

/* ════════════════════════════════════════════════════════════════
   SECCIÓN 3 — DONUT DE CONEXIONES
═══════════════════════════════════════════════════════════════ */

/* Contenedor del cuerpo de conexiones */
.mon-conn-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
  padding: .5rem 0 .25rem;
}

/* Contenedor de la dona — es el área clickeable */
.mon-donut-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .85rem;
  cursor: pointer;
  padding: 1rem 1.5rem .75rem;
  border: 2px solid transparent;
  border-radius: 16px;
  transition: border-color .2s, background .2s;
  user-select: none;
  width: 100%;
  max-width: 380px;
}
.mon-donut-wrap:hover {
  border-color: #e5e7eb;
  background: #f9fafb;
}
.mon-donut-wrap--expanded {
  border-color: #d1d5db;
  background: #f9fafb;
}

/* SVG de la dona */
.mon-donut-svg {
  width: 160px;
  height: 160px;
  filter: drop-shadow(0 2px 8px rgba(0,0,0,.08));
  overflow: visible;
}

/* Textos SVG dentro de la dona */
.mon-donut-num {
  font-size: 1.9rem;
  font-weight: 800;
  font-family: 'DM Sans', sans-serif;
}
.mon-donut-sub {
  font-size: .72rem;
  fill: #9ca3af;
  font-family: 'DM Sans', sans-serif;
}
.mon-donut-pct {
  font-size: .8rem;
  font-weight: 700;
  font-family: 'DM Sans', sans-serif;
}

/* Leyenda de la dona */
.mon-donut-legend {
  display: flex;
  flex-wrap: wrap;
  gap: .5rem .85rem;
  justify-content: center;
}
.mon-donut-legend__item {
  display: flex;
  align-items: center;
  gap: .35rem;
  font-size: .75rem;
  color: #374151;
}
.mon-donut-legend__dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}
.mon-donut-legend__val {
  font-weight: 700;
  font-size: .78rem;
  color: #111827;
  margin-left: .1rem;
}

/* Botón "Ver desglose" */
.mon-donut-expand-btn {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  padding: .35em .9em;
  font-size: .78rem;
  font-weight: 500;
  color: #4b5563;
  background: #fff;
  border: 1px solid #d1d5db;
  border-radius: 999px;
  cursor: pointer;
  transition: background .15s, color .15s;
  font-family: inherit;
}
.mon-donut-expand-btn:hover {
  background: #f3f4f6;
  color: #111827;
}
.mon-donut-expand-btn .material-icons {
  font-size: 1.05rem;
}

/* ── Panel de desglose (expandido) ── */
.mon-conn-breakdown {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: .5rem;
  align-items: start;
  animation: fadeSlideDown .22s ease forwards;
}

@keyframes fadeSlideDown {
  from { opacity: 0; transform: translateY(-8px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Divisor vertical entre subsecciones */
.mon-conn-divider {
  width: 1px;
  background: #e5e7eb;
  align-self: stretch;
  margin-top: .5rem;
}

/* Cada subsección */
.mon-conn-sub {
  background: #fafafa;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: .9rem 1rem;
}

/* Header de subsección */
.mon-conn-sub__header {
  display: flex;
  align-items: center;
  gap: .45rem;
  margin-bottom: .75rem;
  position: relative;
}
.mon-conn-sub__header .material-icons { font-size: 1.15rem; }
.mon-conn-sub__title {
  margin: 0;
  font-size: .83rem;
  font-weight: 700;
  color: #111827;
  flex: 1;
}
.mon-conn-sub__tooltip-wrap {
  position: relative;
  display: inline-flex;
  cursor: help;
}

/* Fila stat (label + valor) */
.mon-conn-stat-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: .35rem;
}
.mon-conn-stat__label { font-size: .78rem; color: #6b7280; }
.mon-conn-stat__val   { font-size: .88rem; font-weight: 700; }

/* Grid de breakdown tipo (pool, interno) */
.mon-conn-breakdown-grid {
  display: flex;
  flex-direction: column;
  gap: .4rem;
  margin-top: .5rem;
}
.mon-conn-breakdown-item {
  display: flex;
  align-items: center;
  gap: .5rem;
}
.mon-conn-breakdown-dot {
  width: 9px; height: 9px;
  border-radius: 50%;
  flex-shrink: 0;
}
.mon-conn-breakdown-label {
  flex: 1;
  font-size: .77rem;
  color: #374151;
}
.mon-conn-breakdown-num {
  font-size: .82rem;
  font-weight: 700;
  color: #111827;
}

/* "Sin usuarios" */
.mon-conn-no-users {
  display: flex;
  align-items: center;
  gap: .5rem;
  color: #9ca3af;
  font-size: .82rem;
  padding: .5rem 0;
}
.mon-conn-no-users .material-icons { font-size: 1.15rem; }

/* Tabla detallada de sesiones de usuario */
.mon-conn-users-table {
  width: 100%;
  border-collapse: collapse;
  font-size: .8rem;
  margin-top: .25rem;
}
.mon-conn-users-table thead tr {
  background: #f3f4f6;
}
.mon-conn-users-table th {
  padding: 6px 10px;
  text-align: left;
  font-weight: 600;
  color: #6b7280;
  font-size: .75rem;
  text-transform: uppercase;
  letter-spacing: .03em;
  white-space: nowrap;
}
.mon-conn-users-table tbody tr {
  border-top: 1px solid #f3f4f6;
}
.mon-conn-users-table tbody tr:hover {
  background: #f9fafb;
}
.mon-conn-users-table td {
  padding: 7px 10px;
  color: #374151;
  white-space: nowrap;
}
.mon-session-user   { font-weight: 500; }
.mon-session-ip     { color: #6b7280; font-family: monospace; font-size: .78rem; }
.mon-session-time   { color: #9ca3af; font-size: .78rem; }
.mon-session-ua     { font-size: .78rem; }

/* Badge "×2" para múltiples sesiones abiertas */
.mon-session-multi {
  display: inline-block;
  margin-left: 5px;
  padding: 1px 6px;
  border-radius: 999px;
  background: #e0e7ff;
  color: #4338ca;
  font-size: .7rem;
  font-weight: 700;
  vertical-align: middle;
}

/* Badges de estado de sesión */
.mon-session-badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: .73rem;
  font-weight: 600;
}
.mon-session-badge--active {
  background: #dcfce7;
  color: #16a34a;
}
.mon-session-badge--idle {
  background: #f3f4f6;
  color: #6b7280;
}
.mon-session-badge--transaction {
  background: #fef3c7;
  color: #d97706;
}

/* ── Badge de total junto al título ── */
.mon-session-total-badge {
  display: inline-flex;
  align-items: center;
  padding: 2px 10px;
  border-radius: 999px;
  font-size: .75rem;
  font-weight: 700;
  line-height: 1.6;
  margin-left: 6px;
}
.mon-session-total-badge--green {
  background: #dcfce7;
  color: #15803d;
}
.mon-session-total-badge--gray {
  background: #f3f4f6;
  color: #9ca3af;
}

/* ── Chips de resumen: 30 min / 1 hora / Hoy ── */
.mon-session-chips {
  display: flex;
  gap: .6rem;
  flex-wrap: wrap;
  margin: .6rem 0 .75rem;
}
.mon-session-chip {
  display: inline-flex;
  align-items: baseline;
  gap: .3rem;
  padding: 4px 12px;
  border-radius: 8px;
  border: 1px solid transparent;
  font-size: .78rem;
}
.mon-session-chip--green {
  background: #f0fdf4;
  border-color: #bbf7d0;
  color: #166534;
}
.mon-session-chip--blue {
  background: #eff6ff;
  border-color: #bfdbfe;
  color: #1e40af;
}
.mon-session-chip--slate {
  background: #f8fafc;
  border-color: #e2e8f0;
  color: #475569;
}
.mon-session-chip__num {
  font-size: 1rem;
  font-weight: 800;
  line-height: 1;
}
.mon-session-chip__label {
  font-size: .72rem;
  font-weight: 500;
}

/* ── Header de subsección con badge integrado ── */
.mon-conn-sub__header {
  display: flex;
  align-items: center;
  gap: .5rem;
  flex-wrap: wrap;
  margin-bottom: .5rem;
}
.mon-conn-sub__title {
  font-size: .9rem;
  font-weight: 600;
  color: #1f2937;
  margin: 0;
}

.mon-tooltip-warn { color: #ef4444; }

/* ════════════════════════════════════════════════════════════════
   TOGGLE DE VISTA (Tabla / Gráfica) — secciones 4 y 5
═══════════════════════════════════════════════════════════════ */
.mon-view-toggle {
  display: inline-flex;
  align-items: center;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  overflow: hidden;
  flex-shrink: 0;
}
.mon-view-toggle button {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  padding: .38em .8em;
  font-size: .78rem;
  font-weight: 500;
  color: #4b5563;
  background: #fff;
  border: none;
  cursor: pointer;
  transition: background .15s, color .15s;
  font-family: inherit;
  white-space: nowrap;
}
.mon-view-toggle button:not(:last-child) {
  border-right: 1px solid #d1d5db;
}
.mon-view-toggle button .material-icons {
  font-size: .95rem;
}
.mon-view-toggle button:hover {
  background: #f3f4f6;
  color: #111827;
}
.mon-view-toggle__btn--active {
  background: #111827 !important;
  color: #fff !important;
}

/* ════════════════════════════════════════════════════════════════
   GRÁFICA DE BARRAS HORIZONTALES
═══════════════════════════════════════════════════════════════ */
.mon-hbar-container {
  padding: .75rem .25rem .25rem;
  display: flex;
  flex-direction: column;
  gap: .25rem;
}

/* Leyenda de colores */
.mon-hbar-legend {
  display: flex;
  flex-wrap: wrap;
  gap: .4rem 1.2rem;
  margin-bottom: .65rem;
  padding-bottom: .65rem;
  border-bottom: 1px solid #f3f4f6;
}
.mon-hbar-legend__item {
  display: flex;
  align-items: center;
  gap: .35rem;
  font-size: .74rem;
  color: #6b7280;
}
.mon-hbar-legend__dot {
  width: 10px; height: 10px;
  border-radius: 2px;
  flex-shrink: 0;
}

/* Fila de cada elemento de la gráfica */
.mon-hbar-row {
  display: grid;
  grid-template-columns: 150px 1fr 70px;
  align-items: center;
  gap: .6rem;
  padding: .3rem 0;
  border-bottom: 1px solid #f9fafb;
}
.mon-hbar-row:last-child { border-bottom: none; }

/* Etiqueta (nombre de tabla/índice) */
.mon-hbar-label {
  font-size: .77rem;
  font-weight: 600;
  color: #374151;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  cursor: default;
}
.mon-hbar-label-group {
  display: flex;
  flex-direction: column;
  gap: .1rem;
  overflow: hidden;
}
.mon-hbar-sublabel {
  font-size: .68rem;
  color: #9ca3af;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Área de barras */
.mon-hbar-bars {
  display: flex;
  flex-direction: column;
  gap: 4px;
  position: relative;
}

/* Pista (fondo gris de la barra) */
.mon-hbar-track {
  position: relative;
  height: 10px;
  background: #f3f4f6;
  border-radius: 4px;
  overflow: visible;
}
.mon-hbar-track--idx {
  height: 14px;
  border-radius: 6px;
}

/* Relleno coloreado */
.mon-hbar-fill {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  border-radius: inherit;
  transition: width .6s cubic-bezier(.4,0,.2,1);
  min-width: 2px;
}

/* Valores numéricos a la derecha */
.mon-hbar-vals {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: .1rem;
  font-size: .73rem;
}
.text-muted { color: #9ca3af; }

/* ── Responsive ── */
@media (max-width: 768px) {
  .mon-conn-breakdown {
    grid-template-columns: 1fr;
  }
  .mon-conn-divider {
    width: 100%;
    height: 1px;
  }
  .mon-hbar-row {
    grid-template-columns: 120px 1fr 55px;
  }
  .mon-view-toggle button span:not(.material-icons) {
    display: none;
  }
}

/* ════════════════════════════════════════════════════════════════
   BARRA DE FILTROS
═══════════════════════════════════════════════════════════════ */
.mon-filter-bar {
  display: flex;
  align-items: center;
  gap: .6rem;
  flex-wrap: wrap;
  padding: .6rem .25rem .75rem;
  border-bottom: 1px solid #f3f4f6;
  margin-bottom: .5rem;
}

/* Input de búsqueda */
.mon-filter-search {
  position: relative;
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 180px;
  max-width: 320px;
}
.mon-filter-search > .material-icons {
  position: absolute;
  left: .55rem;
  font-size: 1rem;
  color: #9ca3af;
  pointer-events: none;
}
.mon-filter-input {
  width: 100%;
  padding: .4em .4em .4em 2rem;
  font-size: .82rem;
  font-family: inherit;
  border: 1px solid #d1d5db;
  border-radius: 7px;
  background: #fff;
  color: #111827;
  outline: none;
  transition: border-color .15s;
}
.mon-filter-input:focus { border-color: #6b7280; }
.mon-filter-clear {
  position: absolute;
  right: .4rem;
  background: none;
  border: none;
  cursor: pointer;
  color: #9ca3af;
  display: flex;
  align-items: center;
  padding: 0;
}
.mon-filter-clear .material-icons { font-size: .9rem; }

/* Select de estado */
.mon-filter-select {
  padding: .4em .75em;
  font-size: .82rem;
  font-family: inherit;
  border: 1px solid #d1d5db;
  border-radius: 7px;
  background: #fff;
  color: #374151;
  cursor: pointer;
  outline: none;
}
.mon-filter-select:focus { border-color: #6b7280; }

/* Toggle "Solo con actividad" */
.mon-filter-toggle {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  cursor: pointer;
  user-select: none;
}
.mon-filter-toggle input[type="checkbox"] { display: none; }
.mon-filter-toggle__track {
  width: 34px;
  height: 18px;
  background: #d1d5db;
  border-radius: 999px;
  position: relative;
  flex-shrink: 0;
  transition: background .2s;
}
.mon-filter-toggle__track::after {
  content: '';
  position: absolute;
  top: 2px; left: 2px;
  width: 14px; height: 14px;
  background: #fff;
  border-radius: 50%;
  transition: transform .2s;
  box-shadow: 0 1px 3px rgba(0,0,0,.2);
}
.mon-filter-toggle input:checked ~ .mon-filter-toggle__track { background: #111827; }
.mon-filter-toggle input:checked ~ .mon-filter-toggle__track::after { transform: translateX(16px); }
.mon-filter-toggle__label { font-size: .8rem; color: #374151; }

/* ════════════════════════════════════════════════════════════════
   TABLA COMPACTA
═══════════════════════════════════════════════════════════════ */
.mon-table--compact th,
.mon-table--compact td {
  padding: 0 .75rem;
  font-size: .8rem;
  white-space: nowrap;
  vertical-align: middle;
}

/* Altura fija por fila — todos los datos en la misma línea */
.mon-table--compact tbody tr,
.mon-tr--fixed {
  height: 48px;
  max-height: 48px;
}
.mon-table--compact thead tr { height: 40px; }

/* Fondo alternado */
.mon-table--striped tbody tr:nth-child(odd),
.mon-tr--alt {
  background-color: #f9fafb;
}
.mon-table--striped tbody tr:nth-child(even) {
  background-color: #ffffff;
}
.mon-table--striped tbody tr:hover,
.mon-tr--fixed:hover {
  background-color: #f0f9ff !important;
  transition: background .12s;
}

/* Columnas numéricas alineadas a la derecha */
.mon-td-num {
  text-align: right;
  font-variant-numeric: tabular-nums;
  font-size: .8rem;
}
.mon-td-date {
  font-size: .76rem;
  color: #6b7280;
}

/* Celda de nombre (índice / tabla) */
.mon-td-name {
  display: flex !important;
  align-items: center;
  gap: .4rem;
  max-width: 260px;
  overflow: hidden;
}

/* Nombre de tabla (columna segunda en tabla-índices) */
.mon-td-tbl {
  font-size: .78rem;
  color: #4b5563;
  max-width: 130px;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Nombre truncado con tooltip al hover */
.mon-td-truncated {
  max-width: 220px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: inline-block;
  vertical-align: middle;
  position: relative;
}

/* ── Ocultar columnas en pantallas pequeñas ── */
.mon-col-hide-sm { display: table-cell; }
@media (max-width: 720px) {
  .mon-col-hide-sm { display: none !important; }
}

/* Ícono de ordenamiento en encabezados */
.mon-th-sortable {
  cursor: pointer;
  user-select: none;
  white-space: nowrap;
  position: relative;
}
.mon-th-sortable:hover { background: #f9fafb; }
.mon-sort-icon {
  font-size: .82rem !important;
  color: #9ca3af;
  vertical-align: middle;
  margin-left: .1rem;
}

/* Estado vacío de tabla */
.mon-td-empty {
  text-align: center;
  padding: 2rem 1rem !important;
  color: #9ca3af;
  font-size: .85rem;
}
.mon-td-empty .material-icons {
  font-size: 1.6rem;
  display: block;
  margin: 0 auto .35rem;
  color: #d1d5db;
}

/* Nota informativa debajo de la tabla de índices */
.mon-index-note {
  margin: .5rem 1.25rem 1rem;
  padding: .65rem .9rem;
  background: #f8fafc;
  border-left: 3px solid #cbd5e1;
  border-radius: 0 8px 8px 0;
  font-size: .76rem;
  color: #64748b;
  line-height: 1.5;
}

/* ════════════════════════════════════════════════════════════════
   PAGINACIÓN
═══════════════════════════════════════════════════════════════ */
.mon-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .25rem;
  padding: .65rem .25rem;
  flex-wrap: wrap;
}
.mon-page-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32px;
  height: 32px;
  padding: 0 .4rem;
  font-size: .8rem;
  font-family: inherit;
  border: 1px solid #e5e7eb;
  border-radius: 6px;
  background: #fff;
  color: #374151;
  cursor: pointer;
  transition: background .12s, border-color .12s;
}
.mon-page-btn:hover:not(:disabled) { background: #f3f4f6; border-color: #d1d5db; }
.mon-page-btn:disabled { opacity: .4; cursor: default; }
.mon-page-btn--active {
  background: #111827 !important;
  color: #fff !important;
  border-color: #111827 !important;
}
.mon-page-btn .material-icons { font-size: 1rem; }
.mon-page-info {
  font-size: .76rem;
  color: #9ca3af;
  margin-left: .35rem;
}

/* Badge contador de filas */
.mon-count-badge {
  display: inline-flex;
  align-items: center;
  margin-left: .45rem;
  padding: .1em .55em;
  background: #f3f4f6;
  border-radius: 999px;
  font-size: .72rem;
  color: #6b7280;
  font-weight: 500;
}

/* Nota aclaratoria en gráfica */
.mon-hbar-chart-note {
  font-size: .72rem;
  color: #9ca3af;
  font-style: italic;
  margin-left: auto;
}

/* ── Responsive filtros ── */
@media (max-width: 768px) {
  .mon-filter-bar    { flex-direction: column; align-items: stretch; }
  .mon-filter-search { max-width: 100%; }
  .mon-pagination    { gap: .2rem; }
  .mon-page-btn      { min-width: 28px; height: 28px; font-size: .75rem; }
}

/* ════════════════════════════════════════════════════════════════
   OVERRIDE: table-wrap en este componente permite overflow visible
   para que los tooltips de las cabeceras no queden recortados.
   El scroll horizontal se traslada al <table> directamente.
═══════════════════════════════════════════════════════════════ */
.mon-section-card .table-wrap {
  overflow: visible;
}
.mon-section-card .mon-table {
  min-width: 640px;
  width: 100%;
}
@media (max-width: 720px) {
  /* En móvil ponemos scroll en el wrapper pero los tooltips
     del thead se ven igualmente porque están fuera del flujo */
  .mon-section-card .table-wrap {
    overflow-x: auto;
    overflow-y: visible;
  }
}

/* ════════════════════════════════════════════════════════════════
   SELECTOR: contador X/N y mensaje de límite (compartido tablas+índices)
═══════════════════════════════════════════════════════════════ */
.mon-sel-counter {
  font-size: .7rem;
  font-weight: 600;
  color: #22c55e;
  white-space: nowrap;
  margin-left: auto;
  padding: 3px 9px;
  border-radius: 10px;
  background: rgba(34,197,94,.1);
  border: 1px solid rgba(34,197,94,.25);
  transition: color .2s, background .2s, border-color .2s;
  flex-shrink: 0;
  cursor: default;
  position: relative;
}
.mon-sel-counter--limit {
  color: #f97316;
  background: rgba(249,115,22,.1);
  border-color: rgba(249,115,22,.3);
  cursor: help;
  /* Animación pulso sutil cuando está en el límite */
  animation: mon-counter-pulse 2s ease-in-out infinite;
}
@keyframes mon-counter-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(249,115,22,.0); }
  50%       { box-shadow: 0 0 0 4px rgba(249,115,22,.18); }
}

.mon-sel-limit-msg {
  margin: 6px 0 0;
  font-size: .72rem;
  color: #f97316;
  display: flex;
  align-items: center;
  gap: 4px;
}

/* Chip deshabilitado (no seleccionado cuando se alcanzó el límite) */
.mon-chip--disabled,
.mon-idx-chip--disabled {
  opacity: .38;
  cursor: not-allowed;
}
/* Quitamos los ::after / ::before — ahora usa tooltip DOM global */
.mon-idx-chip--disabled:hover[data-tooltip]:not([data-tooltip=""])::after,
.mon-chip--disabled:hover[data-tooltip]:not([data-tooltip=""])::after,
.mon-idx-chip--disabled:hover[data-tooltip]:not([data-tooltip=""])::before,
.mon-chip--disabled:hover[data-tooltip]:not([data-tooltip=""])::before {
  content: none;
}

/* Botón Aplicar deshabilitado */
.mon-sel-apply[disabled],
.mon-sel-apply:disabled {
  opacity: .4;
  cursor: not-allowed;
}

/* ════════════════════════════════════════════════════════════════
   PANEL DE ÍNDICES REDISEÑADO — .mon-idx-panel
═══════════════════════════════════════════════════════════════ */
.mon-idx-panel {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  padding: 12px 16px;
  margin-bottom: 16px;
}

/* ── Barra superior del panel ── */
.mon-idx-panel__topbar {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 10px;
}

.mon-idx-panel__search-wrap {
  position: relative;
  display: flex;
  align-items: center;
  flex: 0 0 220px;
}
.mon-idx-panel__search-icon {
  position: absolute;
  left: 8px;
  font-size: 15px;
  color: #94a3b8;
  pointer-events: none;
}
.mon-idx-panel__search {
  width: 100%;
  padding: 5px 28px 5px 28px;
  border: 1px solid #cbd5e1;
  border-radius: 6px;
  font-size: .78rem;
  background: #fff;
  color: #1e293b;
  outline: none;
  transition: border-color .15s;
}
.mon-idx-panel__search:focus { border-color: #3b82f6; }
.mon-idx-panel__search-clear {
  position: absolute;
  right: 4px;
  background: none;
  border: none;
  cursor: pointer;
  color: #94a3b8;
  padding: 2px;
  display: flex;
  align-items: center;
}
.mon-idx-panel__search-clear .material-icons { font-size: 14px; }

.mon-idx-panel__actions {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
}

/* ── Área de grupos (scroll interno) ── */
.mon-idx-panel__groups {
  max-height: 400px;
  overflow-y: auto;
  overflow-x: hidden;
  padding-right: 4px;
  margin-bottom: 8px;
}
/* scrollbar delgada */
.mon-idx-panel__groups::-webkit-scrollbar { width: 5px; }
.mon-idx-panel__groups::-webkit-scrollbar-track { background: transparent; }
.mon-idx-panel__groups::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }

.mon-idx-panel__empty {
  font-size: .78rem;
  color: #94a3b8;
  text-align: center;
  padding: 16px 0;
}

/* ── Grupo colapsable ── */
.mon-idx-group { border-bottom: 1px solid #f1f5f9; }
.mon-idx-group:last-child { border-bottom: none; }

.mon-idx-group__header {
  display: flex;
  align-items: center;
  gap: 6px;
  width: 100%;
  background: none;
  border: none;
  cursor: pointer;
  padding: 6px 4px;
  text-align: left;
  border-radius: 6px;
  transition: background .1s;
}
.mon-idx-group__header:hover { background: #e2e8f0; }

.mon-idx-group__arrow {
  font-size: 16px;
  color: #94a3b8;
  transition: transform .18s;
  flex-shrink: 0;
}
.mon-idx-group__arrow--open {
  transform: rotate(90deg);
}

.mon-idx-group__table {
  font-size: .78rem;
  font-weight: 600;
  color: #334155;
  font-family: 'Courier New', monospace;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mon-idx-group__count {
  font-size: .68rem;
  color: #94a3b8;
  flex-shrink: 0;
}

/* ── Chips de índice ── */
.mon-idx-group__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  padding: 4px 4px 8px 22px;
}

.mon-idx-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 8px;
  border-radius: 6px;
  border: 1px solid #e2e8f0;
  background: #fff;
  cursor: pointer;
  transition: background .15s, border-color .15s, opacity .15s;
  max-width: 240px;
}
.mon-idx-chip:hover {
  background: #f1f5f9;
  border-color: #94a3b8;
}
.mon-idx-chip--active {
  background: #eff6ff;
  border-color: #3b82f6;
}
.mon-idx-chip--active:hover { background: #dbeafe; }

/* Punto de color */
.mon-idx-chip__dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  flex-shrink: 0;
  background: #e2e8f0;       /* unused: gris */
}
.mon-idx-chip__dot--ok     { background: #16a34a; }
.mon-idx-chip__dot--warn   { background: #d97706; }
.mon-idx-chip__dot--bad    { background: #dc2626; }
.mon-idx-chip__dot--unused { background: #94a3b8; }

/* Nombre del índice */
.mon-idx-chip__name {
  font-family: 'Courier New', monospace;
  font-size: .68rem;
  color: #334155;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 165px;
}
.mon-idx-chip--active .mon-idx-chip__name { color: #1d4ed8; }

/* Eficiencia */
.mon-idx-chip__eff {
  font-size: .65rem;
  color: #94a3b8;
  flex-shrink: 0;
}
.mon-idx-chip--active .mon-idx-chip__eff { color: #60a5fa; }

/* ── Footer del panel de índices (reutiliza .mon-sel-panel__footer) ── */
.mon-idx-panel .mon-sel-panel__footer {
  border-top: 1px solid #e2e8f0;
  margin-top: 8px;
  padding-top: 10px;
}

/* ════════════════════════════════════════════════════════════════
   TOOLTIP GLOBAL — chips bloqueados (position:fixed, escapa overflow)
═══════════════════════════════════════════════════════════════ */
.mon-chip-tooltip-global {
  position: fixed;
  transform: translate(-50%, -100%);
  background: #0f172a;
  color: #ffffff;
  font-size: .78rem;
  font-weight: 600;
  line-height: 1.6;
  white-space: normal;
  max-width: 260px;
  width: max-content;
  padding: 10px 16px;
  border-radius: 8px;
  border: 2px solid #f97316;
  box-shadow: 0 8px 32px rgba(0,0,0,.75);
  z-index: 99999;
  pointer-events: none;
  text-align: center;
}
/* Flecha hacia abajo */
.mon-chip-tooltip-global::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  border: 7px solid transparent;
  border-top-color: #f97316;
}

/* ════════════════════════════════════════════════════════════════
   SCORE — botón clickeable y desglose expandible
═══════════════════════════════════════════════════════════════ */
.mon-health-score--btn {
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  border-radius: 50%;
  transition: transform .15s, box-shadow .15s;
}
.mon-health-score--btn:hover {
  transform: scale(1.04);
  box-shadow: 0 0 0 4px rgba(59,130,246,.15);
}

.mon-score-breakdown-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-top: 8px;
  padding: 4px 10px;
  background: #f1f5f9;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  font-size: .72rem;
  font-weight: 600;
  color: #475569;
  cursor: pointer;
  transition: background .15s, color .15s;
}
.mon-score-breakdown-btn:hover {
  background: #e2e8f0;
  color: #1e293b;
}

/* Panel de desglose */
.mon-score-breakdown {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  padding: 16px 20px;
  margin-bottom: 16px;
}
.mon-score-breakdown__title {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: .82rem;
  font-weight: 700;
  color: #334155;
  margin: 0 0 14px;
}
.mon-score-breakdown__title .material-icons {
  font-size: 16px;
  color: #64748b;
}
.mon-score-breakdown__rows {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* Fila de factor */
.mon-sbrow {
  display: grid;
  grid-template-columns: 200px 1fr auto;
  align-items: center;
  gap: 12px;
}
@media (max-width: 680px) {
  .mon-sbrow { grid-template-columns: 1fr; gap: 4px; }
}
.mon-sbrow__name {
  font-size: .78rem;
  font-weight: 500;
  color: #475569;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 4px;
}
.mon-sbrow__help {
  display: inline-flex;
  align-items: center;
  cursor: help;
  color: #94a3b8;
  transition: color .15s;
}
.mon-sbrow__help:hover { color: #3b82f6; }
.mon-sbrow__help .material-icons { font-size: 14px; }
.mon-sbrow__bar-wrap {
  background: #f1f5f9;
  border-radius: 99px;
  height: 8px;
  overflow: hidden;
}
.mon-sbrow__bar {
  height: 100%;
  border-radius: 99px;
  transition: width .4s ease;
  min-width: 3px;
}
.mon-sbrow__bar--green  { background: #22c55e; }
.mon-sbrow__bar--amber  { background: #f59e0b; }
.mon-sbrow__bar--red    { background: #ef4444; }

.mon-sbrow__pts {
  font-size: .72rem;
  font-weight: 600;
  white-space: nowrap;
  min-width: 150px;
  text-align: right;
}
.mon-sbrow__pts--green { color: #16a34a; }
.mon-sbrow__pts--amber { color: #d97706; }
.mon-sbrow__pts--red   { color: #dc2626; }

/* ════════════════════════════════════════════════════════════════
   ALERTAS — rediseño completo
═══════════════════════════════════════════════════════════════ */
.mon-alerts-section { padding-bottom: 4px; }

.mon-alerts-body {
  max-height: 500px;
  overflow-y: auto;
  overflow-x: hidden;
  padding-right: 2px;
}
.mon-alerts-body::-webkit-scrollbar { width: 4px; }
.mon-alerts-body::-webkit-scrollbar-track { background: transparent; }
.mon-alerts-body::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }

/* Estado vacío */
.mon-alerts-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 32px 16px;
}
.mon-alerts-empty__icon {
  font-size: 48px;
  color: #22c55e;
}
.mon-alerts-empty__title {
  font-size: 1rem;
  font-weight: 700;
  color: #166534;
  margin: 0;
}
.mon-alerts-empty__sub {
  font-size: .8rem;
  color: #6b7280;
  margin: 0;
}

/* Bloque crítico / advertencias */
.mon-alerts-block {
  border-radius: 8px;
  margin-bottom: 12px;
  overflow: hidden;
}
.mon-alerts-block--critical {
  background: #fff0f0;
  border-left: 3px solid #dc2626;
}
.mon-alerts-block--warning {
  background: #fffbeb;
  border-left: 3px solid #f59e0b;
}

.mon-alerts-block__header {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  font-size: .78rem;
  font-weight: 700;
  border-bottom: 1px solid rgba(0,0,0,.06);
}
.mon-alerts-block--critical .mon-alerts-block__header {
  color: #991b1b;
}
.mon-alerts-block--critical .mon-alerts-block__header .material-icons {
  color: #dc2626;
  font-size: 16px;
}
.mon-alerts-block--warning .mon-alerts-block__header {
  color: #92400e;
}
.mon-alerts-block--warning .mon-alerts-block__header .material-icons {
  color: #f59e0b;
  font-size: 16px;
}

/* Fila de alerta individual */
.mon-alert-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 10px 12px;
  border-bottom: .5px solid rgba(0,0,0,.06);
  transition: background .12s;
}
.mon-alert-row:last-child { border-bottom: none; }
.mon-alert-row--critical:hover { background: rgba(220,38,38,.05); }
.mon-alert-row--warning:hover  { background: rgba(245,158,11,.05); }
.mon-alert-row--sub {
  padding-left: 20px;
  background: rgba(255,255,255,.6);
}

.mon-alert-row__icon {
  font-size: 18px;
  flex-shrink: 0;
  margin-top: 1px;
}
.mon-alert-row--critical .mon-alert-row__icon { color: #dc2626; }
.mon-alert-row--warning  .mon-alert-row__icon { color: #f59e0b; }
.mon-alert-row--index-weak .mon-alert-row__icon { color: #6366f1; }
.mon-alert-row--sub      .mon-alert-row__icon { color: #94a3b8; font-size: 16px; }

/* ── Bloque índices débiles (azul-índigo) ─────────────────────────────────── */
.mon-alerts-block--index-weak {
  border: 1px solid #e0e7ff;
  border-radius: 10px;
  background: #f5f3ff;
  overflow: hidden;
  margin-top: 8px;
}
.mon-alerts-block--index-weak .mon-alerts-block__header {
  background: #ede9fe;
  color: #4338ca;
  border-bottom: 1px solid #c7d2fe;
}
.mon-alerts-block--index-weak .mon-alerts-block__header .material-icons { color: #6366f1; }

.mon-alert-row--index-weak:hover { background: rgba(99,102,241,.05); }

/* Botón "Ir a REINDEX" en el header del bloque */
.mon-alert-goto-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-left: auto;
  padding: 4px 12px;
  font-size: .72rem;
  font-weight: 600;
  color: #4338ca;
  background: #fff;
  border: 1px solid #c7d2fe;
  border-radius: 6px;
  cursor: pointer;
  transition: background .12s, border-color .12s;
  white-space: nowrap;
}
.mon-alert-goto-btn .material-icons { font-size: 13px; }
.mon-alert-goto-btn:hover { background: #ede9fe; border-color: #818cf8; }

.mon-alert-row__body { flex: 1; min-width: 0; }
.mon-alert-row__msg {
  font-size: .82rem;
  font-weight: 500;
  color: #1e293b;
  margin: 0 0 2px;
  line-height: 1.4;
}
.mon-alert-row__value {
  font-size: .75rem;
  color: #64748b;
  margin: 0 0 2px;
}
.mon-alert-row__hint {
  font-size: .7rem;
  color: #94a3b8;
  font-style: italic;
  margin: 0;
}
.mon-alert-row__cat {
  font-size: .65rem;
  font-weight: 600;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: .04em;
  white-space: nowrap;
  flex-shrink: 0;
}

/* Grupo agrupado de advertencias */
.mon-alert-group { border-bottom: .5px solid rgba(0,0,0,.06); }
.mon-alert-group:last-child { border-bottom: none; }
.mon-alert-group__header {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 10px 12px;
  cursor: pointer;
  transition: background .12s;
}
.mon-alert-group__header:hover { background: rgba(245,158,11,.06); }
.mon-alert-group__info { flex: 1; min-width: 0; }
.mon-alert-group__chevron {
  color: #94a3b8;
  transition: transform .2s;
  margin-top: 2px;
}
.mon-alert-group__chevron--open { transform: rotate(180deg); }
.mon-alert-group__chevron .material-icons { font-size: 18px; }
.mon-alert-group__items { background: rgba(255,255,255,.5); }

/* Botón "Ver más advertencias" */
.mon-alerts-more-btn {
  display: block;
  width: 100%;
  padding: 8px;
  background: none;
  border: none;
  border-top: 1px dashed #fcd34d;
  font-size: .75rem;
  font-weight: 600;
  color: #b45309;
  cursor: pointer;
  text-align: center;
  transition: background .12s;
}
.mon-alerts-more-btn:hover { background: rgba(245,158,11,.07); }

/* Icono verde para sección sin alertas */
.mon-section-icon--green {
  background: #dcfce7;
  color: #16a34a;
}
</file>

<file path="src/app/components/admin/admin-db-management/tabs/admin-db-monitoring/admin-db-monitoring.component.html">
<div class="tab-root">

  <!-- ══════════════════════════════════════════════════════════════════════
       ENCABEZADO
  ══════════════════════════════════════════════════════════════════════════ -->
  <div class="tab-header">
    <div class="tab-header__left">
      <div class="tab-header__icon tab-header__icon--teal">
        <span class="material-icons">monitor_heart</span>
      </div>
      <div>
        <h2 class="tab-header__title">Monitoreo de Base de Datos</h2>
        <p class="tab-header__sub">Estado y salud · PostgreSQL</p>
      </div>
    </div>
    <!-- Botón + hora de última actualización -->
    <div class="mon-refresh-group">
      @if (lastUpdated && !loading) {
        <span class="mon-last-updated">
          <span class="material-icons">schedule</span>
          Actualizado a las {{ formatLastUpdated() }}
        </span>
      }
      <button class="btn-refresh-mon" (click)="loadMetrics()" [disabled]="loading">
        <span class="material-icons" [class.spin]="loading">refresh</span>
        {{ loading ? 'Actualizando…' : 'Actualizar ahora' }}
      </button>
    </div>
  </div>

  <!-- Error global -->
  @if (error) {
    <div class="callout callout--red">
      <span class="material-icons">error_outline</span>
      <div>
        <strong>Error al obtener métricas</strong>
        <span>{{ error }}</span>
      </div>
    </div>
  }

  <!-- Info banner: indexes with insufficient data (no false positives) -->
  @if (!loading && insufficientDataIndexCount > 0) {
    <div class="callout callout--info">
      <span class="material-icons">info</span>
      <div>
        <strong>{{ insufficientDataIndexCount }} índice{{ insufficientDataIndexCount > 1 ? 's' : '' }} sin suficientes datos</strong>
        <span>
          {{ insufficientDataIndexCount > 1 ? 'Estos índices no tienen' : 'Este índice no tiene' }}
          suficiente tráfico acumulado para evaluarse correctamente.
          El sistema los excluye de las alertas para evitar falsos positivos.
          Volverán a evaluarse automáticamente cuando acumulen más actividad.
        </span>
      </div>
    </div>
  }

  <!-- ══════════════════════════════════════════════════════════════════════
       SECCIÓN 1 — PANEL DE SALUD GENERAL
  ══════════════════════════════════════════════════════════════════════════ -->
  <div class="mon-health-panel">

    <!-- Score ring — clickeable para desglose -->
    <button class="mon-health-score mon-health-score--btn"
            [class.mon-health-score--green]="healthColor === 'green'"
            [class.mon-health-score--amber]="healthColor === 'amber'"
            [class.mon-health-score--red]="healthColor === 'red'"
            (click)="toggleScoreBreakdown()"
            [title]="scoreBreakdownOpen ? 'Ocultar desglose del score' : 'Ver cómo se calcula este score'">
      @if (loading) {
        <div class="skel skel--ring"></div>
      } @else {
        <svg class="mon-score-svg" viewBox="0 0 100 100">
          <circle class="mon-score-track" cx="50" cy="50" r="42"/>
          <circle class="mon-score-fill" cx="50" cy="50" r="42"
                  [style.stroke-dashoffset]="scoreRingOffset"/>
        </svg>
        <div class="mon-score-inner">
          <span class="mon-score-num">{{ metrics?.healthScore ?? '—' }}</span>
          <span class="mon-score-den">/100</span>
        </div>
      }
    </button>

    <!-- Estado descriptivo -->
    <div class="mon-health-info">
      @if (loading) {
        <div class="skel skel--md" style="height:22px;margin-bottom:.5rem"></div>
        <div class="skel skel--value" style="width:260px"></div>
      } @else {
        <p class="mon-health-label" [class.text-green]="healthColor==='green'"
           [class.text-amber]="healthColor==='amber'"
           [class.text-red]="healthColor==='red'">
          <span class="material-icons">
            {{ healthColor === 'green' ? 'check_circle' : healthColor === 'amber' ? 'warning' : 'error' }}
          </span>
          {{ healthLabel }}
        </p>
        <p class="mon-health-status">{{ healthStatus }}</p>

        <!-- Botón desglose -->
        <button class="mon-score-breakdown-btn" (click)="toggleScoreBreakdown()">
          {{ scoreBreakdownOpen ? 'Ocultar ▲' : 'Ver desglose ▼' }}
        </button>

        <!-- Alertas rápidas del banner -->
        @if (alertCount('critical') > 0) {
          <span class="mon-alert-pill mon-alert-pill--critical">
            <span class="material-icons">error</span>
            {{ alertCount('critical') }} crítica{{ alertCount('critical') > 1 ? 's' : '' }}
          </span>
        }
        @if (alertCount('warning') > 0) {
          <span class="mon-alert-pill mon-alert-pill--warning">
            <span class="material-icons">warning</span>
            {{ alertCount('warning') }} advertencia{{ alertCount('warning') > 1 ? 's' : '' }}
          </span>
        }
      }
    </div>

    <!-- KPIs -->
    <div class="mon-kpi-row">

      <!-- KPI: Tamaño BD -->
      <div class="mon-kpi-card"
           (mouseenter)="showTooltip('dbsize', $event)" (mouseleave)="hideTooltip()">
        <div class="mon-kpi-icon mon-kpi-icon--blue">
          <span class="material-icons">storage</span>
        </div>
        <div class="mon-kpi-body">
          <p class="mon-kpi-label">Tamaño de la BD</p>
          @if (loading) { <div class="skel skel--sm" style="height:18px"></div> }
          @else { <p class="mon-kpi-value">{{ formatBytes(metrics?.totalDatabaseSizeBytes) }}</p> }
        </div>
      </div>

      <!-- KPI: Uptime -->
      <div class="mon-kpi-card"
           (mouseenter)="showTooltip('uptime', $event)" (mouseleave)="hideTooltip()">
        <div class="mon-kpi-icon mon-kpi-icon--green">
          <span class="material-icons">schedule</span>
        </div>
        <div class="mon-kpi-body">
          <p class="mon-kpi-label">Servidor activo desde hace</p>
          @if (loading) { <div class="skel skel--sm" style="height:18px"></div> }
          @else { <p class="mon-kpi-value">{{ formatUptime(metrics?.uptimeDays) }}</p> }
        </div>
      </div>

      <!-- KPI: Tablas -->
      <div class="mon-kpi-card"
           (mouseenter)="showTooltip('tables', $event)" (mouseleave)="hideTooltip()">
        <div class="mon-kpi-icon mon-kpi-icon--purple">
          <span class="material-icons">table_chart</span>
        </div>
        <div class="mon-kpi-body">
          <p class="mon-kpi-label">Tablas monitoreadas</p>
          @if (loading) { <div class="skel skel--sm" style="height:18px"></div> }
          @else { <p class="mon-kpi-value">{{ metrics?.tableHealth?.length ?? 0 }}</p> }
        </div>
      </div>

    </div>
  </div><!-- /health-panel -->

  <!-- ── Desglose del score (expandible) ── -->
  @if (scoreBreakdownOpen && metrics) {
    <div class="mon-score-breakdown" [@fadeIn]>
      <h4 class="mon-score-breakdown__title">
        <span class="material-icons">analytics</span>
        Desglose del score de salud
      </h4>
      <div class="mon-score-breakdown__rows">

        <!-- Factor 1: Cache hit ratio -->
        <div class="mon-sbrow">
          <span class="mon-sbrow__name">Datos leídos desde memoria</span>
          <div class="mon-sbrow__bar-wrap">
            <div class="mon-sbrow__bar"
                 [class.mon-sbrow__bar--green]="scoreBarColor(scoreFactorCache, 40) === 'green'"
                 [class.mon-sbrow__bar--amber]="scoreBarColor(scoreFactorCache, 40) === 'amber'"
                 [class.mon-sbrow__bar--red]="scoreBarColor(scoreFactorCache, 40) === 'red'"
                 [style.width.%]="(scoreFactorCache / 40) * 100">
            </div>
          </div>
          <span class="mon-sbrow__pts"
                [class.mon-sbrow__pts--green]="scoreBarColor(scoreFactorCache, 40) === 'green'"
                [class.mon-sbrow__pts--amber]="scoreBarColor(scoreFactorCache, 40) === 'amber'"
                [class.mon-sbrow__pts--red]="scoreBarColor(scoreFactorCache, 40) === 'red'">
            {{ scoreFactorCache }} / 40 pts
            · {{ metrics.performance.cacheHitRatio | number:'1.1-1' }}%
          </span>
        </div>

        <!-- Factor 2: Uso de conexiones -->
        <div class="mon-sbrow">
          <span class="mon-sbrow__name">Uso de conexiones</span>
          <div class="mon-sbrow__bar-wrap">
            <div class="mon-sbrow__bar"
                 [class.mon-sbrow__bar--green]="scoreBarColor(scoreFactorConns, 20) === 'green'"
                 [class.mon-sbrow__bar--amber]="scoreBarColor(scoreFactorConns, 20) === 'amber'"
                 [class.mon-sbrow__bar--red]="scoreBarColor(scoreFactorConns, 20) === 'red'"
                 [style.width.%]="(scoreFactorConns / 20) * 100">
            </div>
          </div>
          <span class="mon-sbrow__pts"
                [class.mon-sbrow__pts--green]="scoreBarColor(scoreFactorConns, 20) === 'green'"
                [class.mon-sbrow__pts--amber]="scoreBarColor(scoreFactorConns, 20) === 'amber'"
                [class.mon-sbrow__pts--red]="scoreBarColor(scoreFactorConns, 20) === 'red'">
            {{ scoreFactorConns }} / 20 pts
            · {{ metrics.connections.total }} de {{ metrics.connections.maxLimit }} conexiones
          </span>
        </div>

        <!-- Factor 3: Alertas críticas -->
        <div class="mon-sbrow">
          <span class="mon-sbrow__name">Alertas críticas</span>
          <div class="mon-sbrow__bar-wrap">
            <div class="mon-sbrow__bar"
                 [class.mon-sbrow__bar--green]="scoreBarColor(scoreFactorAlerts, 25) === 'green'"
                 [class.mon-sbrow__bar--amber]="scoreBarColor(scoreFactorAlerts, 25) === 'amber'"
                 [class.mon-sbrow__bar--red]="scoreBarColor(scoreFactorAlerts, 25) === 'red'"
                 [style.width.%]="(scoreFactorAlerts / 25) * 100">
            </div>
          </div>
          <span class="mon-sbrow__pts"
                [class.mon-sbrow__pts--green]="scoreBarColor(scoreFactorAlerts, 25) === 'green'"
                [class.mon-sbrow__pts--amber]="scoreBarColor(scoreFactorAlerts, 25) === 'amber'"
                [class.mon-sbrow__pts--red]="scoreBarColor(scoreFactorAlerts, 25) === 'red'">
            {{ scoreFactorAlerts }} / 25 pts
            · {{ alertCount('critical') }} alerta{{ alertCount('critical') !== 1 ? 's' : '' }} crítica{{ alertCount('critical') !== 1 ? 's' : '' }}
          </span>
        </div>

        <!-- Factor 4: Estado de índices -->
        <div class="mon-sbrow">
          <span class="mon-sbrow__name">
            Estado de índices
            <span class="mon-sbrow__help"
                  title="Evalúa si existen índices duplicados — dos índices sobre las mismas columnas de la misma tabla. Los duplicados desperdician espacio y ralentizan las operaciones de escritura sin ningún beneficio.">
              <span class="material-icons">help_outline</span>
            </span>
          </span>
          <div class="mon-sbrow__bar-wrap">
            <div class="mon-sbrow__bar"
                 [class.mon-sbrow__bar--green]="scoreBarColor(scoreFactorIndexes, 15) === 'green'"
                 [class.mon-sbrow__bar--amber]="scoreBarColor(scoreFactorIndexes, 15) === 'amber'"
                 [class.mon-sbrow__bar--red]="scoreBarColor(scoreFactorIndexes, 15) === 'red'"
                 [style.width.%]="(scoreFactorIndexes / 15) * 100">
            </div>
          </div>
          <span class="mon-sbrow__pts"
                [class.mon-sbrow__pts--green]="scoreBarColor(scoreFactorIndexes, 15) === 'green'"
                [class.mon-sbrow__pts--amber]="scoreBarColor(scoreFactorIndexes, 15) === 'amber'"
                [class.mon-sbrow__pts--red]="scoreBarColor(scoreFactorIndexes, 15) === 'red'">
            {{ scoreFactorIndexes }} / 15 pts
            · {{ scoreFactorIndexes === 15 ? 'Sin índices duplicados' : unusedIndexCount + ' índice' + (unusedIndexCount !== 1 ? 's' : '') + ' duplicado' + (unusedIndexCount !== 1 ? 's' : '') + ' detectado' + (unusedIndexCount !== 1 ? 's' : '') }}
          </span>
        </div>

      </div><!-- /rows -->
    </div><!-- /breakdown -->
  }


  <!-- ══════════════════════════════════════════════════════════════════════
       SECCIÓN 2 — RENDIMIENTO EN TIEMPO REAL
  ══════════════════════════════════════════════════════════════════════════ -->
  <div class="mon-section-card">
    <div class="mon-section-header">
      <div class="mon-section-header__left">
        <div class="mon-section-icon mon-section-icon--teal">
          <span class="material-icons">speed</span>
        </div>
        <div>
          <h3 class="mon-section-title">Rendimiento en tiempo real</h3>
          <p class="mon-section-sub">Métricas del motor PostgreSQL en este momento</p>
        </div>
      </div>
    </div>

    <div class="mon-perf-grid">

      <!-- Cache Hit -->
      <div class="mon-perf-card" [class.mon-perf-card--warn]="cacheAlertLevel==='warning'"
           [class.mon-perf-card--bad]="cacheAlertLevel==='critical'"
           (mouseenter)="showTooltip('cache', $event)" (mouseleave)="hideTooltip()">
        <div class="mon-perf-top">
          <span class="mon-perf-label">Datos leídos desde memoria</span>
          <span class="mon-trend" [class.mon-trend--up]="trends['cacheHit']==='up'"
                [class.mon-trend--down]="trends['cacheHit']==='down'">
            {{ trends['cacheHit'] === 'up' ? '↑' : trends['cacheHit'] === 'down' ? '↓' : '—' }}
          </span>
        </div>
        @if (loading) { <div class="skel skel--value"></div> }
        @else {
          <p class="mon-perf-value"
             [class.text-green]="cacheAlertLevel==='ok'"
             [class.text-amber]="cacheAlertLevel==='warning'"
             [class.text-red]="cacheAlertLevel==='critical'">
            {{ metrics?.performance?.cacheHitRatio ?? '—' }}<span class="mon-perf-unit">%</span>
          </p>
          <div class="mon-progress">
            <div class="mon-progress__bar"
                 [class.mon-progress__bar--green]="cacheAlertLevel==='ok'"
                 [class.mon-progress__bar--amber]="cacheAlertLevel==='warning'"
                 [class.mon-progress__bar--red]="cacheAlertLevel==='critical'"
                 [style.width.%]="metrics?.performance?.cacheHitRatio ?? 0"></div>
          </div>
          <p class="mon-perf-goal">Meta: &gt;95%
            @if (cacheAlertLevel === 'ok') { <span class="mon-goal-ok">✓ Cumplida</span> }
            @else { <span class="mon-goal-fail">✗ Por debajo</span> }
          </p>
        }
        @if (cacheAlertLevel !== 'ok' && metrics) {
          <p class="mon-perf-hint">
            <span class="material-icons">tips_and_updates</span>
            La eficiencia de memoria está por debajo de lo recomendado. Considera revisar las consultas más frecuentes.
          </p>
        }
      </div>

      <!-- TPS -->
      <div class="mon-perf-card"
           (mouseenter)="showTooltip('tps', $event)" (mouseleave)="hideTooltip()">
        <div class="mon-perf-top">
          <span class="mon-perf-label">Operaciones por segundo</span>
          <span class="mon-trend" [class.mon-trend--up]="trends['tps']==='up'"
                [class.mon-trend--down]="trends['tps']==='down'">
            {{ trends['tps'] === 'up' ? '↑' : trends['tps'] === 'down' ? '↓' : '—' }}
          </span>
        </div>
        @if (loading) { <div class="skel skel--value"></div> }
        @else {
          <p class="mon-perf-value">
            {{ formatTps() }}<span class="mon-perf-unit" [style.display]="metrics?.performance?.tps === -1 ? 'none' : ''">ops/s</span>
          </p>
        }
      </div>

      <!-- Tiempo promedio de respuesta -->
      <div class="mon-perf-card"
           (mouseenter)="showTooltip('avgq', $event)" (mouseleave)="hideTooltip()">
        <div class="mon-perf-top">
          <span class="mon-perf-label">Tiempo promedio de respuesta</span>
          <span class="mon-trend" [class.mon-trend--up]="trends['avgQuery']==='up'"
                [class.mon-trend--down]="trends['avgQuery']==='down'">
            {{ trends['avgQuery'] === 'up' ? '↑' : trends['avgQuery'] === 'down' ? '↓' : '—' }}
          </span>
        </div>
        @if (loading) { <div class="skel skel--value"></div> }
        @else {
          <p class="mon-perf-value">
            {{ formatMs(metrics?.performance?.avgQueryTimeMs) }}
          </p>
        }
      </div>

    </div>
  </div>


  <!-- ══════════════════════════════════════════════════════════════════════
       SECCIÓN 3 — CONEXIONES ACTIVAS
  ══════════════════════════════════════════════════════════════════════════ -->
  <div class="mon-section-card">
    <div class="mon-section-header">
      <div class="mon-section-header__left">
        <div class="mon-section-icon mon-section-icon--blue">
          <span class="material-icons">cable</span>
        </div>
        <div>
          <h3 class="mon-section-title">Conexiones activas</h3>
          <p class="mon-section-sub">Haz clic en la gráfica para ver el desglose detallado</p>
        </div>
      </div>
      <!-- Tendencia -->
      @if (!loading && metrics) {
        <span class="mon-trend mon-trend--conn"
              [class.mon-trend--up]="trends['conns']==='up'"
              [class.mon-trend--down]="trends['conns']==='down'">
          {{ trends['conns'] === 'up' ? '↑ Mejorando' : trends['conns'] === 'down' ? '↓ Aumentando' : '— Sin cambios' }}
        </span>
      }
    </div>

    <div class="mon-conn-body">
      @if (loading) {
        <div class="mon-conn-skeleton">
          <div class="skel skel--ring" style="width:160px;height:160px;border-radius:50%"></div>
        </div>
      } @else {

        <!-- ── Dona SVG clickeable ── -->
        <div class="mon-donut-wrap" (click)="toggleConn()" [attr.aria-expanded]="connExpanded"
             [class.mon-donut-wrap--expanded]="connExpanded">

          <svg class="mon-donut-svg" viewBox="0 0 140 140" role="img" aria-label="Gráfica de conexiones">
            <!-- fondo gris -->
            <circle cx="70" cy="70" [attr.r]="donutRadius" fill="none" stroke="#f3f4f6"
                    stroke-width="18"/>
            <!-- segmentos -->
            @for (seg of donutSegments; track seg.label) {
              <circle cx="70" cy="70" [attr.r]="donutRadius" fill="none"
                      [attr.stroke]="seg.color"
                      stroke-width="18"
                      [attr.stroke-dasharray]="seg.dash + ' ' + (donutCircumference - seg.dash)"
                      [attr.stroke-dashoffset]="seg.offset"
                      stroke-linecap="butt"
                      style="transform:rotate(-90deg);transform-origin:50% 50%;transition:stroke-dasharray .6s ease"/>
            }
            <!-- texto central -->
            <text x="70" y="64" text-anchor="middle" class="mon-donut-num"
                  [attr.fill]="connAlertLevel === 'ok' ? '#16a34a' : connAlertLevel === 'warning' ? '#b45309' : '#dc2626'">
              {{ metrics?.connections?.total ?? 0 }}
            </text>
            <text x="70" y="80" text-anchor="middle" class="mon-donut-sub">de {{ metrics?.connections?.maxLimit }}</text>
            <text x="70" y="95" text-anchor="middle" class="mon-donut-pct"
                  [attr.fill]="connAlertLevel === 'ok' ? '#16a34a' : connAlertLevel === 'warning' ? '#b45309' : '#dc2626'">
              {{ metrics?.connections?.usagePct }}%
            </text>
          </svg>

          <!-- Leyenda de segmentos -->
          <div class="mon-donut-legend">
            @for (seg of donutSegments; track seg.label) {
              <div class="mon-donut-legend__item">
                <span class="mon-donut-legend__dot" [style.background]="seg.color"></span>
                <span class="mon-donut-legend__label">{{ seg.label }}</span>
                <span class="mon-donut-legend__val">{{ seg.value }}</span>
                @if (seg.label === 'Herramientas de administración') {
                  <div class="mon-conn-sub__tooltip-wrap"
                       (mouseenter)="showTooltip('donut-admin-tools', $event)" (mouseleave)="hideTooltip()">
                    <span class="material-icons mon-th-help" style="font-size:13px;margin-left:3px">help_outline</span>
                  </div>
                }
              </div>
            }
          </div>

          <!-- Indicador de expandir -->
          <button class="mon-donut-expand-btn" type="button">
            <span class="material-icons">{{ connExpanded ? 'expand_less' : 'expand_more' }}</span>
            {{ connExpanded ? 'Ocultar desglose' : 'Ver desglose' }}
          </button>
        </div>

        <!-- ── Panel de desglose (colapsable) ── -->
        @if (connExpanded) {
          <div class="mon-conn-breakdown">

            <!-- Subsección 1: Uso del servidor -->
            <div class="mon-conn-sub">
              <div class="mon-conn-sub__header">
                <span class="material-icons" style="color:#3b82f6">dns</span>
                <h4 class="mon-conn-sub__title">Uso del servidor</h4>
                <div class="mon-conn-sub__tooltip-wrap"
                     (mouseenter)="showTooltip('conn-server', $event)" (mouseleave)="hideTooltip()">
                  <span class="material-icons mon-th-help">help_outline</span>
                </div>
              </div>

              <!-- Barra total del servidor -->
              <div class="mon-conn-stat-row">
                <span class="mon-conn-stat__label">Total abiertas</span>
                <span class="mon-conn-stat__val"
                      [class.text-green]="connAlertLevel==='ok'"
                      [class.text-amber]="connAlertLevel==='warning'"
                      [class.text-red]="connAlertLevel==='critical'">
                  {{ metrics?.connections?.total }} / {{ metrics?.connections?.maxLimit }}
                </span>
              </div>
              <div class="mon-progress" style="margin-bottom:.85rem">
                <div class="mon-progress__bar"
                     [class.mon-progress__bar--green]="connAlertLevel==='ok'"
                     [class.mon-progress__bar--amber]="connAlertLevel==='warning'"
                     [class.mon-progress__bar--red]="connAlertLevel==='critical'"
                     [style.width.%]="metrics?.connections?.usagePct ?? 0"></div>
                <div class="mon-progress__mark mon-progress__mark--70"><span>70%</span></div>
                <div class="mon-progress__mark mon-progress__mark--90"><span>90%</span></div>
              </div>

              <!-- Desglose tipo de conexión -->
              <div class="mon-conn-breakdown-grid">
                <div class="mon-conn-breakdown-item">
                  <span class="mon-conn-breakdown-dot" style="background:#3b82f6"></span>
                  <span class="mon-conn-breakdown-label">Pool Spring Boot (HikariCP)</span>
                  <span class="mon-conn-breakdown-num">{{ metrics?.connections?.poolConnections ?? 0 }}</span>
                </div>
                <div class="mon-conn-breakdown-item">
                  <span class="mon-conn-breakdown-dot" style="background:#9ca3af"></span>
                  <span class="mon-conn-breakdown-label">Procesos internos PostgreSQL</span>
                  <span class="mon-conn-breakdown-num">{{ metrics?.connections?.pgInternalConnections ?? 0 }}</span>
                </div>
                @if ((metrics?.connections?.adminTools ?? 0) > 0) {
                  <div class="mon-conn-breakdown-item">
                    <span class="mon-conn-breakdown-dot" style="background:#a78bfa"></span>
                    <span class="mon-conn-breakdown-label">Herramientas de administración</span>
                    <span class="mon-conn-breakdown-num">{{ metrics?.connections?.adminTools }}</span>
                    <div class="mon-conn-sub__tooltip-wrap"
                         (mouseenter)="showTooltip('conn-admin-tools', $event)" (mouseleave)="hideTooltip()">
                      <span class="material-icons mon-th-help" style="font-size:14px;margin-left:4px">help_outline</span>
                    </div>
                  </div>
                }
              </div>

              @if (connAlertLevel === 'warning') {
                <div class="callout callout--amber" style="margin-top:.75rem">
                  <span class="material-icons">warning</span>
                  <div><strong>Advertencia</strong>
                    <span>Uso de conexiones al {{ metrics?.connections?.usagePct }}%. Considera revisar conexiones ociosas.</span></div>
                </div>
              }
              @if (connAlertLevel === 'critical') {
                <div class="callout callout--red" style="margin-top:.75rem">
                  <span class="material-icons">error</span>
                  <div><strong>Límite cercano</strong>
                    <span>Uso al {{ metrics?.connections?.usagePct }}%. Pueden producirse errores de conexión.</span></div>
                </div>
              }
            </div>

            <!-- Divisor -->
            <div class="mon-conn-divider"></div>

            <!-- Subsección 2: Sesiones de usuario -->
            <div class="mon-conn-sub">

              <!-- Header con badge de total -->
              <div class="mon-conn-sub__header">
                <span class="material-icons" style="color:#22c55e">people</span>
                <h4 class="mon-conn-sub__title">Sesiones de usuario activas</h4>
                <span [class]="(metrics?.connections?.activeUserSessions ?? 0) > 0
                              ? 'mon-session-total-badge mon-session-total-badge--green'
                              : 'mon-session-total-badge mon-session-total-badge--gray'">
                  {{ metrics?.connections?.activeUserSessions ?? 0 }} conectados ahora
                </span>
                <div class="mon-conn-sub__tooltip-wrap"
                     (mouseenter)="showTooltip('conn-users', $event)" (mouseleave)="hideTooltip()">
                  <span class="material-icons mon-th-help">help_outline</span>
                </div>
              </div>

              <!-- Chips de resumen: 30 min / 1 hora / hoy -->
              <div class="mon-session-chips">
                <div class="mon-session-chip mon-session-chip--green">
                  <span class="mon-session-chip__num">{{ metrics?.connections?.activeUserSessions ?? 0 }}</span>
                  <span class="mon-session-chip__label">Últimos 30 min</span>
                </div>
                <div class="mon-session-chip mon-session-chip--blue">
                  <span class="mon-session-chip__num">{{ metrics?.connections?.sessionsLastHour ?? 0 }}</span>
                  <span class="mon-session-chip__label">Última hora</span>
                </div>
                <div class="mon-session-chip mon-session-chip--slate">
                  <span class="mon-session-chip__num">{{ metrics?.connections?.sessionsToday ?? 0 }}</span>
                  <span class="mon-session-chip__label">Hoy</span>
                </div>
              </div>

              <!-- Tabla paginada o estado vacío -->
              @if (allSessions.length === 0) {
                <div class="mon-conn-no-users">
                  <span class="material-icons">person_off</span>
                  No hay sesiones activas en los últimos 30 minutos
                </div>
              } @else {
                <table class="mon-conn-users-table">
                  <thead>
                    <tr>
                      <th>Usuario</th>
                      <th>IP</th>
                      <th>Navegador</th>
                      <th>Última actividad</th>
                    </tr>
                  </thead>
                  <tbody>
                    @for (s of pagedSessions; track s.email) {
                      <tr>
                        <td class="mon-session-user">
                          <span class="material-icons" style="font-size:14px;vertical-align:middle;margin-right:4px;color:#6b7280">person</span>
                          <span>{{ s.usuario }}</span>
                          @if (s.sessionCount > 1) {
                            <span class="mon-session-multi" title="{{ s.sessionCount }} sesiones abiertas">×{{ s.sessionCount }}</span>
                          }
                        </td>
                        <td class="mon-session-ip">{{ s.ipAddress || '—' }}</td>
                        <td class="mon-session-ua">
                          <span class="mon-session-badge mon-session-badge--active">{{ s.userAgent }}</span>
                        </td>
                        <td class="mon-session-time">{{ s.lastActivity }}</td>
                      </tr>
                    }
                  </tbody>
                </table>

                <!-- Paginación + contador -->
                <div class="mon-pagination">
                  <div class="mon-pagination__info">
                    Mostrando {{ sessionPage * SESSION_PAGE_SIZE + 1 }}–{{ sessionPageEnd }} de {{ allSessions.length }}
                  </div>
                  <div class="mon-pagination__controls">
                    <button class="mon-page-btn"
                            [disabled]="sessionPage === 0"
                            (click)="sessionPage = 0" title="Primera página">
                      <span class="material-icons">first_page</span>
                    </button>
                    <button class="mon-page-btn"
                            [disabled]="sessionPage === 0"
                            (click)="sessionPage = sessionPage - 1" title="Anterior">
                      <span class="material-icons">chevron_left</span>
                    </button>
                    @for (p of sessionPageNumbers; track p) {
                      <button class="mon-page-btn"
                              [class.mon-page-btn--active]="p === sessionPage"
                              (click)="sessionPage = p">{{ p + 1 }}</button>
                    }
                    <button class="mon-page-btn"
                            [disabled]="sessionPage === sessionTotalPages - 1"
                            (click)="sessionPage = sessionPage + 1" title="Siguiente">
                      <span class="material-icons">chevron_right</span>
                    </button>
                    <button class="mon-page-btn"
                            [disabled]="sessionPage === sessionTotalPages - 1"
                            (click)="sessionPage = sessionTotalPages - 1" title="Última página">
                      <span class="material-icons">last_page</span>
                    </button>
                  </div>
                </div>
              }
            </div>

          </div><!-- /breakdown -->
        }

      }
    </div>
  </div>



  <!-- ══════════════════════════════════════════════════════════════════════
       SECCIÓN 4 — ESTADÍSTICAS DE TABLAS
  ══════════════════════════════════════════════════════════════════════════ -->
  <div class="mon-section-card">
    <div class="mon-section-header">
      <div class="mon-section-header__left">
        <div class="mon-section-icon mon-section-icon--slate">
          <span class="material-icons">table_rows</span>
        </div>
        <div>
          <h3 class="mon-section-title">Estado de las tablas</h3>
          <p class="mon-section-sub">
            Salud, espacio y limpieza pendiente por tabla
            @if (!loading && metrics) {
              <span class="mon-count-badge">{{ filteredTables.length }} tabla{{ filteredTables.length !== 1 ? 's' : '' }}</span>
            }
          </p>
        </div>
      </div>
      <!-- Toggle vista -->
      <div style="display:flex; align-items:center; gap:.75rem; flex-wrap:wrap">
        @if (tableView === 'chart') {
          <button class="mon-sel-btn"
                  (click)="toggleTableSelectionPanel()"
                  [title]="'Seleccionar tablas a visualizar en la gráfica (' + selectedTableNames.length + ' de ' + TABLE_MAX_SEL + ' seleccionadas)'">
            <span class="material-icons" style="font-size:15px">format_list_bulleted</span>
            Seleccionar tablas
            <span class="mon-sel-badge">{{ selectedTableNames.length }}</span>
          </button>
        }
        <div class="mon-view-toggle" role="group" aria-label="Tipo de vista">
          <button type="button" [class.mon-view-toggle__btn--active]="tableView === 'table'"
                  (click)="setTableView('table')" title="Vista de tabla">
            <span class="material-icons">table_rows</span> Tabla
          </button>
          <button type="button" [class.mon-view-toggle__btn--active]="tableView === 'chart'"
                  (click)="setTableView('chart')" title="Vista de gráfica">
            <span class="material-icons">bar_chart</span> Gráfica
          </button>
        </div>
      </div>
    </div>

    <!-- ── Panel selector de tablas (rediseñado) ── -->
    @if (tableSelectionOpen) {
      <div class="mon-idx-panel" [@fadeIn]>

        <!-- Fila superior: buscador + acciones rápidas + contador -->
        <div class="mon-idx-panel__topbar">
          <div class="mon-idx-panel__search-wrap">
            <span class="material-icons mon-idx-panel__search-icon">search</span>
            <input class="mon-idx-panel__search"
                   type="text"
                   placeholder="Buscar tabla..."
                   [(ngModel)]="tablePanelSearch"/>
            @if (tablePanelSearch) {
              <button class="mon-idx-panel__search-clear" type="button"
                      (click)="tablePanelSearch = ''">
                <span class="material-icons">close</span>
              </button>
            }
          </div>
          <div class="mon-idx-panel__actions">
            <button class="mon-sel-action" (click)="selectMostActiveTables()"
                    title="Selecciona las 8 tablas con más registros y actividad">Más activas</button>
            <button class="mon-sel-action" (click)="selectProblemTables()"
                    title="Prioriza tablas con estado crítico o advertencia">Con problemas</button>
            <button class="mon-sel-action" (click)="selectAllTables()"
                    title="Selecciona las 8 tablas más activas del sistema">Todas</button>
            <button class="mon-sel-action" (click)="selectNoTables()">Ninguna</button>
          </div>
          <span class="mon-sel-counter"
                [class.mon-sel-counter--limit]="tempTableSelection.length >= TABLE_MAX_SEL"
                [title]="tempTableSelection.length >= TABLE_MAX_SEL
                  ? 'Límite alcanzado — la gráfica puede mostrar máximo ' + TABLE_MAX_SEL + ' tablas a la vez. Deselecciona una para poder agregar otra.'
                  : tempTableSelection.length + ' de ' + TABLE_MAX_SEL + ' tablas seleccionadas para la gráfica'">
            {{ tempTableSelection.length }} / {{ TABLE_MAX_SEL }} tablas en gráfica
          </span>
        </div>

        <!-- Lista de chips con scroll -->
        <div class="mon-idx-panel__groups">
          <div class="mon-idx-group__chips" style="padding-left:4px">
            @for (t of filteredPanelTables; track t.tableName) {
              <button class="mon-idx-chip"
                      [class.mon-idx-chip--active]="tempTableSelection.includes(t.tableName)"
                      [class.mon-idx-chip--disabled]="!tempTableSelection.includes(t.tableName) && tempTableSelection.length >= TABLE_MAX_SEL"
                      [title]="(!tempTableSelection.includes(t.tableName) && tempTableSelection.length >= TABLE_MAX_SEL)
                        ? ''
                        : tempTableSelection.includes(t.tableName)
                          ? 'Clic para deseleccionar ' + t.tableName
                          : 'Clic para agregar ' + t.tableName + ' a la gráfica'"
                      (mouseenter)="(!tempTableSelection.includes(t.tableName) && tempTableSelection.length >= TABLE_MAX_SEL)
                        ? showChipTooltip($event, 'Límite de ' + TABLE_MAX_SEL + ' tablas alcanzado. Deselecciona una para agregar ' + t.tableName)
                        : null"
                      (mouseleave)="hideChipTooltip()"
                      (click)="toggleTableChip(t.tableName)">
                <!-- Punto de color por estado -->
                <span class="mon-idx-chip__dot"
                      [class.mon-idx-chip__dot--bad]="t.status === 'critical'"
                      [class.mon-idx-chip__dot--warn]="t.status === 'warning'"
                      [class.mon-idx-chip__dot--ok]="t.status !== 'critical' && t.status !== 'warning' && (t.estimatedRows > 0 || t.deadTuples > 0)"
                      [class.mon-idx-chip__dot--unused]="t.status !== 'critical' && t.status !== 'warning' && t.estimatedRows === 0 && t.deadTuples === 0">
                </span>
                <!-- Nombre de la tabla -->
                <span class="mon-idx-chip__name">{{ t.tableName.length > 26 ? t.tableName.substring(0,26) + '…' : t.tableName }}</span>
                <!-- Info secundaria -->
                @if (t.tableName === 'active_sessions') {
                  <span class="mon-idx-chip__eff" style="color:#f59e0b">⚠ técnica</span>
                } @else if (t.estimatedRows > 0 || t.deadTuples > 0) {
                  <span class="mon-idx-chip__eff">{{ formatRows(t.estimatedRows) }} · {{ t.deadTuples }} obs.</span>
                } @else {
                  <span class="mon-idx-chip__eff">sin registros</span>
                }
              </button>
            }
            @if (filteredPanelTables.length === 0) {
              <p class="mon-idx-panel__empty">Sin resultados para "{{ tablePanelSearch }}"</p>
            }
          </div>
        </div>

        @if (tableSelectionLimitMsg) {
          <p class="mon-sel-limit-msg">
            <span class="material-icons" style="font-size:14px;vertical-align:middle">warning_amber</span>
            Límite de {{ TABLE_MAX_SEL }} tablas alcanzado. Para agregar otra, primero deselecciona una de las ya marcadas.
          </p>
        }
        <div class="mon-sel-panel__footer">
          <button class="mon-sel-cancel" (click)="tableSelectionOpen = false">Cancelar</button>
          <button class="mon-sel-apply"
                  [disabled]="tempTableSelection.length === 0"
                  [title]="tempTableSelection.length === 0 ? 'Selecciona al menos una tabla para ver la gráfica' : 'Aplicar selección y actualizar gráfica'"
                  (click)="applyTableSelection()">Aplicar</button>
        </div>
      </div>
    }


    <!-- ── Barra de filtros ── -->
    <div class="mon-filter-bar">
      <!-- Búsqueda -->
      <div class="mon-filter-search">
        <span class="material-icons">search</span>
        <input type="text" placeholder="Buscar tabla…"
               [(ngModel)]="tableSearch" (ngModelChange)="onTableFilterChange()"
               class="mon-filter-input"/>
        @if (tableSearch) {
          <button class="mon-filter-clear" type="button" (click)="tableSearch=''; onTableFilterChange()">
            <span class="material-icons">close</span>
          </button>
        }
      </div>
      <!-- Filtro estado -->
      <select class="mon-filter-select" [(ngModel)]="tableStatusFilter" (ngModelChange)="onTableFilterChange()">
        <option value="all">Todos los estados</option>
        <option value="optimal">✅ Óptimo</option>
        <option value="warning">⚠️ Advertencia</option>
        <option value="critical">🔴 Atención</option>
      </select>
      <!-- Toggle solo activas -->
      <label class="mon-filter-toggle">
        <input type="checkbox" [(ngModel)]="tableOnlyActive" (ngModelChange)="onTableFilterChange()"/>
        <span class="mon-filter-toggle__track"></span>
        <span class="mon-filter-toggle__label">Solo con actividad</span>
      </label>
    </div>

    <!-- ── Vista: Tabla ── -->
    @if (tableView === 'table') {
      <div class="table-wrap">
        <table class="mon-table mon-table--compact mon-table--striped">
          <thead>
            <tr>
              <!-- TABLA -->
              <th class="mon-th-tip mon-th-sortable" (click)="sortTable('tableName')">
                <span class="mon-th-inner">
                  Tabla
                  <span class="material-icons mon-th-help">help_outline</span>
                  <span class="mon-sort-icon material-icons">
                    {{ tableSortCol === 'tableName' ? (tableSortAsc ? 'arrow_upward' : 'arrow_downward') : 'unfold_more' }}
                  </span>
                </span>
                <div class="mon-tt-fixed">
                  <strong>Tabla</strong><br>
                  Nombre de la tabla en la base de datos.
                </div>
              </th>
              <!-- REGISTROS -->
              <th class="mon-th-tip mon-th-sortable" (click)="sortTable('estimatedRows')">
                <span class="mon-th-inner">
                  Registros
                  <span class="material-icons mon-th-help">help_outline</span>
                  <span class="mon-sort-icon material-icons">
                    {{ tableSortCol === 'estimatedRows' ? (tableSortAsc ? 'arrow_upward' : 'arrow_downward') : 'unfold_more' }}
                  </span>
                </span>
                <div class="mon-tt-fixed">
                  <strong>Registros activos</strong><br>
                  Cantidad de filas activas y válidas que tiene la tabla
                  en este momento.
                </div>
              </th>
              <!-- OBSOLETOS -->
              <th class="mon-th-tip mon-th-sortable" (click)="sortTable('deadTuples')">
                <span class="mon-th-inner">
                  Obsoletos
                  <span class="material-icons mon-th-help">help_outline</span>
                  <span class="mon-sort-icon material-icons">
                    {{ tableSortCol === 'deadTuples' ? (tableSortAsc ? 'arrow_upward' : 'arrow_downward') : 'unfold_more' }}
                  </span>
                </span>
                <div class="mon-tt-fixed">
                  <strong>Registros obsoletos (dead tuples)</strong><br>
                  Filas que fueron eliminadas o modificadas pero que aún
                  ocupan espacio en disco. Un número alto indica que se
                  necesita una limpieza desde el módulo de Mantenimiento.
                </div>
              </th>
              <!-- ESPACIO % -->
              <th class="mon-th-tip mon-th-sortable" (click)="sortTable('bloatPercent')">
                <span class="mon-th-inner">
                  Espacio %
                  <span class="material-icons mon-th-help">help_outline</span>
                  <span class="mon-sort-icon material-icons">
                    {{ tableSortCol === 'bloatPercent' ? (tableSortAsc ? 'arrow_upward' : 'arrow_downward') : 'unfold_more' }}
                  </span>
                </span>
                <div class="mon-tt-fixed">
                  <strong>Desperdicio de espacio</strong><br>
                  Porcentaje del espacio de la tabla que está siendo
                  desperdiciado por registros obsoletos.<br>
                  Meta: menor al 10%.
                </div>
              </th>
              <!-- ÚLTIMO VACUUM -->
              <th class="mon-th-tip">
                <span class="mon-th-inner">
                  Último VACUUM
                  <span class="material-icons mon-th-help">help_outline</span>
                </span>
                <div class="mon-tt-fixed mon-tt-fixed--left">
                  <strong>Último VACUUM automático</strong><br>
                  Fecha y hora en que PostgreSQL realizó la última limpieza
                  automática de esta tabla. Si dice 'Nunca', la tabla aún
                  no ha necesitado limpieza o el proceso automático
                  no ha corrido.
                </div>
              </th>
              <!-- ESTADO -->
              <th class="mon-th-tip">
                <span class="mon-th-inner">
                  Estado
                  <span class="material-icons mon-th-help">help_outline</span>
                </span>
                <div class="mon-tt-fixed mon-tt-fixed--left">
                  <strong>Estado de la tabla</strong><br><br>
                  <span class="mon-tt-badge mon-tt-badge--green">Óptimo</span>
                  La tabla está en buen estado. No requiere atención.<br><br>
                  <span class="mon-tt-badge mon-tt-badge--amber">Advertencia</span>
                  La tabla tiene registros obsoletos acumulados.
                  Se recomienda revisar pronto.<br><br>
                  <span class="mon-tt-badge mon-tt-badge--red">Atención</span>
                  La tabla requiere limpieza urgente.
                  Haz clic para ir al módulo de Mantenimiento.
                </div>
              </th>
            </tr>
          </thead>
          <tbody>
            @if (loading) {
              @for (r of [1,2,3,4,5]; track r) {
                <tr class="skeleton-tr">
                  <td><div class="skel skel--md"></div></td>
                  <td><div class="skel skel--sm"></div></td>
                  <td><div class="skel skel--sm"></div></td>
                  <td><div class="skel skel--sm"></div></td>
                  <td><div class="skel skel--sm"></div></td>
                  <td><div class="skel skel--xs"></div></td>
                </tr>
              }
            }
            @if (!loading && metrics) {
              @for (t of pagedTables; track t.tableName; let i = $index) {
                <tr class="mon-tr--fixed" [class.mon-tr--alt]="i % 2 !== 0">
                  <!-- Tabla -->
                  <td class="mon-td-name">
                    <span class="material-icons mon-td-icon-muted">table_rows</span>
                    <span class="mon-tt-wrap" [class.is-truncated]="t.tableName.length > 38">
                      <span class="mon-td-mono">{{ truncate(t.tableName, 38) }}</span>
                      @if (t.tableName.length > 38) {
                        <span class="mon-tt-fixed mon-tt-fixed--name">{{ t.tableName }}</span>
                      }
                    </span>
                  </td>
                  <!-- Registros -->
                  <td class="mon-td-num mon-td-right">{{ formatRows(t.estimatedRows) }}</td>
                  <!-- Obsoletos -->
                  <td class="mon-td-num mon-td-right">
                    <span [class.mon-dead-red]="t.deadTuples >= 20"
                          [class.mon-dead-yellow]="t.deadTuples >= 5 && t.deadTuples < 20"
                          [class.mon-dead-gray]="t.deadTuples < 5">
                      {{ t.deadTuples | number }}
                    </span>
                  </td>
                  <!-- Espacio desperdiciado — barra 8px -->
                  <td style="min-width:130px">
                    <div class="mon-bar8-wrap">
                      <div class="mon-bar8">
                        <div class="mon-bar8__fill"
                             [class.mon-bar8__fill--green]="t.bloatPercent <= 10"
                             [class.mon-bar8__fill--yellow]="t.bloatPercent > 10 && t.bloatPercent <= 30"
                             [class.mon-bar8__fill--red]="t.bloatPercent > 30"
                             [style.width.%]="t.bloatPercent > 100 ? 100 : t.bloatPercent">
                        </div>
                      </div>
                      <span class="mon-bar8-pct"
                            [class.mon-dead-red]="t.bloatPercent > 30"
                            [class.mon-dead-yellow]="t.bloatPercent > 10 && t.bloatPercent <= 30">
                        {{ t.bloatPercent | number:'1.1-1' }}%
                      </span>
                    </div>
                  </td>
                  <!-- Último VACUUM -->
                  <td>
                    @if (!t.lastAutoVacuum) {
                      <span class="mon-vacuum-never">
                        <span class="material-icons" style="font-size:14px">timer_off</span>
                        Nunca
                      </span>
                    } @else {
                      <span class="mon-vacuum-date">{{ formatDate(t.lastAutoVacuum) }}</span>
                    }
                  </td>
                  <!-- Estado -->
                  <td>
                    @if (t.status === 'warning' || t.status === 'critical') {
                      <button class="mon-status-badge mon-status-badge--link"
                              [class.mon-status-badge--warning]="t.status === 'warning'"
                              [class.mon-status-badge--critical]="t.status === 'critical'"
                              (click)="goToMaintenance()"
                              title="Ir a Mantenimiento para limpiar esta tabla">
                        <span class="material-icons mon-badge-icon">
                          {{ t.status === 'critical' ? 'error_outline' : 'warning_amber' }}
                        </span>
                        {{ tableStatusLabel(t.status) }}
                        <span class="material-icons mon-badge-arrow">arrow_forward</span>
                      </button>
                    } @else {
                      <span class="mon-status-badge mon-status-badge--optimal">
                        <span class="material-icons mon-badge-icon">check_circle</span>
                        {{ tableStatusLabel(t.status) }}
                      </span>
                    }
                  </td>
                </tr>
              }
              @if (filteredTables.length === 0) {
                <tr>
                  <td colspan="6" class="mon-td-empty">
                    <span class="material-icons">search_off</span>
                    No hay tablas que coincidan con los filtros
                  </td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>

      <!-- Paginación -->
      @if (!loading && tableTotalPages > 1) {
        <div class="mon-pagination">
          <button class="mon-page-btn" [disabled]="tablePage === 0" (click)="tablePage = tablePage - 1">
            <span class="material-icons">chevron_left</span>
          </button>
          @for (p of tablePageNumbers; track p) {
            <button class="mon-page-btn" [class.mon-page-btn--active]="p === tablePage" (click)="tablePage = p">
              {{ p + 1 }}
            </button>
          }
          <button class="mon-page-btn" [disabled]="tablePage === tableTotalPages - 1" (click)="tablePage = tablePage + 1">
            <span class="material-icons">chevron_right</span>
          </button>
          <span class="mon-page-info">
            {{ tablePage * TABLE_PAGE_SIZE + 1 }}–{{ tablePageEnd }} de {{ filteredTables.length }}
          </span>
        </div>
      }
    }

    <!-- ── Vista: Gráfica (Chart.js) ── -->
    @if (tableView === 'chart') {
      <!-- Tarjeta de alerta para active_sessions si está seleccionada -->
      @if (alertSessionsTable) {
        <div class="mon-outlier-card">
          <span class="material-icons mon-outlier-card__icon">people</span>
          <div class="mon-outlier-card__body">
            <p class="mon-outlier-card__title">active_sessions — tabla de sesiones activas</p>
            <p class="mon-outlier-card__stats">
              {{ formatRows(alertSessionsTable.estimatedRows) }} registros activos ·
              {{ alertSessionsTable.deadTuples | number }} obsoletos ·
              Esp. desperdiciado: {{ alertSessionsTable.bloatPercent | number:'1.1-1' }}%
            </p>
          </div>
        </div>
      }
      <!-- Tarjetas de alerta por cada outlier -->
      @for (t of outlierTables; track t.tableName) {
        @if (selectedTableNames.includes(t.tableName)) {
          <div class="mon-outlier-card">
            <span class="material-icons mon-outlier-card__icon">warning_amber</span>
            <div class="mon-outlier-card__body">
              <p class="mon-outlier-card__title">{{ t.tableName }} requiere atención</p>
              <p class="mon-outlier-card__stats">
                {{ formatRows(t.estimatedRows) }} registros activos ·
                {{ t.deadTuples | number }} obsoletos ·
                Espacio desperdiciado: {{ t.bloatPercent | number:'1.1-1' }}%
              </p>
              <button class="mon-outlier-link" (click)="goToMaintenance()">
                → Ir a Mantenimiento
              </button>
            </div>
          </div>
        }
      }
      <!-- Leyenda custom HTML (no usa Chart.js legend) -->
      <div class="mon-chart-legend">
        <span class="mon-chart-legend__item">
          <span class="mon-chart-legend__swatch" style="background:#378ADD"></span>
          Registros activos
        </span>
        <span class="mon-chart-legend__item">
          <span class="mon-chart-legend__swatch" style="background:#EF9F27"></span>
          Registros obsoletos
        </span>
      </div>
      @if (chartSelectedTables.length > 0) {
        <div class="mon-chart-canvas-wrap" [@fadeIn]>
          <canvas #tableChartCanvas></canvas>
        </div>
        <p class="mon-chart-footnote">
          Tablas seleccionadas ({{ chartSelectedTables.length }}), ordenadas por nombre.
          Pasa el cursor sobre una barra para ver el desglose y estado.
        </p>
      } @else {
        <div class="mon-chart-ok-msg">
          <span class="material-icons mon-chart-ok-msg__icon" style="color:#94a3b8">bar_chart</span>
          <p class="mon-chart-ok-msg__title" style="color:#64748b">No hay tablas seleccionadas</p>
          <p class="mon-chart-ok-msg__sub">Usa el botón «Tablas» para elegir qué tablas visualizar</p>
        </div>
      }
    }
  </div>



  <!-- ══════════════════════════════════════════════════════════════════════
       SECCIÓN 5 — USO DE ÍNDICES
  ══════════════════════════════════════════════════════════════════════════ -->
  <div class="mon-section-card">
    <div class="mon-section-header">
      <div class="mon-section-header__left">
        <div class="mon-section-icon mon-section-icon--purple">
          <span class="material-icons">account_tree</span>
        </div>
        <div>
          <h3 class="mon-section-title">Uso de índices</h3>
          <p class="mon-section-sub">
            Eficiencia de las búsquedas rápidas de la base de datos
            @if (!loading && metrics) {
              <span class="mon-count-badge">{{ filteredIndexes.length }} índice{{ filteredIndexes.length !== 1 ? 's' : '' }}</span>
            }
          </p>
        </div>
      </div>
      <!-- Toggle vista -->
      <div style="display:flex; align-items:center; gap:.75rem; flex-wrap:wrap">
        @if (indexView === 'chart') {
          <button class="mon-sel-btn"
                  (click)="toggleIndexSelectionPanel()">
            <span class="material-icons" style="font-size:15px">format_list_bulleted</span>
            Índices
            <span class="mon-sel-badge">{{ selectedIndexNames.length }}</span>
          </button>
        }
        <div class="mon-view-toggle" role="group" aria-label="Tipo de vista">
          <button type="button" [class.mon-view-toggle__btn--active]="indexView === 'table'"
                  (click)="setIndexView('table')" title="Vista de tabla">
            <span class="material-icons">table_rows</span> Tabla
          </button>
          <button type="button" [class.mon-view-toggle__btn--active]="indexView === 'chart'"
                  (click)="setIndexView('chart')" title="Vista de gráfica">
            <span class="material-icons">bar_chart</span> Gráfica
          </button>
        </div>
      </div>
    </div>

    <!-- ── Panel selector de índices (rediseñado) ── -->
    @if (indexSelectionOpen) {
      <div class="mon-idx-panel" [@fadeIn]>

        <!-- Fila superior: buscador + acciones rápidas -->
        <div class="mon-idx-panel__topbar">
          <div class="mon-idx-panel__search-wrap">
            <span class="material-icons mon-idx-panel__search-icon">search</span>
            <input class="mon-idx-panel__search"
                   type="text"
                   placeholder="Buscar índice o tabla..."
                   [(ngModel)]="indexPanelSearch"/>
            @if (indexPanelSearch) {
              <button class="mon-idx-panel__search-clear" type="button"
                      (click)="indexPanelSearch = ''">
                <span class="material-icons">close</span>
              </button>
            }
          </div>
          <div class="mon-idx-panel__actions">
            <button class="mon-sel-action" (click)="selectAllIndexes()">Todos</button>
            <button class="mon-sel-action" (click)="selectNoIndexes()">Ninguno</button>
            <button class="mon-sel-action" (click)="selectTopIndexes()">Más activos</button>
            <button class="mon-sel-action" (click)="selectProblemIndexes()">Con problemas</button>
          </div>
          <span class="mon-sel-counter"
                [class.mon-sel-counter--limit]="tempIndexSelection.length >= INDEX_MAX_SEL"
                [title]="tempIndexSelection.length >= INDEX_MAX_SEL
                  ? 'Límite alcanzado — la gráfica puede mostrar máximo ' + INDEX_MAX_SEL + ' índices a la vez. Deselecciona uno de los marcados en azul para poder agregar otro.'
                  : tempIndexSelection.length + ' de ' + INDEX_MAX_SEL + ' índices seleccionados para la gráfica'">
            {{ tempIndexSelection.length }} / {{ INDEX_MAX_SEL }} índices en gráfica
          </span>
        </div>

        <!-- Grupos colapsables por tabla -->
        <div class="mon-idx-panel__groups">
          @for (group of indexGroupsByTable; track group.tableName) {
            <div class="mon-idx-group">
              <!-- Header colapsable -->
              <button class="mon-idx-group__header"
                      (click)="toggleGroupCollapse(group.tableName)">
                <span class="material-icons mon-idx-group__arrow"
                      [class.mon-idx-group__arrow--open]="!isGroupCollapsed(group.tableName)">
                  chevron_right
                </span>
                <span class="mon-idx-group__table">{{ group.tableName }}</span>
                <span class="mon-idx-group__count">{{ group.indexes.length }} índice{{ group.indexes.length !== 1 ? 's' : '' }}</span>
              </button>

              <!-- Chips del grupo -->
              @if (!isGroupCollapsed(group.tableName)) {
                <div class="mon-idx-group__chips">
                  @for (idx of group.indexes; track idx.indexName) {
                    <button class="mon-idx-chip"
                            [class.mon-idx-chip--active]="tempIndexSelection.includes(idx.indexName)"
                            [class.mon-idx-chip--disabled]="!tempIndexSelection.includes(idx.indexName) && tempIndexSelection.length >= INDEX_MAX_SEL"
                            [title]="(!tempIndexSelection.includes(idx.indexName) && tempIndexSelection.length >= INDEX_MAX_SEL)
                              ? ''
                              : tempIndexSelection.includes(idx.indexName)
                                ? 'Clic para quitar ' + idx.indexName + ' de la gráfica'
                                : 'Agregar ' + idx.indexName + ' a la gráfica (tabla: ' + idx.tableName + ')'"
                            (mouseenter)="(!tempIndexSelection.includes(idx.indexName) && tempIndexSelection.length >= INDEX_MAX_SEL)
                              ? showChipTooltip($event, 'Límite de ' + INDEX_MAX_SEL + ' índices alcanzado — deselecciona uno de los marcados en azul para agregar éste.')
                              : null"
                            (mouseleave)="hideChipTooltip()"
                            (click)="toggleIndexChip(idx.indexName)">
                      <!-- Punto de color -->
                      <span class="mon-idx-chip__dot"
                            [class.mon-idx-chip__dot--ok]="idx.indexScans > 0 && idx.efficiencyPct >= 80"
                            [class.mon-idx-chip__dot--warn]="idx.indexScans > 0 && idx.efficiencyPct >= 40 && idx.efficiencyPct < 80"
                            [class.mon-idx-chip__dot--bad]="idx.indexScans > 0 && idx.efficiencyPct < 40"
                            [class.mon-idx-chip__dot--unused]="idx.indexScans === 0">
                      </span>
                      <!-- Nombre del índice -->
                      <span class="mon-idx-chip__name">{{ idx.indexName.length > 24 ? idx.indexName.substring(0,24) + '…' : idx.indexName }}</span>
                      <!-- Eficiencia -->
                      <span class="mon-idx-chip__eff">{{ idx.efficiencyPct | number:'1.0-0' }}%</span>
                    </button>
                  }
                </div>
              }
            </div>
          }
          @if (indexGroupsByTable.length === 0) {
            <p class="mon-idx-panel__empty">Sin resultados para "{{ indexPanelSearch }}"</p>
          }
        </div>

        @if (indexSelectionLimitMsg) {
          <p class="mon-sel-limit-msg">
            <span class="material-icons" style="font-size:14px;vertical-align:middle">warning_amber</span>
            Límite de {{ INDEX_MAX_SEL }} índices en la gráfica alcanzado. Para agregar otro, primero deselecciona uno de los ya marcados.
          </p>
        }

        <div class="mon-sel-panel__footer">
          <button class="mon-sel-cancel" (click)="indexSelectionOpen = false">Cancelar</button>
          <button class="mon-sel-apply" (click)="applyIndexSelection()">Aplicar</button>
        </div>
      </div>
    }


    <!-- ── Barra de filtros ── -->
    <div class="mon-filter-bar">
      <div class="mon-filter-search">
        <span class="material-icons">search</span>
        <input type="text" placeholder="Buscar índice o tabla…"
               [(ngModel)]="indexSearch" (ngModelChange)="onIndexFilterChange()"
               class="mon-filter-input"/>
        @if (indexSearch) {
          <button class="mon-filter-clear" type="button" (click)="indexSearch=''; onIndexFilterChange()">
            <span class="material-icons">close</span>
          </button>
        }
      </div>
      <select class="mon-filter-select" [(ngModel)]="indexStatusFilter" (ngModelChange)="onIndexFilterChange()">
        <option value="all">Todos los estados</option>
        <option value="active">✅ En uso</option>
        <option value="low-efficiency">⚠️ Eficiencia baja</option>
        <option value="unused">🔴 Sin uso</option>
      </select>
    </div>

    <!-- ── Vista: Tabla ── -->
    @if (indexView === 'table') {
      <div class="table-wrap">
        <table class="mon-table mon-table--compact mon-table--striped">
          <thead>
            <tr>
              <!-- ÍNDICE -->
              <th class="mon-th-tip">
                <span class="mon-th-inner">
                  Índice
                  <span class="material-icons mon-th-help">help_outline</span>
                </span>
                <div class="mon-tt-fixed">
                  <strong>Índice</strong><br>
                  Nombre técnico del índice en la base de datos.<br>
                  Los índices ayudan a encontrar datos rápidamente.
                </div>
              </th>
              <!-- TABLA -->
              <th class="mon-th-tip">
                <span class="mon-th-inner">
                  Tabla
                  <span class="material-icons mon-th-help">help_outline</span>
                </span>
                <div class="mon-tt-fixed">
                  <strong>Tabla</strong><br>
                  Tabla de la base de datos a la que pertenece este índice.
                </div>
              </th>
              <!-- RÁPIDAS -->
              <th class="mon-th-tip mon-col-hide-sm">
                <span class="mon-th-inner">
                  Rápidas
                  <span class="material-icons mon-th-help">help_outline</span>
                </span>
                <div class="mon-tt-fixed">
                  <strong>Búsquedas rápidas</strong><br>
                  Veces que PostgreSQL usó este índice para encontrar datos
                  de forma directa y eficiente, como usar el índice de un libro.
                </div>
              </th>
              <!-- SECUENCIALES -->
              <th class="mon-th-tip mon-col-hide-sm">
                <span class="mon-th-inner">
                  Secuenciales
                  <span class="material-icons mon-th-help">help_outline</span>
                </span>
                <div class="mon-tt-fixed">
                  <strong>Escaneos secuenciales</strong><br>
                  Veces que PostgreSQL tuvo que leer la tabla completa
                  ignorando el índice. Un número alto indica que el índice
                  no está siendo aprovechado.
                </div>
              </th>
              <!-- EFICIENCIA -->
              <th class="mon-th-tip">
                <span class="mon-th-inner">
                  Eficiencia
                  <span class="material-icons mon-th-help">help_outline</span>
                </span>
                <div class="mon-tt-fixed">
                  <strong>Eficiencia del índice</strong><br>
                  Porcentaje de veces que el índice fue útil.<br>
                  Fórmula: búsquedas rápidas / (rápidas + secuenciales) × 100.<br>
                  Meta: mayor al 80%.
                </div>
              </th>
              <!-- ESTADO -->
              <th class="mon-th-tip">
                <span class="mon-th-inner">
                  Estado
                  <span class="material-icons mon-th-help">help_outline</span>
                </span>
                <div class="mon-tt-fixed mon-tt-fixed--left">
                  <strong>Estado del índice</strong><br><br>
                  <span class="mon-tt-badge mon-tt-badge--green">En uso</span>
                  Este índice se usa frecuentemente.
                  Está cumpliendo su función correctamente.<br><br>
                  <span class="mon-tt-badge mon-tt-badge--amber">Eficiencia baja</span>
                  El índice existe pero rara vez se usa. Puede deberse a que
                  la tabla tiene pocos datos o que las consultas no lo aprovechan.<br><br>
                  <span class="mon-tt-badge mon-tt-badge--red">Sin uso</span>
                  Este índice nunca ha sido utilizado.
                  Es un candidato para ser eliminado.
                </div>
              </th>
            </tr>
          </thead>
          <tbody>
            @if (loading) {
              @for (r of [1,2,3,4]; track r) {
                <tr class="skeleton-tr">
                  <td><div class="skel skel--md"></div></td>
                  <td><div class="skel skel--sm"></div></td>
                  <td class="mon-col-hide-sm"><div class="skel skel--xs"></div></td>
                  <td class="mon-col-hide-sm"><div class="skel skel--xs"></div></td>
                  <td><div class="skel skel--sm"></div></td>
                  <td><div class="skel skel--xs"></div></td>
                </tr>
              }
            }
            @if (!loading && metrics) {
              @for (idx of pagedIndexes; track idx.indexName; let i = $index) {
                <tr class="mon-tr--fixed" [class.mon-tr--alt]="i % 2 !== 0">
                  <!-- Índice -->
                  <td class="mon-td-name">
                    <span class="material-icons mon-td-icon-muted" style="font-size:15px">bolt</span>
                    <span class="mon-tt-wrap" [class.is-truncated]="idx.indexName.length > 32">
                      <span class="mon-td-mono">{{ truncate(idx.indexName, 32) }}</span>
                      @if (idx.indexName.length > 32) {
                        <span class="mon-tt-fixed mon-tt-fixed--name">{{ idx.indexName }}</span>
                      }
                    </span>
                  </td>
                  <!-- Tabla -->
                  <td class="mon-td-tbl">
                    <span class="mon-tt-wrap">
                      {{ truncate(idx.tableName, 20) }}
                      @if (idx.tableName.length > 20) {
                        <span class="mon-tt-fixed mon-tt-fixed--name">{{ idx.tableName }}</span>
                      }
                    </span>
                  </td>
                  <!-- Rápidas (index scans) -->
                  <td class="mon-td-num mon-td-right mon-col-hide-sm"
                      [class.mon-scans-fast]="idx.indexScans > 0"
                      [class.mon-scans-gray]="idx.indexScans === 0">
                    {{ idx.indexScans | number }}
                  </td>
                  <!-- Secuenciales (seq scans) -->
                  <td class="mon-td-num mon-td-right mon-col-hide-sm"
                      [class.mon-scans-red]="idx.seqScans > 100"
                      [class.mon-scans-yellow]="idx.seqScans > 10 && idx.seqScans <= 100"
                      [class.mon-scans-gray]="idx.seqScans <= 10">
                    {{ idx.seqScans | number }}
                  </td>
                  <!-- Eficiencia — barra 8px -->
                  <td style="min-width:130px">
                    <div class="mon-bar8-wrap">
                      <div class="mon-bar8">
                        <div class="mon-bar8__fill"
                             [class.mon-bar8__fill--green]="idx.efficiencyPct >= 80"
                             [class.mon-bar8__fill--yellow]="idx.efficiencyPct >= 40 && idx.efficiencyPct < 80"
                             [class.mon-bar8__fill--red]="idx.efficiencyPct < 40"
                             [style.width.%]="idx.efficiencyPct > 100 ? 100 : idx.efficiencyPct">
                        </div>
                      </div>
                      <span class="mon-bar8-pct"
                            [class.mon-dead-red]="idx.efficiencyPct < 40"
                            [class.mon-dead-yellow]="idx.efficiencyPct >= 40 && idx.efficiencyPct < 80">
                        {{ idx.efficiencyPct | number:'1.0-1' }}%
                      </span>
                    </div>
                  </td>
                  <!-- Estado -->
                  <td>
                    <span class="mon-status-badge"
                          [class.mon-status-badge--optimal]="idx.status === 'active'"
                          [class.mon-status-badge--warning]="idx.status === 'low-efficiency'"
                          [class.mon-status-badge--critical]="idx.status === 'unused'">
                      {{ indexStatusLabel(idx.status) }}
                    </span>
                  </td>
                </tr>
              }
              @if (filteredIndexes.length === 0) {
                <tr>
                  <td colspan="6" class="mon-td-empty">
                    <span class="material-icons">search_off</span>
                    No hay índices que coincidan con los filtros
                  </td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>
      <!-- Nota informativa -->
      @if (!loading && metrics) {
        <p class="mon-index-note">
          💡 Los índices con estado 'Sin uso' o 'Eficiencia baja' en tablas vacías son normales durante el desarrollo.
          PostgreSQL prefiere el escaneo directo cuando las tablas tienen pocos registros.
        </p>
      }

      <!-- Paginación índices -->
      @if (!loading && indexTotalPages > 1) {
        <div class="mon-pagination">
          <button class="mon-page-btn" [disabled]="indexPage === 0" (click)="indexPage = indexPage - 1">
            <span class="material-icons">chevron_left</span>
          </button>
          @for (p of indexPageNumbers; track p) {
            <button class="mon-page-btn" [class.mon-page-btn--active]="p === indexPage" (click)="indexPage = p">
              {{ p + 1 }}
            </button>
          }
          <button class="mon-page-btn" [disabled]="indexPage === indexTotalPages - 1" (click)="indexPage = indexPage + 1">
            <span class="material-icons">chevron_right</span>
          </button>
          <span class="mon-page-info">
            Pág. {{ indexPage + 1 }} de {{ indexTotalPages }}
          </span>
        </div>
      }
    }

    <!-- ── Vista: Gráfica (Chart.js) ── -->
    @if (indexView === 'chart') {

      <!-- ── Tabs tipo pill (fondo secundario, activa blanca con borde 0.5px) ── -->
      <div class="mon-chart-tabs">
        <div class="mon-chart-tabs-pill">
          <button class="mon-chart-tab"
                  [class.mon-chart-tab--active]="indexChartTab === 'used'"
                  (click)="setIndexChartTab('used')">
            <span class="material-icons" style="font-size:14px">trending_up</span>
            Más utilizados
          </button>
          <button class="mon-chart-tab"
                  [class.mon-chart-tab--active]="indexChartTab === 'attention'"
                  (click)="setIndexChartTab('attention')">
            <span class="material-icons" style="font-size:14px">report_problem</span>
            Requieren atención
          </button>
        </div>
      </div>

      <!-- ══ PESTAÑA: Más utilizados ══ -->
      @if (indexChartTab === 'used') {

        <!-- Tarjeta campeón con círculo/trofeo -->
        @if (indexChampion) {
          <div class="mon-champion-card">
            <div class="mon-champion-circle">
              <span class="material-icons" style="font-size:1.1rem;color:#b45309;">emoji_events</span>
            </div>
            <div class="mon-champion-card__body">
              <p class="mon-champion-card__label">Índice más activo del sistema</p>
              <span class="mon-champion-card__name">{{ indexChampion.indexName }}</span>
              <span class="mon-champion-card__stats">
                &nbsp;·&nbsp;tabla:&nbsp;{{ indexChampion.tableName }}
                &nbsp;·&nbsp;{{ indexChampion.indexScans | number }} búsquedas
              </span>
              <span class="mon-champion-card__eff">
                &nbsp;·&nbsp;{{ indexChampion.efficiencyPct | number:'1.1-1' }}% eficiencia
              </span>
            </div>
          </div>
        }

        @if (chartSelectedIndexes.length > 0) {
          <!-- Leyenda custom HTML -->
          <div class="mon-chart-legend">
            <span class="mon-chart-legend__item">
              <span class="mon-chart-legend__swatch" style="background:#1D9E75"></span>
              Eficiencia ≥ 80%
            </span>
            <span class="mon-chart-legend__item">
              <span class="mon-chart-legend__swatch" style="background:#EF9F27"></span>
              Eficiencia 40–79%
            </span>
            <span class="mon-chart-legend__item">
              <span class="mon-chart-legend__swatch" style="background:#E24B4A"></span>
              Eficiencia &lt; 40%
            </span>
          </div>
          <div class="mon-chart-canvas-wrap mon-chart-canvas-wrap--idx" [@fadeIn]>
            <canvas #indexChartCanvas></canvas>
          </div>
          <p class="mon-chart-footnote">
            Índices seleccionados ({{ chartSelectedIndexes.length }}), excluyendo el campeón.
            El color indica la eficiencia del índice.
          </p>
        } @else {
          <div class="mon-chart-ok-msg">
            <span class="material-icons mon-chart-ok-msg__icon" style="color:#94a3b8">bar_chart</span>
            <p class="mon-chart-ok-msg__title" style="color:#64748b">No hay índices seleccionados</p>
            <p class="mon-chart-ok-msg__sub">Usa el botón «Índices» para elegir qué índices visualizar</p>
          </div>
        }
      }

      <!-- ══ PESTAÑA: Requieren atención ══ -->
      @if (indexChartTab === 'attention') {
        @if (chartSelectedLowEff.length === 0) {
          <!-- Sin problemas -->
          <div class="mon-chart-ok-msg">
            <span class="material-icons mon-chart-ok-msg__icon">check_circle</span>
            <p class="mon-chart-ok-msg__title">Todos los índices activos funcionan correctamente</p>
            <p class="mon-chart-ok-msg__sub">
              Los índices con eficiencia baja en tablas vacías son normales en esta etapa
            </p>
          </div>
        } @else {
          <!-- Leyenda custom HTML stacked -->
          <div class="mon-chart-legend">
            <span class="mon-chart-legend__item">
              <span class="mon-chart-legend__swatch" style="background:#1D9E75"></span>
              Búsquedas rápidas
            </span>
            <span class="mon-chart-legend__item">
              <span class="mon-chart-legend__swatch" style="background:#E24B4A"></span>
              Búsquedas lentas (secuenciales)
            </span>
          </div>
          <div class="mon-chart-canvas-wrap mon-chart-canvas-wrap--idx" [@fadeIn]>
            <canvas #indexChartCanvas></canvas>
          </div>
          <p class="mon-chart-footnote">
            Índices con más de 50 búsquedas totales y eficiencia &lt; 75%.
            Reducir las búsquedas secuenciales mejora el rendimiento.
          </p>
        }
      }
    }
  </div>


  <!-- ══════════════════════════════════════════════════════════════════════
       SECCIÓN 6 — ALERTAS ACTIVAS
  ══════════════════════════════════════════════════════════════════════════ -->
  @if (!loading && metrics) {
    <div class="mon-section-card mon-alerts-section">

      <!-- ── Header ── -->
      <div class="mon-section-header">
        <div class="mon-section-header__left">
          <div class="mon-section-icon" [class.mon-section-icon--red]="criticalAlerts.length > 0"
               [class.mon-section-icon--amber]="criticalAlerts.length === 0 && (warningAlerts.length > 0 || weakIndexAlert.count > 0)"
               [class.mon-section-icon--green]="metrics.alerts.length === 0 && weakIndexAlert.count === 0">
            <span class="material-icons">
              {{ (metrics.alerts.length === 0 && weakIndexAlert.count === 0) ? 'check_circle' : criticalAlerts.length > 0 ? 'notifications_active' : 'warning' }}
            </span>
          </div>
          <div>
            <h3 class="mon-section-title">Alertas activas</h3>
            <p class="mon-section-sub">Condiciones que requieren tu atención</p>
          </div>
        </div>
        <div class="mon-alerts-summary">
          @if (criticalAlerts.length > 0) {
            <span class="mon-alert-pill mon-alert-pill--critical">
              <span class="material-icons">error</span>
              {{ criticalAlerts.length }} crítica{{ criticalAlerts.length > 1 ? 's' : '' }}
            </span>
          }
          @if (warningAlerts.length > 0) {
            <span class="mon-alert-pill mon-alert-pill--warning">
              <span class="material-icons">warning</span>
              {{ warningAlerts.length }} advertencia{{ warningAlerts.length > 1 ? 's' : '' }}
            </span>
          }
          @if (weakIndexAlert.count > 0) {
            <span class="mon-alert-pill mon-alert-pill--index">
              <span class="material-icons">trending_down</span>
              {{ weakIndexAlert.count }} índice{{ weakIndexAlert.count > 1 ? 's' : '' }} débil{{ weakIndexAlert.count > 1 ? 'es' : '' }}
            </span>
          }
        </div>
      </div>

      <!-- ── Cuerpo con max-height scroll ── -->
      <div class="mon-alerts-body">

        <!-- ── Estado vacío ── -->
        @if (metrics.alerts.length === 0 && weakIndexAlert.count === 0) {
          <div class="mon-alerts-empty">
            <span class="material-icons mon-alerts-empty__icon">check_circle</span>
            <p class="mon-alerts-empty__title">Todo funciona correctamente</p>
            <p class="mon-alerts-empty__sub">No hay alertas activas en este momento</p>
          </div>
        }

        <!-- ── Bloque CRÍTICO — siempre visible ── -->
        @if (criticalAlerts.length > 0) {
          <div class="mon-alerts-block mon-alerts-block--critical">
            <div class="mon-alerts-block__header">
              <span class="material-icons">error</span>
              <strong>{{ criticalAlerts.length }} alerta{{ criticalAlerts.length > 1 ? 's' : '' }} crítica{{ criticalAlerts.length > 1 ? 's' : '' }}</strong>
            </div>
            @for (alert of criticalAlerts; track alert.id) {
              <div class="mon-alert-row mon-alert-row--critical">
                <span class="material-icons mon-alert-row__icon">error</span>
                <div class="mon-alert-row__body">
                  <p class="mon-alert-row__msg">{{ alert.message }}</p>
                  <p class="mon-alert-row__value">{{ alert.value }}</p>
                  <p class="mon-alert-row__hint">{{ alert.hint }}</p>
                </div>
                <span class="mon-alert-row__cat">{{ alert.category }}</span>
              </div>
            }
          </div>
        }

        <!-- ── Bloque ADVERTENCIAS — colapsado por defecto ── -->
        @if (warningAlerts.length > 0) {
          <div class="mon-alerts-block mon-alerts-block--warning">
            <div class="mon-alerts-block__header">
              <span class="material-icons">warning</span>
              <strong>{{ warningAlerts.length }} advertencia{{ warningAlerts.length > 1 ? 's' : '' }}</strong>
            </div>

            <!-- Grupos de advertencias -->
            @for (group of visibleGroupedWarnings; track group.key) {
              @if (group.count === 1) {
                <!-- Alerta individual -->
                <div class="mon-alert-row mon-alert-row--warning">
                  <span class="material-icons mon-alert-row__icon">warning_amber</span>
                  <div class="mon-alert-row__body">
                    <p class="mon-alert-row__msg">{{ group.summary }}</p>
                    <p class="mon-alert-row__value">{{ group.items[0].value }}</p>
                    <p class="mon-alert-row__hint">{{ group.items[0].hint }}</p>
                  </div>
                  <span class="mon-alert-row__cat">{{ group.category }}</span>
                </div>
              } @else {
                <!-- Grupo agrupado -->
                <div class="mon-alert-group">
                  <div class="mon-alert-group__header" (click)="toggleAlertGroup(group.key)">
                    <span class="material-icons mon-alert-row__icon">warning_amber</span>
                    <div class="mon-alert-group__info">
                      <p class="mon-alert-row__msg">
                        <strong>{{ group.count }}</strong> {{ group.summary }}
                      </p>
                      <p class="mon-alert-row__value">La más crítica: {{ group.worst }}</p>
                    </div>
                    <span class="mon-alert-group__chevron"
                          [class.mon-alert-group__chevron--open]="isAlertGroupExpanded(group.key)">
                      <span class="material-icons">expand_more</span>
                    </span>
                  </div>
                  @if (isAlertGroupExpanded(group.key)) {
                    <div class="mon-alert-group__items" [@fadeIn]>
                      @for (item of group.items; track item.id) {
                        <div class="mon-alert-row mon-alert-row--warning mon-alert-row--sub">
                          <span class="material-icons mon-alert-row__icon">subdirectory_arrow_right</span>
                          <div class="mon-alert-row__body">
                            <p class="mon-alert-row__msg">{{ item.message }}</p>
                            <p class="mon-alert-row__value">{{ item.value }}</p>
                            <p class="mon-alert-row__hint">{{ item.hint }}</p>
                          </div>
                        </div>
                      }
                    </div>
                  }
                </div>
              }
            }

            <!-- Botón "Ver más" -->
            @if (hiddenWarningCount > 0) {
              <button class="mon-alerts-more-btn" (click)="toggleWarnings()">
                {{ showAllWarnings ? 'Ver menos ▲' : 'Ver ' + hiddenWarningCount + ' advertencia' + (hiddenWarningCount > 1 ? 's' : '') + ' más ▼' }}
              </button>
            }

          </div>
        }

        <!-- ── Bloque ÍNDICES CON BAJA EFICIENCIA — enlace a Mantenimiento REINDEX ── -->
        @if (weakIndexAlert.count > 0) {
          <div class="mon-alerts-block mon-alerts-block--index-weak">
            <div class="mon-alerts-block__header">
              <span class="material-icons">trending_down</span>
              <strong>
                {{ weakIndexAlert.count }} índice{{ weakIndexAlert.count > 1 ? 's' : '' }}
                {{ weakIndexAlert.count > 1 ? 'con baja eficiencia' : 'con baja eficiencia' }}
              </strong>
              <button class="mon-alert-goto-btn" (click)="goToMaintenance()"
                      title="Ir a Mantenimiento → REINDEX">
                <span class="material-icons">open_in_new</span>
                Ir a REINDEX
              </button>
            </div>
            <div class="mon-alert-row mon-alert-row--index-weak">
              <span class="material-icons mon-alert-row__icon">auto_fix_high</span>
              <div class="mon-alert-row__body">
                <p class="mon-alert-row__msg">
                  El índice más afectado es
                  <strong>{{ weakIndexAlert.worst?.index_name }}</strong>
                  en la tabla <strong>{{ weakIndexAlert.worst?.table_name }}</strong>
                </p>
                <p class="mon-alert-row__value">
                  Eficiencia: {{ weakIndexAlert.worst?.efficiency_pct?.toFixed(1) }}%
                  ({{ weakIndexAlert.worst?.idx_scan }} escaneos por índice vs.
                  {{ weakIndexAlert.worst?.seq_scan }} secuenciales)
                </p>
                <p class="mon-alert-row__hint">
                  Un REINDEX TABLE reconstruye el índice y puede mejorar
                  significativamente los tiempos de consulta.
                </p>
              </div>
            </div>
          </div>
        }

      </div><!-- /mon-alerts-body -->
    </div>
  }

  <!-- ══════════════════════════════════════════════════════════════════════
       TOOLTIP OVERLAY GLOBAL — position:fixed, visible sobre todo el DOM
       Se renderiza aquí (al final, fuera de cualquier contenedor con
       overflow:hidden) para que NUNCA quede recortado.
  ══════════════════════════════════════════════════════════════════════════ -->
  @if (activeTooltip) {
    <div class="mon-tooltip-overlay"
         [class.mon-tooltip-overlay--down]="tooltipDir === 'down'"
         [style.left.px]="tooltipX"
         [style.top.px]="tooltipY">
      @switch (activeTooltip) {
        @case ('dbsize') {
          Espacio total que ocupa la base de datos en el servidor.
        }
        @case ('uptime') {
          Días que lleva funcionando el servidor PostgreSQL sin reinicios.
        }
        @case ('tables') {
          Número de tablas de usuario analizadas y monitoreadas en esta sesión.
        }
        @case ('cache') {
          Indica qué tan bien el servidor evita leer del disco duro.
          Un valor mayor al 95% es ideal. Valores bajos generan lentitud.
        }
        @case ('tps') {
          Número de operaciones (lecturas y escrituras) que realiza la base
          de datos cada segundo. Un valor alto indica mucha actividad.
        }
        @case ('avgq') {
          Tiempo promedio que tarda el servidor en responder una consulta.
          Menos de 10 ms es excelente; más de 100 ms indica lentitud.
        }
        @case ('donut-admin-tools') {
          Conexiones abiertas desde herramientas de administración como
          pgAdmin, DBeaver o DataGrip. Estas conexiones las genera el
          administrador de la base de datos, no los usuarios de la app.
        }
        @case ('conn-server') {
          Estas conexiones las mantiene el servidor automáticamente.
          No representan usuarios conectados a la aplicación.
        }
        @case ('conn-admin-tools') {
          Conexiones abiertas desde herramientas de administración como
          pgAdmin, DBeaver o DataGrip. Estas conexiones las genera el
          administrador de la base de datos, no los usuarios de la app.
        }
        @case ('conn-users') {
          Sesiones reales de usuarios con actividad en los últimos 30 minutos.
          Incluye conexiones activas, inactivas (idle) y en transacción.
          No incluye el pool interno de Spring Boot (HikariCP).
        }
      }
    </div>
  }

  <!-- ── Tooltip global para chips bloqueados (escapa de overflow) ── -->
  @if (chipTooltip) {
    <div class="mon-chip-tooltip-global"
         [style.left.px]="chipTooltip.x"
         [style.top.px]="chipTooltip.y">
      {{ chipTooltip.text }}
    </div>
  }

</div><!-- /tab-root -->
</file>

<file path="src/app/components/admin/admin-db-management/tabs/admin-db-monitoring/admin-db-monitoring.component.ts">
import {
  ChangeDetectionStrategy, ChangeDetectorRef,
  Component, ElementRef, EventEmitter,
  OnInit, OnDestroy, AfterViewInit,
  Output, ViewChild, NgZone,
} from '@angular/core';
import { CommonModule } from '@angular/common';
