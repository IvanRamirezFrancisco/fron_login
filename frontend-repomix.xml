<section class="py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="text-xs font-semibold tracking-widest uppercase text-amber-500 mb-1">Explora por sección</p>
        <h2 class="text-3xl font-extrabold text-slate-900">Categorías</h2>
