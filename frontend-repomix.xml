<file path="src/app/components/home-header/home-header.component.html">
<header class="home-header" (click)="cerrarMenuUsuario()">
  <div class="header-container">
    <!-- Logo/Marca -->
    <div class="logo-section">
      <a routerLink="/" class="logo-link">
        <div class="logo-icon">
          <span class="material-symbols-outlined">music_note</span>
        </div>
        <div class="logo-text">
          <h1 class="logo-title">Casa de Música Castillo</h1>
          <p class="logo-subtitle">Instrumentos & Audio Profesional</p>
        </div>
      </a>
    </div>

    <!-- Navegación Principal -->
    <nav class="main-nav">
      <ul class="nav-list">
        <li><button (click)="scrollToSection('inicio')" class="nav-link nav-link--btn">Inicio</button></li>
        <li><button (click)="scrollToSection('productos')" class="nav-link nav-link--btn">Productos</button></li>
        <li><button (click)="scrollToSection('sobre-nosotros')" class="nav-link nav-link--btn">Nosotros</button></li>
        <li><button (click)="scrollToSection('contacto')" class="nav-link nav-link--btn">Contacto</button></li>
        <li><button (click)="navigateToCatalog()" class="nav-link nav-link--btn catalog-link">
          <span class="material-symbols-outlined">store</span>
          Ayuda
        </button></li>
      </ul>
    </nav>

    <!-- Acciones del Usuario -->
    <div class="user-actions">
      <!-- Usuario No Autenticado -->
      <div class="auth-buttons" *ngIf="!isAuthenticated">
        <button (click)="navigateToLogin()" class="btn-login">
          <span class="material-symbols-outlined">login</span>
          Iniciar Sesión
        </button>
        <button (click)="navigateToRegister()" class="btn-register">
          <span class="material-symbols-outlined">person_add</span>
          Registrarse
        </button>
      </div>

      <!-- Usuario Autenticado -->
      <div class="user-section" *ngIf="isAuthenticated">
        <!-- Carrito -->
        <button (click)="navigateToCart()" class="cart-button">
          <span class="material-symbols-outlined">shopping_cart</span>
          <span class="cart-text">Carrito</span>
        </button>

        <!-- Información del Usuario -->
        <div class="user-info" (click)="toggleMenuUsuario(); $event.stopPropagation()">
          <div class="user-avatar">
            <span class="material-symbols-outlined">account_circle</span>
          </div>
          <div class="user-details">
            <span class="welcome-text">¡Hola!</span>
            <span class="user-name">{{ currentUser?.firstName || currentUser?.name || 'Usuario' }}</span>
          </div>
          <span class="material-symbols-outlined chevron">expand_more</span>
        </div>

        <!-- Dropdown del Usuario -->
        <div class="user-dropdown" [class.visible]="mostrarMenuUsuario" (click)="$event.stopPropagation()">
          <div class="dropdown-header">
            <div class="avatar-large">
              <span class="material-symbols-outlined">account_circle</span>
            </div>
            <div class="user-info-detailed">
              <div class="full-name">{{ currentUser?.firstName }} {{ currentUser?.lastName }}</div>
              <div class="email">{{ currentUser?.email }}</div>
            </div>
          </div>
          
          <nav class="dropdown-nav">
            <a routerLink="/dashboard" class="dropdown-link" (click)="cerrarMenuUsuario()">
              <span class="material-symbols-outlined">dashboard</span>
              Mi Dashboard
            </a>
            <a routerLink="/dashboard/seguridad" class="dropdown-link" (click)="cerrarMenuUsuario()">
              <span class="material-symbols-outlined">person</span>
              Mi Perfil
            </a>
            <a routerLink="/orders/my" class="dropdown-link" (click)="cerrarMenuUsuario()">
              <span class="material-symbols-outlined">receipt_long</span>
              Mis Pedidos
            </a>
            <a routerLink="/dashboard/favoritos" class="dropdown-link" (click)="cerrarMenuUsuario()">
              <span class="material-symbols-outlined">favorite</span>
              Lista de Deseos
            </a>
            <div class="dropdown-divider"></div>
            <button (click)="logout()" class="dropdown-link logout-link">
              <span class="material-symbols-outlined">logout</span>
              Cerrar Sesión
            </button>
          </nav>
        </div>
      </div>
    </div>

    <!-- Botón Móvil -->
    <button class="mobile-menu-toggle" (click)="$event.stopPropagation()">
      <span class="material-symbols-outlined">menu</span>
    </button>
  </div>
</header>
</file>

<file path="src/app/components/main-header/main-header.component.css">
/* =================================================================
   MAIN HEADER COMPONENT - Casa de Música Castillo
   Header Global Reutilizable
   ================================================================= */

/* Material Icons - Configuración global */
.material-icons {
  font-family: 'Material Icons';
  font-weight: normal;
  font-style: normal;
  font-size: 24px;
  line-height: 1;
  letter-spacing: normal;
  text-transform: none;
  display: inline-block;
  white-space: nowrap;
  word-wrap: normal;
  direction: ltr;
  -webkit-font-feature-settings: 'liga';
  font-feature-settings: 'liga';
  -webkit-font-smoothing: antialiased;
}

/* Container principal */
.container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
}

/* Header principal - Sticky completo con navegación secundaria integrada */
.header-main {
  background: linear-gradient(135deg, #722f37 0%, #600015 100%);
  color: #F5F5F5;
  padding: 0; /* Sin padding para control total */
  box-shadow: 0 4px 20px rgba(128, 0, 32, 0.4);
  position: sticky;
  top: 0;
  z-index: 1000;
  width: 100%;
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  padding: 15px 0; /* Padding solo en el contenido principal */
}

.logo-section {
  display: flex;
  align-items: center;
  gap: 15px;
  min-width: 250px;
  transition: all 0.3s ease;
}

.logo-section:hover {
  transform: scale(1.05);
}

.logo-image {
  height: 65px; /* Aumentado de 45px a 65px */
  width: auto;
  object-fit: contain;
  filter: brightness(1.15) drop-shadow(0 2px 8px rgba(197, 160, 89, 0.4));
  transition: all 0.3s ease;
}

.logo-image:hover {
  filter: brightness(1.25) drop-shadow(0 4px 12px rgba(197, 160, 89, 0.6));
}

.logo-text {
  font-family: Montserrat, sans-serif;
  font-size: 28px; /* Aumentado de 24px a 28px */
  font-weight: 800; /* Aumentado de 700 a 800 */
  letter-spacing: 2.5px;
  color: #C5A059;
  text-shadow: 2px 2px 6px rgba(0,0,0,0.4), 0 0 20px rgba(197, 160, 89, 0.3);
  transition: all 0.3s ease;
}

.logo-text:hover {
  color: #d4b066;
  text-shadow: 2px 2px 8px rgba(0,0,0,0.5), 0 0 25px rgba(197, 160, 89, 0.5);
}

.search-section {
  flex: 1;
  max-width: 600px;
  position: relative;
  z-index: 1000;
}

/* Los estilos del search-bar ya no son necesarios porque se usan los del GlobalSearchComponent */

.user-actions {
  display: flex;
  align-items: center;
  gap: 15px;
  min-width: 200px;
  justify-content: flex-end;
}

.action-btn {
  position: relative;
  background: rgba(245, 245, 245, 0.1);
  border: 2px solid rgba(197, 160, 89, 0.3);
  border-radius: 12px;
  padding: 12px;
  color: #F5F5F5;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn:hover {
  background: rgba(197, 160, 89, 0.2);
  border-color: #C5A059;
  transform: translateY(-2px);
}

.action-btn .material-icons {
  font-size: 24px;
}

/* Menú de usuario logueado */
.user-menu-container {
  position: relative;
}

.user-btn {
  background: rgba(197, 160, 89, 0.2);
  border-color: #C5A059;
}

/* Contenedor del menú de usuario */
.user-menu-container {
  position: relative;
}

.user-dropdown {
  position: absolute;
  top: calc(100% + 12px);
  right: 0;
  background: white;
  border-radius: 12px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  min-width: 280px;
  max-width: 320px;
  z-index: 10000;
  animation: slideDown 0.3s ease-out;
}

/* Flecha del dropdown apuntando al botón */
.user-dropdown::before {
  content: '';
  position: absolute;
  top: -8px;
  right: 20px;
  width: 16px;
  height: 16px;
  background: linear-gradient(135deg, #722f37 0%, #600015 100%);
  transform: rotate(45deg);
  border-radius: 2px 0 0 0;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.user-dropdown-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 1.25rem;
  background: linear-gradient(135deg, #722f37 0%, #600015 100%);
  border-radius: 12px 12px 0 0;
}

.user-avatar {
  width: 48px;
  height: 48px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-avatar .material-icons {
  font-size: 32px;
  color: white;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 1rem;
  font-weight: 600;
  color: white;
  margin: 0 0 4px 0;
  font-family: 'Montserrat', sans-serif;
}

.user-email {
  font-size: 0.85rem;
  color: rgba(255, 255, 255, 0.8);
  margin: 0;
}

.dropdown-divider {
  height: 1px;
  background: #e9ecef;
  margin: 0;
}

.dropdown-menu-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.dropdown-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 1.25rem;
  background: none;
  border: none;
  color: #2c3e50;
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
  text-align: left;
  font-family: 'Roboto', sans-serif;
}

.dropdown-item:hover {
  background: #f8f9fa;
}

.dropdown-item .material-icons {
  font-size: 20px;
  color: #722f37;
}

.logout-item {
  color: #e74c3c;
  border-radius: 0 0 12px 12px;
}

.logout-item:hover {
  background: #fee;
}

/* Admin Panel Link */
.admin-item {
  background: linear-gradient(135deg, rgba(114, 47, 55, 0.04) 0%, rgba(197, 160, 89, 0.04) 100%);
  border-bottom: 1px solid rgba(114, 47, 55, 0.08);
}

.admin-item .material-icons {
  color: #C5A059 !important;
}

.admin-item:hover {
  background: linear-gradient(135deg, rgba(114, 47, 55, 0.1) 0%, rgba(197, 160, 89, 0.08) 100%);
}

.logout-item .material-icons {
  color: #e74c3c;
}

.cart-count, .action-count {
  position: absolute;
  top: -8px;
  right: -8px;
  background: #C0392B;
  color: white;
  border-radius: 50%;
  min-width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 600;
}

/* ===== NAVEGACIÓN SECUNDARIA ===== */
/* Integrada completamente dentro del header sticky */
.secondary-nav {
  background: #000000;
  box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  padding: 0;
  margin: 0;
  width: 100%;
  border-top: 1px solid rgba(197, 160, 89, 0.2); /* Sutil separación dorada */
}

.nav-menu {
  display: flex;
  list-style: none;
  margin: 0;
  padding: 0;
  justify-content: center;
  gap: 40px;
}

.nav-item {
  position: relative;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 20px 0;
  color: #F5F5F5;
  text-decoration: none;
  font-family: Roboto, sans-serif;
  font-weight: 500;
  font-size: 15px;
  transition: all 0.3s ease;
  position: relative;
}

.nav-link:hover {
  color: #C5A059;
  transform: translateY(-2px);
}

.nav-link.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, #C5A059 0%, #D4AF6A 100%);
  border-radius: 3px 3px 0 0;
}

.nav-link .material-icons {
  font-size: 20px;
}

/* Responsive */
@media (max-width: 1024px) {
  .search-section {
    max-width: 400px;
  }
  
  .logo-text {
    font-size: 20px;
  }
  
  .nav-menu {
    gap: 20px;
  }
  
  .nav-link {
    font-size: 14px;
    gap: 6px;
  }
  
  .nav-link .material-icons {
    font-size: 18px;
  }
}

@media (max-width: 768px) {
  .header-content {
    gap: 15px;
    padding: 12px 0;
  }
  
  .search-section {
    display: none;
  }
  
  .logo-section {
    min-width: auto;
    gap: 10px;
  }
  
  .logo-image {
    height: 50px; /* Mantener buen tamaño en mobile */
  }
  
  .logo-text {
    font-size: 20px; /* Reducir un poco en mobile pero mantenerlo visible */
    letter-spacing: 1.5px;
  }
  
  .user-actions {
    gap: 10px;
    min-width: auto;
  }
  
  .action-btn {
    padding: 10px;
  }
  
  /* Ocultar navegación secundaria en móviles - se puede implementar un menú hamburguesa después */
  .secondary-nav {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  
  .nav-menu {
    gap: 15px;
    justify-content: flex-start;
    padding: 0 10px;
  }
  
  .nav-link {
    font-size: 13px;
    padding: 15px 0;
    white-space: nowrap;
  }
}

@media (max-width: 480px) {
  .header-content {
    padding: 10px 0;
  }
  
  .logo-image {
    height: 45px; /* Tamaño adecuado para pantallas muy pequeñas */
  }
  
  .logo-text {
    font-size: 18px;
    letter-spacing: 1px;
  }
  
  .action-count, .cart-count {
    font-size: 10px;
    min-width: 18px;
    height: 18px;
  }
  
  .nav-menu {
    gap: 10px;
  }
  
  .nav-link {
    font-size: 12px;
    padding: 12px 0;
  }
  
  .nav-link .material-icons {
    display: none; /* Ocultar iconos en móviles muy pequeños para ahorrar espacio */
  }
}

/* ===================================
   ANIMACIONES DE PRODUCTOS AL CARRITO
   =================================== */
.flying-products-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 9999;
}

.flying-product {
  position: absolute;
  width: 80px;
  height: 80px;
  pointer-events: none;
  animation: flyToCart 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

.flying-product img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  border-radius: 8px;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
  background: white;
  padding: 5px;
}

@keyframes flyToCart {
  0% {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
  50% {
    transform: scale(0.8) rotate(15deg);
    opacity: 0.9;
  }
  100% {
    transform: scale(0.2) rotate(360deg) translateX(calc(100vw - 150px)) translateY(-80px);
    opacity: 0;
  }
}

/* Animación de pulso para el contador del carrito */
.cart-count {
  animation: cartPulse 0.4s ease-in-out;
}

@keyframes cartPulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.3);
    background: #4caf50;
  }
}

/* Animación para el ícono del carrito cuando se agrega producto */
.cart-btn.adding {
  animation: cartShake 0.6s ease-in-out;
}

@keyframes cartShake {
  0%, 100% {
    transform: rotate(0deg);
  }
  25% {
    transform: rotate(-10deg) scale(1.1);
  }
  50% {
    transform: rotate(10deg) scale(1.15);
  }
  75% {
    transform: rotate(-10deg) scale(1.1);
  }
}

/* ===== DROPDOWN "MÁS" EN NAVEGACIÓN ===== */
.dropdown-nav {
  position: relative;
}

.dropdown-trigger {
  background: transparent;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 20px 0;
  color: #F5F5F5;
  font-family: 'Poppins', sans-serif;
  font-weight: 500;
  font-size: 15px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border-radius: 8px;
  position: relative;
}

.dropdown-trigger:hover {
  color: #C5A059;
  transform: translateY(-2px);
  background: rgba(197, 160, 89, 0.1);
  padding-left: 12px;
  padding-right: 12px;
}

.dropdown-trigger .material-icons:first-child {
  font-size: 22px;
}

.dropdown-arrow {
  font-size: 20px;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  margin-left: 4px;
}

.dropdown-arrow.open {
  transform: rotate(180deg);
  color: #C5A059;
}

.dropdown-menu-nav {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  min-width: 300px;
  background: #ffffff;
  border-radius: 16px;
  box-shadow: 
    0 4px 6px rgba(0, 0, 0, 0.07),
    0 8px 16px rgba(0, 0, 0, 0.1),
    0 16px 32px rgba(128, 0, 32, 0.15),
    0 0 0 1px rgba(128, 0, 32, 0.08);
  padding: 12px 0;
  margin-top: 0;
  z-index: 1000;
  animation: slideDownFadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
  backdrop-filter: blur(10px);
}

.dropdown-menu-nav::before {
  content: '';
  position: absolute;
  top: -8px;
  right: 24px;
  width: 0;
  height: 0;
  border-left: 10px solid transparent;
  border-right: 10px solid transparent;
  border-bottom: 10px solid white;
  filter: drop-shadow(0 -2px 3px rgba(0, 0, 0, 0.05));
}

@keyframes slideDownFadeIn {
  from {
    opacity: 0;
    transform: translateY(-16px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.dropdown-item-nav {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 24px;
  color: #2C3E50;
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  position: relative;
  overflow: hidden;
  border-left: 3px solid transparent;
}

.dropdown-item-nav::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 0;
  height: 100%;
  background: linear-gradient(90deg, rgba(197, 160, 89, 0.15) 0%, rgba(197, 160, 89, 0.05) 100%);
  transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 0;
}

.dropdown-item-nav span {
  position: relative;
  z-index: 1;
}

.dropdown-item-nav:hover {
  background: rgba(128, 0, 32, 0.03);
  color: #722f37;
  padding-left: 28px;
  border-left-color: #C5A059;
}

.dropdown-item-nav:hover::before {
  width: 100%;
}

.dropdown-item-nav .material-icons {
  font-size: 22px;
  color: #722f37;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  z-index: 1;
}

.dropdown-item-nav:hover .material-icons {
  transform: scale(1.15) translateX(3px);
  color: #C5A059;
}

.dropdown-item-nav:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 24px;
  right: 24px;
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, rgba(128, 0, 32, 0.1) 20%, rgba(128, 0, 32, 0.1) 80%, transparent 100%);
}

.dropdown-menu-nav .dropdown-divider {
  height: 2px;
  background: linear-gradient(90deg, transparent 0%, rgba(197, 160, 89, 0.3) 20%, rgba(197, 160, 89, 0.3) 80%, transparent 100%);
  margin: 8px 0;
  border: none;
}

/* Responsive Styles */
@media (max-width: 900px) {
  .nav-text {
    display: none;
  }
  
  .nav-link {
    padding: 16px 0;
  }
  
  .dropdown-trigger {
    padding: 16px 12px;
  }
  
  .dropdown-trigger:hover {
    padding: 16px 16px;
  }
  
  .dropdown-menu-nav {
    right: -10px;
    min-width: 280px;
  }
  
  .dropdown-menu-nav::before {
    right: 20px;
  }
}

@media (max-width: 768px) {
  .dropdown-menu-nav {
    min-width: 260px;
    right: -20px;
  }
  
  .dropdown-menu-nav::before {
    right: 30px;
  }
  
  .dropdown-item-nav {
    padding: 14px 20px;
    font-size: 13px;
    gap: 14px;
  }
  
  .dropdown-item-nav .material-icons {
    font-size: 20px;
  }
}

@media (max-width: 480px) {
  .dropdown-menu-nav {
    position: fixed;
    left: 10px;
    right: 10px;
    min-width: unset;
    max-width: calc(100vw - 20px);
    top: 140px;
  }
  
  .dropdown-menu-nav::before {
    display: none;
  }
  
  .dropdown-item-nav {
    padding: 16px 20px;
  }
}

/* ==============================
   MOBILE MENU STYLES
   ============================== */

/* Mobile Menu Button */
.mobile-menu-btn {
  display: none;
  background: rgba(197, 160, 89, 0.2);
  border: 2px solid rgba(197, 160, 89, 0.5);
  border-radius: 12px;
  padding: 10px;
  cursor: pointer;
  color: #F5F5F5;
  transition: all 0.3s ease;
}

.mobile-menu-btn:hover {
  background: rgba(197, 160, 89, 0.3);
  border-color: #C5A059;
  transform: scale(1.05);
}

.mobile-menu-btn .material-icons {
  font-size: 28px;
  display: block;
}

/* Mobile Overlay */
.mobile-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.7);
  z-index: 1000;
  backdrop-filter: blur(4px);
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* Mobile Nav Header */
.mobile-nav-header {
  display: none;
  padding: 20px;
  background: linear-gradient(135deg, #722f37 0%, #600015 100%);
  border-bottom: 2px solid rgba(197, 160, 89, 0.3);
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1002;
}

.mobile-logo-section {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
}

.mobile-logo-image {
  height: 40px;
  width: auto;
  object-fit: contain;
  filter: brightness(1.1);
}

.mobile-brand-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.mobile-logo-title {
  font-family: 'Montserrat', sans-serif;
  font-size: 14px;
  font-weight: 600;
  color: #F5F5F5;
  line-height: 1;
  letter-spacing: 0.5px;
}

.mobile-logo-subtitle {
  font-family: 'Montserrat', sans-serif;
  font-size: 18px;
  font-weight: 700;
  color: #C5A059;
  line-height: 1;
  letter-spacing: 2px;
  text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
}

.mobile-nav-header h3 {
  margin: 0;
  color: #C5A059;
  font-family: 'Montserrat', sans-serif;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 1px;
}

.close-mobile-menu {
  background: rgba(197, 160, 89, 0.2);
  border: 2px solid rgba(197, 160, 89, 0.5);
  border-radius: 50%;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #F5F5F5;
  transition: all 0.3s ease;
}

.close-mobile-menu:hover {
  background: rgba(197, 160, 89, 0.3);
  border-color: #C5A059;
  transform: rotate(90deg);
}

.close-mobile-menu .material-icons {
  font-size: 24px;
}

/* ==============================
   RESPONSIVE BREAKPOINTS
   ============================== */

/* Tablet and below */
@media (max-width: 1024px) {
  .container {
    padding: 0 15px;
  }

  .header-content {
    gap: 15px;
  }

  .logo-section {
    min-width: 150px;
  }

  .logo-image {
    height: 40px;
  }

  .logo-text {
    font-size: 20px;
  }

  .search-section {
    max-width: 400px;
  }

  .user-actions {
    gap: 10px;
    min-width: 150px;
  }

  .action-btn {
    padding: 10px;
  }

  .badge {
    min-width: 18px;
    height: 18px;
    font-size: 10px;
    top: -6px;
    right: -6px;
  }

  /* User dropdown adjustments for tablets */
  .user-dropdown {
    min-width: 270px;
    max-width: 300px;
    top: calc(100% + 10px);
  }

  .user-dropdown-header {
    padding: 1.125rem;
  }

  .user-avatar {
    width: 44px;
    height: 44px;
  }

  .user-avatar .material-icons {
    font-size: 30px;
  }

  .user-name {
    font-size: 0.975rem;
  }

  .user-email {
    font-size: 0.825rem;
  }

  .dropdown-item {
    padding: 11px 1.125rem;
    font-size: 0.925rem;
  }

  .dropdown-item .material-icons {
    font-size: 19px;
  }
}

/* Mobile Landscape and below */
@media (max-width: 768px) {
  /* Show mobile menu button */
  .mobile-menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Adjust header layout */
  .header-content {
    gap: 10px;
    padding: 12px 0;
  }

  .logo-section {
    flex: 1;
    min-width: auto;
    justify-content: center;
    order: 2;
  }

  .logo-text {
    font-size: 18px;
  }

  /* Hide search on mobile */
  .search-section {
    display: none;
  }

  /* Adjust user actions */
  .user-actions {
    order: 3;
    min-width: auto;
    gap: 8px;
  }

  .action-btn {
    padding: 8px;
    border-radius: 10px;
  }

  .action-btn .material-icons {
    font-size: 22px;
  }

  /* Mobile navigation */
  .secondary-nav {
    position: fixed;
    top: 0;
    left: -100%;
    width: 85%;
    max-width: 320px;
    height: 100vh;
    background: linear-gradient(180deg, #722f37 0%, #600015 100%);
    z-index: 1001;
    transition: left 0.3s ease-out;
    box-shadow: 4px 0 20px rgba(0, 0, 0, 0.3);
    overflow-y: auto;
  }

  .secondary-nav.mobile-open {
    left: 0;
  }

  /* Mostrar overlay cuando el menú está abierto */
  body.mobile-menu-open .mobile-overlay {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-nav-header {
    display: flex;
  }

  .nav-container {
    padding: 0 !important;
  }

  .nav-container.mobile-open {
    display: block;
  }

  .nav-menu {
    flex-direction: column;
    gap: 0;
    padding: 10px 0;
  }

  .nav-item {
    width: 100%;
    border-bottom: 1px solid rgba(197, 160, 89, 0.2);
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 18px 20px !important;
    justify-content: flex-start;
    border-radius: 0;
  }

  .nav-text {
    display: block !important;
    font-size: 16px;
  }

  .nav-link .material-icons {
    font-size: 24px;
  }

  .nav-link:hover {
    background: rgba(197, 160, 89, 0.15);
    padding: 18px 24px !important;
  }

  .nav-link.active {
    background: rgba(197, 160, 89, 0.25);
    border-left: 4px solid #C5A059;
  }

  /* Dropdown in mobile */
  .dropdown-nav {
    position: relative;
  }

  .dropdown-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 18px 20px !important;
    justify-content: space-between;
  }

  .dropdown-trigger .nav-text {
    flex: 1;
    text-align: left;
  }

  .dropdown-arrow {
    margin-left: auto;
  }

  .dropdown-menu-nav {
    position: static;
    width: 100%;
    margin: 0;
    border-radius: 0;
    background: rgba(0, 0, 0, 0.2);
    box-shadow: none;
    animation: none;
  }

  .dropdown-menu-nav::before {
    display: none;
  }

  .dropdown-item-nav {
    padding: 16px 20px 16px 60px;
    font-size: 15px;
    border-radius: 0;
  }

  .dropdown-item-nav:hover {
    background: rgba(197, 160, 89, 0.15);
    padding-left: 64px;
  }

  /* User dropdown mobile adjustments */
  .user-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    left: auto;
    bottom: auto;
    min-width: 260px;
    max-width: 280px;
    max-height: 80vh;
    overflow-y: auto;
  }

  .user-dropdown-header {
    padding: 1rem;
  }

  .user-avatar {
    width: 42px;
    height: 42px;
  }

  .user-avatar .material-icons {
    font-size: 28px;
  }

  .user-name {
    font-size: 0.95rem;
  }

  .user-email {
    font-size: 0.8rem;
  }

  .dropdown-item {
    padding: 10px 1rem;
    font-size: 0.9rem;
  }

  .dropdown-item .material-icons {
    font-size: 18px;
  }
}

/* Small Mobile */
@media (max-width: 480px) {
  .logo-image {
    height: 35px;
  }

  .logo-text {
    font-size: 16px;
    letter-spacing: 1px;
  }

  .action-btn {
    padding: 6px;
  }

  .action-btn .material-icons {
    font-size: 20px;
  }

  .badge {
    min-width: 16px;
    height: 16px;
    font-size: 9px;
  }

  .secondary-nav {
    width: 90%;
  }

  .user-dropdown {
    min-width: 240px;
    max-width: 260px;
    right: 0;
  }

  .user-dropdown-header {
    padding: 0.875rem;
  }

  .user-avatar {
    width: 38px;
    height: 38px;
  }

  .user-avatar .material-icons {
    font-size: 24px;
  }

  .user-name {
    font-size: 0.9rem;
  }

  .user-email {
    font-size: 0.75rem;
  }

  .dropdown-item {
    padding: 9px 0.875rem;
    font-size: 0.85rem;
  }

  .dropdown-item .material-icons {
    font-size: 17px;
  }
}

/* Very Small Devices */
@media (max-width: 360px) {
  .logo-text {
    font-size: 14px;
  }

  .nav-link {
    padding: 16px 15px !important;
  }

  .user-dropdown {
    min-width: 220px;
    max-width: 240px;
    right: -5px;
  }

  .user-dropdown-header {
    padding: 0.75rem;
  }

  .user-avatar {
    width: 36px;
    height: 36px;
  }

  .user-avatar .material-icons {
    font-size: 22px;
  }

  .user-name {
    font-size: 0.85rem;
  }

  .user-email {
    font-size: 0.7rem;
  }

  .dropdown-item {
    padding: 8px 0.75rem;
    font-size: 0.8rem;
    gap: 10px;
  }

  .dropdown-item .material-icons {
    font-size: 16px;
  }

  .dropdown-item-nav {
    padding: 14px 15px 14px 50px;
  }
}
