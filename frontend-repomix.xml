                <label class="form-label">
                  SKU (Código) <span class="required">*</span>
                  <span class="help-icon" [title]="fieldHelp.sku">
                    <span class="material-icons">help_outline</span>
                  </span>
                </label>
                <input
                  type="text"
                  class="form-input input-uppercase"
                  [(ngModel)]="productForm.sku"
                  name="sku"
                  placeholder="GUIT-STRAT-001"
                  [class.input-error]="formErrors.sku"
                  (blur)="validateSKU()"
                  (input)="validateSKU()"
                  maxlength="50"
                  required
                />
                <div class="input-help">{{ fieldHelp.sku }}</div>
                <div *ngIf="formErrors.sku" class="error-message">
                  <span class="material-icons">error</span>
                  {{ formErrors.sku }}
                </div>
              </div>

              <!-- Categoría -->
              <div class="form-group">
                <label class="form-label">
                  Categoría <span class="required">*</span>
                  <span class="help-icon" [title]="fieldHelp.categoryId">
                    <span class="material-icons">help_outline</span>
                  </span>
                </label>
                <select 
                  class="form-select" 
                  [(ngModel)]="productForm.categoryId" 
                  name="categoryId"
                  [class.input-error]="formErrors.categoryId"
                  required
                >
                  <option [value]="null">-- Seleccionar Categoría --</option>
                  <option *ngFor="let category of categories" [value]="category.id">
                    {{ category.name }}
                  </option>
                </select>
                <div class="input-help">{{ fieldHelp.categoryId }}</div>
                <div *ngIf="formErrors.categoryId" class="error-message">
                  <span class="material-icons">error</span>
                  {{ formErrors.categoryId }}
                </div>
              </div>

              <!-- Marca -->
              <div class="form-group">
                <label class="form-label">
                  Marca
                  <span class="help-icon" [title]="fieldHelp.brandId">
                    <span class="material-icons">help_outline</span>
                  </span>
                </label>
                <select class="form-select" [(ngModel)]="productForm.brandId" name="brandId">
                  <option [value]="null">-- Sin Marca --</option>
                  <option *ngFor="let brand of brands" [value]="brand.id">
                    {{ brand.name }}
                  </option>
                </select>
                <div class="input-help">{{ fieldHelp.brandId }}</div>
              </div>
            </div>

            <!-- Navegación Tab -->
            <div class="tab-navigation">
              <button type="button" class="btn btn-secondary" (click)="closeModal()">
                <span class="material-icons">close</span>
                Cancelar
              </button>
              <button type="button" class="btn btn-primary" (click)="setTab('pricing')">
                Siguiente: Precios
                <span class="material-icons">arrow_forward</span>
              </button>
            </div>
          </div>
        </div>

        <!-- ============================================
             TAB 2: PRECIOS E INVENTARIO
             ============================================ -->
        <div class="tab-content" *ngIf="currentTab === 'pricing'">
          <div class="form-section-tab">
            <div class="section-intro">
              <span class="material-icons intro-icon">attach_money</span>
              <div>
                <h3>Precios e Inventario</h3>
                <p>Configure los precios de venta y control de stock</p>
              </div>
            </div>

            <div class="form-grid">
              <!-- Precio Regular -->
              <div class="form-group">
                <label class="form-label">
                  Precio Regular <span class="required">*</span>
                  <span class="help-icon" [title]="fieldHelp.price">
                    <span class="material-icons">help_outline</span>
                  </span>
                </label>
                <div class="input-with-icon">
                  <span class="input-icon">$</span>
                  <input
                    type="number"
                    class="form-input input-with-left-icon"
                    [(ngModel)]="productForm.price"
                    name="price"
                    placeholder="5000.00"
                    min="0"
                    step="0.01"
                    [class.input-error]="formErrors.price"
                    (input)="onNumberInput($event, 'price')"
                    (blur)="validateDiscountPrice()"
                    required
                  />
                </div>
                <div class="input-help">{{ fieldHelp.price }}</div>
                <div *ngIf="formErrors.price" class="error-message">
                  <span class="material-icons">error</span>
                  {{ formErrors.price }}
                </div>
              </div>

              <!-- Precio con Descuento -->
              <div class="form-group">
                <label class="form-label">
                  Precio con Descuento
                  <span class="help-icon" [title]="fieldHelp.discountPrice">
                    <span class="material-icons">help_outline</span>
                  </span>
                </label>
                <div class="input-with-icon">
                  <span class="input-icon">$</span>
                  <input
                    type="number"
                    class="form-input input-with-left-icon"
                    [(ngModel)]="productForm.discountPrice"
                    name="discountPrice"
                    placeholder="4500.00"
                    min="0"
                    step="0.01"
                    [class.input-error]="formErrors.discountPrice"
                    (input)="onNumberInput($event, 'discountPrice')"
                    (blur)="validateDiscountPrice()"
                  />
                </div>
                <div class="input-help">{{ fieldHelp.discountPrice }}</div>
                <div *ngIf="formErrors.discountPrice" class="error-message">
                  <span class="material-icons">error</span>
                  {{ formErrors.discountPrice }}
                </div>
                <!-- Badge de descuento -->
                <div *ngIf="productForm.price && productForm.discountPrice && productForm.discountPrice < productForm.price" 
                     class="discount-badge">
                  <span class="material-icons">local_offer</span>
                  {{ ((1 - productForm.discountPrice / productForm.price) * 100).toFixed(0) }}% OFF
                </div>
              </div>

              <!-- Stock -->
              <div class="form-group">
                <label class="form-label">
                  Stock Disponible <span class="required">*</span>
                  <span class="help-icon" [title]="fieldHelp.stock">
                    <span class="material-icons">help_outline</span>
                  </span>
                </label>
                <div class="input-with-icon">
                  <span class="input-icon">
                    <span class="material-icons">inventory</span>
                  </span>
                  <input
                    type="number"
                    class="form-input input-with-left-icon"
                    [(ngModel)]="productForm.stock"
                    name="stock"
                    placeholder="10"
                    min="0"
                    [class.input-error]="formErrors.stock"
                    (input)="onNumberInput($event, 'stock')"
                    required
                  />
                </div>
                <div class="input-help">{{ fieldHelp.stock }}</div>
                <div *ngIf="formErrors.stock" class="error-message">
                  <span class="material-icons">error</span>
                  {{ formErrors.stock }}
                </div>
              </div>

              <!-- Estado -->
              <div class="form-group">
                <label class="form-label">Estado del Producto</label>
                <div class="toggle-switch-modern">
                  <input
                    type="checkbox"
                    id="activeToggle"
                    [(ngModel)]="productForm.active"
                    name="active"
                  />
                  <label for="activeToggle" class="toggle-label-modern">
                    <span class="toggle-slider-modern"></span>
                    <span class="toggle-text-modern">
                      <span class="material-icons">{{ productForm.active ? 'visibility' : 'visibility_off' }}</span>
                      {{ productForm.active ? 'Visible en tienda' : 'Oculto' }}
                    </span>
                  </label>
                </div>
              </div>

              <!-- Destacado -->
              <div class="form-group">
                <label class="form-label">Producto Destacado</label>
                <div class="toggle-switch-modern">
                  <input
                    type="checkbox"
                    id="featuredToggle"
                    [(ngModel)]="productForm.featured"
                    name="featured"
                  />
                  <label for="featuredToggle" class="toggle-label-modern">
                    <span class="toggle-slider-modern"></span>
                    <span class="toggle-text-modern">
                      <span class="material-icons">{{ productForm.featured ? 'star' : 'star_border' }}</span>
                      {{ productForm.featured ? 'Sí' : 'No' }}
                    </span>
                  </label>
                </div>
              </div>
            </div>

            <!-- Navegación Tab -->
            <div class="tab-navigation">
              <button type="button" class="btn btn-secondary" (click)="setTab('general')">
                <span class="material-icons">arrow_back</span>
                Anterior
              </button>
              <button type="button" class="btn btn-primary" (click)="setTab('media')">
                Siguiente: Multimedia
                <span class="material-icons">arrow_forward</span>
              </button>
            </div>
          </div>
        </div>

        <!-- ============================================
             TAB 3: MULTIMEDIA (IMÁGENES)
             ============================================ -->
        <div class="tab-content" *ngIf="currentTab === 'media'">
          <div class="form-section-tab">
            <div class="section-intro">
              <span class="material-icons intro-icon">image</span>
              <div>
                <h3>Multimedia del Producto</h3>
                <p>Sube la imagen principal del producto</p>
              </div>
            </div>

            <!-- Selector de Modo de Imagen -->
            <div class="image-mode-selector">
              <button 
                type="button"
                class="mode-btn"
                [class.active]="imageUploadMode === 'file'"
                (click)="setImageUploadMode('file')">
                <span class="material-icons">cloud_upload</span>
                <div class="mode-info">
                  <span class="mode-title">Subir desde mi dispositivo</span>
                  <span class="mode-desc">Selecciona un archivo JPG, PNG o WebP</span>
                </div>
              </button>

              <button 
                type="button"
                class="mode-btn"
                [class.active]="imageUploadMode === 'url'"
                (click)="setImageUploadMode('url')">
                <span class="material-icons">link</span>
                <div class="mode-info">
                  <span class="mode-title">Usar URL de imagen</span>
                  <span class="mode-desc">Pega la URL de una imagen externa</span>
                </div>
              </button>
            </div>

            <!-- Contenido según el modo -->
            <div class="image-upload-area">
              
              <!-- Modo: Archivo Local -->
              <div *ngIf="imageUploadMode === 'file'" class="upload-file-section">
                <div class="upload-zone" (click)="fileInput.click()">
                  <input
                    type="file"
                    #fileInput
                    accept="image/*"
                    (change)="onImageFileSelected($event)"
                    style="display: none"
                  />
                  <div class="upload-icon">
                    <span class="material-icons">add_photo_alternate</span>
                  </div>
                  <p class="upload-title">Haz clic para seleccionar una imagen</p>
                  <p class="upload-hint">o arrastra y suelta aquí</p>
                  <span class="upload-specs">Máximo 5MB - JPG, PNG, WebP</span>
                </div>

                <!-- Vista Previa Archivo Local -->
                <div *ngIf="imagePreview" class="image-preview-card">
                  <div class="preview-header">
                    <span class="material-icons">check_circle</span>
                    <span>Imagen seleccionada</span>
                  </div>
                  <div class="preview-image-container">
                    <img [src]="imagePreview" alt="Preview">
                    <button type="button" class="btn-remove-preview" (click)="clearImage()">
                      <span class="material-icons">close</span>
                    </button>
                  </div>
                  <div *ngIf="selectedImageFile" class="preview-info">
                    <span class="material-icons">description</span>
                    {{ selectedImageFile.name }} ({{ (selectedImageFile.size / 1024 / 1024).toFixed(2) }} MB)
                  </div>
                </div>
              </div>

              <!-- Modo: URL -->
              <div *ngIf="imageUploadMode === 'url'" class="upload-url-section">
                <div class="url-input-group">
                  <label class="form-label">
                    <span class="material-icons">link</span>
                    URL de la Imagen
                  </label>
                  <input
                    type="url"
                    class="form-input input-url"
                    [(ngModel)]="productForm.imageUrl"
                    name="imageUrl"
                    placeholder="https://ejemplo.com/imagen-producto.jpg"
                  />
                  <div class="input-help">
                    <span class="material-icons">info</span>
                    Asegúrate de que la URL sea accesible públicamente
                  </div>
                </div>

                <!-- Vista Previa URL -->
                <div *ngIf="productForm.imageUrl" class="image-preview-card">
                  <div class="preview-header">
                    <span class="material-icons">check_circle</span>
                    <span>Vista previa de la imagen</span>
                  </div>
                  <div class="preview-image-container">
                    <img [src]="productForm.imageUrl" alt="Preview" (error)="onImageError($event)">
                  </div>
                </div>
              </div>
            </div>

            <!-- Navegación Tab -->
            <div class="tab-navigation">
              <button type="button" class="btn btn-secondary" (click)="setTab('pricing')">
                <span class="material-icons">arrow_back</span>
                Anterior
              </button>
              <button type="button" class="btn btn-primary" (click)="setTab('details')">
                Siguiente: Especificaciones
                <span class="material-icons">arrow_forward</span>
              </button>
            </div>
          </div>
        </div>

        <!-- ============================================
             TAB 4: ESPECIFICACIONES Y DETALLES
             ============================================ -->
        <div class="tab-content" *ngIf="currentTab === 'details'">
          <div class="form-section-tab">
            <div class="section-intro">
              <span class="material-icons intro-icon">description</span>
              <div>
                <h3>Especificaciones y Detalles</h3>
                <p>Información técnica y descripción del producto</p>
              </div>
            </div>

            <div class="form-grid">
              <!-- Modelo -->
              <div class="form-group">
                <label class="form-label">
                  Modelo
                  <span class="help-icon" [title]="fieldHelp.model">
                    <span class="material-icons">help_outline</span>
                  </span>
                </label>
                <input
                  type="text"
                  class="form-input"
                  [(ngModel)]="productForm.model"
                  name="model"
                  placeholder="Stratocaster Professional II"
                  maxlength="100"
                />
                <div class="input-help">{{ fieldHelp.model }}</div>
              </div>

              <!-- Peso -->
              <div class="form-group">
                <label class="form-label">
                  Peso (kg)
                  <span class="help-icon" [title]="fieldHelp.weight">
                    <span class="material-icons">help_outline</span>
                  </span>
                </label>
                <div class="input-with-icon">
                  <input
                    type="number"
                    class="form-input input-with-right-icon"
                    [(ngModel)]="productForm.weight"
                    name="weight"
                    placeholder="3.5"
                    min="0"
                    step="0.1"
                    (input)="onNumberInput($event, 'weight')"
                  />
                  <span class="input-icon-right">kg</span>
                </div>
                <div class="input-help">{{ fieldHelp.weight }}</div>
              </div>
            </div>

            <!-- Editor de Descripción Rico -->
            <div class="description-section">
              <label class="form-label">
                <span class="material-icons">description</span>
                Descripción Detallada del Producto
                <span class="section-badge">Editor de Texto Enriquecido</span>
              </label>

              <div class="rich-text-editor-container">
                <!-- Barra de Herramientas -->
                <div class="editor-toolbar">
                  <div class="toolbar-group">
                    <button type="button" class="toolbar-btn" (click)="applyTextFormat('bold')" title="Negrita">
                      <span class="material-icons">format_bold</span>
                    </button>
                    <button type="button" class="toolbar-btn" (click)="applyTextFormat('italic')" title="Cursiva">
                      <span class="material-icons">format_italic</span>
                    </button>
                    <button type="button" class="toolbar-btn" (click)="applyTextFormat('underline')" title="Subrayado">
                      <span class="material-icons">format_underlined</span>
                    </button>
                  </div>

                  <div class="toolbar-separator"></div>

                  <div class="toolbar-group">
                    <button type="button" class="toolbar-btn" (click)="insertList('ul')" title="Lista con viñetas">
                      <span class="material-icons">format_list_bulleted</span>
                    </button>
                    <button type="button" class="toolbar-btn" (click)="insertList('ol')" title="Lista numerada">
                      <span class="material-icons">format_list_numbered</span>
                    </button>
                  </div>

                  <div class="toolbar-separator"></div>

                  <div class="toolbar-group">
                    <button type="button" class="toolbar-btn" (click)="applyTextFormat('formatBlock', '<h3>')" title="Título">
                      <span class="material-icons">title</span>
                    </button>
                    <button type="button" class="toolbar-btn" (click)="clearFormatting()" title="Limpiar formato">
                      <span class="material-icons">format_clear</span>
                    </button>
                  </div>
                </div>

                <!-- Área de Edición -->
                <div 
                  class="rich-text-editor"
                  contenteditable="true"
                  (input)="onDescriptionInput($event)"
                  placeholder="Escribe una descripción profesional y atractiva...

📋 Sugerencias:
• Características principales
• Especificaciones técnicas (materiales, dimensiones)
• Beneficios y ventajas
• Contenido incluido
• Garantía

💡 Usa el formato para resaltar información importante"
                ></div>

                <!-- Ayuda -->
                <div class="editor-help">
                  <span class="material-icons">info</span>
                  <span>Las descripciones detalladas con formato aumentan la confianza del cliente</span>
                </div>
              </div>
            </div>

            <!-- Navegación Tab -->
            <div class="tab-navigation">
              <button type="button" class="btn btn-secondary" (click)="setTab('media')">
                <span class="material-icons">arrow_back</span>
                Anterior
              </button>
              <button type="button" class="btn btn-primary" (click)="saveProduct()" [disabled]="loading">
                <span class="material-icons">{{ loading ? 'hourglass_empty' : 'save' }}</span>
                {{ loading ? 'Guardando...' : (showCreateModal ? 'Crear Producto' : 'Guardar Cambios') }}
              </button>
            </div>
          </div>
        </div>

      </form>
    </div>

  </div>
</div>
</file>

<file path="src/app/components/admin/admin-reviews/admin-reviews.component.html">
<div class="admin-reviews-container">
  <!-- Header -->
  <div class="page-header">
    <div class="header-content">
      <h1>Moderación de Reseñas</h1>
      <p class="subtitle">Gestiona y modera las reseñas de productos</p>
    </div>
    <div class="header-actions">
      <span class="pending-badge" *ngIf="statusFilter === ReviewStatus.PENDING && totalElements > 0">
        <i class="icon-bell"></i>
        {{ totalElements }} pendientes
      </span>
    </div>
  </div>

  <!-- Filters -->
  <div class="filters-section">
    <div class="filter-group">
      <label for="statusFilter">Estado:</label>
      <select id="statusFilter" [(ngModel)]="statusFilter" class="filter-select">
        <option value="ALL">Todos</option>
        <option [value]="ReviewStatus.PENDING">Pendientes</option>
        <option [value]="ReviewStatus.APPROVED">Aprobadas</option>
        <option [value]="ReviewStatus.REJECTED">Rechazadas</option>
      </select>
    </div>

    <div class="filter-group">
      <label for="ratingFilter">Calificación:</label>
      <select id="ratingFilter" [(ngModel)]="ratingFilter" class="filter-select">
        <option value="ALL">Todas</option>
        <option [value]="5">5 estrellas</option>
        <option [value]="4">4 estrellas</option>
        <option [value]="3">3 estrellas</option>
        <option [value]="2">2 estrellas</option>
        <option [value]="1">1 estrella</option>
      </select>
    </div>

    <button class="btn-filter" (click)="applyFilters()">Aplicar Filtros</button>
    <button class="btn-reset" (click)="resetFilters()">Limpiar</button>
  </div>

  <!-- Loading Spinner -->
  <div *ngIf="isLoading" class="loading-container">
    <div class="spinner"></div>
    <p>Cargando reseñas...</p>
  </div>

  <!-- Error Message -->
  <div *ngIf="error" class="error-message">
    <i class="icon-error"></i>
    {{ error }}
    <button class="btn-close-error" (click)="error = null">✕</button>
  </div>

  <!-- Reviews Table -->
  <div class="table-container" *ngIf="!isLoading && reviews.length > 0">
    <table class="reviews-table">
      <thead>
        <tr>
          <th>Producto</th>
          <th>Usuario</th>
          <th>Calificación</th>
          <th>Comentario</th>
          <th>Fecha</th>
          <th>Estado</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <tr *ngFor="let review of reviews">
          <td>
            <div class="product-info">
              <span class="product-name">{{ review.productName }}</span>
              <span class="product-id">ID: {{ review.productId }}</span>
            </div>
          </td>
          <td>
            <div class="user-info">
              <span class="user-name">{{ review.userName }}</span>
              <span class="user-id">ID: {{ review.userId }}</span>
            </div>
          </td>
          <td>
            <div class="rating">
              <span class="stars">{{ getRatingStars(review.rating) }}</span>
              <span class="rating-number">{{ review.rating }}/5</span>
            </div>
          </td>
          <td>
            <div class="comment-cell">
              <p class="comment-text">{{ truncateText(review.comment, 80) }}</p>
              <div class="review-meta">
                <span *ngIf="hasImages(review)" class="has-images">
                  <i class="icon-image"></i> {{ review.images?.length }} fotos
                </span>
                <span *ngIf="hasSellerResponse(review)" class="has-response">
                  <i class="icon-reply"></i> Con respuesta
                </span>
              </div>
            </div>
          </td>
          <td>
            <span class="date-text">{{ formatDate(review.createdAt) }}</span>
          </td>
          <td>
            <span class="status-badge" [ngClass]="getStatusClass(review.status)">
              {{ getStatusLabel(review.status) }}
            </span>
          </td>
          <td>
            <div class="action-buttons">
              <!-- View Details -->
              <button 
                class="btn-icon btn-view" 
                (click)="openDetailsModal(review)"
                title="Ver detalles">
                <i class="icon-eye"></i>
              </button>

              <!-- Approve (only for pending) -->
              <button 
                *ngIf="canModerate(review)"
                class="btn-icon btn-approve" 
                (click)="approveReview(review.id)"
                title="Aprobar">
                <i class="icon-check"></i>
              </button>

              <!-- Reject (only for pending) -->
              <button 
                *ngIf="canModerate(review)"
                class="btn-icon btn-reject" 
                (click)="openRejectModal(review)"
                title="Rechazar">
                <i class="icon-times"></i>
              </button>

              <!-- Seller Response (only for approved without response) -->
              <button 
                *ngIf="canAddResponse(review)"
                class="btn-icon btn-response" 
                (click)="openResponseModal(review)"
                title="Responder">
                <i class="icon-comment"></i>
              </button>

              <!-- Edit Response (only for approved with response) -->
              <button 
                *ngIf="canEditResponse(review)"
                class="btn-icon btn-edit-response" 
                (click)="openResponseModal(review)"
                title="Editar respuesta">
                <i class="icon-edit"></i>
              </button>

              <!-- Delete -->
              <button 
                class="btn-icon btn-delete" 
                (click)="deleteReview(review.id)"
                title="Eliminar">
                <i class="icon-trash"></i>
              </button>
            </div>
          </td>
        </tr>
      </tbody>
    </table>

    <!-- Pagination -->
    <div class="pagination" *ngIf="totalPages > 1">
      <button 
        class="btn-pagination" 
        (click)="previousPage()" 
        [disabled]="currentPage === 0">
        Anterior
      </button>
      <span class="page-info">
        Página {{ currentPage + 1 }} de {{ totalPages }} 
        ({{ totalElements }} reseñas)
      </span>
      <button 
        class="btn-pagination" 
        (click)="nextPage()" 
        [disabled]="currentPage >= totalPages - 1">
        Siguiente
      </button>
    </div>
  </div>

  <!-- Empty State -->
  <div class="empty-state" *ngIf="!isLoading && reviews.length === 0">
    <div class="empty-icon">📝</div>
    <h3>No hay reseñas para mostrar</h3>
    <p>No se encontraron reseñas con los filtros seleccionados.</p>
    <button class="btn-primary" (click)="resetFilters()">Limpiar Filtros</button>
  </div>
</div>

<!-- Details Modal -->
<div class="modal-overlay" *ngIf="showDetailsModal" (click)="closeDetailsModal()">
  <div class="modal-content details-modal" (click)="$event.stopPropagation()">
    <div class="modal-header">
      <h2>Detalles de la Reseña</h2>
      <button class="btn-close" (click)="closeDetailsModal()">✕</button>
    </div>

    <div class="modal-body" *ngIf="selectedReview">
      <!-- Product Info -->
      <div class="detail-section">
        <h3>Producto</h3>
        <p><strong>Nombre:</strong> {{ selectedReview.productName }}</p>
        <p><strong>ID:</strong> {{ selectedReview.productId }}</p>
      </div>

      <!-- User Info -->
      <div class="detail-section">
        <h3>Usuario</h3>
        <p><strong>Nombre:</strong> {{ selectedReview.userName }}</p>
        <p><strong>ID:</strong> {{ selectedReview.userId }}</p>
      </div>

      <!-- Review Info -->
      <div class="detail-section">
        <h3>Reseña</h3>
        <div class="rating-display">
          <span class="stars-large">{{ getRatingStars(selectedReview.rating) }}</span>
          <span class="rating-number">{{ selectedReview.rating }}/5</span>
        </div>
        <p class="comment-full">{{ selectedReview.comment }}</p>
        <p><strong>Fecha:</strong> {{ formatDate(selectedReview.createdAt) }}</p>
        <p>
          <strong>Estado:</strong> 
          <span class="status-badge" [ngClass]="getStatusClass(selectedReview.status)">
            {{ getStatusLabel(selectedReview.status) }}
          </span>
        </p>
      </div>

      <!-- Images -->
      <div class="detail-section" *ngIf="hasImages(selectedReview)">
        <h3>Imágenes ({{ selectedReview.images?.length }})</h3>
        <div class="images-grid">
          <img *ngFor="let image of selectedReview.images" 
               [src]="image" 
               alt="Review image" 
               class="review-image">
        </div>
      </div>

      <!-- Seller Response -->
      <div class="detail-section" *ngIf="hasSellerResponse(selectedReview)">
        <h3>Respuesta del Vendedor</h3>
        <div class="seller-response-display">
          <p>{{ selectedReview.sellerResponse }}</p>
          <small *ngIf="selectedReview.sellerResponseDate">
            {{ formatDate(selectedReview.sellerResponseDate) }}
          </small>
        </div>
      </div>

      <!-- Votes -->
      <div class="detail-section">
        <h3>Votos de Utilidad</h3>
        <div class="votes-display">
          <div class="vote-item">
            <span class="vote-icon helpful">👍</span>
            <span class="vote-count">{{ selectedReview.helpfulCount || 0 }} útiles</span>
          </div>
          <div class="vote-item">
            <span class="vote-icon not-helpful">👎</span>
            <span class="vote-count">{{ selectedReview.notHelpfulCount || 0 }} no útiles</span>
          </div>
        </div>
      </div>
    </div>

    <div class="modal-footer">
      <button class="btn-secondary" (click)="closeDetailsModal()">Cerrar</button>
    </div>
  </div>
</div>

<!-- Seller Response Modal -->
<div class="modal-overlay" *ngIf="showResponseModal" (click)="closeResponseModal()">
  <div class="modal-content response-modal" (click)="$event.stopPropagation()">
    <div class="modal-header">
      <h2>{{ hasSellerResponse(selectedReview!) ? 'Editar Respuesta' : 'Agregar Respuesta' }}</h2>
      <button class="btn-close" (click)="closeResponseModal()">✕</button>
    </div>

    <div class="modal-body" *ngIf="selectedReview">
      <!-- Original Review -->
      <div class="original-review">
        <h4>Reseña Original</h4>
        <div class="rating-display">
          <span class="stars">{{ getRatingStars(selectedReview.rating) }}</span>
        </div>
        <p class="comment-text">{{ selectedReview.comment }}</p>
        <small>Por {{ selectedReview.userName }} - {{ formatDate(selectedReview.createdAt) }}</small>
      </div>

      <!-- Response Form -->
      <div class="form-group">
        <label for="responseText">Tu Respuesta <span class="required">*</span></label>
        <textarea 
          id="responseText"
          [(ngModel)]="sellerResponse.response"
          class="form-control"
          rows="6"
          placeholder="Escribe una respuesta profesional y útil..."
          maxlength="1000">
        </textarea>
        <small class="char-count">
          {{ sellerResponse.response.length }}/1000 caracteres
        </small>
      </div>
    </div>

    <div class="modal-footer">
      <button class="btn-secondary" (click)="closeResponseModal()">Cancelar</button>
      <button 
        class="btn-primary" 
        (click)="saveSellerResponse()"
        [disabled]="isLoading || !sellerResponse.response.trim()">
        {{ isLoading ? 'Guardando...' : 'Guardar Respuesta' }}
      </button>
    </div>
  </div>
</div>

<!-- Reject Modal -->
<div class="modal-overlay" *ngIf="showRejectModal" (click)="closeRejectModal()">
  <div class="modal-content reject-modal" (click)="$event.stopPropagation()">
    <div class="modal-header">
      <h2>Rechazar Reseña</h2>
      <button class="btn-close" (click)="closeRejectModal()">✕</button>
    </div>

    <div class="modal-body" *ngIf="selectedReview">
      <div class="warning-box">
        <i class="icon-warning"></i>
        <p>Estás a punto de rechazar esta reseña. Por favor, proporciona un motivo claro.</p>
      </div>

      <div class="review-summary">
        <p><strong>Producto:</strong> {{ selectedReview.productName }}</p>
        <p><strong>Usuario:</strong> {{ selectedReview.userName }}</p>
        <p><strong>Calificación:</strong> {{ selectedReview.rating }}/5</p>
      </div>

      <div class="form-group">
        <label for="rejectReason">Motivo del Rechazo <span class="required">*</span></label>
        <textarea 
          id="rejectReason"
          [(ngModel)]="rejectReason"
          class="form-control"
          rows="4"
          placeholder="Explica por qué esta reseña no cumple con las políticas...">
        </textarea>
      </div>
    </div>

    <div class="modal-footer">
      <button class="btn-secondary" (click)="closeRejectModal()">Cancelar</button>
      <button 
        class="btn-danger" 
        (click)="rejectReview()"
        [disabled]="isLoading || !rejectReason.trim()">
        {{ isLoading ? 'Rechazando...' : 'Rechazar Reseña' }}
      </button>
    </div>
  </div>
</div>
