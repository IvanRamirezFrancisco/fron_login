        </p>
        
        <div class="redes-sociales">
          <h4 class="redes-titulo">Síguenos</h4>
          <div class="redes-iconos">
            <a href="javascript:void(0)" class="red-social" aria-label="Facebook">
              <span class="material-symbols-outlined">facebook</span>
            </a>
            <a href="javascript:void(0)" class="red-social" aria-label="Instagram">
              <span class="material-symbols-outlined">camera_alt</span>
            </a>
            <a href="javascript:void(0)" class="red-social" aria-label="YouTube">
              <span class="material-symbols-outlined">play_circle</span>
            </a>
            <a href="javascript:void(0)" class="red-social" aria-label="WhatsApp">
              <span class="material-symbols-outlined">chat</span>
            </a>
          </div>
        </div>
      </div>
      
      <!-- Columna 2: Enlaces Rápidos -->
      <div class="footer-columna enlaces-columna">
        <h3 class="footer-titulo">Enlaces Rápidos</h3>
        
        <div class="enlaces-grupos">
          <!-- Grupo: Tienda -->
          <div class="enlaces-grupo">
            <h4 class="grupo-titulo">Tienda</h4>
            <ul class="enlaces-lista">
              <li>
                <a routerLink="/catalogo" class="footer-enlace">
                  <span class="material-symbols-outlined">library_music</span>
                  <span>Catálogo Completo</span>
                </a>
              </li>

              <li>
                <a routerLink="/nuevos" class="footer-enlace">
                  <span class="material-symbols-outlined">new_releases</span>
                  <span>Nuevos Productos</span>
                </a>
              </li>
              <li>
                <a routerLink="/marcas" class="footer-enlace">
                  <span class="material-symbols-outlined">verified</span>
                  <span>Nuestras Marcas</span>
                </a>
              </li>
            </ul>
          </div>
          
          <!-- Grupo: Categorías -->
          <div class="enlaces-grupo">
            <h4 class="grupo-titulo">Categorías</h4>
            <ul class="enlaces-lista">
              <li>
                <a routerLink="/catalogo/guitarras" class="footer-enlace">
                  <span class="material-symbols-outlined">music_note</span>
                  <span>Guitarras</span>
                </a>
              </li>
              <li>
                <a routerLink="/catalogo/pianos" class="footer-enlace">
                  <span class="material-symbols-outlined">piano</span>
                  <span>Pianos y Teclados</span>
                </a>
              </li>
              <li>
                <a routerLink="/catalogo/baterias" class="footer-enlace">
                  <span class="material-symbols-outlined">drum_kit</span>
                  <span>Baterías</span>
                </a>
              </li>
              <li>
                <a routerLink="/catalogo/vientos" class="footer-enlace">
                  <span class="material-symbols-outlined">saxophone</span>
                  <span>Instrumentos de Viento</span>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
      
      <!-- Columna 3: Contacto y Soporte -->
      <div class="footer-columna contacto-columna">
        <h3 class="footer-titulo">Contacto</h3>
        
        <!-- Información de contacto -->
        <div class="contacto-info">
          <div class="contacto-item">
            <span class="material-symbols-outlined">location_on</span>
            <div class="contacto-detalles">
              <h4>Nuestra Tienda</h4>
              <p>Av. Música 123, Centro<br>Ciudad Musical, CP 12345</p>
            </div>
          </div>
          
          <div class="contacto-item">
            <span class="material-symbols-outlined">phone</span>
            <div class="contacto-detalles">
              <h4>Teléfono</h4>
              <p><a href="tel:+5255123456789" class="contacto-enlace">+52 55 1234-5678</a></p>
            </div>
          </div>
          
          <div class="contacto-item">
            <span class="material-symbols-outlined">email</span>
            <div class="contacto-detalles">
              <h4>Email</h4>
              <p><a href="mailto:info&#64;musicacastillo.com" class="contacto-enlace">info&#64;musicacastillo.com</a></p>
            </div>
          </div>
          
          <div class="contacto-item">
            <span class="material-symbols-outlined">schedule</span>
            <div class="contacto-detalles">
              <h4>Horarios</h4>
              <p>Lun - Sáb: 9:00 - 19:00<br>Domingo: 10:00 - 16:00</p>
            </div>
          </div>
        </div>
        
        <!-- Sección de soporte -->
        <div class="soporte-seccion">
          <h4 class="soporte-titulo">¿Necesitas Ayuda?</h4>
          <div class="soporte-botones">
            <a routerLink="/ayuda" class="boton-soporte">
              <span class="material-symbols-outlined">help</span>
              <span>Centro de Ayuda</span>
            </a>
            <a routerLink="/contacto" class="boton-soporte">
              <span class="material-symbols-outlined">support_agent</span>
              <span>Contactar Soporte</span>
            </a>
          </div>
        </div>
      </div>
      
    </div>
    
    <!-- Sección de newsletter -->
    <div class="newsletter-seccion">
      <div class="newsletter-contenido">
        <div class="newsletter-info">
          <h3 class="newsletter-titulo">Mantente al día</h3>
          <p class="newsletter-descripcion">
            Recibe noticias sobre nuevos productos, ofertas exclusivas y eventos musicales.
          </p>
        </div>
        <form class="newsletter-form" (ngSubmit)="suscribirNewsletter()" #newsletterForm="ngForm">
          <div class="newsletter-input-grupo">
            <span class="material-symbols-outlined">email</span>
            <input 
              type="email" 
              placeholder="tu-email&#64;ejemplo.com" 
              class="newsletter-input"
              [(ngModel)]="emailNewsletter"
              name="email"
              required
              #emailInput="ngModel"
            >
            <button 
              type="submit" 
              class="newsletter-boton"
              [disabled]="newsletterForm.invalid || enviandoNewsletter"
            >
              <span *ngIf="!enviandoNewsletter" class="material-symbols-outlined">send</span>
              <span *ngIf="enviandoNewsletter" class="material-symbols-outlined spinner">hourglass_empty</span>
              <span>{{ enviandoNewsletter ? 'Enviando...' : 'Suscribirse' }}</span>
            </button>
          </div>
          <div class="newsletter-mensaje" *ngIf="mensajeNewsletter" [class.exito]="newsletterExito">
            <span class="material-symbols-outlined">
              {{ newsletterExito ? 'check_circle' : 'error' }}
            </span>
            <span>{{ mensajeNewsletter }}</span>
          </div>
        </form>
      </div>
    </div>
    
    <!-- Línea divisoria -->
    <div class="footer-divisor"></div>
    
    <!-- Footer inferior -->
    <div class="footer-inferior">
      <div class="footer-legal">
        <p class="copyright">
          &copy; {{ anioActual }} Casa de Música Castillo. Todos los derechos reservados.
        </p>
        <div class="enlaces-legales">
          <a routerLink="/terminos" class="enlace-legal">Términos y Condiciones</a>
          <span class="separador">•</span>
          <a routerLink="/privacidad" class="enlace-legal">Política de Privacidad</a>
          <span class="separador">•</span>
          <a routerLink="/cookies" class="enlace-legal">Política de Cookies</a>
        </div>
      </div>
      
      <div class="footer-certificaciones">
        <div class="certificacion-item">
          <span class="material-symbols-outlined">verified</span>
          <span>Tienda Verificada</span>
        </div>
        <div class="certificacion-item">
          <span class="material-symbols-outlined">security</span>
          <span>Compra Segura</span>
        </div>
        <div class="certificacion-item">
          <span class="material-symbols-outlined">local_shipping</span>
          <span>Envío Garantizado</span>
        </div>
      </div>
    </div>
    
  </div>
</footer>
</file>

