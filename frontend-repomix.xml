<file path="src/app/components/home-header/home-header.component.css">
/* ========================================
   HOME HEADER - ESTILO PRINCIPAL
======================================== */

.home-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: rgba(62, 39, 35, 0.95);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.header-container {
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80px;
  gap: 1rem;
}

/* ========================================
   LOGO Y MARCA
======================================== */

.logo-section {
  flex-shrink: 0;
  min-width: 280px;
}

.logo-link {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  color: inherit;
  transition: transform 0.3s ease;
}

.logo-link:hover {
  transform: scale(1.02);
}

.logo-icon {
  width: 45px;
  height: 45px;
  background: linear-gradient(135deg, var(--color-acento), var(--color-accion));
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(218, 165, 32, 0.3);
  flex-shrink: 0;
}

.logo-icon .material-symbols-outlined {
  font-size: 26px;
  color: var(--color-blanco);
  font-weight: 600;
}

.logo-text {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
  min-width: 0;
}

.logo-title {
  font-family: var(--font-titulos);
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--color-blanco);
  margin: 0;
  letter-spacing: -0.3px;
  white-space: nowrap;
}

.logo-subtitle {
  font-size: 0.75rem;
  color: rgba(255, 255, 255, 0.8);
  margin: 0;
  font-weight: 400;
  white-space: nowrap;
}

/* ========================================
   NAVEGACIÓN PRINCIPAL
======================================== */

.main-nav {
  flex: 1;
  display: flex;
  justify-content: center;
  max-width: 600px;
}

.nav-list {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1rem;
  color: rgba(255, 255, 255, 0.9);
  text-decoration: none;
  font-family: var(--font-titulos);
  font-weight: 500;
  font-size: 0.95rem;
  border-radius: 8px;
  transition: all 0.3s ease;
  cursor: pointer;
}

/* Reset para <button> que actúa como nav-link */
button.nav-link--btn {
  background: none;
  border: none;
  outline: none;
  margin: 0;
  width: 100%;
  text-align: left;
}

.nav-link:hover {
  color: var(--color-blanco);
  background: rgba(255, 255, 255, 0.1);
  transform: translateY(-1px);
}

.catalog-link {
  background: var(--color-acento);
  /* color: var(--color-primario) !important; */
  font-weight: 600;
}

.catalog-link:hover {
  background: var(--color-accion);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(218, 165, 32, 0.3);
}

.catalog-link .material-symbols-outlined {
  font-size: 20px;
}

/* ========================================
   ACCIONES DEL USUARIO
======================================== */

.user-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
  min-width: 250px;
  justify-content: flex-end;
}

/* Botones de Autenticación */
.auth-buttons {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-login,
.btn-register {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.6rem 1.2rem;
  border: none;
  border-radius: 20px;
  font-family: var(--font-titulos);
  font-weight: 600;
  font-size: 0.85rem;
  cursor: pointer;
  transition: all 0.3s ease;
  text-decoration: none;
  white-space: nowrap;
}

.btn-login {
  /* background: transparent;
  color: var(--color-blanco); */
  border: 2px solid rgba(255, 255, 255, 0.3);
}

.btn-login:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.5);
  transform: translateY(-1px);
}

.btn-register {
  /* background: var(--color-acento); */
  /* color: var(--color-primario); */
  border: 2px solid rgba(255, 255, 255, 0.3);
  /* box-shadow: 0 2px 8px rgba(218, 165, 32, 0.3); */
}

.btn-register:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.5);
  transform: translateY(-1px);
  /* box-shadow: 0 4px 12px rgba(218, 165, 32, 0.4); */
}

.btn-login .material-symbols-outlined,
.btn-register .material-symbols-outlined {
  font-size: 20px;
}

/* ========================================
   SECCIÓN DE USUARIO AUTENTICADO
======================================== */

.user-section {
  display: flex;
  align-items: center;
  gap: 1rem;
  position: relative;
}

/* Botón del Carrito */
.cart-button {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1rem;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 20px;
  color: var(--color-blanco);
  cursor: pointer;
  transition: all 0.3s ease;
  font-family: var(--font-titulos);
  font-weight: 500;
}

.cart-button:hover {
  background: rgba(255, 255, 255, 0.2);
  transform: translateY(-1px);
}

.cart-button .material-symbols-outlined {
  font-size: 22px;
}

.cart-text {
  font-size: 0.9rem;
}

/* Información del Usuario */
.user-info {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.5rem 1rem;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 25px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.user-info:hover {
  background: rgba(255, 255, 255, 0.15);
  transform: translateY(-1px);
}

.user-avatar .material-symbols-outlined {
  font-size: 32px;
  color: var(--color-acento);
}

.user-details {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.welcome-text {
  font-size: 0.75rem;
  color: rgba(255, 255, 255, 0.8);
}

.user-name {
  font-weight: 600;
  font-size: 0.9rem;
  color: var(--color-blanco);
  max-width: 100px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chevron {
  color: rgba(255, 255, 255, 0.7);
  transition: transform 0.3s ease;
  font-size: 20px;
}

.user-info:hover .chevron {
  transform: rotate(180deg);
}

/* ========================================
   DROPDOWN DEL USUARIO
======================================== */

.user-dropdown {
  position: absolute;
  top: calc(100% + 15px);
  right: 0;
  background: #FFFFFF;
  border-radius: 20px;
  box-shadow: 
    0 20px 60px rgba(62, 39, 35, 0.25),
    0 8px 25px rgba(62, 39, 35, 0.15),
    0 0 0 1px rgba(62, 39, 35, 0.1);
  min-width: 320px;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-15px) scale(0.92);
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 1001;
  overflow: hidden;
  backdrop-filter: blur(20px);
  border: 2px solid rgba(62, 39, 35, 0.08);
}

.user-dropdown::before {
  content: '';
  position: absolute;
  top: -8px;
  right: 25px;
  width: 16px;
  height: 16px;
  background: #FFFFFF;
  border: 2px solid rgba(62, 39, 35, 0.08);
  border-bottom: none;
  border-right: none;
  transform: rotate(45deg);
  z-index: 1002;
}

.user-dropdown.visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
  animation: dropdownSlide 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.dropdown-header {
  padding: 2rem 1.75rem 1.5rem;
  background: linear-gradient(135deg, #3E2723 0%, #4A2C2A 50%, #5D4037 100%);
  position: relative;
  display: flex;
  align-items: center;
  gap: 1.25rem;
  overflow: hidden;
}

.dropdown-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(45deg, rgba(255, 207, 113, 0.1) 0%, rgba(199, 93, 44, 0.1) 100%);
  pointer-events: none;
}

.avatar-large {
  position: relative;
  z-index: 1;
  background: linear-gradient(135deg, #FFCF71, #DAA520);
  border-radius: 50%;
  padding: 0.75rem;
  box-shadow: 
    0 8px 25px rgba(255, 207, 113, 0.3),
    inset 0 2px 4px rgba(255, 255, 255, 0.2);
}

.avatar-large .material-symbols-outlined {
  font-size: 42px;
  color: #3E2723;
  font-weight: 600;
  display: block;
}

.user-info-detailed {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  position: relative;
  z-index: 1;
}

.full-name {
  font-weight: 700;
  color: #FFFFFF;
  font-size: 1.2rem;
  font-family: 'Montserrat', sans-serif;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  letter-spacing: -0.02em;
}

.email {
  font-size: 0.9rem;
  color: rgba(255, 207, 113, 0.9);
  font-weight: 500;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
}

/* Navegación del Dropdown */
.dropdown-nav {
  padding: 1rem 0 0.5rem;
  background: #FFFFFF;
}

.dropdown-link {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.2rem 1.75rem;
  color: #3E2723;
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 600;
  font-family: 'Montserrat', sans-serif;
  border: none;
  background: transparent;
  width: 100%;
  text-align: left;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  overflow: hidden;
}

.dropdown-link::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  background: linear-gradient(135deg, #C75D2C, #FFCF71);
  transform: scaleY(0);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  border-radius: 0 2px 2px 0;
}

.dropdown-link:hover {
  background: linear-gradient(135deg, rgba(255, 207, 113, 0.08), rgba(199, 93, 44, 0.05));
  color: #C75D2C;
  transform: translateX(8px);
  box-shadow: inset 0 0 0 1px rgba(199, 93, 44, 0.1);
}

.dropdown-link:hover::before {
  transform: scaleY(1);
}

.dropdown-link .material-symbols-outlined {
  font-size: 24px;
  color: #C75D2C;
  font-weight: 500;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.dropdown-link:hover .material-symbols-outlined {
  transform: scale(1.1);
  color: #3E2723;
}

.logout-link {
  color: #D32F2F !important;
  margin-top: 0.5rem;
  border-top: 2px solid rgba(62, 39, 35, 0.08);
  background: linear-gradient(135deg, rgba(211, 47, 47, 0.02), rgba(244, 67, 54, 0.02));
}

.logout-link .material-symbols-outlined {
  color: #D32F2F !important;
}

.logout-link::before {
  background: linear-gradient(135deg, #D32F2F, #F44336);
}

.logout-link:hover {
  background: linear-gradient(135deg, rgba(211, 47, 47, 0.1), rgba(244, 67, 54, 0.05)) !important;
  color: #B71C1C !important;
  box-shadow: inset 0 0 0 1px rgba(211, 47, 47, 0.15);
}

.logout-link:hover .material-symbols-outlined {
  color: #B71C1C !important;
}

.dropdown-divider {
  height: 2px;
  background: linear-gradient(90deg, transparent, rgba(62, 39, 35, 0.1), transparent);
  margin: 0.75rem 1.75rem;
  border-radius: 1px;
}

/* Animaciones mejoradas */
@keyframes dropdownSlide {
  0% {
    opacity: 0;
    transform: translateY(-20px) scale(0.9) rotateX(-10deg);
  }
  50% {
    opacity: 0.8;
    transform: translateY(-5px) scale(0.98) rotateX(-2deg);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1) rotateX(0deg);
  }
}

/* Estados de enfoque accesibilidad */
.dropdown-link:focus-visible {
  outline: 2px solid #C75D2C;
  outline-offset: -2px;
  background: linear-gradient(135deg, rgba(255, 207, 113, 0.12), rgba(199, 93, 44, 0.08));
}

/* Hover mejorado para el avatar */
.dropdown-header:hover .avatar-large {
  transform: scale(1.05) rotate(5deg);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

/* ========================================
   BOTÓN MÓVIL
======================================== */

.mobile-menu-toggle {
  display: none;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 8px;
  padding: 0.75rem;
  color: var(--color-blanco);
  cursor: pointer;
  transition: all 0.3s ease;
}

.mobile-menu-toggle:hover {
  background: rgba(255, 255, 255, 0.2);
}

.mobile-menu-toggle .material-symbols-outlined {
  font-size: 24px;
}

/* ========================================
   RESPONSIVE DESIGN
======================================== */

@media (max-width: 1200px) {
  .header-container {
    max-width: 100%;
    padding: 0 1.5rem;
  }

  .logo-section {
    min-width: 240px;
  }

  .nav-list {
    gap: 1.2rem;
  }

  .user-actions {
    min-width: 200px;
  }
}

@media (max-width: 1024px) {
  .header-container {
    padding: 0 1rem;
    gap: 1rem;
  }

  .logo-section {
    min-width: 220px;
  }

  .nav-list {
    gap: 1rem;
  }

  .nav-link {
    padding: 0.6rem 0.8rem;
    font-size: 0.9rem;
  }

  .user-actions {
    min-width: 180px;
  }

  .btn-login,
  .btn-register {
    padding: 0.55rem 1rem;
    font-size: 0.8rem;
  }
}

@media (max-width: 768px) {
  .header-container {
    padding: 0 1rem;
    gap: 0.5rem;
    min-height: 70px;
    max-width: 100%;
  }

  .logo-section {
    min-width: 160px;
    flex-shrink: 1;
  }

  .main-nav {
    display: none;
  }

  .mobile-menu-toggle {
    display: flex;
    order: 2;
    flex-shrink: 0;
  }

  .user-actions {
    order: 3;
    min-width: auto;
    max-width: 180px;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .logo-title {
    font-size: 1rem;
  }

  .logo-subtitle {
    font-size: 0.7rem;
  }

  .auth-buttons {
    gap: 0.3rem;
    flex-wrap: nowrap;
  }

  .btn-login,
  .btn-register {
    padding: 0.45rem 0.7rem;
    font-size: 0.75rem;
    gap: 0.25rem;
    white-space: nowrap;
  }

  .cart-text,
  .user-details {
    display: none;
  }

  .user-dropdown {
    right: -30px;
    min-width: 220px;
  }
}

@media (max-width: 480px) {
  .home-header {
    padding: 0 0.5rem;
  }

  .header-container {
    padding: 0;
    gap: 0.3rem;
    min-height: 65px;
    max-width: 100%;
    overflow: hidden;
  }

  .logo-section {
    min-width: 120px;
    flex-shrink: 1;
  }

  .logo-link {
    gap: 0.5rem;
  }

  .logo-icon {
    width: 35px;
    height: 35px;
  }

  .logo-icon .material-symbols-outlined {
    font-size: 20px;
  }

  .logo-title {
    font-size: 0.85rem;
  }

  .logo-subtitle {
    display: none;
  }

  .user-actions {
    min-width: auto;
    flex-shrink: 0;
    max-width: 140px;
  }

  .auth-buttons {
    flex-direction: row;
    gap: 0.25rem;
    flex-wrap: nowrap;
  }

  .btn-login,
  .btn-register {
    padding: 0.4rem 0.5rem;
    font-size: 0.7rem;
    min-width: auto;
    max-width: 65px;
    justify-content: center;
    border-radius: 15px;
  }

  .btn-login .material-symbols-outlined,
  .btn-register .material-symbols-outlined {
    font-size: 16px;
  }

  .btn-login span:not(.material-symbols-outlined),
  .btn-register span:not(.material-symbols-outlined) {
    display: none;
  }

  .mobile-menu-toggle {
    padding: 0.5rem;
    margin-left: 0.25rem;
  }

  .user-dropdown {
    right: -60px;
    min-width: 180px;
  }
}

/* ========================================
   ANIMACIONES Y EFECTOS
======================================== */

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20px) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.user-dropdown.visible {
  animation: slideDown 0.4s ease-out;
}

/* Efecto de scroll del header */
.home-header.scrolled {
  background: rgba(62, 39, 35, 0.98);
  backdrop-filter: blur(30px);
  border-bottom-color: rgba(255, 255, 255, 0.2);
}

/* Estados de hover mejorados */
.logo-link:hover .logo-icon {
  transform: rotate(5deg) scale(1.05);
}

.nav-link:hover {
