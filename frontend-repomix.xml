  flex-direction: column;
  gap: 0.75rem;
  margin-top: 1.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid #E8E2DC;
}

.link-btn {
  background: none;
  border: none;
  color: #722f37;
  font-size: 0.95rem;
  font-weight: 500;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.5rem;
  border-radius: 6px;
  transition: all 0.3s ease;
}

.link-btn:hover {
  background: rgba(128, 0, 32, 0.1);
}

.link-btn .material-icons {
  font-size: 20px;
}

.resend-section {
  margin-top: 1rem;
  text-align: center;
}

/* ============================================
   RESPONSIVE: Modal 2FA
   ============================================ */

/* Tablets y pantallas medianas (≤1036px) */
@media (max-width: 1036px) {
  .modal-2fa {
    width: 85%;
    max-height: 85vh;
  }
}

/* Tablets y móviles (≤768px) */
@media (max-width: 768px) {
  .modal-2fa {
    width: 90%;
    max-height: 85vh;
  }

  .modal-header {
    padding: 1.5rem 1.25rem;
  }

  .modal-header .header-icon {
    width: 60px;
    height: 60px;
  }

  .modal-header .header-icon .material-icons {
    font-size: 32px;
  }

  .modal-header h2 {
    font-size: 1.35rem;
  }

  .modal-header p {
    font-size: 0.9rem;
  }

  .modal-body {
    padding: 1.5rem 1.25rem;
  }

  .methods-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .method-card {
    padding: 1.25rem;
  }

  .method-header .material-icons {
    font-size: 28px;
  }

  .method-header h3 {
    font-size: 1.15rem;
  }

  .code-input {
    font-size: 1.25rem;
    padding: 0.875rem;
    letter-spacing: 0.4rem;
  }

  .btn-verify,
  .btn-send-code {
    padding: 0.875rem;
    font-size: 1rem;
  }
}

/* Móviles (≤480px) - Para 412x915, 375x667, etc */
@media (max-width: 480px) {
  .modal-2fa {
    width: 92%;
    max-height: 88vh;
    border-radius: 12px;
  }

  .modal-header {
    padding: 1.25rem 1rem;
  }

