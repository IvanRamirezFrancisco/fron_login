<file path="src/styles.css">
/* -- Importaciones externas (deben ser siempre las primeras) -- */
@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Roboto:wght@300;400;500;600;700&display=swap');

/* -- Tailwind CSS (used only by csv-import-export modal component) -- */
@tailwind base;
@tailwind components;
@tailwind utilities;

/* Estilos Globales - Casa de Mï¿½sica Castillo */
:root {
  /* Colores Principales */
  --primary-color: #722f37;    /* Vino Tinto/Bordï¿½ - Navegaciï¿½n, botones principales */
  --secondary-color: #C5A059;  /* Dorado Antiguo - Detalles, iconos activos */
  --dark-color: #1A1A1A;       /* Negro Noche - Texto principal, footer */
  --bg-color: #f5f0eb;         /* Crema cï¿½lida - Fondo general */
  --card-bg: #FDFCFB;          /* Hueso cï¿½lido - Tarjetas, contenedores */
  --card-alt: #FAF8F6;         /* Crema suave - Filas alternas, fondos secundarios */
  --card-hover: #f5f0eb;       /* Hover suave sobre filas/cards */
  --success-color: #27AE60;    /* Verde Bosque - Stock disponible */
  --error-color: #C0392B;      /* Rojo Ladrillo - Alertas, errores */
  --text-light: #ffffff;       /* Texto blanco para botones */
  
  /* Tipografï¿½a */
  --font-title: 'Montserrat', sans-serif;  /* Tï¿½tulos y nombres de instrumentos */
  --font-body: 'Roboto', sans-serif;       /* Cuerpo, tablas, formularios */
  
  /* Variaciones de colores para estados */
  --primary-hover: #66001a;    /* Vino mï¿½s oscuro para hover */
  --primary-light: #99002b;    /* Vino mï¿½s claro */
  --secondary-hover: #b8934f;  /* Dorado mï¿½s oscuro */
  --secondary-light: #d4b066;  /* Dorado mï¿½s claro */
  --text-main: #2D2A26;        /* Gris carbï¿½n cï¿½lido - Texto principal */
  --text-muted: #6B6560;       /* Gris cï¿½lido - Texto secundario */
  --border-color: #E8E2DC;     /* Beige medio - Bordes y separadores */
  
  /* Sombras profesionales */
  --shadow-light: rgba(128, 0, 32, 0.08);
  --shadow-medium: rgba(128, 0, 32, 0.15);
  --shadow-strong: rgba(128, 0, 32, 0.25);
  --card-shadow: 0 2px 8px rgba(26, 26, 26, 0.1);
  --card-shadow-hover: 0 8px 24px rgba(26, 26, 26, 0.15);
  
  /* Medidas y transiciones */
  --border-radius: 8px;
  --border-radius-lg: 12px;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  height: 100%;
  font-family: var(--font-body);
  background-color: var(--bg-color);
  color: var(--text-main);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-title);
  font-weight: 600;
  line-height: 1.3;
  color: var(--text-main);
  margin-bottom: 0.5em;
}

h1 { font-size: 2.5rem; font-weight: 700; }
h2 { font-size: 2rem; font-weight: 600; }
h3 { font-size: 1.5rem; font-weight: 500; }
h4 { font-size: 1.25rem; font-weight: 500; }
h5 { font-size: 1.125rem; font-weight: 500; }
h6 { font-size: 1rem; font-weight: 500; }

p {
  margin-bottom: 1rem;
  color: var(--text-main);
}

a {
  color: var(--primary-color);
  text-decoration: none;
  transition: var(--transition);
}

a:hover {
  color: var(--primary-hover);
  text-decoration: underline;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 24px;
  font-family: var(--font-body);
  font-size: 1rem;
  font-weight: 500;
  text-decoration: none;
  border: none;
  border-radius: var(--border-radius);
  cursor: pointer;
  transition: var(--transition);
  text-align: center;
  min-width: 120px;
  gap: 8px;
}

.btn-primary {
  background-color: var(--primary-color);
  color: var(--text-light);
  box-shadow: 0 2px 4px var(--shadow-light);
}

.btn-primary:hover {
  background-color: var(--primary-hover);
  transform: translateY(-2px);
  box-shadow: 0 4px 8px var(--shadow-medium);
}

.btn-action {
  background-color: var(--secondary-color);
  color: var(--dark-color);
  box-shadow: var(--card-shadow);
}

.btn-action:hover {
  background-color: var(--secondary-hover);
  color: var(--dark-color);
  transform: translateY(-2px);
  box-shadow: var(--card-shadow-hover);
}

.btn-secondary {
  background-color: var(--secondary-color);
  color: var(--dark-color);
  box-shadow: var(--card-shadow);
}

.btn-secondary:hover {
  background-color: var(--secondary-hover);
  color: var(--dark-color);
  transform: translateY(-2px);
  box-shadow: var(--card-shadow-hover);
}

.btn-success {
  background-color: var(--success-color);
  color: var(--text-light);
  box-shadow: var(--card-shadow);
}

.btn-success:hover {
  background-color: #219A52;
  transform: translateY(-2px);
  box-shadow: var(--card-shadow-hover);
}

.btn-danger {
  background-color: var(--error-color);
  color: var(--text-light);
  box-shadow: var(--card-shadow);
}

.btn-danger:hover {
  background-color: #A93226;
  transform: translateY(-2px);
  box-shadow: var(--card-shadow-hover);
}

.btn-outline {
  background-color: transparent;
  color: var(--primary-color);
  border: 2px solid var(--primary-color);
}

.btn-outline:hover {
  background-color: var(--primary-color);
  color: var(--text-light);
}

.card {
  background-color: var(--card-bg);
  border-radius: var(--border-radius-lg);
  box-shadow: var(--card-shadow);
  padding: 24px;
  transition: var(--transition);
  border: 1px solid var(--border-color);
}

.card:hover {
  box-shadow: var(--card-shadow-hover);
  transform: translateY(-4px);
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.text-center { text-align: center; }
.text-primary { color: var(--primary-color); }
.text-secondary { color: var(--secondary-color); }
.text-success { color: var(--success-color); }
.text-danger { color: var(--error-color); }
.text-muted { color: var(--text-muted); }
.text-dark { color: var(--dark-color); }

.d-flex { display: flex; }
.flex-column { flex-direction: column; }
.align-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }

.mb-0 { margin-bottom: 0; }
.mb-1 { margin-bottom: 8px; }
.mb-2 { margin-bottom: 16px; }
.mb-3 { margin-bottom: 24px; }
.mt-0 { margin-top: 0; }
.mt-1 { margin-top: 8px; }
.mt-2 { margin-top: 16px; }
.mt-3 { margin-top: 24px; }

@keyframes fadeIn {
  to { opacity: 1; }
}

.fade-in {
  opacity: 0;
  animation: fadeIn 0.6s ease-in-out forwards;
}

@media (max-width: 768px) {
  .container { padding: 0 15px; }
  h1 { font-size: 2rem; }
  h2 { font-size: 1.75rem; }
  h3 { font-size: 1.25rem; }
  .btn { padding: 10px 20px; font-size: 0.9rem; }
  .card { padding: 16px; }
}

@media (max-width: 576px) {
  h1 { font-size: 1.75rem; }
  h2 { font-size: 1.5rem; }
  .btn { width: 100%; margin-bottom: 8px; }
  .card { padding: 12px; }
}

/* ===== FORMULARIOS PROFESIONALES ===== */

/* Inputs y formularios con bordes suaves */
.form-control {
  width: 100%;
  padding: 12px 16px;
  font-size: 1rem;
  font-family: var(--font-body);
  border: 2px solid var(--border-color);
  border-radius: var(--border-radius);
  background-color: var(--card-bg);
  color: var(--text-main);
  transition: var(--transition);
}

.form-control:focus {
  border-color: var(--primary-color);
  outline: none;
  box-shadow: 0 0 0 3px rgba(128, 0, 32, 0.1);
  background-color: var(--card-bg);
}

.form-control.is-valid {
  border-color: var(--success-color);
  box-shadow: 0 0 0 3px rgba(39, 174, 96, 0.1);
  background-color: rgba(39, 174, 96, 0.05);
}

.form-control.is-invalid {
  border-color: var(--error-color);
  box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.1);
  background-color: rgba(192, 57, 43, 0.05);
}

/* Etiquetas de formularios */
.form-label {
  font-family: var(--font-title);
  font-weight: 500;
  color: var(--dark-color);
  margin-bottom: 6px;
  display: block;
  font-size: 0.9rem;
}

/* Retroalimentaciï¿½n de formularios */
.valid-feedback {
  display: block;
  color: var(--success-color);
  font-size: 0.875rem;
  margin-top: 6px;
  font-family: var(--font-body);
}

.invalid-feedback {
  display: block;
  color: var(--error-color);
  font-size: 0.875rem;
  margin-top: 6px;
  font-family: var(--font-body);
}

.form-text {
  color: var(--text-muted);
  font-size: 0.875rem;
  margin-top: 6px;
  font-family: var(--font-body);
}

/* ===== HEADER Y FOOTER ===== */

/* Header principal */
.header-main {
  background-color: var(--primary-color);
  color: var(--text-light);
  padding: 1rem 0;
  box-shadow: var(--card-shadow);
}

.navbar-brand {
  font-family: var(--font-title);
  font-weight: 700;
  font-size: 1.5rem;
  color: var(--text-light);
  text-decoration: none;
}

.nav-link {
  color: var(--text-light);
  font-family: var(--font-body);
  font-weight: 500;
  transition: var(--transition);
  padding: 0.5rem 1rem;
  border-radius: var(--border-radius);
}

.nav-link:hover {
  background-color: rgba(255, 255, 255, 0.1);
  color: var(--secondary-color);
}

.nav-link.active {
  background-color: var(--secondary-color);
  color: var(--dark-color);
}

/* Footer */
.footer-main {
  background-color: var(--dark-color);
  color: var(--text-light);
  padding: 3rem 0 1rem;
  margin-top: auto;
}

.footer-section h5 {
  color: var(--secondary-color);
  font-family: var(--font-title);
  font-weight: 600;
  margin-bottom: 1rem;
}

.footer-link {
  color: var(--text-light);
  text-decoration: none;
  font-family: var(--font-body);
  transition: var(--transition);
}

.footer-link:hover {
  color: var(--secondary-color);
  text-decoration: underline;
}

/* ===== INDICADORES DE STOCK ===== */

.badge-stock {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.25rem 0.75rem;
  border-radius: var(--border-radius);
  font-size: 0.75rem;
  font-weight: 500;
  font-family: var(--font-body);
}

.badge-disponible {
  background-color: rgba(39, 174, 96, 0.1);
  color: var(--success-color);
  border: 1px solid var(--success-color);
}

.badge-agotado {
  background-color: rgba(192, 57, 43, 0.1);
  color: var(--error-color);
  border: 1px solid var(--error-color);
}

.badge-bajo-stock {
  background-color: rgba(201, 165, 89, 0.1);
  color: var(--secondary-color);
  border: 1px solid var(--secondary-color);
}

/* ===== TARJETAS DE PRODUCTOS ===== */

.product-card {
  background: var(--card-bg);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  box-shadow: var(--card-shadow);
  transition: var(--transition);
  border: 1px solid var(--border-color);
}

.product-card:hover {
  box-shadow: var(--card-shadow-hover);
  transform: translateY(-4px);
}

.product-card.featured {
  border: 2px solid var(--secondary-color);
  box-shadow: 0 4px 16px rgba(197, 160, 89, 0.2);
}

.product-price {
  font-family: var(--font-title);
  font-weight: 700;
  font-size: 1.25rem;
  color: var(--success-color);
}

.product-name {
  font-family: var(--font-title);
  font-weight: 600;
  color: var(--dark-color);
  margin-bottom: 0.5rem;
}

.product-description {
  font-family: var(--font-body);
  color: var(--text-muted);
  font-size: 0.9rem;
  line-height: 1.4;
}

/* ===== ALERTAS ===== */

.alert {
  padding: 1rem;
  border-radius: var(--border-radius);
  font-family: var(--font-body);
  border: 1px solid transparent;
}

.alert-success {
  background-color: rgba(39, 174, 96, 0.1);
  color: var(--success-color);
  border-color: var(--success-color);
}

.alert-danger {
  background-color: rgba(192, 57, 43, 0.1);
  color: var(--error-color);
  border-color: var(--error-color);
}

.alert-warning {
  background-color: rgba(197, 160, 89, 0.1);
  color: var(--secondary-color);
  border-color: var(--secondary-color);
}

/* ===== UTILIDADES ADICIONALES ===== */


.text-gold { color: var(--secondary-color); }
.bg-primary { background-color: var(--primary-color); }
.bg-secondary { background-color: var(--secondary-color); }
.bg-dark { background-color: var(--dark-color); }
.bg-light { background-color: var(--bg-color); }

.border-gold { border-color: var(--secondary-color); }
.border-primary { border-color: var(--primary-color); }

/* Loading states */
.loading {
  opacity: 0.7;
  pointer-events: none;
  cursor: not-allowed;
}

.spinner {
  display: inline-block;
  width: 1rem;
  height: 1rem;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: var(--text-light);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ==================== GOOGLE MATERIAL ICONS ==================== */
.material-icons,
.material-symbols-outlined {
  font-family: 'Material Icons', 'Material Symbols Outlined';
  font-weight: normal;
  font-style: normal;
  font-size: 24px;
  display: inline-block;
  line-height: 1;
  text-transform: none;
  letter-spacing: normal;
  word-wrap: normal;
  white-space: nowrap;
  direction: ltr;
  vertical-align: middle;
}

/* Tamaï¿½os de iconos */
.material-icons.md-18,
.material-symbols-outlined.md-18 { font-size: 18px; }

.material-icons.md-20,
.material-symbols-outlined.md-20 { font-size: 20px; }

.material-icons.md-24,
.material-symbols-outlined.md-24 { font-size: 24px; }

.material-icons.md-36,
.material-symbols-outlined.md-36 { font-size: 36px; }

.material-icons.md-48,
.material-symbols-outlined.md-48 { font-size: 48px; }

/* Colores de iconos */
.material-icons.md-dark,
.material-symbols-outlined.md-dark { color: rgba(0, 0, 0, 0.54); }

.material-icons.md-light,
.material-symbols-outlined.md-light { color: rgba(255, 255, 255, 1); }

.material-icons.md-inactive,
.material-symbols-outlined.md-inactive { color: rgba(0, 0, 0, 0.26); }

/* Iconos dentro de botones */
button .material-icons,
button .material-symbols-outlined,
.btn .material-icons,
.btn .material-symbols-outlined {
  font-size: 20px;
  margin-right: 0.5rem;
  vertical-align: middle;
}

button .material-icons:last-child,
button .material-symbols-outlined:last-child,
.btn .material-icons:last-child,
.btn .material-symbols-outlined:last-child {
  margin-right: 0;
  margin-left: 0.5rem;
}

/* SVG a Material Icons en tablas */
.btn-action .material-icons,
.btn-icon .material-icons {
  font-size: 18px;
  margin: 0;
}

.stat-icon .material-icons {
  font-size: 32px;
}

.icon-wrapper .material-icons {
  font-size: 28px;
}

/* ==================== FIN MATERIAL ICONS ==================== */


/* --------------------------------------------------------------
   SWEETALERT2 ï¿½ Restaurar estilos pisados por Tailwind Preflight
   @tailwind base incluye button { background: transparent; color: inherit }
   que sobrescribe los colores de Swal. Estos overrides los restauran.
   -------------------------------------------------------------- */

/* Contenedor de acciones */
div.swal2-actions {
  display: flex !important;
  gap: 12px;
}

/* Botï¿½n confirmar */
button.swal2-confirm {
  color: #fff !important;
  border: 0 !important;
  border-radius: 0.25em !important;
  padding: 0.625em 1.1em !important;
  font-size: 1em !important;
  font-weight: 500 !important;
  cursor: pointer !important;
  /* El color de fondo es inyectado inline por Swal vï¿½a confirmButtonColor,
     pero si no hay color inline lo ponemos como fallback */
  background-color: #3085d6 !important;
}

/* Cuando Swal inyecta el color inline (confirmButtonColor), no pisarlo */
button.swal2-confirm[style*="background"] {
  /* Deja que el inline style gane ï¿½ solo aseguramos text-color y cursor */
  color: #fff !important;
  cursor: pointer !important;
}

/* Botï¿½n cancelar */
button.swal2-cancel {
  color: #fff !important;
  border: 0 !important;
  border-radius: 0.25em !important;
  padding: 0.625em 1.1em !important;
  font-size: 1em !important;
  font-weight: 500 !important;
  cursor: pointer !important;
  background-color: #6c757d !important;
}

button.swal2-cancel[style*="background"] {
  color: #fff !important;
  cursor: pointer !important;
}

/* Botï¿½n "deny" (por si se usa) */
button.swal2-deny {
  color: #fff !important;
  cursor: pointer !important;
}

/* Hover genï¿½rico para todos los botones Swal */
button.swal2-confirm:hover,
button.swal2-cancel:hover,
button.swal2-deny:hover {
  filter: brightness(0.9);
}

/* Popup base ï¿½ asegurar que no herede colores extraï¿½os */
div.swal2-popup {
  font-family: var(--font-body, 'Roboto', sans-serif);
}

/* -- Bloquear scroll del fondo cuando un modal estï¿½ abierto --
   Se activa automï¿½ticamente cuando .brand-modal-overlay existe en el DOM,
   sin necesitar ningï¿½n cï¿½digo JS manual (add/remove class).
   :has() tiene soporte en todos los navegadores modernos (Chrome 105+, Firefox 121+, Safari 15.4+).
   La clase .modal-open se mantiene como fallback para navegadores antiguos. -- */
body:has(.brand-modal-overlay),
body.modal-open {
  overflow: hidden;
}

/* -- Paleta cï¿½lida: override de clases Tailwind bg-white / bg-slate / bg-gray --
   Sustituye los fondos frï¿½os blancos/grises por la crema cï¿½lida de la marca.
   !important asegura prioridad sobre las utilidades de Tailwind generadas. -- */
.bg-white         { background-color: #FDFCFB !important; }
.bg-slate-50      { background-color: #f5f0eb !important; }
.bg-slate-100     { background-color: #FAF8F6 !important; }
.bg-gray-50       { background-color: #f5f0eb !important; }
.bg-gray-100      { background-color: #FAF8F6 !important; }
.bg-stone-50      { background-color: #FAF8F6 !important; }
.bg-stone-100     { background-color: #f0ece6 !important; }

/* -- Override global de fondos blancos heredados de componentes legacy --
   Convierte cualquier uso de colores frï¿½os neutros a la paleta cï¿½lida. -- */
.search-bar,
.search-box       { background-color: #FDFCFB !important; }

/* Fase 6: Solución global de z-index para alertas sobre modales */
.toast-container,
.toast-top-right,
.app-toast-container,

.swal2-container,
.toast-container,
.toast-top-right,
.ngx-toastr,
.cdk-overlay-container,
.app-toast-container,
.notification-container,
.custom-toast-container,
.pm-toast-wrapper {
  z-index: 50000 !important;
}
