/* ===== ACCESIBILIDAD ===== */
@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Focus States para Accesibilidad */
.btn:focus,
input:focus,
.app-link:focus {
  outline: 2px solid var(--highlight-mamey);
  outline-offset: 2px;
}

/* ===== ESTILOS PARA NUEVAS TARJETAS ESTÁTICAS ===== */

/* Notification Preferences Card */
.preference-list,
.privacy-options {
  margin: 1.5rem 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.preference-item,
.privacy-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem;
  background: var(--neutral-medium);
  border-radius: var(--border-radius);
  border: 1px solid rgba(62, 39, 35, 0.08);
}

.preference-info,
.privacy-info {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-grow: 1;
}

.preference-info .material-symbols-outlined,
.privacy-info .material-symbols-outlined {
  color: var(--secondary-naranja);
  font-size: 1.5rem;
}

.preference-info div strong,
.privacy-info div strong {
  color: var(--text-primary);
  font-family: var(--font-heading);
  font-weight: 600;
  display: block;
  margin-bottom: 0.25rem;
}

.preference-info div p,
.privacy-info div p {
  color: var(--text-secondary);
  font-size: 0.875rem;
  margin: 0;
}

.toggle-switch {
  display: flex;
  align-items: center;
  padding: 0.375rem 0.75rem;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.025em;
}

.toggle-switch.enabled {
  background: var(--success);
  color: white;
}

.toggle-switch.disabled {
  background: var(--text-secondary);
  color: white;
}

/* Session History Card */
.session-list {
  margin: 1.5rem 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.session-item {
  padding: 1rem;
  background: var(--white);
  border-radius: var(--border-radius);
  border: 1px solid rgba(62, 39, 35, 0.08);
  transition: var(--transition);
}

.session-item.current {
  border-color: var(--success);
  background: rgba(34, 197, 94, 0.02);
}

.session-item:hover {
  box-shadow: var(--shadow-soft);
}

.session-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.session-device {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-grow: 1;
}

.session-device .material-symbols-outlined {
  color: var(--secondary-naranja);
  font-size: 1.5rem;
}

.session-device strong {
  color: var(--text-primary);
  font-family: var(--font-heading);
  font-weight: 600;
  display: block;
  margin-bottom: 0.25rem;
}

.session-device p {
  color: var(--text-secondary);
  font-size: 0.875rem;
  margin: 0;
}

.session-time {
  text-align: right;
}

.status {
  display: inline-block;
  padding: 0.25rem 0.5rem;
  border-radius: 12px;
  font-size: 0.75rem;
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.status.active {
  background: var(--success);
  color: white;
}

.status.recent {
  background: var(--warning);
  color: white;
}

.status.old {
  background: var(--text-secondary);
  color: white;
}

.session-time p {
  color: var(--text-secondary);
  font-size: 0.875rem;
  margin: 0;
}

/* Contact Information Card */
.contact-grid {
  display: grid;
  gap: 1.5rem;
  margin: 1.5rem 0;
}

.contact-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  padding: 1rem;
  background: var(--neutral-medium);
  border-radius: var(--border-radius);
  border: 1px solid rgba(62, 39, 35, 0.08);
}

.contact-item .material-symbols-outlined {
  color: var(--secondary-naranja);
  font-size: 1.5rem;
  margin-top: 0.25rem;
}

.contact-item div {
  flex-grow: 1;
}

.contact-item label {
  color: var(--text-secondary);
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.025em;
  font-weight: 600;
  display: block;
  margin-bottom: 0.5rem;
}

.contact-item p {
  color: var(--text-primary);
  margin: 0 0 0.5rem 0;
  line-height: 1.4;
}

.contact-item .status {
  font-size: 0.75rem;
  padding: 0.25rem 0.5rem;
}

.status.verified {
  background: var(--success);
  color: white;
}

.status.pending {
  background: var(--warning);
  color: white;
}

.contact-actions {
  display: flex;
  gap: 0.75rem;
  margin-top: 1.5rem;
  flex-wrap: wrap;
}

/* ===== RESPONSIVE MEJORAS ===== */
@media (max-width: 768px) {
  .preference-item,
  .privacy-item {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  
  .session-info {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  
  .session-time {
    text-align: left;
  }
  
  .contact-actions {
    flex-direction: column;
  }
  
  .contact-actions .btn {
    width: 100%;
  }
}

/* ===== MODALES PREMIUM ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(62, 39, 35, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  backdrop-filter: blur(12px);
  padding: 1rem;
  animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes fadeIn {
  from { 
    opacity: 0; 
    backdrop-filter: blur(0px); 
  }
  to { 
    opacity: 1; 
    backdrop-filter: blur(12px); 
  }
}

.modal-container {
  background: var(--white);
  border-radius: var(--border-radius-large);
  box-shadow: var(--shadow-strong);
  max-width: 650px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  position: relative;
  border: 1px solid rgba(62, 39, 35, 0.1);
  animation: modalSlideIn 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes modalSlideIn {
  from { 
    opacity: 0; 
    transform: translateY(-40px) scale(0.9); 
    filter: blur(4px);
  }
  to { 
    opacity: 1; 
    transform: translateY(0) scale(1); 
    filter: blur(0px);
  }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 2rem;
  border-bottom: 1px solid rgba(62, 39, 35, 0.1);
  background: var(--gradient-primary);
  color: var(--white);
  border-radius: var(--border-radius-large) var(--border-radius-large) 0 0;
  position: relative;
  overflow: hidden;
}

.modal-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 20% 50%, rgba(255, 207, 113, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 80% 50%, rgba(199, 93, 44, 0.1) 0%, transparent 50%);
  pointer-events: none;
}

.modal-header h2 {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 600;
  margin: 0;
}

.modal-header .material-symbols-outlined {
  font-size: 24px;
  color: var(--highlight-mamey);
}

.modal-close {
  background: none;
  border: none;
  color: var(--white);
  cursor: pointer;
  padding: 0.5rem;
  border-radius: 50%;
  transition: var(--transition);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close:hover {
  background: rgba(255, 255, 255, 0.1);
}

.modal-close .material-symbols-outlined {
  font-size: 20px;
}

.modal-body {
  padding: 1.5rem;
}

.modal-footer {
  display: flex;
  gap: 1rem;
  justify-content: flex-end;
  padding: 1.5rem;
  border-top: 1px solid rgba(62, 39, 35, 0.1);
  background: var(--neutral-medium);
}

/* ===== MODAL DE CÓDIGOS GENERADOS ===== */
.security-warning {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  background: rgba(220, 53, 69, 0.1);
  border-radius: var(--border-radius);
  padding: 1.25rem;
  margin-bottom: 1.5rem;
  border-left: 4px solid var(--error);
}

.error-icon {
  flex-shrink: 0;
  font-size: 24px;
  color: var(--error);
  margin-top: 0.125rem;
}

.warning-text h3 {
  font-family: var(--font-heading);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--error);
  margin: 0 0 0.5rem 0;
}

.warning-text p {
  font-size: 0.95rem;
  color: var(--text-primary);
  margin: 0;
  line-height: 1.4;
}

.backup-codes-list {
  margin: 1.5rem 0;
}

.codes-grid-modal {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}

.code-item-modal {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  background: var(--neutral-medium);
  border: 2px solid rgba(62, 39, 35, 0.1);
  border-radius: var(--border-radius);
  padding: 1rem;
  transition: var(--transition);
}

.code-item-modal:hover {
  border-color: var(--secondary-naranja);
  background: rgba(199, 93, 44, 0.05);
}

.code-number {
  font-family: var(--font-heading);
  font-weight: 600;
  color: var(--text-secondary);
  font-size: 0.9rem;
  min-width: 20px;
}

.backup-code-modal {
  font-family: 'Courier New', monospace;
  font-weight: 700;
  font-size: 1rem;
  color: var(--text-primary);
  letter-spacing: 0.1em;
  background: var(--white);
  padding: 0.5rem;
  border-radius: 4px;
  border: 1px solid rgba(62, 39, 35, 0.1);
  flex-grow: 1;
}

.backup-instructions {
  background: var(--neutral-light);
  border-radius: var(--border-radius);
  padding: 1.25rem;
  border: 1px solid rgba(62, 39, 35, 0.1);
}

.backup-instructions h4 {
  font-family: var(--font-heading);
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0 0 0.75rem 0;
}

.backup-instructions ul {
  margin: 0;
  padding-left: 1.25rem;
  list-style-type: none;
}

.backup-instructions li {
  position: relative;
  padding-left: 1.5rem;
  margin-bottom: 0.5rem;
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.4;
}

.backup-instructions li:before {
  content: '•';
  color: var(--secondary-naranja);
  font-weight: bold;
  position: absolute;
  left: 0;
}

.backup-instructions li:last-child {
  margin-bottom: 0;
}

/* ===== MODAL DE ADVERTENCIA ===== */
.warning-modal {
  max-width: 480px;
}

.warning-content {
  text-align: center;
  padding: 1rem 0;
}

.warning-main {
  font-family: var(--font-heading);
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--error);
  margin: 0 0 1rem 0;
  line-height: 1.4;
}

.warning-secondary {
  font-size: 0.95rem;
  color: var(--text-primary);
  margin: 0 0 1.5rem 0;
  line-height: 1.4;
}

.warning-question {
  font-family: var(--font-heading);
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0;
}

/* ===== RESPONSIVE PARA MODALES ===== */
@media (max-width: 768px) {
  .modal-overlay {
    padding: 0.5rem;
  }
  
  .modal-container {
    max-height: 95vh;
  }
  
  .modal-header,
  .modal-body,
  .modal-footer {
    padding: 1rem;
  }
  
  .modal-header h2 {
    font-size: 1.1rem;
  }
  
  .codes-grid-modal {
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }
  
  .code-item-modal {
    padding: 0.75rem;
  }
  
  .backup-code-modal {
    font-size: 0.9rem;
  }
  
  .modal-footer {
    flex-direction: column-reverse;
  }
  
  .modal-footer .btn {
    width: 100%;
  }
  
  .security-warning {
    padding: 1rem;
    flex-direction: column;
    text-align: center;
    gap: 0.75rem;
  }
}

@media (max-width: 480px) {
  .modal-overlay {
    padding: 0.25rem;
  }
  
  .modal-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  
  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }
  
  .backup-instructions {
    padding: 1rem;
  }
  
  .code-number {
    min-width: 16px;
    font-size: 0.8rem;
  }
  
  .backup-code-modal {
    font-size: 0.85rem;
    padding: 0.375rem;
  }
}

/* ===== DARK MODE COMPATIBILITY ===== */
@media (prefers-color-scheme: dark) {
  :root {
    --neutral-light: #1a1a1a;
    --neutral-medium: #2a2a2a;
    --white: #ffffff;
    --text-primary: #ffffff;
    --text-secondary: #cccccc;
  }
}

/* =============================== */
/*      APPLE-LIKE BACKUP CODES    */
/* =============================== */

.codes-grid-apple {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  padding: 20px;
}

.code-item-apple {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 18px 20px;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(15px);
  border-radius: 20px;
  border: 1px solid rgba(230, 230, 230, 0.6);
  box-shadow: 0 6px 15px rgba(0,0,0,0.05);
}

.code-circle {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: #f2f2f7;
  display: flex;
  justify-content: center;
  align-items: center;
  font-weight: 600;
  font-size: 18px;
  color: #333;
}

.code-box {
  font-family: "SF Mono", monospace;
  font-size: 20px;
  font-weight: 500;
  padding: 8px 14px;
  background: #f8f8fa;
  border-radius: 14px;
  border: 1px solid #e2e2e7;
  color: #111;
  letter-spacing: 1px;
}

/* Modal estilo Apple */
.backup-codes-modal {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(25px);
  border-radius: 28px !important;
  padding: 30px !important;
  box-shadow: 0 10px 40px rgba(0,0,0,0.15);
}

.modal-header h2 {
  font-weight: 600;
  font-size: 26px;
  color: #111;
}

.modal-body {
  padding: 10px 0;
}

/* ===== ANIMACIÓN SPINNING PARA LOADING ===== */
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.spinning {
  animation: spin 1s linear infinite;
}

/* ===== ESTILOS PARA QR ERROR ===== */
.qr-error {
  text-align: center;
  padding: 1.5rem;
  background: #fff3cd;
  border-radius: var(--border-radius);
  border: 1px solid #ffc107;
  margin: 1rem 0;
}

.qr-error .material-symbols-outlined {
  font-size: 2.5rem;
  color: #856404;
  margin-bottom: 0.5rem;
}

.qr-error p {
  margin: 0.5rem 0;
  color: #856404;
  font-weight: 500;
}

.qr-error .btn {
  margin-top: 0.75rem;
}
