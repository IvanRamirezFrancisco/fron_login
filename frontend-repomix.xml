/* ── Header actions ──────────────────────────────────────────────────────── */
.slq-header-actions {
  display: flex;
  align-items: center;
  gap: .5rem;
}
.slq-config-btn {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  padding: .45rem .85rem;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: #fff;
  font-size: .78rem;
  font-weight: 500;
  color: #6b7280;
  cursor: pointer;
  transition: all .15s;
  font-family: 'Poppins', sans-serif;
}
.slq-config-btn .material-icons { font-size: 1rem; }
.slq-config-btn:hover {
  border-color: #722f37;
  color: #722f37;
  background: rgba(114, 47, 55, .04);
}

/* ── Config panel ────────────────────────────────────────────────────────── */
.slq-config-panel {
  background: #FDFCFB;
