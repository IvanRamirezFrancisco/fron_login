<file path="src/app/components/admin/admin-db-management/tabs/admin-db-maintenance/admin-db-maintenance.component.html">
<div class="mnt-root">

  <!-- ══ Tooltip flotante global ══════════════════════════════════════════ -->
  @if (tooltip.visible) {
    <div class="mnt-global-tooltip"
         [style.left.px]="tooltip.x"
         [style.top.px]="tooltip.y"
         [innerHTML]="tooltip.text">
    </div>
  }

  <!-- ══ Diálogo de confirmación VACUUM individual ═════════════════════════ -->
  @if (vacuumConfirmDialog) {
    <div class="mnt-backdrop" (click)="cancelVacuumConfirm()">
      <div class="mnt-dialog" (click)="$event.stopPropagation()">
        <div class="mnt-dialog__icon mnt-dialog__icon--orange">
          <span class="material-icons">cleaning_services</span>
        </div>
        <h3 class="mnt-dialog__title">¿Ejecutar VACUUM ANALYZE?</h3>
        <p class="mnt-dialog__body">
          Se ejecutará <strong>VACUUM ANALYZE</strong> en la tabla
          <code class="mnt-dialog__table">{{ vacuumConfirmDialog.tableName }}</code>.<br><br>
          Esta operación eliminará <strong>{{ formatNum(vacuumConfirmDialog.deadTuples) }} registros obsoletos</strong>
          ({{ vacuumConfirmDialog.bloatPercent.toFixed(1) }}% de desperdicio de espacio)
          y actualizará las estadísticas del planificador.
          <br><br>
          <span class="mnt-dialog__note">
            <span class="material-icons">info</span>
            Operación segura — no bloquea lecturas ni escrituras en la tabla.
          </span>
        </p>
        <div class="mnt-dialog__actions">
          <button class="mnt-btn mnt-btn--ghost" (click)="cancelVacuumConfirm()">
            <span class="material-icons">close</span> Cancelar
          </button>
          <button class="mnt-btn mnt-btn--primary" (click)="confirmVacuum()">
            <span class="material-icons">play_arrow</span> Ejecutar VACUUM ANALYZE
          </button>
        </div>
      </div>
    </div>
  }

  <!-- ══ Toast flotante ═══════════════════════════════════════════════════ -->
  @if (toast && toast.visible) {
    <div class="mnt-toast"
         [class.mnt-toast--success]="toast.type === 'success'"
         [class.mnt-toast--error]="toast.type === 'error'"
         [class.mnt-toast--closing]="toast.closing">
      <div class="mnt-toast__icon">
        @if (toast.type === 'success') {
          <span class="material-icons">check_circle</span>
        } @else {
          <span class="material-icons">error</span>
        }
      </div>
      <div class="mnt-toast__body">
        <p class="mnt-toast__title">{{ toast.title }}</p>
        <p class="mnt-toast__sub">
          <span class="mnt-toast__badge">{{ toast.operation }}</span>
          @if (toast.table) { <span class="mnt-toast__table">{{ toast.table }}</span> }
        </p>
        <p class="mnt-toast__msg">{{ toast.message }}</p>
      </div>
      <button class="mnt-toast__close" (click)="dismissToast()">
        <span class="material-icons">close</span>
      </button>
      <div class="mnt-toast__progress"
           [class.mnt-toast__progress--error]="toast.type === 'error'"></div>
    </div>
  }

  <!-- ══ Dialog de confirmación bulk vacuum ════════════════════════════════ -->
  @if (confirmDialogVisible) {
    <div class="mnt-backdrop" (click)="cancelBulkVacuum()">
      <div class="mnt-dialog" (click)="$event.stopPropagation()">
        <div class="mnt-dialog__icon">
          <span class="material-icons">cleaning_services</span>
        </div>
        <h3 class="mnt-dialog__title">¿Ejecutar VACUUM ANALYZE en todas las tablas?</h3>
        <p class="mnt-dialog__body">
          Esta operación limpiará <strong>{{ visibleStats.length }} tablas</strong>
          y puede tardar varios segundos dependiendo del tamaño de cada una.
        </p>
        <div class="mnt-dialog__actions">
          <button class="mnt-btn mnt-btn--ghost" (click)="cancelBulkVacuum()">Cancelar</button>
          <button class="mnt-btn mnt-btn--primary" (click)="confirmBulkVacuum()">
            <span class="material-icons">play_arrow</span> Confirmar
          </button>
        </div>
      </div>
    </div>
  }

  <!-- ══ Header del módulo ═════════════════════════════════════════════════ -->
  <div class="mnt-header">
    <div class="mnt-header__left">
      <div class="mnt-header__icon">
        <span class="material-icons">build_circle</span>
      </div>
      <div>
        <div class="mnt-header__title-row">
          <h2 class="mnt-header__title">Mantenimiento de Base de Datos</h2>
          <span class="mnt-av-badge" [class.mnt-av-badge--active]="autovacuumActive"
                                     [class.mnt-av-badge--inactive]="!autovacuumActive">
            <span class="mnt-av-badge__dot"></span>
            Autovacuum Nativo: {{ autovacuumActive ? 'ACTIVO' : 'INACTIVO' }}
          </span>
        </div>
        <p class="mnt-header__sub">VACUUM ANALYZE, ANALYZE y REINDEX por tabla — bajo demanda del DBA</p>
      </div>
    </div>
    <button class="mnt-btn-refresh" (click)="loadAll()" [disabled]="loading || anyOperationRunning">
      <span class="material-icons" [class.mnt-spin]="loading">refresh</span>
      {{ loading ? 'Cargando…' : 'Actualizar' }}
    </button>
  </div>

  <!-- ══ Error de carga ════════════════════════════════════════════════════ -->
  @if (error) {
    <div class="mnt-callout mnt-callout--red">
      <span class="material-icons">error_outline</span>
      <div><strong>Error al cargar datos</strong><span>{{ error }}</span></div>
    </div>
  }

  <!-- ════════════════════════════════════════════════════════════════════════
       SECCIÓN 1 — KPIs
  ════════════════════════════════════════════════════════════════════════════ -->
  <div class="mnt-kpi-grid">

    <!-- Tablas críticas -->
    <div class="mnt-kpi" [class.mnt-kpi--loading]="loading">
      <div class="mnt-kpi__icon mnt-kpi__icon--red">
        <span class="material-icons">report_problem</span>
      </div>
      <div class="mnt-kpi__body">
        <span class="mnt-kpi__value"
              [class.mnt-kpi__value--red]="criticalTablesCount > 0"
              [class.mnt-kpi__value--green]="criticalTablesCount === 0">
          {{ loading ? '–' : criticalTablesCount }}
        </span>
        <span class="mnt-kpi__label">Tablas críticas</span>
        <span class="mnt-kpi__sub"
              [class.mnt-kpi__sub--red]="criticalTablesCount > 0">
          {{ criticalTablesCount > 0 ? 'Requieren VACUUM urgente' : 'Sin urgencias' }}
        </span>
      </div>
    </div>

    <!-- Tablas con obsoletos -->
    <div class="mnt-kpi" [class.mnt-kpi--loading]="loading">
      <div class="mnt-kpi__icon mnt-kpi__icon--amber">
        <span class="material-icons">delete_sweep</span>
      </div>
      <div class="mnt-kpi__body">
        <span class="mnt-kpi__value"
              [class.mnt-kpi__value--amber]="obsoleteTablesCount > 3"
              [class.mnt-kpi__value--green]="obsoleteTablesCount <= 3">
          {{ loading ? '–' : obsoleteTablesCount }}
        </span>
        <span class="mnt-kpi__label">Tablas con obsoletos</span>
        <span class="mnt-kpi__sub">Limpieza pendiente</span>
      </div>
    </div>

    <!-- Índices con baja eficiencia -->
    <div class="mnt-kpi" [class.mnt-kpi--loading]="loading">
      <div class="mnt-kpi__icon mnt-kpi__icon--blue">
        <span class="material-icons">account_tree</span>
      </div>
      <div class="mnt-kpi__body">
        <span class="mnt-kpi__value"
              [class.mnt-kpi__value--amber]="lowEfficiencyIndexCount > 0"
              [class.mnt-kpi__value--green]="lowEfficiencyIndexCount === 0">
          {{ loading ? '–' : lowEfficiencyIndexCount }}
        </span>
        <span class="mnt-kpi__label">Índices con baja eficiencia</span>
        <span class="mnt-kpi__sub">Considerar REINDEX</span>
      </div>
    </div>

    <!-- Autovacuum -->
    <div class="mnt-kpi mnt-kpi--hoverable" [class.mnt-kpi--loading]="loading"
         (mouseenter)="showTooltip($event,
           autovacuumActive
             ? '<strong>Autovacuum</strong> — Demonio nativo de PostgreSQL<br><br>Limpia automáticamente las <em>dead tuples</em> y actualiza las estadísticas del planificador cuando una tabla supera los umbrales definidos en <code>postgresql.conf</code>.<br><br>Estado actual: <span style=\'color:#16a34a;font-weight:700\'>ACTIVO ✓</span>'
             : '<strong>Autovacuum</strong> — Demonio nativo de PostgreSQL<br><br>Limpia automáticamente las <em>dead tuples</em> y actualiza las estadísticas del planificador cuando una tabla supera los umbrales definidos en <code>postgresql.conf</code>.<br><br>Estado actual: <span style=\'color:#dc2626;font-weight:700\'>INACTIVO — se recomienda revisar la configuración</span>'
         )"
         (mouseleave)="hideTooltip()">
      <div class="mnt-kpi__icon"
           [class.mnt-kpi__icon--green]="autovacuumActive"
           [class.mnt-kpi__icon--red]="!autovacuumActive">
        <span class="material-icons">autorenew</span>
      </div>
      <div class="mnt-kpi__body">
        <span class="mnt-kpi__value"
              [class.mnt-kpi__value--green]="autovacuumActive"
              [class.mnt-kpi__value--red]="!autovacuumActive">
          {{ loading ? '–' : (autovacuumActive ? 'ACTIVO' : 'INACTIVO') }}
        </span>
        <span class="mnt-kpi__label">Autovacuum</span>
        <span class="mnt-kpi__sub"
              [class.mnt-kpi__sub--red]="!autovacuumActive">
          {{ autovacuumActive ? 'Funcionando correctamente' : 'Inactivo — revisar config' }}
        </span>
      </div>
    </div>

  </div><!-- /mnt-kpi-grid -->

  <!-- ════════════════════════════════════════════════════════════════════════
       SECCIÓN 2 — LIMPIEZA DE TABLAS
  ════════════════════════════════════════════════════════════════════════════ -->
  <div class="mnt-card">

    <!-- Header sección 2 -->
    <div class="mnt-card__header">
      <div class="mnt-card__header-left">
        <span class="mnt-section-icon mnt-section-icon--orange">
          <span class="material-icons">cleaning_services</span>
        </span>
        <div>
          <h3 class="mnt-card__title">
            Limpieza de tablas — VACUUM ANALYZE
            <button class="mnt-help-tip" tabindex="0"
              (mouseenter)="showTooltip($event, 'VACUUM elimina los registros marcados como borrados que siguen ocupando espacio en disco.<br>ANALYZE actualiza las estadísticas que usa PostgreSQL para elegir el plan más rápido al ejecutar consultas.')"
              (mouseleave)="hideTooltip()"
              (focus)="showTooltip($event, 'VACUUM elimina los registros marcados como borrados que siguen ocupando espacio en disco.<br>ANALYZE actualiza las estadísticas que usa PostgreSQL para elegir el plan más rápido al ejecutar consultas.')"
              (blur)="hideTooltip()"
              aria-label="Información sobre VACUUM ANALYZE">
              <span class="material-icons">help_outline</span>
            </button>
          </h3>
          <p class="mnt-card__sub">Elimina registros obsoletos y actualiza estadísticas del planificador de consultas</p>
        </div>
      </div>
      <div class="mnt-card__header-actions">
        <button class="mnt-btn mnt-btn--outline"
                [class.mnt-btn--outline-active]="showOnlyProblematic"
                (click)="toggleProblematicFilter()"
                [disabled]="loading">
          <span class="material-icons">filter_list</span>
          Solo con problemas
        </button>
        <button class="mnt-btn mnt-btn--primary"
                (click)="openBulkVacuumDialog()"
                [disabled]="loading || anyOperationRunning || visibleStats.length === 0">
          <span class="material-icons">play_arrow</span>
          VACUUM a todas
        </button>
        <button class="mnt-btn mnt-btn--analyze-all"
                (click)="runBulkAnalyze()"
                [disabled]="loading || anyOperationRunning"
                (mouseenter)="showTooltip($event, 'Ejecuta ANALYZE en <strong>todas las tablas</strong> de la base de datos.<br>Actualiza las estadísticas del planificador de consultas para mejorar el rendimiento.<br>Operación rápida — no bloquea escrituras.')"
                (mouseleave)="hideTooltip()">
          @if (bulkAnalyzeRunning) {
            <span class="material-icons mnt-spin">analytics</span>
            Analizando…
          } @else {
            <span class="material-icons">analytics</span>
            ANALYZE todas
          }
        </button>
      </div>
    </div>

    <!-- Barra de progreso bulk vacuum -->
    @if (bulkVacuumRunning) {
      <div class="mnt-bulk-progress">
        <div class="mnt-bulk-progress__bar-wrap">
          <div class="mnt-bulk-progress__bar" [style.width.%]="bulkVacuumProgress"></div>
        </div>
        <span class="mnt-bulk-progress__label">
          Ejecutando VACUUM ANALYZE… {{ bulkVacuumDone }} / {{ bulkVacuumTotal }} tablas
        </span>
      </div>
    }

    <!-- Panel colapsable de alertas críticas -->
    @if (criticalTablesBanner.length > 0) {
      <div class="mnt-alerts-panel">
        <button class="mnt-alerts-panel__toggle"
                (click)="alertsPanelOpen = !alertsPanelOpen"
                [class.mnt-alerts-panel__toggle--open]="alertsPanelOpen">
          <div class="mnt-alerts-panel__toggle-left">
            <span class="mnt-alerts-panel__badge">
              <span class="material-icons">warning_amber</span>
              {{ criticalTablesBanner.length }}
            </span>
            <span class="mnt-alerts-panel__toggle-title">
              Mostrar alertas
            </span>
            <span class="mnt-alerts-panel__toggle-sub">
              {{ criticalTablesBanner.length }} tabla{{ criticalTablesBanner.length !== 1 ? 's' : '' }} requiere{{ criticalTablesBanner.length === 1 ? '' : 'n' }} VACUUM urgente
            </span>
          </div>
          <span class="material-icons mnt-alerts-panel__chevron">
            {{ alertsPanelOpen ? 'expand_less' : 'expand_more' }}
          </span>
        </button>
        @if (alertsPanelOpen) {
          <div class="mnt-alerts-panel__body">
            @for (t of criticalTablesBanner; track t.tableName) {
              <div class="mnt-banner mnt-banner--critical">
                <span class="material-icons">warning_amber</span>
                <div>
                  <strong>{{ t.tableName }}</strong> tiene {{ formatNum(t.deadTuples) }} registros obsoletos
                  ({{ t.bloatPercent }}% de espacio desperdiciado).
                  <span>Se recomienda ejecutar VACUUM ANALYZE inmediatamente.</span>
                </div>
              </div>
            }
          </div>
        }
      </div>
    }

    <!-- Tabla — solo si hay filas o estamos cargando -->
    @if (loading || visibleStats.length > 0) {
    <div class="mnt-table-wrap">
      <table class="mnt-table">
        <thead>
          <tr>
            <th>TABLA</th>
            <th>OBSOLETOS</th>
            <th>ÚLTIMO VACUUM</th>
            <th>
              ESTADO
              <button class="mnt-help-tip" tabindex="0"
                (mouseenter)="showTooltip($event, '<strong>Acción urgente:</strong> más de 20 registros obsoletos con más del 30% de espacio desperdiciado.<br><strong>Recomendado:</strong> más de 5 obsoletos con más del 20%.<br><strong>Puede esperar:</strong> pocos obsoletos — el autovacuum se encargará automáticamente.')"
                (mouseleave)="hideTooltip()"
                (focus)="showTooltip($event, '<strong>Acción urgente:</strong> más de 20 registros obsoletos con más del 30%.<br><strong>Recomendado:</strong> más de 5 con más del 20%.<br><strong>Puede esperar:</strong> el autovacuum lo resolverá.')"
                (blur)="hideTooltip()"
                aria-label="Información sobre los estados de mantenimiento">
                <span class="material-icons">help_outline</span>
              </button>
            </th>
            <th class="mnt-th-c">ACCIONES</th>
          </tr>
        </thead>
        <tbody>

          <!-- Skeleton loading -->
          @if (loading) {
            @for (row of [1,2,3,4,5,6]; track row) {
              <tr class="mnt-tr--skeleton">
                <td><div class="mnt-skel mnt-skel--md"></div></td>
                <td><div class="mnt-skel mnt-skel--sm mnt-skel--r"></div></td>
                <td><div class="mnt-skel mnt-skel--md"></div></td>
                <td><div class="mnt-skel mnt-skel--sm"></div></td>
                <td><div class="mnt-skel mnt-skel--md mnt-skel--c"></div></td>
              </tr>
            }
          }

          <!-- Filas reales -->
          @if (!loading) {
            @for (t of visibleStats; track t.tableName) {
              <tr [class.mnt-tr--busy]="isRowBusy(t.tableName)">

                <!-- Tabla -->
                <td class="mnt-td-name">
                  <code>{{ t.tableName }}</code>
                </td>

                <!-- Obsoletos: número grande + mini barra de bloat -->
                <td class="mnt-td-obsoletos">
                  <span class="mnt-obsoletos__num"
                        [class.mnt-val--red]="maintenanceStatus(t) === 'critical'"
                        [class.mnt-val--orange]="maintenanceStatus(t) === 'warning'">
                    {{ formatNum(t.deadTuples) }}
                  </span>
                  <div class="mnt-mini-bar-wrap">
                    <div class="mnt-mini-bar"
                         [class.mnt-mini-bar--red]="t.bloatPercent > 30"
                         [class.mnt-mini-bar--amber]="t.bloatPercent > 15 && t.bloatPercent <= 30"
                         [class.mnt-mini-bar--green]="t.bloatPercent <= 15"
                         [style.width.%]="bloatBarWidth(t)"></div>
                  </div>
                </td>

                <!-- Último vacuum: relativo con tooltip exacto -->
                <td class="mnt-td-date"
                    [title]="t.lastVacuum !== 'Nunca' ? t.lastVacuum : ''"
                    [class.mnt-val--muted]="t.lastVacuum === 'Nunca'">
                  {{ relativeDate(t.lastVacuum) }}
                </td>

                <!-- Estado: etiqueta accionable específica de Mantenimiento -->
                <td class="mnt-td-status">
                  <span class="mnt-status-badge"
                        [class.mnt-status-badge--critical]="maintenanceStatus(t) === 'critical'"
                        [class.mnt-status-badge--warning]="maintenanceStatus(t) === 'warning'"
                        [class.mnt-status-badge--ok]="maintenanceStatus(t) === 'ok'">
                    @if (maintenanceStatus(t) === 'critical') {
                      <span class="material-icons">error_outline</span>
                    } @else if (maintenanceStatus(t) === 'warning') {
                      <span class="material-icons">warning_amber</span>
                    } @else {
                      <span class="material-icons">check_circle</span>
                    }
                    {{ maintenanceStatusLabel(maintenanceStatus(t)) }}
                  </span>
                </td>

                <!-- Acciones: VACUUM ANALYZE + ANALYZE independiente -->
                <td class="mnt-td-actions mnt-td-actions--center">
                  <div class="mnt-row-action-group">
                    <!-- Botón VACUUM ANALYZE -->
                    <button class="mnt-row-btn mnt-row-btn--va"
                            [class.mnt-row-btn--va-critical]="maintenanceStatus(t) === 'critical'"
                            [class.mnt-row-btn--va-warning]="maintenanceStatus(t) === 'warning'"
                            [class.mnt-row-btn--va-low]="maintenanceStatus(t) === 'ok'"
                            (mouseenter)="showTooltip($event, 'Ejecuta VACUUM (limpia registros obsoletos) + ANALYZE (actualiza estadísticas).<br>Operación segura — no bloquea la tabla.')"
                            (mouseleave)="hideTooltip()"
                            (click)="runVacuum(t.tableName)"
                            [disabled]="isRowBusy(t.tableName) || bulkVacuumRunning || bulkAnalyzeRunning">
                      @if (vacuumState[t.tableName] === 'loading') {
                        <span class="material-icons mnt-spin">refresh</span> Ejecutando…
                      } @else if (vacuumState[t.tableName] === 'ok') {
                        <span class="material-icons">check_circle</span> Completado
                      } @else if (vacuumState[t.tableName] === 'err') {
                        <span class="material-icons">cancel</span> Error
                      } @else {
                        <span class="material-icons">cleaning_services</span> VACUUM
                      }
                    </button>
                    <!-- Botón ANALYZE independiente -->
                    <button class="mnt-row-btn mnt-row-btn--analyze"
                            (mouseenter)="showTooltip($event, 'Ejecuta solo ANALYZE — actualiza las estadísticas del planificador sin limpiar espacio.<br>Más rápido que VACUUM. Útil cuando las consultas son lentas pero la tabla está relativamente limpia.')"
                            (mouseleave)="hideTooltip()"
                            (click)="runRowAnalyze(t.tableName)"
                            [disabled]="analyzeState[t.tableName] === 'loading' || isRowBusy(t.tableName) || bulkVacuumRunning || bulkAnalyzeRunning">
                      @if (analyzeState[t.tableName] === 'loading') {
                        <span class="material-icons mnt-spin">refresh</span> Analizando…
                      } @else if (analyzeState[t.tableName] === 'ok') {
                        <span class="material-icons">check_circle</span> Listo
                      } @else if (analyzeState[t.tableName] === 'err') {
                        <span class="material-icons">cancel</span> Error
                      } @else {
                        <span class="material-icons">analytics</span> ANALYZE
                      }
                    </button>
                  </div>
                </td>

              </tr>
            }
          }

        </tbody>
      </table>
    </div>
    }

    <!-- Estado vacío: todas las tablas limpias -->
    @if (!loading && visibleStats.length === 0) {
      <div class="mnt-clean-state">
        <span class="material-icons mnt-clean-state__icon">task_alt</span>
        <p class="mnt-clean-state__title">Todas las tablas están limpias</p>
        <p class="mnt-clean-state__sub">
          No hay registros obsoletos pendientes de limpieza en este momento
        </p>
        @if (showOnlyProblematic && stats.length > 0) {
          <button class="mnt-btn mnt-btn--ghost mnt-clean-state__toggle"
                  (click)="toggleProblematicFilter()">
            <span class="material-icons">visibility</span>
            Ver todas las tablas
          </button>
        }
      </div>
    }
  </div><!-- /mnt-card vacuum -->

  <!-- ════════════════════════════════════════════════════════════════════════
       SECCIÓN 3 — RECONSTRUCCIÓN DE ÍNDICES
  ════════════════════════════════════════════════════════════════════════════ -->
  <div class="mnt-card">

    <!-- Header sección 3 -->
    <div class="mnt-card__header">
      <div class="mnt-card__header-left">
        <span class="mnt-section-icon mnt-section-icon--blue">
          <span class="material-icons">account_tree</span>
        </span>
        <div>
          <h3 class="mnt-card__title">
            Reconstrucción de índices — REINDEX
            <button class="mnt-help-tip" tabindex="0"
              (mouseenter)="showTooltip($event, 'Los índices se fragmentan con el tiempo debido a muchas inserciones y eliminaciones.<br>REINDEX los reconstruye desde cero, mejorando la velocidad de las búsquedas.')"
              (mouseleave)="hideTooltip()"
              (focus)="showTooltip($event, 'Los índices se fragmentan con el tiempo debido a muchas inserciones y eliminaciones.<br>REINDEX los reconstruye desde cero, mejorando la velocidad de las búsquedas.')"
              (blur)="hideTooltip()"
              aria-label="Información sobre REINDEX">
              <span class="material-icons">help_outline</span>
            </button>
          </h3>
          <p class="mnt-card__sub">Reconstruye índices fragmentados para mejorar el rendimiento de búsquedas</p>
        </div>
      </div>
      @if (!loading && problematicIndexes.length > 0) {
        <button class="mnt-btn mnt-btn--primary"
                (click)="runBulkReindex()"
                [disabled]="anyOperationRunning">
          <span class="material-icons">play_arrow</span>
          REINDEX a índices con problemas
        </button>
      }
    </div>

    <!-- Skeleton loading índices -->
    @if (loading) {
      <div class="mnt-table-wrap">
        <table class="mnt-table">
          <thead><tr>
            <th>ÍNDICE</th><th>TABLA</th><th>EFICIENCIA</th>
            <th>PROBLEMA DETECTADO</th><th class="mnt-th-c">ACCIÓN</th>
          </tr></thead>
          <tbody>
            @for (row of [1,2,3]; track row) {
              <tr class="mnt-tr--skeleton">
                <td><div class="mnt-skel mnt-skel--lg"></div></td>
                <td><div class="mnt-skel mnt-skel--sm"></div></td>
                <td><div class="mnt-skel mnt-skel--md"></div></td>
                <td><div class="mnt-skel mnt-skel--xl"></div></td>
                <td><div class="mnt-skel mnt-skel--md mnt-skel--c"></div></td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }

    <!-- Estado vacío: todos los índices con tráfico real están bien -->
    @if (!loading && problematicIndexes.length === 0) {
      <div class="mnt-clean-state">
        <span class="material-icons mnt-clean-state__icon">verified</span>
        <p class="mnt-clean-state__title">Todos los índices están optimizados</p>
        <p class="mnt-clean-state__sub">
          No hay índices que requieran reconstrucción en este momento
        </p>
      </div>
    }

    <!-- Tabla de índices problemáticos (columnas simplificadas) -->
    @if (!loading && problematicIndexes.length > 0) {
      <div class="mnt-table-wrap mnt-reindex-wrap">
        <table class="mnt-table mnt-reindex-table">
          <colgroup>
            <col class="mnt-rcol--index">
            <col class="mnt-rcol--table">
            <col class="mnt-rcol--eff">
            <col class="mnt-rcol--problem">
            <col class="mnt-rcol--action">
          </colgroup>
          <thead>
            <tr>
              <th>ÍNDICE</th>
              <th>TABLA</th>
              <th>
                EFICIENCIA
                <button class="mnt-help-tip" tabindex="0"
                  (mouseenter)="showTooltip($event, '<strong>Eficiencia del índice</strong><br>Porcentaje de veces que PostgreSQL usó el índice respecto al total de accesos (índice + secuencial).<br><br><span style=\'color:#16a34a\'>≥ 75%</span> — Buena eficiencia<br><span style=\'color:#d97706\'>50%–74%</span> — Eficiencia baja<br><span style=\'color:#dc2626\'>&lt; 50%</span> — Fragmentado, recomendado REINDEX<br><br>Fórmula: <em>idx_scan / (idx_scan + seq_scan) × 100</em>')"
                  (mouseleave)="hideTooltip()"
                  (focus)="showTooltip($event, 'Porcentaje de búsquedas que usaron el índice. Valores bajos indican fragmentación o baja selectividad.')"
                  (blur)="hideTooltip()"
                  aria-label="Información sobre eficiencia de índice">
                  <span class="material-icons">help_outline</span>
                </button>
              </th>
              <th>PROBLEMA DETECTADO</th>
              <th class="mnt-th-c">ACCIÓN</th>
            </tr>
          </thead>
          <tbody>
            @for (idx of problematicIndexes; track idx.index_name) {
              <tr [class.mnt-tr--busy]="isIndexBusy(idx.index_name)">

                <!-- Índice -->
                <td class="mnt-td-name mnt-rtd-index">
                  <code>{{ truncate(idx.index_name, 32) }}</code>
                </td>

                <!-- Tabla -->
                <td class="mnt-rtd-table">
                  <span class="mnt-rtd-table__badge">
                    <span class="material-icons">table_chart</span>
                    {{ idx.table_name }}
                  </span>
                </td>

                <!-- Eficiencia -->
                <td class="mnt-td-eff mnt-rtd-eff">
                  <div class="mnt-eff"
                       (mouseenter)="showTooltip($event, '<strong>' + idx.efficiency_pct.toFixed(1) + '% de eficiencia</strong><br>' + idx.idx_scan + ' búsquedas por índice vs ' + idx.seq_scan + ' secuenciales.<br>' + (idx.efficiency_pct < 50 ? '<span style=\'color:#dc2626\'>Fragmentación crítica — REINDEX recomendado.</span>' : idx.efficiency_pct < 75 ? '<span style=\'color:#d97706\'>Eficiencia baja — monitorear.</span>' : '<span style=\'color:#16a34a\'>Rendimiento aceptable.</span>'))"
                       (mouseleave)="hideTooltip()">
                    <div class="mnt-eff__bar-wrap">
                      <div class="mnt-eff__bar"
