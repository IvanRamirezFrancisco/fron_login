                           [class.mnt-eff__bar--amber]="effColor(idx.efficiency_pct) === 'amber'"
                           [class.mnt-eff__bar--red]="effColor(idx.efficiency_pct) === 'red'"
                           [style.width.%]="idx.efficiency_pct"></div>
                    </div>
                    <span class="mnt-eff__pct"
                          [class.mnt-val--green]="effColor(idx.efficiency_pct) === 'green'"
                          [class.mnt-val--amber]="effColor(idx.efficiency_pct) === 'amber'"
                          [class.mnt-val--red]="effColor(idx.efficiency_pct) === 'red'">
                      {{ idx.efficiency_pct.toFixed(1) }}%
                    </span>
                  </div>
                </td>

                <!-- Problema detectado -->
                <td class="mnt-rtd-problem">
                  <span class="mnt-rtd-problem__chip">
