/* ═══════════════════════════════════════════════════════════
   GESTIÓN DE CLIENTES — admin-customers.component.css
   Paleta: vino #722f37 / dorado #D4A347 / neutros grises
═══════════════════════════════════════════════════════════ */

:host {
  display: block;
  --wine:        #722f37;
  --wine-dark:   #600018;
  --wine-light:  #a0002a;
  --gold:        #D4A347;
  --gold-light:  #e8c070;
  --success:     #198754;
  --danger:      #dc3545;
  --warning:     #ffc107;
  --info:        #0dcaf0;
  --text-main:   #1a1a2e;
  --text-muted:  #6c757d;
  --border:      #dee2e6;
  --bg-row-alt:  #fafafa;
  --shadow-sm:   0 2px 8px rgba(0,0,0,.06);
  --shadow-md:   0 4px 20px rgba(128,0,32,.10);
  --radius:      10px;
}

/* ── CSV Widget spacing ─────────────────────────────────────── */
.csv-section {
  margin-bottom: 1.5rem;
}

/* ── Wrapper principal ───────────────────────────────────── */
.customers-wrapper {
  padding: 24px;
  background: #f5f0eb;
  min-height: 100vh;
  font-family: 'Segoe UI', system-ui, sans-serif;
}

/* ── Cabecera ────────────────────────────────────────────── */
.section-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20px;
  gap: 16px;
  flex-wrap: wrap;
}

.section-title-group {
  display: flex;
  align-items: center;
  gap: 14px;
}

.section-icon {
  width: 46px;
  height: 46px;
  background: linear-gradient(135deg, var(--wine) 0%, var(--wine-dark) 100%);
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  box-shadow: 0 4px 12px rgba(128,0,32,.30);
  flex-shrink: 0;
}

.section-title {
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--text-main);
  margin: 0 0 2px 0;
  line-height: 1.2;
}

.section-subtitle {
  font-size: 0.82rem;
  color: var(--text-muted);
  margin: 0;
}

.header-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  align-items: center;
}

/* ── Botones de cabecera ─────────────────────────────────── */
.btn-export,
.btn-refresh {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  border: none;
  border-radius: 8px;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  transition: all .18s ease;
  white-space: nowrap;
}

.btn-export {
  background: linear-gradient(135deg, var(--wine) 0%, var(--wine-dark) 100%);
  color: #fff;
  box-shadow: 0 3px 10px rgba(128,0,32,.28);
}

.btn-export:hover {
  background: linear-gradient(135deg, var(--wine-light) 0%, var(--wine) 100%);
  transform: translateY(-1px);
  box-shadow: 0 5px 14px rgba(128,0,32,.36);
}

.btn-refresh {
  background: #FDFCFB;
  color: var(--wine);
  border: 1.5px solid var(--wine);
}

.btn-refresh:hover {
  background: var(--wine);
  color: #fff;
  transform: translateY(-1px);
}

/* ── Barra de filtros ────────────────────────────────────── */
.filters-bar {
  display: flex;
  align-items: flex-end;
  gap: 10px;
  flex-wrap: wrap;
  background: transparent;
  padding: 0 0 14px 0;
  border-radius: 0;
  border: none;
  box-shadow: none;
  margin-bottom: 16px;
}

/* Search box */
.search-box {
  position: relative;
  flex: 1;
  min-width: 200px;
  max-width: 340px;
}

.search-icon {
  position: absolute;
  left: 10px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-muted);
  pointer-events: none;
}

.search-input {
  width: 100%;
  padding: 7px 32px 7px 30px;
  border: 1.5px solid var(--border);
  border-radius: 8px;
  font-size: 0.82rem;
  color: var(--text-main);
  background: #FAF8F6;
  transition: border-color .18s, box-shadow .18s;
  outline: none;
}

.search-input:focus {
  border-color: var(--wine);
  background: #FDFCFB;
  box-shadow: 0 0 0 3px rgba(128,0,32,.10);
}

.search-clear {
  position: absolute;
  right: 8px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: 2px;
  display: flex;
  align-items: center;
  border-radius: 4px;
  transition: color .15s;
}

.search-clear:hover { color: var(--danger); }

/* Filtros select */
.filter-group {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.filter-label {
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: .04em;
}

.filter-select {
  padding: 6px 10px;
  border: 1.5px solid var(--border);
  border-radius: 8px;
  font-size: 0.82rem;
  color: var(--text-main);
  background: #FAF8F6;
  cursor: pointer;
  transition: border-color .18s;
  outline: none;
}

.filter-select:focus {
  border-color: var(--wine);
  box-shadow: 0 0 0 3px rgba(128,0,32,.08);
}

/* Botones filtros */
.btn-clear-filters,
.btn-search {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 7px 12px;
  border-radius: 8px;
  font-size: 0.81rem;
  font-weight: 600;
  cursor: pointer;
  transition: all .18s;
  border: none;
  align-self: flex-end;
}

.btn-clear-filters {
  background: #f8d7da;
  color: #842029;
  border: 1.5px solid #f5c2c7;
}

.btn-clear-filters:hover { background: #f5c2c7; }

.btn-search {
  background: linear-gradient(135deg, var(--wine) 0%, var(--wine-dark) 100%);
  color: #fff;
  box-shadow: 0 2px 8px rgba(128,0,32,.22);
}

.btn-search:hover {
  background: linear-gradient(135deg, var(--wine-light) 0%, var(--wine) 100%);
  transform: translateY(-1px);
}

/* ── Tarjeta de tabla ────────────────────────────────────── */
.table-card {
  background: #FDFCFB;
  border-radius: var(--radius);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-md);
  overflow: hidden;
  position: relative;
}

/* Loading overlay */
.loading-overlay {
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,.82);
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: var(--wine);
  font-size: 0.86rem;
  font-weight: 600;
  border-radius: var(--radius);
}

.spinner {
  width: 36px;
  height: 36px;
  border: 3px solid rgba(128,0,32,.15);
  border-top-color: var(--wine);
  border-radius: 50%;
  animation: spin .7s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.table-loading { opacity: .5; pointer-events: none; }

/* ── Tabla ───────────────────────────────────────────────── */
.table-responsive { overflow-x: auto; }

.table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.82rem;
}

/* Encabezado — clase propia para evitar que Bootstrap sobreescriba el color */
.thead-customers {
  background: linear-gradient(135deg, #1a1a2e 0%, #2c1810 100%);
}

.thead-customers th {
  padding: 11px 12px;
  color: #fff !important;
  font-weight: 600;
  font-size: 0.76rem;
  text-transform: uppercase;
  letter-spacing: .05em;
  border: none !important;
  white-space: nowrap;
  background: transparent;
  --bs-table-bg: transparent;
  --bs-table-color: #fff;
}

/* Filas */
.table tbody tr {
  border-bottom: 1px solid #f0f0f0;
  transition: background .12s, transform .12s;
}

.table tbody tr:hover {
  background: #fdf5f7;
  transform: translateX(2px);
}

.table tbody tr:nth-child(even) { background: var(--bg-row-alt); }
.table tbody tr:nth-child(even):hover { background: #fdf5f7; }

.table tbody td {
  padding: 9px 12px;
  vertical-align: middle;
  color: var(--text-main);
  border: none;
}

/* Filas con estados especiales */
.row-disabled { opacity: .65; }

.row-locked td:first-child {
  border-left: 3px solid var(--danger);
}

/* ── Columnas específicas ────────────────────────────────── */
.col-cliente   { min-width: 155px; }
.col-contacto  { min-width: 200px; max-width: 240px; }
.col-pedidos   { width: 80px; }
.col-gasto     { width: 130px; }
.col-estado    { width: 110px; }
.col-cuenta    { width: 110px; }
.col-registro  { width: 110px; }
.col-acciones  { width: 110px; }

/* ── Info del cliente ────────────────────────────────────── */
.customer-info {
  display: flex;
  align-items: center;
  gap: 9px;
}

.customer-avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.82rem;
  font-weight: 700;
  color: #fff !important;
  flex-shrink: 0;
  letter-spacing: .5px;
