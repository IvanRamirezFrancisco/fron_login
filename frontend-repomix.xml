  }

  .footer-bottom-links {
    flex-direction: column;
    gap: 10px;
  }

  .payment-methods {
    justify-content: center;
  }
}

/* ===== ESTILOS MODERNOS DE OFERTAS ===== */

/* Banner */
.ofertas-banner {
  background: linear-gradient(135deg, #722f37 0%, #3A0D0D 100%);
  padding: 3rem 0;
  margin-bottom: 2rem;
}

.banner-content {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  color: white;
}

.banner-icon {
  font-size: 64px;
  color: #FFD700;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.banner-text h1 {
  font-family: 'Montserrat', sans-serif;
  font-size: 2.5rem;
  font-weight: 700;
  margin: 0;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
}

.banner-text p {
  font-size: 1.2rem;
  margin: 0.5rem 0 0 0;
  opacity: 0.95;
}

/* Controls */
.ofertas-controls {
  background: white;
  border-bottom: 1px solid #eee;
  padding: 1.5rem 0;
  margin-bottom: 2rem;
}

.controls-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
}

.results-count {
  font-size: 1.1rem;
  font-weight: 600;
  color: #333;
}

.sort-controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.sort-controls label {
  font-weight: 600;
  color: #666;
  margin-right: 0.5rem;
}

.sort-btn {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.6rem 1.2rem;
  background: white;
  border: 2px solid #ddd;
  border-radius: 25px;
  color: #666;
  font-weight: 600;
  font-size: 0.9rem;
  cursor: pointer;
  transition: all 0.3s ease;
}

.sort-btn:hover {
  border-color: #C5A059;
  color: #C5A059;
  transform: translateY(-2px);
  box-shadow: 0 4px 8px rgba(197, 160, 89, 0.2);
}

.sort-btn.active {
  background: #C5A059;
  border-color: #C5A059;
  color: white;
}

.sort-btn .material-symbols-outlined {
  font-size: 18px;
}

/* Loading & Empty States */
.loading-container,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rem 2rem;
  color: #722f37;
}

.loading-container .material-symbols-outlined {
  font-size: 64px;
  margin-bottom: 1rem;
}

.spinning {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.empty-state .material-symbols-outlined {
  font-size: 80px;
  color: #C5A059;
  margin-bottom: 1rem;
}

.empty-state h3 {
  font-size: 1.5rem;
  margin: 1rem 0;
  color: #333;
}

.empty-state p {
  color: #666;
  margin-bottom: 1.5rem;
}

/* Grid de Ofertas */
.ofertas-content {
  padding: 2rem 0 4rem;
  background: #f8f9fa;
}

.ofertas-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.5rem;
}

/* Card de Oferta - COMPACTA Y PROFESIONAL */
.oferta-card {
  background: white;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.oferta-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.12);
}

/* Discount Badge - COMPACTO */
.discount-badge {
  position: absolute;
  top: 12px;
  right: 12px;
  background: linear-gradient(135deg, #ff4444 0%, #cc0000 100%);
  color: white;
  padding: 0.4rem 0.7rem;
  border-radius: 8px;
  font-size: 1.1rem;
  font-weight: 800;
