// =============================================================================
//  AdminInventoryPredictionComponent — Estilos
//  Diseño: tarjetas blancas con borde superior coloreado, grafica limpia,
//  pasos con circulo numerado, tema claro integrado al admin dashboard.
// =============================================================================

// -- Variables ----------------------------------------------------------------
$bg-card:        #ffffff;
$bg-section:     #f8f9fa;
$border:         #e8e8e8;
$accent:         #800020;
$accent-light:   rgba(128, 0, 32, 0.08);
$text-primary:   #2C3E50;
$text-secondary: #6c757d;
$text-muted:     #adb5bd;
$red:            #c0392b;

$shadow-sm:  0 2px 8px rgba(0, 0, 0, 0.07);
$shadow-md:  0 8px 24px rgba(0, 0, 0, 0.11);
$radius-lg:  16px;
$radius-md:  10px;
$radius-sm:  6px;
$transition: 0.2s ease;

// -- Wrapper ------------------------------------------------------------------
.inv-pred-wrapper {
  width: 100%;
  background: transparent;
  margin-bottom: 2rem;
  animation: fadeSlideIn 0.3s ease;
}

// =============================================================================
// BLOQUE A - Encabezado
// =============================================================================

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 1.25rem;

  &__left  { flex: 1; min-width: 0; }

  &__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
}

.section-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 1.2rem;
  font-weight: 700;
  color: $text-primary;
  margin: 0;

  &__icon {
    font-size: 20px;
    color: $accent;
  }
}

.section-sub {
  font-size: 12.5px;
  color: $text-secondary;
  margin: 3px 0 0;

  sup { font-size: 9px; }

  &__updated {
    color: $text-muted;
    font-style: italic;
  }
}

.btn-refresh {
  background: #fff;
  border: 1.5px solid $border;
  border-radius: $radius-sm;
  color: $text-secondary;
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: $shadow-sm;
  transition: border-color $transition, color $transition;

  .material-icons { font-size: 17px; }
  .spinning       { animation: spin 0.8s linear infinite; }

  &:hover:not(:disabled) {
    border-color: $accent;
    color: $accent;
  }
  &:disabled { opacity: 0.4; cursor: not-allowed; }
}

.btn-detail {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 12.5px;
  font-weight: 600;
  color: $accent;
  text-decoration: none;
  padding: 6px 13px;
  border: 1.5px solid rgba($accent, 0.3);
  border-radius: $radius-sm;
  background: #fff;
  box-shadow: $shadow-sm;
  transition: background $transition, border-color $transition;

  .material-icons { font-size: 13px; }

  &:hover {
    background: $accent-light;
    border-color: $accent;
  }
}

// =============================================================================
// Paneles de estado (loading / error)
// =============================================================================

.state-panel {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 13px 16px;
  border-radius: $radius-md;
  font-size: 13px;
  margin-bottom: 1.25rem;

  &--loading {
    background: $bg-section;
    border: 1px dashed $border;
    color: $text-secondary;
  }

  &--error {
    background: #fdf1f1;
    border: 1px solid rgba($red, 0.3);
    color: $red;

    .material-icons { font-size: 18px; }
  }
}

.loader {
  width: 15px;
  height: 15px;
  border: 2px solid $border;
  border-top-color: $accent;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  flex-shrink: 0;
}

.btn-retry {
  margin-left: 8px;
  background: transparent;
  border: 1px solid rgba($red, 0.4);
  border-radius: 5px;
  color: $red;
  font-size: 12px;
  padding: 3px 10px;
  cursor: pointer;
  transition: background $transition;

  &:hover { background: rgba($red, 0.07); }
}

// =============================================================================
// BLOQUE B - Grid de tarjetas
// =============================================================================

.cards-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-bottom: 1.5rem;

  @media (max-width: 1100px) { grid-template-columns: repeat(2, 1fr); }
  @media (max-width: 560px)  { grid-template-columns: 1fr; }
}

.pred-card {
  --card-top: #{$accent};

  position: relative;
  background: #ffffff;
  border: 1px solid $border;
  border-radius: $radius-lg;
  padding: 1.1rem 1.2rem 1rem;
  box-shadow: $shadow-sm;
  overflow: visible;   // permite que el tooltip sobresalga
  transition: transform $transition, box-shadow $transition;

  &:hover {
    transform: translateY(-3px);
    box-shadow: $shadow-md;
  }

  &:hover .pred-tooltip {
    opacity: 1;
    pointer-events: auto;
  }

  // Borde superior coloreado de 3px
  &::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--card-top);
    border-radius: $radius-lg $radius-lg 0 0;
  }

  .card-glow {
    position: absolute;
    top: -24px; right: -24px;
    width: 90px; height: 90px;
    background: radial-gradient(circle, var(--card-top) 0%, transparent 65%);
    opacity: 0.06;
    pointer-events: none;
  }

  &.ok   { --card-top: #27ae60; }
  &.warn { --card-top: #f39c12; }
  &.crit { --card-top: #c0392b; }
}

// ── Tooltip de la tarjeta ─────────────────────────────────────────────────────
.pred-tooltip {
  position: absolute;
  bottom: calc(100% + 10px);
  left: 50%;
  transform: translateX(-50%);
  background: #1a1a2e;
  color: #fff;
  border-radius: 10px;
  padding: 10px 14px;
  font-size: 11px;
  line-height: 1.7;
  white-space: nowrap;
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);

  // Flecha apuntando hacia abajo
  &::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: #1a1a2e;
  }

  .tooltip-title {
    font-size: 11px;
    font-weight: 600;
    color: #e0e0e0;
    margin-bottom: 6px;
    padding-bottom: 5px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .tooltip-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;

    .lbl      { color: #aaa; }
    .val      { color: #fff; font-weight: 600; }
    .val-danger { color: #fc8181; }
    .val-ok     { color: #6fcf97; }
  }
}

.card-section-label {
  display: block;
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: $text-secondary;
  margin-bottom: 0.55rem;
  padding-right: 28px;
}

.card-main {
  display: flex;
  align-items: baseline;
  gap: 5px;
  margin-bottom: 0.35rem;
}

.card-days {
