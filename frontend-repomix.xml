}

/* Tip de uso */
.input-tip {
  display: flex;
  align-items: start;
  gap: 0.5rem;
  margin-top: 0.5rem;
  padding: 0.75rem;
  background: #fef3c7;
  border-left: 3px solid #D4A347;
  border-radius: 6px;
  font-size: 0.85rem;
  color: #78350f;
}

.input-tip .material-icons {
  font-size: 1.1rem;
  color: #D4A347;
