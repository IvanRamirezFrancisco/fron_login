}

.form-input-sm {
  padding: 0.75rem 1rem;
  font-size: 0.9rem;
}

.attribute-separator {
  display: flex;
  align-items: center;
  padding-top: 1.75rem;
}

.attribute-separator .material-icons {
  color: #9ca3af;
  font-size: 1.5rem;
}

.btn-remove-attribute {
  padding: 0.75rem;
  background: #fef2f2;
  border: 2px solid #fecaca;
  border-radius: 10px;
