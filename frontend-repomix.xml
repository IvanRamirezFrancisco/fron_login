  color: #C5A059;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  line-height: 1;
}

/* Nombre del Producto */
.oferta-nombre {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.1rem;
  font-weight: 700;
  color: #333;
  margin: 0;
  line-height: 1.3;
  cursor: pointer;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  transition: color 0.2s ease;
}

.oferta-nombre:hover {
  color: #722f37;
}

/* Meta Info (Rating + Stock) */
.oferta-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding: 0.4rem 0;
  border-bottom: 1px solid #f0f0f0;
}

.rating-compact {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.85rem;
}

.star-icon {
  font-size: 16px;
  color: #FFD700;
  font-variation-settings: 'FILL' 1;
}

.rating-value {
  font-weight: 700;
  color: #333;
}

.rating-reviews {
  color: #666;
}

.stock-status {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.8rem;
  font-weight: 600;
  padding: 0.25rem 0.5rem;
