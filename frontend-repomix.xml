<file path="src/app/components/navbar/navbar.component.css">
/* ============================================
   CASA DE MÚSICA CASTILLO - HEADER PROFESIONAL
============================================ */

.main-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: var(--z-fixed);
  background-color: var(--primary-color);
  box-shadow: var(--shadow-lg);
  transition: var(--transition-normal);
}

.header-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 var(--space-lg);
  height: 70px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-lg);
}

/* ============================================
   LOGO SECTION
============================================ */

.logo-section {
  flex-shrink: 0;
}

.logo-link {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  text-decoration: none;
  transition: var(--transition-fast);
}

.logo-link:hover {
  transform: scale(1.02);
}

.logo-icon {
  width: 40px;
  height: 40px;
  background: var(--secondary-color);
  border-radius: var(--border-radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  font-size: 1.5rem;
  font-weight: bold;
  box-shadow: var(--shadow-md);
}

.logo-text .brand-name {
  color: var(--text-inverse);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  white-space: nowrap;
  font-family: var(--font-primary);
}

/* ============================================
   SEARCH SECTION
============================================ */

.search-section {
  flex: 1;
  max-width: 600px;
  margin: 0 var(--space-xl);
}

.search-container {
  position: relative;
  width: 100%;
}

.search-input {
  width: 100%;
  height: 45px;
  padding: var(--space-md) var(--space-lg);
  padding-right: 55px;
  border: none;
  border-radius: var(--border-radius-lg);
  font-size: var(--font-size-base);
  font-family: var(--font-primary);
  background: var(--background-card);
  color: var(--text-primary);
  transition: var(--transition-fast);
  outline: none;
  box-shadow: var(--shadow-sm);
}

.search-input:focus {
  box-shadow: var(--shadow-md);
  transform: translateY(-1px);
}

.search-input::placeholder {
  color: var(--text-muted);
  font-size: var(--font-size-sm);
}

.search-btn {
  position: absolute;
  right: 5px;
  top: 50%;
  transform: translateY(-50%);
  width: 35px;
  height: 35px;
  border: none;
  border-radius: var(--border-radius-md);
  background: var(--secondary-color);
  color: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: var(--transition-fast);
  font-size: 1.2rem;
}

.search-btn:hover {
  background: var(--secondary-light);
  transform: translateY(-50%) scale(1.05);
}

/* ============================================
   NAVIGATION ACTIONS
============================================ */

.nav-actions {
  display: flex;
  align-items: center;
  gap: var(--space-lg);
  flex-shrink: 0;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.nav-link {
  color: rgba(255, 255, 255, 0.9);
  text-decoration: none;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--border-radius-md);
  transition: var(--transition-fast);
  white-space: nowrap;
  position: relative;
}

.nav-link:hover {
  color: var(--text-inverse);
  background: rgba(255, 255, 255, 0.1);
}

.nav-link.active {
  color: var(--secondary-color);
  background: rgba(212, 175, 55, 0.1);
  font-weight: var(--font-weight-semibold);
}

/* ============================================
   USER ACTIONS
============================================ */

.user-actions {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.action-btn {
  width: 42px;
  height: 42px;
  border: none;
  border-radius: var(--border-radius-lg);
  background: rgba(255, 255, 255, 0.1);
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: var(--transition-fast);
  font-size: 1.3rem;
  position: relative;
}

.action-btn:hover {
  background: rgba(255, 255, 255, 0.2);
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

.cart-btn .cart-count {
  position: absolute;
  top: -8px;
  right: -8px;
  background: var(--accent-color);
  color: var(--text-inverse);
  border-radius: var(--border-radius-full);
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-bold);
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

/* ============================================
   MOBILE MENU BUTTON
============================================ */

.mobile-menu-btn {
  display: none;
  width: 42px;
  height: 42px;
  border: none;
  border-radius: var(--border-radius-lg);
  background: rgba(255, 255, 255, 0.1);
  color: var(--text-inverse);
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: var(--transition-fast);
  font-size: 1.5rem;
}

.mobile-menu-btn:hover {
  background: rgba(255, 255, 255, 0.2);
}

/* ============================================
   USER DROPDOWN
============================================ */

.user-dropdown {
  position: absolute;
  top: 100%;
  right: 0;
  z-index: var(--z-dropdown);
  margin-top: var(--space-sm);
}

.dropdown-content {
  background: var(--background-card);
  border-radius: var(--border-radius-xl);
  box-shadow: var(--shadow-xl);
  border: 1px solid var(--border-light);
  padding: var(--space-sm);
  min-width: 200px;
  animation: dropdownSlideIn 0.2s ease-out;
}

@keyframes dropdownSlideIn {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.dropdown-item {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  color: var(--text-primary);
  text-decoration: none;
  border-radius: var(--border-radius-lg);
  transition: var(--transition-fast);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  width: 100%;
  border: none;
  background: none;
  cursor: pointer;
}

.dropdown-item:hover {
  background: var(--gray-100);
  color: var(--primary-color);
}

.dropdown-item .material-symbols-outlined {
  font-size: 1.2rem;
  color: var(--text-secondary);
}

.dropdown-item:hover .material-symbols-outlined {
  color: var(--primary-color);
}

.dropdown-divider {
  height: 1px;
  background: var(--border-light);
  margin: var(--space-sm) 0;
}

.logout-btn {
  color: var(--error-color);
}

.logout-btn:hover {
  background: rgba(220, 53, 69, 0.1);
  color: var(--error-color);
}

.logout-btn .material-symbols-outlined {
  color: var(--error-color);
}

/* ============================================
   MOBILE MENU
============================================ */

.mobile-menu {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: var(--background-card);
  border-top: 1px solid var(--border-light);
  box-shadow: var(--shadow-xl);
  z-index: var(--z-dropdown);
  animation: mobileMenuSlideIn 0.3s ease-out;
}

@keyframes mobileMenuSlideIn {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.mobile-menu-content {
  padding: var(--space-lg);
}

.mobile-search {
  display: flex;
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
}

.mobile-search-input {
  flex: 1;
  height: 45px;
  padding: var(--space-md);
  border: 2px solid var(--border-light);
  border-radius: var(--border-radius-lg);
  font-size: var(--font-size-base);
  font-family: var(--font-primary);
  outline: none;
  transition: var(--transition-fast);
}

.mobile-search-input:focus {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(139, 21, 56, 0.1);
}

.mobile-search-btn {
  width: 45px;
  height: 45px;
  border: none;
  border-radius: var(--border-radius-lg);
  background: var(--secondary-color);
  color: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 1.3rem;
  transition: var(--transition-fast);
}

.mobile-search-btn:hover {
  background: var(--secondary-light);
  transform: scale(1.05);
}

.mobile-nav-links {
  margin-bottom: var(--space-xl);
}

.mobile-nav-link {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-lg);
  color: var(--text-primary);
  text-decoration: none;
  border-radius: var(--border-radius-lg);
  transition: var(--transition-fast);
  font-weight: var(--font-weight-medium);
  margin-bottom: var(--space-sm);
}

.mobile-nav-link:hover {
  background: var(--gray-100);
  color: var(--primary-color);
}

.mobile-nav-link .material-symbols-outlined {
  font-size: 1.4rem;
  color: var(--text-secondary);
}

.mobile-nav-link:hover .material-symbols-outlined {
  color: var(--primary-color);
}

.mobile-actions {
  border-top: 1px solid var(--border-light);
  padding-top: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.mobile-action-btn {
  padding: var(--space-lg);
  border-radius: var(--border-radius-lg);
  text-decoration: none;
  text-align: center;
  font-weight: var(--font-weight-semibold);
  transition: var(--transition-fast);
  border: none;
  cursor: pointer;
}

.mobile-action-btn.btn-primary {
  background: var(--primary-color);
  color: var(--text-inverse);
}

.mobile-action-btn.btn-primary:hover {
  background: var(--primary-light);
  transform: translateY(-1px);
}

.mobile-action-btn.btn-secondary {
  background: transparent;
  color: var(--primary-color);
  border: 2px solid var(--primary-color);
}

.mobile-action-btn.btn-secondary:hover {
  background: var(--primary-color);
  color: var(--text-inverse);
}

.logout-mobile {
  background: transparent;
  color: var(--error-color);
  border: 2px solid var(--error-color);
}

.logout-mobile:hover {
  background: var(--error-color);
  color: var(--text-inverse);
}

/* ============================================
   RESPONSIVE DESIGN
============================================ */

@media (max-width: 1024px) {
  .nav-links {
    display: none;
  }
  
  .mobile-menu-btn {
    display: flex;
  }
  
  .search-section {
    margin: 0 var(--space-md);
  }
}

@media (max-width: 768px) {
  .header-container {
    padding: 0 var(--space-md);
    gap: var(--space-md);
  }
  
  .search-section {
    display: none;
  }
  
  .logo-text .brand-name {
    font-size: var(--font-size-base);
  }
  
  .user-actions {
    gap: var(--space-xs);
  }
  
  .action-btn {
    width: 38px;
    height: 38px;
    font-size: 1.2rem;
  }
}

@media (max-width: 480px) {
  .header-container {
    height: 60px;
    padding: 0 var(--space-sm);
  }
  
  .logo-icon {
    width: 35px;
    height: 35px;
    font-size: 1.3rem;
  }
  
  .logo-text .brand-name {
    font-size: var(--font-size-sm);
  }
}
