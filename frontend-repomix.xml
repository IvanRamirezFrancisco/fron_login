  background: transparent;
  border: none;
  color: #999;
  cursor: pointer;
  padding: 0.3rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s ease;
  margin-left: 0.5rem;
}

.clear-btn:hover {
  background: #f0f0f0;
  color: #666;
}

.clear-btn .material-symbols-outlined {
  font-size: 20px;
}

.loading-indicator {
  margin-left: 0.5rem;
  display: flex;
  align-items: center;
  color: #C5A059;
}

.spinning {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* Dropdown de resultados */
.search-dropdown {
  position: absolute;
  top: calc(100% + 0.5rem);
  left: 0;
  right: 0;
  background: #FDFCFB;
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  max-height: 70vh;
  overflow-y: auto;
  z-index: 1000;
  animation: fadeInDown 0.3s ease;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Scrollbar personalizado */
.search-dropdown::-webkit-scrollbar {
  width: 8px;
}

.search-dropdown::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 10px;
}

.search-dropdown::-webkit-scrollbar-thumb {
  background: #C5A059;
  border-radius: 10px;
}

.search-dropdown::-webkit-scrollbar-thumb:hover {
  background: #b08f4a;
}

/* Sección de sugerencias */
.suggestions-section {
  padding: 1rem;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: #666;
  font-size: 0.85rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 0.8rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid #f0f0f0;
}

.section-header .material-symbols-outlined {
  font-size: 18px;
}

.suggestions-list {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}

.suggestion-item {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  padding: 0.7rem 1rem;
  background: transparent;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.2s ease;
  text-align: left;
  color: #333;
  font-size: 0.95rem;
}

.suggestion-item:hover {
  background: #FAF8F6;
  color: #722f37;
}

.suggestion-item .material-symbols-outlined {
  font-size: 20px;
  color: #999;
}

.suggestion-item:hover .material-symbols-outlined {
  color: #722f37;
}

/* Estados */
.loading-state,
.no-results-state {
  padding: 2rem;
  text-align: center;
  color: #666;
}

.loading-state .material-symbols-outlined,
.no-results-state .material-symbols-outlined {
  font-size: 48px;
  color: #C5A059;
  margin-bottom: 1rem;
}

.no-results-state h4 {
  font-size: 1.2rem;
  color: #333;
  margin: 0.5rem 0;
}

.no-results-state p {
  color: #666;
  margin: 0.5rem 0 1.5rem 0;
}

.suggestions-help {
  text-align: left;
  background: #FAF8F6;
  padding: 1rem;
  border-radius: 8px;
  margin-top: 1rem;
}

.suggestions-help p {
  margin: 0 0 0.5rem 0;
  color: #333;
}

.suggestions-help ul {
  margin: 0;
  padding-left: 1.5rem;
  color: #666;
}

.suggestions-help li {
  margin: 0.3rem 0;
  font-size: 0.9rem;
}

/* Sección de resultados */
.results-section {
  padding: 1rem;
}

.results-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.5rem 1rem 1rem;
  border-bottom: 2px solid #f0f0f0;
  margin-bottom: 0.8rem;
}

.results-count {
  font-weight: 700;
  color: #333;
  font-size: 0.95rem;
}

.execution-time {
  font-size: 0.8rem;
  color: #999;
}

/* Lista de resultados */
.results-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.result-item {
  display: grid;
  grid-template-columns: 80px 1fr auto;
  gap: 1rem;
  padding: 0.8rem;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.2s ease;
  border: 1px solid transparent;
}

.result-item:hover {
  background: #FAF8F6;
  border-color: #e0e0e0;
  transform: translateX(4px);
}

/* Imagen del resultado */
.result-image {
  width: 80px;
  height: 80px;
  border-radius: 8px;
  overflow: hidden;
  background: #FAF8F6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
}

.image-placeholder .material-symbols-outlined {
  font-size: 40px;
  color: #ccc;
}

/* Info del resultado */
.result-info {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  justify-content: center;
  min-width: 0;
}

.result-category {
  font-size: 0.75rem;
  color: #C5A059;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.result-name {
  font-size: 1rem;
  font-weight: 600;
  color: #333;
  margin: 0;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
}

.result-name mark {
  background: #fff3cd;
  color: #722f37;
  padding: 0 0.2rem;
  border-radius: 3px;
  font-weight: 700;
}

.result-meta {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  font-size: 0.85rem;
  color: #666;
}

.result-brand {
  font-weight: 500;
}

.result-rating {
  display: flex;
  align-items: center;
  gap: 0.2rem;
  color: #FFD700;
  font-weight: 600;
}

.result-rating .material-symbols-outlined {
  font-size: 16px;
  font-variation-settings: 'FILL' 1;
}

/* Precio del resultado */
.result-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 0.3rem;
  padding-left: 1rem;
  border-left: 1px solid #f0f0f0;
}

.price-current {
  font-size: 1.2rem;
  font-weight: 800;
  color: #722f37;
  line-height: 1;
  white-space: nowrap;
}

.price-original {
  font-size: 0.8rem;
  font-weight: 500;
  color: #999;
  text-decoration: line-through;
  white-space: nowrap;
}

.price-discount {
  font-size: 0.75rem;
  font-weight: 700;
  color: white;
  background: linear-gradient(135deg, #ff4444 0%, #cc0000 100%);
  padding: 0.2rem 0.4rem;
  border-radius: 4px;
}

/* Footer - Ver todos */
.view-all-footer {
  padding: 1rem;
  border-top: 2px solid #f0f0f0;
  margin-top: 0.5rem;
}

.btn-view-all {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.9rem;
  background: linear-gradient(135deg, #722f37 0%, #a00028 100%);
  color: white;
  border: none;
  border-radius: 10px;
  font-weight: 700;
  font-size: 0.95rem;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 12px rgba(128, 0, 32, 0.2);
}

.btn-view-all:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(128, 0, 32, 0.3);
}

.btn-view-all .material-symbols-outlined {
  font-size: 20px;
  transition: transform 0.3s ease;
}

.btn-view-all:hover .material-symbols-outlined {
  transform: translateX(4px);
}

/* Responsive */
@media (max-width: 768px) {
  .search-box {
    padding: 0.4rem 1rem;
  }

  .search-input {
    font-size: 0.9rem;
  }

  .search-dropdown {
    max-height: 60vh;
  }

  .result-item {
    grid-template-columns: 60px 1fr;
    gap: 0.8rem;
  }

  .result-image {
    width: 60px;
    height: 60px;
  }

  .result-price {
    grid-column: 2;
    border-left: none;
    border-top: 1px solid #f0f0f0;
    padding-top: 0.5rem;
    padding-left: 0;
    align-items: flex-start;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 0.5rem;
  }

  .price-current {
    font-size: 1.1rem;
  }
}

@media (max-width: 480px) {
  .search-box {
    border-radius: 12px;
    padding: 0.5rem 0.8rem;
  }

  .search-icon {
    font-size: 20px;
    margin-right: 0.5rem;
  }

  .search-input {
    font-size: 0.85rem;
  }

  .result-name {
    font-size: 0.9rem;
  }

  .result-meta {
    font-size: 0.8rem;
  }
}
