  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  font-family: Montserrat, sans-serif;
}

.newsletter-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(197, 160, 89, 0.5);
  background: linear-gradient(135deg, #D4AF6A 0%, #C5A059 100%);
}

.newsletter-btn .material-icons {
  font-size: 20px;
}

.footer-bottom {
  background: #0A0A0A;
  padding: 25px 0;
  margin-top: 50px;
  border-top: 1px solid #222;
}

.footer-bottom-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 20px;
}

.footer-bottom p {
  font-family: Roboto, sans-serif;
  font-size: 0.9rem;
  color: #888;
  margin: 0;
}

.footer-bottom-links {
  display: flex;
  gap: 25px;
}

.footer-bottom-links a {
  color: #888;
  text-decoration: none;
  font-family: Roboto, sans-serif;
  font-size: 0.9rem;
  transition: color 0.3s ease;
}

.footer-bottom-links a:hover {
  color: #C5A059;
}

.payment-methods {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-top: 15px;
}

.payment-methods .material-icons {
  font-size: 32px;
  color: #555;
  transition: color 0.3s ease;
}

.payment-methods .material-icons:hover {
  color: #C5A059;
}

/* Responsive Design */
@media (max-width: 768px) {
  .register-card {
    margin: 20px;
    border-radius: 20px;
  }

  .register-header {
    padding: 30px 20px;
  }

  .register-title {
    font-size: 1.6rem;
  }

  .register-body {
    padding: 30px 20px;
  }

  .register-btn {
    font-size: 1rem;
    padding: 14px;
  }

  .verification-success {
    padding: 40px 20px;
    margin: 20px;
    border-radius: 20px;
  }

  .verification-success h2 {
    font-size: 1.6rem;
  }

  .success-icon {
    width: 80px;
    height: 80px;
  }

  .success-icon .material-icons {
    font-size: 50px;
  }

  .header-content {
    flex-wrap: wrap;
  }

  .search-section {
    order: 3;
    width: 100%;
    max-width: 100%;
  }

  .nav-menu {
    flex-wrap: wrap;
    gap: 20px;
  }

  /* Footer Responsive */
  .footer-content {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .footer-section {
    text-align: center;
  }

  .footer-logo {
    justify-content: center;
  }

  .social-links {
    justify-content: center;
  }

  .footer-links a {
    justify-content: center;
  }

  .contact-info li {
    justify-content: center;
  }

  .footer-bottom-content {
    flex-direction: column;
    text-align: center;
  }

  .footer-bottom-links {
    flex-direction: column;
    gap: 10px;
  }

  .payment-methods {
    justify-content: center;
  }
}
