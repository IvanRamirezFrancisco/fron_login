  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 10px;
}

/* Badge */
.slq-badge {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 2px 8px;
  border-radius: 4px;
  white-space: nowrap;
}
.slq-badge--blocked { background: rgba(220, 53, 69, .1);  color: #dc3545; }
.slq-badge--idle-tx { background: rgba(220, 53, 69, .15); color: #a71d2a; }
.slq-badge--slow    { background: rgba(197, 160, 89, .15); color: #7b5800; }
.slq-badge--watch   { background: rgba(59, 130, 246, .1);  color: #1d4ed8; }
.slq-badge--normal  { background: rgba(40, 167, 69, .1);   color: #155724; }

/* Query meta */
.slq-query-duration {
  display: inline-flex;
  align-items: center;
  gap: .2rem;
  font-size: 13px;
  font-weight: 600;
  color: #1A1A1A;
}
.slq-query-duration .material-icons { font-size: .9rem; }
.slq-duration--critical { color: #dc3545; }
.slq-query-user {
  display: inline-flex;
  align-items: center;
  gap: .2rem;
  font-size: 12px;
  color: #6b7280;
}
.slq-query-user .material-icons { font-size: .85rem; }
.slq-query-app { font-size: 11px; color: #9ca3af; }
.slq-query-pid {
  font-size: 11px;
  color: #9ca3af;
  font-family: 'Courier New', monospace;
}
.slq-query-ip {
  display: inline-flex;
  align-items: center;
  gap: .15rem;
  font-size: 11px;
  color: #9ca3af;
}
.slq-query-ip .material-icons { font-size: .8rem; }
.slq-query-wait {
  display: inline-flex;
  align-items: center;
  gap: .2rem;
  font-size: 11px;
  color: #dc3545;
  font-weight: 500;
}
.slq-query-wait .material-icons { font-size: .8rem; }

/* Query preview */
.slq-query-preview {
  font-size: 12px;
  font-family: 'Courier New', monospace;
  background: #f5f0eb;
  border: 1px solid #E8E2DC;
  border-radius: 6px;
  padding: 8px 12px;
  margin: 0;
  white-space: pre-wrap;
  word-break: break-all;
  color: #1A1A1A;
  max-height: 80px;
  overflow: hidden;
  line-height: 1.45;
}

/* ── Locks section ───────────────────────────────────────────────────────── */
.slq-locks-section { margin-top: 1rem; }
.slq-locks-title {
  display: flex;
  align-items: center;
  gap: .4rem;
  font-size: 15px;
  font-weight: 600;
  color: #dc3545;
  margin: 0 0 4px;
}
.slq-locks-title .material-icons { font-size: 1.1rem; }
.slq-locks-subtitle {
  font-size: .78rem;
  color: #6b7280;
  margin: 0 0 .75rem;
}
.slq-lock-row {
  background: #FDFCFB;
  border: 1.5px solid rgba(220, 53, 69, .2);
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.slq-lock-party {
  padding: 10px 12px;
  border-radius: 8px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}
.slq-lock-party--blocked { background: rgba(220, 53, 69, .06); }
.slq-lock-party--blocker { background: rgba(197, 160, 89, .06); }
.slq-lock-party__label {
  font-size: 10px;
  text-transform: uppercase;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: #6b7280;
}
.slq-lock-party__pid {
  font-family: 'Courier New', monospace;
  font-size: 13px;
  font-weight: 600;
  color: #1A1A1A;
}
.slq-lock-party__user {
  font-size: 12px;
  color: #6b7280;
}
.slq-lock-party__app {
  font-size: 11px;
  color: #9ca3af;
}
.slq-lock-party__wait {
  display: inline-flex;
  align-items: center;
  gap: .2rem;
  font-size: 12px;
  color: #dc3545;
  font-weight: 600;
}
.slq-lock-party__wait .material-icons { font-size: .85rem; }
.slq-lock-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .3rem;
  font-size: 12px;
  color: #9ca3af;
  padding: .15rem 0;
}
.slq-lock-arrow .material-icons { font-size: 1rem; }
.slq-lock-query {
  font-size: 11px;
  font-family: 'Courier New', monospace;
  background: #f5f0eb;
  border-radius: 4px;
  padding: 6px 10px;
  margin: 6px 0 0;
  white-space: pre-wrap;
  word-break: break-all;
  width: 100%;
  max-height: 60px;
  overflow: hidden;
  color: #1A1A1A;
  line-height: 1.4;
}

/* ════════════════════════════════════════════════════════════════════════════
   TAB B — HISTORIAL (pg_stat_statements)
   ════════════════════════════════════════════════════════════════════════════ */

.slq-history { display: flex; flex-direction: column; gap: 1rem; }

/* Extension notice */
.slq-extension-notice {
  display: flex;
  gap: 14px;
  background: rgba(59, 130, 246, .06);
  border: 1px solid rgba(59, 130, 246, .2);
  border-radius: 10px;
  padding: 18px 20px;
}
.slq-extension-notice__icon {
  font-size: 1.3rem;
  flex-shrink: 0;
  color: #3b82f6;
}
.slq-extension-notice strong {
  display: block;
  font-size: .88rem;
  color: #1A1A1A;
  margin-bottom: .35rem;
}
.slq-extension-notice p {
  font-size: .82rem;
  color: #6b7280;
  line-height: 1.5;
  margin: .3rem 0;
}
.slq-notice-code {
  display: block;
  background: #f5f0eb;
  border: 1px solid #E8E2DC;
  border-radius: 6px;
  padding: 8px 12px;
  margin: 8px 0;
  font-size: 13px;
  font-family: 'Courier New', monospace;
  color: #722f37;
}
.slq-notice-hint {
  font-size: .75rem;
  color: #9ca3af;
}

.slq-history-subtitle {
  font-size: .82rem;
  color: #6b7280;
  line-height: 1.5;
  margin: 0;
}

/* ── Expensive queries table ─────────────────────────────────────────────── */
.slq-table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border: 1px solid #E8E2DC;
  border-radius: 10px;
  background: #FDFCFB;
}
.slq-expensive-table,
.slq-stats-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
}
.slq-expensive-table thead th,
.slq-stats-table thead th {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #6b7280;
  font-weight: 600;
  padding: 10px 12px;
  border-bottom: 1.5px solid #E8E2DC;
  font-family: 'Poppins', sans-serif;
  background: #f8f6f3;
  white-space: nowrap;
}
.slq-th-numeric { text-align: right; }
.slq-th-tooltip {
  display: inline-flex;
  vertical-align: middle;
  margin-left: .25rem;
  cursor: help;
}
.slq-th-tooltip .material-icons {
  font-size: .75rem;
  color: #9ca3af;
}
.slq-expensive-table tbody tr,
.slq-stats-table tbody tr {
  transition: background .1s;
}
.slq-expensive-table tbody tr:hover,
.slq-stats-table tbody tr:hover {
  background: #f5f0eb;
}
.slq-expensive-table tbody td,
.slq-stats-table tbody td {
  padding: 12px;
  border-bottom: 1px solid #E8E2DC;
  font-size: 13px;
  vertical-align: middle;
  color: #1A1A1A;
}
.slq-td-numeric { text-align: right; font-variant-numeric: tabular-nums; }
.slq-td-query { max-width: 380px; }
.slq-row-critical { background: rgba(220, 53, 69, .03); }
.slq-row-warning  { background: rgba(197, 160, 89, .03); }

.slq-ms-badge {
  display: inline-block;
  font-family: 'Courier New', monospace;
  font-size: 13px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 4px;
  background: rgba(40, 167, 69, .08);
  color: #155724;
}
.slq-ms-critical { background: rgba(220, 53, 69, .1); color: #dc3545; }
.slq-ms-warning  { background: rgba(197, 160, 89, .1); color: #7b5800; }

.slq-exp-query-preview {
  font-size: 11px;
  font-family: 'Courier New', monospace;
  color: #1A1A1A;
  background: #f5f0eb;
  border: 1px solid #E8E2DC;
  border-radius: 6px;
  padding: 6px 10px;
  margin: 0;
  max-width: 360px;
  white-space: nowrap;      /* fuerza una sola línea */
  overflow: hidden;         /* oculta el desbordamiento */
  text-overflow: ellipsis;  /* añade los … */
  cursor: help;             /* indica que hay tooltip */
  line-height: 1.4;
  display: block;           /* necesario para que text-overflow funcione en pre */
}

.slq-cache-low { color: #dc3545; font-weight: 600; }

/* Impact bar */
.slq-impact-bar {
  height: 8px;
  background: #E8E2DC;
  border-radius: 4px;
  width: 80px;
  overflow: hidden;
}
.slq-impact-bar__fill {
  height: 100%;
  background: linear-gradient(90deg, #722f37, #8a3545);
  border-radius: 4px;
  transition: width .3s ease;
}

/* Legend */
.slq-history-note {
  display: flex;
  gap: 16px;
  align-items: center;
  margin-top: 4px;
  font-size: 12px;
  color: #6b7280;
  flex-wrap: wrap;
}
.slq-legend { white-space: nowrap; font-weight: 500; }
.slq-legend--critical { color: #dc3545; }
.slq-legend--warning  { color: #C5A059; }
.slq-legend--ok       { color: #28a745; }
.slq-note-hint {
  font-style: italic;
  flex: 1;
  min-width: 200px;
}

/* ════════════════════════════════════════════════════════════════════════════
   TAB C — TABLAS CON CARGA
   ════════════════════════════════════════════════════════════════════════════ */

.slq-tables { display: flex; flex-direction: column; gap: 1rem; }

.slq-tables-subtitle {
  font-size: .82rem;
  color: #6b7280;
  line-height: 1.5;
  margin: 0;
}
.slq-tables-subtitle code {
  background: #f3f4f6;
  padding: .1em .35em;
  border-radius: 4px;
  font-size: .78rem;
  color: #722f37;
}

/* Seq scan alert */
.slq-seqscan-alert {
  display: flex;
  align-items: flex-start;
  gap: .5rem;
  background: rgba(197, 160, 89, .08);
  border: 1px solid rgba(197, 160, 89, .3);
  border-left: 3px solid #C5A059;
  border-radius: 8px;
  padding: 10px 14px;
  font-size: 13px;
  color: #1A1A1A;
  line-height: 1.5;
}
.slq-seqscan-alert .material-icons {
  font-size: 1.1rem;
  color: #C5A059;
  flex-shrink: 0;
  margin-top: 1px;
}

/* Table stats specifics */
.slq-td-tablename {
  display: flex;
  align-items: center;
  gap: .35rem;
  font-weight: 500;
  white-space: nowrap;
}
.slq-table-icon {
  font-size: .9rem;
  color: #9ca3af;
}
.slq-seqscan-high { color: #dc3545; font-weight: 700; }
.slq-dead-high    { color: #C5A059; font-weight: 600; }
.slq-ts-row-warn  { background: rgba(197, 160, 89, .04); }

/* Index usage bar */
.slq-idx-bar {
  display: flex;
  align-items: center;
  gap: 6px;
  min-width: 80px;
}
.slq-idx-bar__fill {
  height: 6px;
  border-radius: 3px;
  background: #28a745;
  transition: width .3s;
  flex-shrink: 0;
  min-width: 2px;
}
.slq-idx-bar__fill.slq-idx-low { background: #dc3545; }
.slq-idx-label {
  font-size: 12px;
  color: #6b7280;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

/* ════════════════════════════════════════════════════════════════════════════
   TABLA — FILA CLICKABLE (abre modal de detalle)
   ════════════════════════════════════════════════════════════════════════════ */
.slq-row-clickable {
  cursor: pointer;
}
.slq-row-clickable:hover .slq-exp-query-preview {
  color: #722f37;
}
.slq-row-detail-hint {
  display: none;
  font-size: 10px;
  color: #C5A059;
  font-weight: 600;
  margin-top: 3px;
  letter-spacing: .03em;
}
.slq-row-clickable:hover .slq-row-detail-hint {
  display: block;
}

/* ════════════════════════════════════════════════════════════════════════════
   MODAL — DETALLE DE QUERY COSTOSA
   ════════════════════════════════════════════════════════════════════════════ */

/* Backdrop */
.slq-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, .55);
  z-index: 1050;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  backdrop-filter: blur(2px);
  animation: slq-backdrop-in .15s ease;
}
@keyframes slq-backdrop-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* Contenedor */
.slq-modal {
  background: #FDFCFB;
  border-radius: 14px;
  box-shadow: 0 24px 60px rgba(0, 0, 0, .22), 0 4px 16px rgba(0, 0, 0, .1);
  width: 100%;
  max-width: 760px;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: slq-modal-in .18s cubic-bezier(.34, 1.56, .64, 1);
}
@keyframes slq-modal-in {
  from { opacity: 0; transform: scale(.94) translateY(12px); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}

/* Header */
.slq-modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 22px;
  border-bottom: 1.5px solid #E8E2DC;
  background: #f8f6f3;
  flex-shrink: 0;
}
.slq-modal__header-left {
  display: flex;
  align-items: center;
  gap: .6rem;
}
.slq-modal__header-icon {
  font-size: 1.3rem;
  color: #722f37;
}
.slq-modal__title {
  margin: 0;
  font-size: 1rem;
  font-weight: 700;
  color: #1A1A1A;
}
.slq-modal__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: none;
  border-radius: 8px;
  background: transparent;
  color: #6b7280;
  cursor: pointer;
  transition: all .15s;
}
.slq-modal__close .material-icons { font-size: 1.2rem; }
.slq-modal__close:hover {
  background: rgba(220, 53, 69, .08);
  color: #dc3545;
}

/* Body */
.slq-modal__body {
  flex: 1;
  overflow-y: auto;
  padding: 20px 22px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* KPIs grid */
.slq-modal__kpis {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
.slq-modal__kpi {
  background: #f8f6f3;
  border: 1px solid #E8E2DC;
  border-radius: 10px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.slq-modal__kpi-label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: #6b7280;
  font-weight: 600;
}
.slq-modal__kpi-value {
  font-size: 1.1rem;
  font-weight: 700;
  color: #1A1A1A;
  font-variant-numeric: tabular-nums;
}
.slq-modal__kpi-value--critical { color: #dc3545; }
.slq-modal__kpi-value--warning  { color: #b45309; }

/* SQL viewer header */
.slq-modal__sql-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .75rem;
}
.slq-modal__sql-label {
  display: flex;
  align-items: center;
  gap: .3rem;
  font-size: .78rem;
  font-weight: 600;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: .05em;
}
.slq-modal__sql-label .material-icons { font-size: .95rem; }

/* Copy button */
.slq-modal__copy-btn {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  padding: .4rem .9rem;
  border: 1.5px solid #C5A059;
  border-radius: 8px;
  background: rgba(197, 160, 89, .06);
  color: #7b5800;
  font-size: .78rem;
  font-weight: 600;
  cursor: pointer;
  transition: all .15s;
  font-family: 'Poppins', sans-serif;
}
.slq-modal__copy-btn .material-icons { font-size: .9rem; }
.slq-modal__copy-btn:hover {
  background: rgba(197, 160, 89, .15);
  border-color: #a67c00;
}
/* Estado copiado */
.slq-modal__copy-btn:has(.material-icons:first-child) {
  border-color: #28a745;
  background: rgba(40, 167, 69, .08);
  color: #155724;
}

/* SQL block */
.slq-modal__sql-block {
  background: #1e1e2e;
  border-radius: 10px;
  border: 1px solid #2d2d3d;
  max-height: 260px;
  overflow-y: auto;
  overflow-x: auto;
}
.slq-modal__sql-pre {
  margin: 0;
  padding: 16px 18px;
  font-size: 12.5px;
  font-family: 'Courier New', 'Fira Code', monospace;
  color: #cdd6f4;
  white-space: pre-wrap;
  word-break: break-all;
  line-height: 1.65;
}

/* Insight banner */
.slq-modal__insight {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px 14px;
  border-radius: 8px;
  font-size: .82rem;
  line-height: 1.5;
}
.slq-modal__insight .material-icons { font-size: 1.1rem; flex-shrink: 0; margin-top: 1px; }
.slq-modal__insight code {
  background: rgba(0,0,0,.08);
  padding: .1em .35em;
  border-radius: 3px;
  font-size: .78rem;
}
.slq-modal__insight--critical {
  background: rgba(220, 53, 69, .07);
  border: 1px solid rgba(220, 53, 69, .2);
  color: #9f1239;
}
.slq-modal__insight--critical .material-icons { color: #dc3545; }
.slq-modal__insight--warning {
  background: rgba(197, 160, 89, .08);
  border: 1px solid rgba(197, 160, 89, .25);
  color: #7b5800;
}
.slq-modal__insight--warning .material-icons { color: #C5A059; }
.slq-modal__insight--ok {
  background: rgba(40, 167, 69, .06);
  border: 1px solid rgba(40, 167, 69, .2);
  color: #155724;
}
.slq-modal__insight--ok .material-icons { color: #28a745; }

/* Insight — info (catalog / JDBC queries) */
.slq-modal__insight--info {
  background: rgba(59, 130, 246, .06);
  border: 1px solid rgba(59, 130, 246, .2);
  color: #1e40af;
}
.slq-modal__insight--info .material-icons { color: #3b82f6; }

/* Footer */
.slq-modal__footer {
  padding: 14px 22px;
  border-top: 1.5px solid #E8E2DC;
  display: flex;
  justify-content: flex-end;
  background: #f8f6f3;
  flex-shrink: 0;
}
.slq-modal__close-btn {
  padding: .5rem 1.5rem;
  border: 1.5px solid #E8E2DC;
  border-radius: 8px;
  background: #fff;
  font-size: .85rem;
  font-weight: 500;
  color: #6b7280;
  cursor: pointer;
  font-family: 'Poppins', sans-serif;
  transition: all .15s;
}
.slq-modal__close-btn:hover {
  border-color: #722f37;
  color: #722f37;
  background: rgba(114, 47, 55, .04);
}

/* ════════════════════════════════════════════════════════════════════════════
   MEJORA #2 — INSIGHT CONTEXTUAL (Modal multi-issue)
   ════════════════════════════════════════════════════════════════════════════ */
.slq-insight__content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.slq-insight__label {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: #6b7280;
  margin: 0 0 4px;
}
.slq-insight__list {
  margin: 0 0 4px;
  padding-left: 16px;
  font-size: 13px;
  line-height: 1.65;
  color: #1A1A1A;
}
.slq-insight__list li { margin-bottom: 4px; }
.slq-insight__list:last-child { margin-bottom: 0; }
.slq-insight__list--actions {
  color: #722f37;
  font-weight: 500;
}
.slq-insight__list--actions li {
  list-style: none;
}
.slq-insight__ok-msg {
  margin: 0;
  font-size: 13px;
  line-height: 1.55;
  color: #155724;
}

/* Override insight border-left for the new severity model */
.slq-modal__insight.slq-modal__insight--critical {
  border-left: 3px solid #dc3545;
}
.slq-modal__insight.slq-modal__insight--warning {
  border-left: 3px solid #C5A059;
}
.slq-modal__insight.slq-modal__insight--ok {
  border-left: 3px solid #28a745;
}
.slq-modal__insight.slq-modal__insight--info {
  border-left: 3px solid #3b82f6;
}

/* ════════════════════════════════════════════════════════════════════════════
   TAB C — BOTÓN DIAGNOSTICAR (columna Acción de la tabla)
   ════════════════════════════════════════════════════════════════════════════ */
.slq-th-action {
  text-align: center;
  white-space: nowrap;
  font-weight: 600;
  font-size: .75rem;
  color: #6b7280;
  padding: 10px 14px;
}
.slq-td-action {
  text-align: center;
  padding: 8px 14px;
  vertical-align: middle;
}
.slq-diag-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: #eff6ff;
  color: #1d4ed8;
  border: 1px solid #bfdbfe;
  border-radius: 6px;
  padding: 5px 10px;
  font-size: .76rem;
  font-weight: 600;
  cursor: pointer;
  transition: background .15s, border-color .15s, transform .1s;
  white-space: nowrap;
  line-height: 1;
}
.slq-diag-btn:hover {
  background: #dbeafe;
  border-color: #93c5fd;
  transform: translateY(-1px);
}
.slq-diag-btn:active {
  transform: translateY(0);
}
.slq-diag-btn__icon {
  font-size: .95rem;
}

/* ════════════════════════════════════════════════════════════════════════════
   TAB C — MODAL DE SUGERENCIA DE ÍNDICE
   ════════════════════════════════════════════════════════════════════════════ */
.slq-tbl-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, .55);
  backdrop-filter: blur(3px);
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  animation: slq-backdrop-in .18s ease;
}
.slq-tbl-modal {
  background: #ffffff;
  border-radius: 14px;
  box-shadow: 0 20px 60px rgba(0,0,0,.25);
  width: 100%;
  max-width: 640px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: slq-modal-in .22s cubic-bezier(.34,1.56,.64,1);
  max-height: calc(100vh - 40px);
}

/* Header */
.slq-tbl-modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 18px 20px;
  background: #eff6ff;
  border-bottom: 1px solid #bfdbfe;
}
.slq-tbl-modal__header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}
.slq-tbl-modal__header-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: #dbeafe;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.slq-tbl-modal__header-icon .material-icons {
  font-size: 1.3rem;
  color: #1d4ed8;
}
.slq-tbl-modal__title {
  font-size: 1rem;
  font-weight: 700;
  color: #1e40af;
  margin: 0;
}
.slq-tbl-modal__subtitle {
  font-size: .78rem;
  color: #6b7280;
  margin: 2px 0 0;
}
.slq-tbl-modal__subtitle strong {
  color: #1A1A1A;
}
.slq-tbl-modal__close {
  background: none;
  border: none;
  cursor: pointer;
  color: #6b7280;
  padding: 4px;
  display: flex;
  border-radius: 6px;
  transition: color .15s, background .15s;
  flex-shrink: 0;
}
.slq-tbl-modal__close:hover {
  color: #1A1A1A;
  background: #dbeafe;
}

/* Body */
.slq-tbl-modal__body {
  overflow-y: auto;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* KPI pills */
.slq-tbl-modal__kpis {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}
@media (max-width: 560px) {
  .slq-tbl-modal__kpis { grid-template-columns: repeat(2, 1fr); }
}
.slq-tbl-modal__kpi {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.slq-tbl-modal__kpi--warn {
  background: #fef3c7;
  border-color: #fde68a;
}
.slq-tbl-modal__kpi-label {
  font-size: .7rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .04em;
  color: #6b7280;
}
.slq-tbl-modal__kpi--warn .slq-tbl-modal__kpi-label { color: #92400e; }
.slq-tbl-modal__kpi-value {
  font-size: 1.1rem;
  font-weight: 700;
  color: #1A1A1A;
}
.slq-tbl-modal__kpi--warn .slq-tbl-modal__kpi-value { color: #b45309; }

/* Diagnosis text */
.slq-tbl-modal__diagnosis {
  background: #fffbeb;
  border: 1px solid #fde68a;
  border-left: 3px solid #f59e0b;
  border-radius: 8px;
  padding: 12px 14px;
}
.slq-tbl-modal__diagnosis-text {
  font-size: .85rem;
  color: #1A1A1A;
  line-height: 1.6;
  margin: 0;
}
.slq-tbl-modal__pct-warn {
  color: #b45309;
}

/* Steps list */
.slq-tbl-modal__steps {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.slq-tbl-modal__steps-title {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: .82rem;
  font-weight: 700;
  color: #374151;
  margin: 0;
}
.slq-tbl-modal__steps-title .material-icons { font-size: 1rem; color: #6b7280; }
.slq-tbl-modal__step-list {
  margin: 0;
  padding-left: 20px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: .82rem;
  color: #374151;
  line-height: 1.55;
}
.slq-tbl-modal__step-list code {
  background: #f1f5f9;
  padding: 1px 5px;
  border-radius: 4px;
  font-size: .78rem;
  color: #be185d;
  font-family: 'Courier New', monospace;
}

/* SQL dark block */
.slq-tbl-modal__sql-block {
  background: #0f172a;
  border-radius: 10px;
  border: 1px solid #1e293b;
  max-height: 240px;
  overflow-y: auto;
  overflow-x: auto;
}
.slq-tbl-modal__sql-label {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 10px 14px 6px;
  font-size: .7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: #64748b;
  border-bottom: 1px solid #1e293b;
}
.slq-tbl-modal__sql-label .material-icons { font-size: .9rem; }
.slq-tbl-modal__sql-pre {
  margin: 0;
  padding: 14px 16px;
  font-size: 12px;
  font-family: 'Courier New', 'Fira Code', monospace;
  color: #cbd5e1;
  white-space: pre-wrap;
  word-break: break-word;
  line-height: 1.65;
}

/* Note */
.slq-tbl-modal__note {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  background: #f0f9ff;
  border: 1px solid #bae6fd;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: .8rem;
  color: #0c4a6e;
  line-height: 1.5;
}
.slq-tbl-modal__note .material-icons { font-size: 1rem; flex-shrink: 0; margin-top: 1px; color: #0284c7; }
.slq-tbl-modal__note code {
  background: #e0f2fe;
  padding: 1px 5px;
  border-radius: 4px;
  font-size: .75rem;
  font-family: 'Courier New', monospace;
  color: #0369a1;
}

/* Footer */
.slq-tbl-modal__footer {
  display: flex;
  justify-content: flex-end;
  padding: 14px 20px;
  border-top: 1px solid #e2e8f0;
  background: #f8fafc;
}
.slq-tbl-modal__close-btn {
  background: #1d4ed8;
  color: #ffffff;
  border: none;
  border-radius: 8px;
  padding: 9px 22px;
  font-size: .85rem;
  font-weight: 600;
  cursor: pointer;
  transition: background .15s;
}
.slq-tbl-modal__close-btn:hover {
  background: #1e40af;
}

/* ════════════════════════════════════════════════════════════════════════════
   MEJORA #4 — CONFIG PG INDICADORES DE ESTADO
   ════════════════════════════════════════════════════════════════════════════ */
.slq-config-item__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .5rem;
}
.slq-config-item__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}
.slq-dot--ok      { background: #28a745; }
.slq-dot--warning { background: #C5A059; }
.slq-dot--info    { background: #3b82f6; }
.slq-config-item--warning {
  border-color: rgba(197, 160, 89, .35);
  background: rgba(197, 160, 89, .04);
}
.slq-config-item--ok {
  border-color: rgba(40, 167, 69, .25);
}
.slq-config-item__status {
  font-size: 11px;
  color: #6b7280;
  margin-top: 2px;
  line-height: 1.4;
}

/* ════════════════════════════════════════════════════════════════════════════
   RESPONSIVE
   ════════════════════════════════════════════════════════════════════════════ */
@media (max-width: 768px) {
  .slq-tabs { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .slq-tab { padding: 8px 14px; font-size: 12px; white-space: nowrap; }
  .slq-section-header { flex-direction: column; align-items: flex-start; }
  .slq-section-header__right { width: 100%; justify-content: flex-end; }
  .slq-config-grid { grid-template-columns: 1fr; }
  .slq-lock-alert { flex-direction: column; }
  .slq-lock-alert__link { margin-left: 0; }
  .slq-query-top-row { gap: 6px; }
  .slq-expensive-table thead th,
  .slq-stats-table thead th { font-size: 10px; padding: 8px; }
  .slq-expensive-table tbody td,
  .slq-stats-table tbody td { padding: 8px; font-size: 12px; }
  .slq-td-query { max-width: 200px; }
  .slq-exp-query-preview { max-width: 180px; }
  .slq-modal { max-height: 95vh; }
  .slq-modal__kpis { grid-template-columns: repeat(2, 1fr); }
  .slq-modal__body { padding: 14px 16px; }
  .slq-modal__header { padding: 14px 16px; }
  .slq-modal__footer { padding: 12px 16px; }
}
