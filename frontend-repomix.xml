}

.stock-status.in-stock {
  color: #28a745;
  background: #d4edda;
}

.stock-status.out-stock {
  color: #dc3545;
  background: #f8d7da;
}

.stock-status .material-symbols-outlined {
  font-size: 14px;
}

/* Precio - DISEÑO PROFESIONAL */
.oferta-precio {
  margin-top: auto;
  padding-top: 0.8rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

/* Precio Header - Precio anterior */
.precio-header {
  display: flex;
