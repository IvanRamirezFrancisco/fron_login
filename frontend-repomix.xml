            <span class="tab-title">Multimedia</span>
            <span class="tab-subtitle">Imágenes del producto</span>
          </span>
          <span class="tab-indicator"></span>
        </button>
        
        <button 
          class="tab-btn" 
          [class.active]="currentTab === 'details'"
          (click)="setTab('details')">
          <span class="material-icons">description</span>
          <span class="tab-label">
            <span class="tab-title">Especificaciones</span>
            <span class="tab-subtitle">Detalles y descripción</span>
          </span>
          <span class="tab-indicator"></span>
        </button>
      </div>
    </div>

    <!-- Mensajes de Error Global -->
    <div *ngIf="errorMessage" class="alert alert-error-modal">
      <span class="material-icons">error</span>
      <span>{{ errorMessage }}</span>
    </div>

    <!-- Body del Modal con Contenido por Tabs -->
    <div class="modal-body">
      <form class="product-form-professional">
        
        <!-- ============================================
             TAB 1: INFORMACIÓN GENERAL
             ============================================ -->
        <div class="tab-content" *ngIf="currentTab === 'general'">
          <div class="form-section-tab">
            <div class="section-intro">
              <span class="material-icons intro-icon">info</span>
              <div>
                <h3>Información General del Producto</h3>
                <p>Ingrese los datos básicos y esenciales del producto</p>
              </div>
            </div>

            <div class="form-grid">
