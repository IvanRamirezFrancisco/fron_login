    }

  </div><!-- /mnt-card reindex -->

  <!-- ════════════════════════════════════════════════════════════════════════
       SECCIÓN 4 — ACCESO A AUTOMATIZACIONES
  ════════════════════════════════════════════════════════════════════════════ -->
  <div class="mnt-auto-redirect-banner">
    <div class="mnt-auto-redirect-banner__left">
      <span class="mnt-auto-redirect-banner__icon">
        <span class="material-icons">schedule</span>
