}

/* Botón agregar atributo */
.btn-add-attribute {
  width: 100%;
  padding: 1rem 1.5rem;
  background: linear-gradient(135deg, #722f37 0%, #9A1A2F 100%);
  border: none;
  border-radius: 12px;
  color: white;
  font-weight: 600;
  font-size: 0.95rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4px 12px rgba(128, 0, 32, 0.25);
}

.btn-add-attribute:hover {
  background: linear-gradient(135deg, #6d001a 0%, #851727 100%);
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(128, 0, 32, 0.35);
}

.btn-add-attribute .material-icons {
  font-size: 1.5rem;
}

/* Tips de atributos */
.attributes-tips {
  margin-top: 1rem;
  padding: 1rem;
  background: #fef3c7;
  border-left: 4px solid #f59e0b;
  border-radius: 8px;
}

.tip-mini {
  display: flex;
  align-items: start;
  gap: 0.75rem;
  font-size: 0.85rem;
